@model IEnumerable<Last_Dance_System.Models.LearnerLesson>

@{
    ViewBag.Title = "Learner's Licence Lessons";
}

<style>
    body {
        background-color: #f4f8fc;
    }

    .learner-header {
        background: linear-gradient(135deg, #0d6efd, #1565c0);
        color: white;
        padding: 35px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }

        .learner-header h2 {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .learner-header p {
            margin: 0;
            font-size: 16px;
            opacity: 0.95;
        }

    .lesson-card {
        background: white;
        border: none;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
        transition: all 0.2s ease;
    }

        .lesson-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
        }

    .lesson-number {
        width: 45px;
        height: 45px;
        background-color: #e8f1ff;
        color: #1565c0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin-bottom: 18px;
    }

    .lesson-title {
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .lesson-description {
        color: #666;
        min-height: 60px;
        line-height: 1.6;
    }

    .btn-start {
        background-color: #0d6efd;
        color: white;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        border: none;
    }

        .btn-start:hover {
            background-color: #1565c0;
            color: white;
        }

    .empty-lessons {
        background: white;
        padding: 50px;
        border-radius: 15px;
        text-align: center;
        color: #666;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }
</style>

<div class="container mt-4 mb-5">

    <!-- HEADER -->
    <div class="learner-header">

        <h2>Learner's Licence Lessons</h2>

        <p>
            Prepare yourself for your learner's licence test by studying
            important rules, road signs and road safety information.
        </p>


        <!-- ACTION BUTTONS -->

        <div style="margin-top: 20px;">

            <!-- BACK TO DASHBOARD -->

            <a href="@Url.Action("Index", "Dashboard")"
               style="
                display: inline-block;
                margin-right: 10px;
                padding: 9px 16px;
                background: rgba(255,255,255,0.15);
                color: white;
                border: 1px solid rgba(255,255,255,0.6);
                border-radius: 8px;
                text-decoration: none;
                font-size: 12px;
                font-weight: 700;">

                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard

            </a>


            <!-- ALREADY HAVE LEARNER'S LICENCE -->

            <span style="
                font-size: 13px;
                opacity: 0.95;">
                Already have a learner's licence?
            </span>


            <!-- BOOK PRACTICAL LESSON -->

            <a href="@Url.Action("Create", "Booking")"
               style="
                display: inline-block;
                margin-left: 10px;
                padding: 9px 16px;
                background: white;
                color: #1565c0;
                border-radius: 8px;
                text-decoration: none;
                font-size: 12px;
                font-weight: 700;">

                <i class="fa-solid fa-car"></i>
                Book a Driving Lesson

            </a>

        </div>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var lesson in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="lesson-card">

                        <div class="lesson-number">
                            @lesson.LessonOrder
                        </div>

                        <h4 class="lesson-title">
                            @lesson.Title
                        </h4>

                        <p class="lesson-description">
                            @lesson.Description
                        </p>

                        <a href="@Url.Action("Details", "LearnerLessons", new { id = lesson.LearnerLessonId })"
                           class="btn btn-start">
                            Start Lesson
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-lessons">
            <h4>No lessons available</h4>

            <p>
                Learner's licence lessons will appear here once they
                have been added by the administrator.
            </p>
        </div>
    }

</div>