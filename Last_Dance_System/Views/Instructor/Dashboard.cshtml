@{
    ViewBag.Title = "Instructor Dashboard";
}

<h1 class="page-title">Instructor Dashboard</h1>
<p class="page-subtitle">Your schedule and assigned students.</p>

<a href="@Url.Action("Schedule", "Instructor")" class="btn btn-red-action mb-4">Open schedule</a>

<hr style="border-color: var(--card-border);" class="mb-4" />

<!-- Lessons Today Card -->
<div class="stat-card">
    <div>
        <div class="stat-title">LESSONS TODAY</div>
        <div class="stat-value">@Model.LessonsToday</div>
    </div>
    <i class="bi bi-people fs-3 text-danger"></i>
</div>

<!-- Upcoming Card -->
<div class="stat-card">
    <div>
        <div class="stat-title">UPCOMING</div>
        <div class="stat-value">@Model.UpcomingLessons</div>
    </div>
    <i class="bi bi-people fs-3 text-danger"></i>
</div>

<!-- Completed Card -->
<div class="stat-card">
    <div>
        <div class="stat-title">COMPLETED</div>
        <div class="stat-value">@Model.CompletedLessons</div>
    </div>
    <i class="bi bi-people fs-3 text-danger"></i>
</div>

<!-- Students Card -->
<div class="stat-card">
    <div>
        <div class="stat-title">STUDENTS</div>
        <div class="stat-value">@Model.TotalStudents</div>
    </div>
    <i class="bi bi-people fs-3 text-danger"></i>
</div>