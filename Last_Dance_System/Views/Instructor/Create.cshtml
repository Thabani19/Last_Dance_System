
@model Last_Dance_System.Models.InstructorRegisterViewModel

@{
    ViewBag.Title = "Add Instructor";
    Layout = null;
}

<!-- =========================================================
     FONT AWESOME
     ========================================================= -->

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: #f4f8fc;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #172b4d;
    }


    /* =========================================================
       MAIN PAGE
       ========================================================= */

    .instructor-page {
        min-height: 100vh;
        padding: 45px 25px 70px;
        background: radial-gradient( circle at 10% 10%, rgba(33, 150, 243, 0.10), transparent 28% ), radial-gradient( circle at 90% 90%, rgba(13, 71, 161, 0.07), transparent 30% ), linear-gradient( 135deg, #f8fbff 0%, #f1f6fb 50%, #eaf2f9 100% );
    }


    /* =========================================================
       WRAPPER
       ========================================================= */

    .instructor-wrapper {
        width: 100%;
        max-width: 1050px;
        margin: 0 auto;
    }


    /* =========================================================
       MAIN CARD
       ========================================================= */

    .instructor-card {
        background: #ffffff;
        border: 1px solid #dce7f1;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 20px 55px rgba(23, 43, 77, 0.10), 0 4px 15px rgba(23, 43, 77, 0.05);
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        background: linear-gradient( 135deg, #ffffff 0%, #f7fbff 55%, #eaf4ff 100% );
        padding: 32px 42px;
        border-bottom: 1px solid #dbe7f2;
    }


        /* =========================================================
       HEADER DECORATION
       ========================================================= */

        .page-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(33, 150, 243, 0.06);
            right: -100px;
            top: -150px;
        }


        .page-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(13, 71, 161, 0.045);
            left: 40%;
            bottom: -120px;
        }


    /* =========================================================
       HEADER CONTENT
       ========================================================= */

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
    }


    /* =========================================================
       HEADER ICON
       ========================================================= */

    .header-icon {
        width: 62px;
        height: 62px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient( 135deg, #2196f3, #1565c0 );
        color: #ffffff;
        font-size: 25px;
        box-shadow: 0 8px 22px rgba(33, 150, 243, 0.25);
    }


    /* =========================================================
       HEADER TEXT
       ========================================================= */

    .header-text h2 {
        margin: 0 0 5px;
        color: #172b4d;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.4px;
    }


    .header-text p {
        margin: 0;
        color: #71859a;
        font-size: 13px;
    }


    /* =========================================================
       BACK TO DASHBOARD BUTTON
       ========================================================= */

    .back-dashboard-button {
        position: relative;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 17px;
        background: #ffffff;
        border: 1px solid #cbdceb;
        border-radius: 9px;
        color: #31506f;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(23, 43, 77, 0.06);
    }


        .back-dashboard-button i {
            color: #1976d2;
            font-size: 12px;
            transition: transform 0.2s ease;
        }


        .back-dashboard-button:hover {
            background: #edf6ff;
            border-color: #2196f3;
            color: #0d47a1;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(33, 150, 243, 0.12);
        }


            .back-dashboard-button:hover i {
                color: #0d47a1;
                transform: translateX(-2px);
            }


    /* =========================================================
       FORM AREA
       ========================================================= */

    .instructor-form-area {
        padding: 38px 45px 42px;
        background: #ffffff;
    }


    /* =========================================================
       VALIDATION
       ========================================================= */

    .validation-summary-errors {
        background: #fff4f4;
        border: 1px solid #f3c7c7;
        border-left: 4px solid #dc3545;
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 25px;
        color: #b4232f;
        font-size: 13px;
    }


    .text-danger {
        display: block;
        color: #d93025;
        font-size: 11px;
        margin-top: 6px;
    }


    /* =========================================================
       FORM SECTION
       ========================================================= */

    .form-section {
        margin-bottom: 34px;
    }


    /* =========================================================
       SECTION HEADING
       ========================================================= */

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e5edf5;
    }


    .section-number {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf6ff;
        border: 1px solid #cfe6fa;
        color: #1976d2;
        font-size: 11px;
        font-weight: 800;
    }


    .section-heading h3 {
        margin: 0 0 3px;
        color: #172b4d;
        font-size: 17px;
        font-weight: 750;
    }


    .section-heading p {
        margin: 0;
        color: #8193a7;
        font-size: 12px;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .form-group {
        margin-bottom: 21px;
    }


    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #34495e;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }


    /* =========================================================
       INPUT WRAPPER
       ========================================================= */

    .input-wrapper {
        position: relative;
    }


    /* =========================================================
       INPUT ICON
       ========================================================= */

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        color: #7d93aa;
        font-size: 14px;
        text-align: center;
        pointer-events: none;
        z-index: 2;
    }


    /* =========================================================
       INPUTS
       ========================================================= */

    .form-control {
        width: 100%;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #d4e0eb;
        background: #fbfdff;
        color: #172b4d;
        padding: 12px 15px 12px 44px;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }


        .form-control::placeholder {
            color: #9aabba;
        }


        .form-control:hover {
            border-color: #b8cadb;
            background: #ffffff;
        }


        .form-control:focus {
            background: #ffffff;
            border-color: #2196f3;
            box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.10), 0 4px 12px rgba(33, 150, 243, 0.06);
        }


    /* =========================================================
       PASSWORD
       ========================================================= */

    .password-wrapper {
        position: relative;
    }


        .password-wrapper .form-control {
            padding-right: 75px;
        }


    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: #eef6ff;
        color: #1976d2;
        border-radius: 7px;
        padding: 6px 9px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }


        .toggle-password:hover {
            background: #dceeff;
            color: #0d47a1;
        }


    /* =========================================================
       PASSWORD STRENGTH
       ========================================================= */

    .password-strength {
        height: 4px;
        background: #e2eaf2;
        border-radius: 5px;
        margin-top: 9px;
        overflow: hidden;
    }


    .password-strength-bar {
        width: 0;
        height: 100%;
        background: linear-gradient( 90deg, #1976d2, #42a5f5 );
        border-radius: 5px;
        transition: width 0.25s ease;
    }


    .password-strength-text {
        font-size: 11px;
        color: #8193a7;
        margin-top: 6px;
    }


    /* =========================================================
       CREATE BUTTON
       ========================================================= */

    .btn-create {
        width: 100%;
        height: 53px;
        margin-top: 2px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( 135deg, #2196f3, #1565c0 );
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.7px;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(33, 150, 243, 0.20);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }


        .btn-create i {
            margin-right: 8px;
        }


        .btn-create:hover {
            transform: translateY(-2px);
            background: linear-gradient( 135deg, #42a5f5, #1976d2 );
            box-shadow: 0 12px 28px rgba(33, 150, 243, 0.28);
        }


        .btn-create:active {
            transform: translateY(0);
        }


    /* =========================================================
       FOOTER NOTE
       ========================================================= */

    .form-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-align: center;
        margin-top: 18px;
        color: #8193a7;
        font-size: 11px;
    }


        .form-note i {
            color: #2196f3;
            font-size: 11px;
        }


        .form-note strong {
            color: #587089;
        }


    /* =========================================================
       INPUT AUTOFILL
       ========================================================= */

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
        -webkit-text-fill-color: #172b4d;
        -webkit-box-shadow: 0 0 0 1000px #ffffff inset;
        transition: background-color 5000s ease-in-out 0s;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 850px) {

        .instructor-page {
            padding: 25px 18px 50px;
        }


        .page-header {
            padding: 30px;
            flex-direction: column;
            align-items: stretch;
            gap: 18px;
        }


        .instructor-form-area {
            padding: 32px 30px 38px;
        }


        .back-dashboard-button {
            width: 100%;
        }
    }


    @@media (max-width: 576px) {

        .instructor-page {
            padding: 10px;
        }


        .instructor-card {
            border-radius: 17px;
        }


        .page-header {
            padding: 25px 20px;
        }


        .header-content {
            align-items: flex-start;
        }


        .header-icon {
            width: 52px;
            height: 52px;
            border-radius: 13px;
            font-size: 21px;
        }


        .header-text h2 {
            font-size: 22px;
        }


        .header-text p {
            font-size: 11px;
        }


        .instructor-form-area {
            padding: 28px 20px 32px;
        }


        .back-dashboard-button {
            width: 100%;
            min-height: 44px;
        }


        .section-heading {
            align-items: flex-start;
        }


        .section-number {
            width: 33px;
            height: 33px;
        }


        .row {
            margin-left: 0;
            margin-right: 0;
        }


        .col-md-6 {
            padding-left: 0;
            padding-right: 0;
        }


        .form-control {
            height: 49px;
        }


        .btn-create {
            height: 52px;
        }
    }
</style>


<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="instructor-page">

    <div class="instructor-wrapper">

        <div class="instructor-card">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="page-header">


                <!-- HEADER LEFT -->

                <div class="header-content">

                    <div class="header-icon">

                        <i class="fa-solid fa-user-plus"></i>

                    </div>


                    <div class="header-text">

                        <h2>
                            Add Instructor
                        </h2>

                        <p>
                            Create an instructor profile and account
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     BACK TO ADMIN DASHBOARD
                     ================================================= -->

                <a href="@Url.Action("Index", "Admin")"
                   class="back-dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    <span>
                        Back to Dashboard
                    </span>

                </a>

            </div>


            <!-- =================================================
                 FORM
                 ================================================= -->

            <div class="instructor-form-area">

                @using (Html.BeginForm(
                    "Create",
                    "Instructor",
                    FormMethod.Post))
                {

                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         VALIDATION
                         ================================================= -->

                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "validation-summary-errors"
                        }
                    )


                    <!-- =================================================
                         SECTION 01
                         ================================================= -->

                    <div class="form-section">


                        <div class="section-heading">

                            <div class="section-number">
                                01
                            </div>


                            <div>

                                <h3>
                                    Instructor Information
                                </h3>

                                <p>
                                    Enter the instructor's personal and professional details
                                </p>

                            </div>

                        </div>


                        <!-- =================================================
                             FIRST NAME / LAST NAME
                             ================================================= -->

                        <div class="row">


                            <!-- FIRST NAME -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.FirstName,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-user"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.FirstName,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Enter first name",
                                                autocomplete = "given-name"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.FirstName,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>


                            <!-- LAST NAME -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.LastName,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-user"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.LastName,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Enter last name",
                                                autocomplete = "family-name"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.LastName,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             PHONE / EMAIL
                             ================================================= -->

                        <div class="row">


                            <!-- PHONE -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Phone,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-phone"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.Phone,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Enter phone number",
                                                autocomplete = "tel"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.Phone,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>


                            <!-- EMAIL -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Email,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-envelope"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.Email,
                                            new
                                            {
                                                @class = "form-control",
                                                type = "email",
                                                placeholder = "Enter email address",
                                                autocomplete = "email"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.Email,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             LICENSE / EXPERIENCE
                             ================================================= -->

                        <div class="row">


                            <!-- LICENSE -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.LicenseNumber,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-id-card"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.LicenseNumber,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Enter license number"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.LicenseNumber,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>


                            <!-- EXPERIENCE -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Experience,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="input-wrapper">

                                        <span class="input-icon">

                                            <i class="fa-solid fa-award"></i>

                                        </span>


                                        @Html.TextBoxFor(
                                            m => m.Experience,
                                            new
                                            {
                                                @class = "form-control",
                                                type = "number",
                                                min = "0",
                                                max = "50",
                                                placeholder = "Years of experience"
                                            }
                                        )

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.Experience,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         SECTION 02
                         ================================================= -->

                    <div class="form-section">


                        <div class="section-heading">

                            <div class="section-number">
                                02
                            </div>


                            <div>

                                <h3>
                                    Login Information
                                </h3>

                                <p>
                                    Set up secure login credentials for the instructor
                                </p>

                            </div>

                        </div>


                        <div class="row">


                            <!-- =================================================
                                 PASSWORD
                                 ================================================= -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Password,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="password-wrapper">


                                        <span class="input-icon">

                                            <i class="fa-solid fa-lock"></i>

                                        </span>


                                        @Html.PasswordFor(
                                            m => m.Password,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Create password",
                                                id = "InstructorPassword"
                                            }
                                        )


                                        <button type="button"
                                                class="toggle-password"
                                                onclick="togglePassword('InstructorPassword', this)">

                                            <i class="fa-solid fa-eye"></i>

                                            <span>
                                                Show
                                            </span>

                                        </button>

                                    </div>


                                    <div class="password-strength">

                                        <div id="passwordStrengthBar"
                                             class="password-strength-bar">
                                        </div>

                                    </div>


                                    <div id="passwordStrengthText"
                                         class="password-strength-text">

                                        Create a strong password.

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.Password,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>


                            <!-- =================================================
                                 CONFIRM PASSWORD
                                 ================================================= -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.ConfirmPassword,
                                        new
                                        {
                                            @class = "form-label"
                                        }
                                    )


                                    <div class="password-wrapper">


                                        <span class="input-icon">

                                            <i class="fa-solid fa-shield-halved"></i>

                                        </span>


                                        @Html.PasswordFor(
                                            m => m.ConfirmPassword,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "Confirm password",
                                                id = "InstructorConfirmPassword"
                                            }
                                        )


                                        <button type="button"
                                                class="toggle-password"
                                                onclick="togglePassword('InstructorConfirmPassword', this)">

                                            <i class="fa-solid fa-eye"></i>

                                            <span>
                                                Show
                                            </span>

                                        </button>

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.ConfirmPassword,
                                        "",
                                        new
                                        {
                                            @class = "text-danger"
                                        }
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         CREATE BUTTON
                         ================================================= -->

                    <button type="submit"
                            class="btn-create">

                        <i class="fa-solid fa-user-plus"></i>

                        CREATE INSTRUCTOR

                    </button>


                    <!-- =================================================
                         SECURITY NOTE
                         ================================================= -->

                    <div class="form-note">

                        <i class="fa-solid fa-shield-halved"></i>

                        <span>
                            Instructor login credentials will be created securely with this account.
                        </span>

                    </div>

                }

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

    /* =========================================================
       SHOW / HIDE PASSWORD
       ========================================================= */

    function togglePassword(inputId, button) {

        var input =
            document.getElementById(inputId);


        if (!input) {
            return;
        }


        var icon =
            button.querySelector("i");


        var text =
            button.querySelector("span");


        if (input.type === "password") {

            input.type = "text";


            if (icon) {

                icon.className =
                    "fa-solid fa-eye-slash";
            }


            if (text) {

                text.innerText =
                    "Hide";
            }

        }
        else {

            input.type = "password";


            if (icon) {

                icon.className =
                    "fa-solid fa-eye";
            }


            if (text) {

                text.innerText =
                    "Show";
            }

        }

    }


    /* =========================================================
       PASSWORD STRENGTH
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var password =
                document.getElementById(
                    "InstructorPassword"
                );


            var strengthBar =
                document.getElementById(
                    "passwordStrengthBar"
                );


            var strengthText =
                document.getElementById(
                    "passwordStrengthText"
                );


            if (!password) {
                return;
            }


            password.addEventListener(
                "input",
                function () {

                    var value =
                        password.value;


                    var strength = 0;


                    /* =================================================
                       AT LEAST 8 CHARACTERS
                       ================================================= */

                    if (value.length >= 8) {

                        strength++;
                    }


                    /* =================================================
                       UPPERCASE
                       ================================================= */

                    if (/[A-Z]/.test(value)) {

                        strength++;
                    }


                    /* =================================================
                       LOWERCASE
                       ================================================= */

                    if (/[a-z]/.test(value)) {

                        strength++;
                    }


                    /* =================================================
                       NUMBER
                       ================================================= */

                    if (/[0-9]/.test(value)) {

                        strength++;
                    }


                    /* =================================================
                       SPECIAL CHARACTER
                       ================================================= */

                    if (/[^A-Za-z0-9]/.test(value)) {

                        strength++;
                    }


                    /* =================================================
                       EMPTY
                       ================================================= */

                    if (value.length === 0) {

                        strengthBar.style.width =
                            "0%";


                        strengthText.innerText =
                            "Create a strong password.";

                    }


                    /* =================================================
                       WEAK
                       ================================================= */

                    else if (strength <= 2) {

                        strengthBar.style.width =
                            "35%";


                        strengthText.innerText =
                            "Weak password.";

                    }


                    /* =================================================
                       MEDIUM
                       ================================================= */

                    else if (strength === 3) {

                        strengthBar.style.width =
                            "60%";


                        strengthText.innerText =
                            "Medium password.";

                    }


                    /* =================================================
                       STRONG
                       ================================================= */

                    else {

                        strengthBar.style.width =
                            "100%";


                        strengthText.innerText =
                            "Strong password.";
                    }

                }
            );

        }
    );

</script>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}

