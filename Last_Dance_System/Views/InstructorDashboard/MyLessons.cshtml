                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="9" x2="21" y2="9" />

                                            </svg>

                                        </span>

                                        <strong>Date:</strong>

                                        @lesson.LessonDate.ToString("dd MMM yyyy")

                                    </div>


                                    <div class="lesson-detail">

                                        <span class="detail-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2">

                                                <circle cx="12" cy="12" r="9" />
                                                <polyline points="12 7 12 12 15 14" />

                                            </svg>

                                        </span>

                                        <strong>Time:</strong>

                                        @lesson.StartTime.ToString(@"hh\:mm")
                                        -
                                        @lesson.EndTime.ToString(@"hh\:mm")

                                    </div>


                                    <div class="lesson-detail">

                                        <span class="detail-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2">

                                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />

                                            </svg>

                                        </span>

                                        <strong>Lesson:</strong>

                                        @if (lesson.LessonType != null)
                                        {
                                            @lesson.LessonType.LessonTypeName
                                        }
                                        else
                                        {
                                            @:N/A
                                        }

                                    </div>


                                    <div class="lesson-detail">

                                        <span class="detail-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M5 17h14" />
                                                <path d="M6 17l1-6h10l1 6" />
                                                <path d="M7 11l2-4h6l2 4" />
                                                <circle cx="8" cy="17" r="1.5" />
                                                <circle cx="16" cy="17" r="1.5" />

                                            </svg>

                                        </span>

                                        <strong>Vehicle:</strong>

                                        @if (lesson.Vehicle != null)
                                        {
                                            @lesson.Vehicle.VehicleId
                                        }
                                        else
                                        {
                                            @:N/A
                                        }

                                    </div>

                                </div>


                                @if (cancelledBooking != null &&
                                    !string.IsNullOrWhiteSpace(cancelledBooking.Notes))
                                {
                                    <div class="cancellation-reason">

                                        <div class="cancellation-reason-title">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2">

                                                <circle cx="12" cy="12" r="9" />
                                                <line x1="12" y1="8" x2="12" y2="12" />
                                                <line x1="12" y1="16" x2="12.01" y2="16" />

                                            </svg>

                                            Instructor's Cancellation Reason

                                        </div>

                                        <div class="cancellation-reason-text">

                                            @cancelledBooking.Notes

                                        </div>

                                    </div>
                                }

                            </div>


                            <div class="lesson-status cancelled-status">

                                <span class="status-dot"></span>

                                Cancelled

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <circle cx="12" cy="12" r="9" />
                            <line x1="8" y1="8" x2="16" y2="16" />
                            <line x1="16" y1="8" x2="8" y2="16" />

                        </svg>

                    </div>

                    <div class="empty-state-title">
                        No cancelled lessons
                    </div>

                    <div class="empty-state-text">
                        Cancelled lessons will appear here.
                    </div>

                </div>
            }

        </div>

    </div>
    

</div>

<script>

    function showCancelForm(id) {

        var form = document.getElementById(
            "cancel-form-" + id
        );

        if (form) {

            form.style.display = "block";

            var textarea = form.querySelector("textarea");

            if (textarea) {
                textarea.focus();
            }
        }
    }


    function hideCancelForm(id) {

        var form = document.getElementById(
            "cancel-form-" + id
        );

        if (form) {
            form.style.display = "none";
        }
    }

</script>
