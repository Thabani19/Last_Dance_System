@using System
@using System.Collections.Generic
@using Last_Dance_System.Models

@{
    ViewBag.Title = "Instructor Dashboard";

    var todaysLessons = ViewBag.TodaysLessons as List<LessonSchedule>
                        ?? new List<LessonSchedule>();

    var upcomingLessons = ViewBag.UpcomingLessonList as List<LessonSchedule>
                          ?? new List<LessonSchedule>();
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: white;
        font-family: Arial, Helvetica, sans-serif;
    }

    .instructor-dashboard {
        min-height: 100vh;
        padding: 30px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .dashboard-header {
        margin-bottom: 25px;
    }

        .dashboard-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
        }

        .dashboard-header p {
            color: #aeb9c8;
            margin-top: 8px;
            font-size: 15px;
        }


    /* =========================================================
       QUICK SHORTCUTS
       ========================================================= */

    .shortcut-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 30px;
    }

    .shortcut-card {
        display: block;
        background: #101d30;
        border: 1px solid #1c3049;
        border-radius: 14px;
        padding: 22px;
        text-decoration: none;
        color: white;
        transition: 0.2s ease;
    }

        .shortcut-card:hover {
            transform: translateY(-3px);
            border-color: #35577d;
            background: #14243a;
            color: white;
            text-decoration: none;
        }

    .shortcut-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #17263b;
        border-radius: 10px;
        font-size: 20px;
        margin-bottom: 14px;
    }

    .shortcut-title {
        font-size: 17px;
        font-weight: bold;
        margin-bottom: 6px;
    }

    .shortcut-description {
        color: #8493a7;
        font-size: 13px;
        line-height: 1.5;
    }


    /* =========================================================
       STATISTICS
       ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #101d30;
        border: 1px solid #1c3049;
        border-radius: 14px;
        padding: 25px;
        transition: 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
        }

    .stat-title {
        color: #9eacbd;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .stat-number {
        font-size: 32px;
        font-weight: bold;
        color: white;
    }


    /* =========================================================
       MAIN GRID
       ========================================================= */

    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
    }

    .dashboard-card {
        background: #101d30;
        border: 1px solid #1c3049;
        border-radius: 14px;
        padding: 25px;
    }

        .dashboard-card h2 {
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 21px;
        }


    /* =========================================================
       TODAY'S LESSON
       ========================================================= */

    .lesson-card {
        background: #17263b;
        border: 1px solid #243b57;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 15px;
    }

        .lesson-card:last-child {
            margin-bottom: 0;
        }

    .lesson-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .lesson-date {
        font-size: 17px;
        font-weight: bold;
    }

    .lesson-status {
        background: #243b57;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        color: white;
    }


    /* =========================================================
       LESSON INFORMATION
       ========================================================= */

    .lesson-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .info-label {
        color: #8493a7;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .info-value {
        color: white;
        font-size: 14px;
        line-height: 1.5;
    }

        .info-value strong {
            font-size: 14px;
        }

        .info-value span {
            color: #aeb9c8;
            font-size: 13px;
        }


    /* =========================================================
       UPCOMING LESSONS
       ========================================================= */

    .upcoming-item {
        padding: 15px 0;
        border-bottom: 1px solid #243b57;
    }

        .upcoming-item:first-child {
            padding-top: 0;
        }

        .upcoming-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .upcoming-date {
        font-weight: bold;
        margin-bottom: 6px;
        font-size: 15px;
    }

    .upcoming-time {
        color: #aeb9c8;
        font-size: 14px;
    }


    /* =========================================================
       VIEW ALL BUTTON
       ========================================================= */

    .view-all-container {
        margin-top: 20px;
        text-align: center;
    }

    .view-all-btn {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 8px;
        background: #17263b;
        border: 1px solid #2a4565;
        color: white;
        text-decoration: none;
        font-size: 13px;
        transition: 0.2s ease;
    }

        .view-all-btn:hover {
            background: #243b57;
            color: white;
            text-decoration: none;
        }


    /* =========================================================
       EMPTY MESSAGE
       ========================================================= */

    .empty-message {
        color: #8493a7;
        text-align: center;
        padding: 30px 10px;
        font-size: 14px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .shortcut-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }


    @@media (max-width: 1000px) {

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px) {

        .instructor-dashboard {
            padding: 20px;
        }

        .shortcut-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .lesson-info {
            grid-template-columns: 1fr;
        }

        .lesson-header {
            display: block;
        }

        .lesson-status {
            display: inline-block;
            margin-top: 10px;
        }
    }
</style>


<div class="instructor-dashboard">


    <!-- =====================================================
         DASHBOARD HEADER
         ====================================================== -->

    <div class="dashboard-header">

        <h1>
            Instructor Dashboard
        </h1>

        <p>
            Welcome back,
            <strong>@ViewBag.InstructorName</strong>
        </p>

    </div>


    <!-- =====================================================
     QUICK SHORTCUTS
     ====================================================== -->

    <div class="shortcut-grid">


        <!-- UPCOMING -->

        <a href="@Url.Action("Upcoming", "InstructorDashboard")"
           class="shortcut-card">

            <div class="shortcut-icon">
                📅
            </div>

            <div class="shortcut-title">
                Upcoming
            </div>

            <div class="shortcut-description">
                View your upcoming driving lessons and schedules.
            </div>

        </a>


        <!-- BOOKED -->

        <a href="@Url.Action("Booked", "InstructorDashboard")"
           class="shortcut-card">

            <div class="shortcut-icon">
                👤
            </div>

            <div class="shortcut-title">
                Booked
            </div>

            <div class="shortcut-description">
                View lessons that have been booked by students.
            </div>

        </a>


        <!-- COMPLETED -->

        <a href="@Url.Action("Completed", "InstructorDashboard")"
           class="shortcut-card">

            <div class="shortcut-icon">
                ✅
            </div>

            <div class="shortcut-title">
                Completed
            </div>

            <div class="shortcut-description">
                View your completed driving lessons.
            </div>

        </a>


        <!-- HISTORY -->

        <a href="@Url.Action("History", "InstructorDashboard")"
           class="shortcut-card">

            <div class="shortcut-icon">
                📋
            </div>

            <div class="shortcut-title">
                History
            </div>

            <div class="shortcut-description">
                View your lesson history, including completed and cancelled lessons.
            </div>

        </a>


        <!-- PROFILE -->

        <a href="@Url.Action("Profile", "InstructorDashboard")"
           class="shortcut-card">

            <div class="shortcut-icon">
                👨‍🏫
            </div>

            <div class="shortcut-title">
                Profile
            </div>

            <div class="shortcut-description">
                View your instructor information and profile.
            </div>

        </a>

    </div>


    <!-- =====================================================
         STATISTICS
         ====================================================== -->

    <div class="stats-grid">


        <!-- TODAY'S LESSONS -->

        <div class="stat-card">

            <div class="stat-title">
                Today's Lessons
            </div>

            <div class="stat-number">
                @ViewBag.TodayLessons
            </div>

        </div>


        <!-- UPCOMING LESSONS -->

        <div class="stat-card">

            <div class="stat-title">
                Upcoming Lessons
            </div>

            <div class="stat-number">
                @ViewBag.UpcomingLessons
            </div>

        </div>


        <!-- BOOKED LESSONS -->

        <div class="stat-card">

            <div class="stat-title">
                Booked Lessons
            </div>

            <div class="stat-number">
                @ViewBag.BookedLessons
            </div>

        </div>


        <!-- COMPLETED LESSONS -->

        <div class="stat-card">

            <div class="stat-title">
                Completed Lessons
            </div>

            <div class="stat-number">
                @ViewBag.CompletedLessons
            </div>

        </div>


        <!-- TOTAL LESSONS -->

        <div class="stat-card">

            <div class="stat-title">
                Total Lessons
            </div>

            <div class="stat-number">
                @ViewBag.TotalLessons
            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN DASHBOARD CONTENT
         ====================================================== -->

    <div class="dashboard-grid">


        <!-- =================================================
             TODAY'S LESSONS
             ================================================== -->

        <div class="dashboard-card">

            <h2>
                Today's Lessons
            </h2>


            @if (todaysLessons.Count > 0)
            {

                foreach (var lesson in todaysLessons)
                {

                    <div class="lesson-card">


                        <!-- LESSON HEADER -->

                        <div class="lesson-header">

                            <div class="lesson-date">

                                @lesson.LessonDate.ToString("dd MMM yyyy")

                            </div>


                            <div class="lesson-status">

                                @lesson.Status

                            </div>

                        </div>


                        <!-- LESSON INFORMATION -->

                        <div class="lesson-info">


                            <!-- TIME -->

                            <div>

                                <div class="info-label">
                                    Time
                                </div>

                                <div class="info-value">

                                    @lesson.StartTime.ToString(@"hh\:mm")

                                    -

                                    @lesson.EndTime.ToString(@"hh\:mm")

                                </div>

                            </div>


                            <!-- LESSON TYPE -->

                            <div>

                                <div class="info-label">
                                    Lesson Type
                                </div>

                                <div class="info-value">

                                    @if (lesson.LessonType != null)
                                    {
                                        <strong>
                                            @lesson.LessonType.LessonTypeName
                                        </strong>
                                    }
                                    else
                                    {
                                        <span>
                                            Not assigned
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- VEHICLE -->

                            <div>

                                <div class="info-label">
                                    Vehicle
                                </div>

                                <div class="info-value">

                                    @if (lesson.Vehicle != null)
                                    {
                                        <strong>
                                            @lesson.Vehicle.Make
                                            @lesson.Vehicle.Model
                                        </strong>

                                        <br />

                                        <span>
                                            Registration:
                                            @lesson.Vehicle.RegistrationNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Not assigned
                                        </span>
                                    }

                                </div>

                            </div>


                        </div>

                    </div>

                }

            }
            else
            {

                <div class="empty-message">

                    No lessons scheduled for today.

                </div>

            }

        </div>


        <!-- =================================================
             UPCOMING LESSONS
             ================================================== -->

        <div class="dashboard-card">

            <h2>
                Upcoming Lessons
            </h2>


            @if (upcomingLessons.Count > 0)
            {

                foreach (var lesson in upcomingLessons)
                {

                    <div class="upcoming-item">


                        <div class="upcoming-date">

                            @lesson.LessonDate.ToString("dd MMM yyyy")

                        </div>


                        <div class="upcoming-time">

                            @lesson.StartTime.ToString(@"hh\:mm")

                            -

                            @lesson.EndTime.ToString(@"hh\:mm")

                        </div>


                        <!-- LESSON TYPE -->

                        @if (lesson.LessonType != null)
                        {
                            <div class="upcoming-time">

                                @lesson.LessonType.LessonTypeName

                            </div>
                        }


                    </div>

                }


                <!-- VIEW ALL UPCOMING -->

                <div class="view-all-container">

                    <a href="@Url.Action("Upcoming", "InstructorDashboard")"
                       class="view-all-btn">

                        View All Upcoming Lessons

                    </a>

                </div>

            }
            else
            {

                <div class="empty-message">

                    No upcoming lessons.

                </div>

            }

        </div>

    </div>

</div>