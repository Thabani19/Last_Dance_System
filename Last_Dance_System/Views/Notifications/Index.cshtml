@model IEnumerable<Last_Dance_System.Models.Notification>
@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/instructor-theme.css" rel="stylesheet" />

<div class="instructor-container" style="max-width: 800px; margin: 30px auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h2 class="page-title">System notifications</h2>
            <p class="page-subtitle">All active driving school announcements and updates.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="card-wrapper mb-3" style="border-left: 4px solid #0284c7; padding: 16px 20px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <h5 style="font-weight: 700; margin: 0; color: #1f2937;">@item.Title</h5>
                            <span class="badge" style="background-color: #e0f2fe; color: #0284c7; font-size: 0.75rem;">@item.NotificationType</span>
                        </div>
                        <p style="color: #4b5563; margin-bottom: 8px;">@item.Message</p>
                        <small style="color: #9ca3af;">@item.CreatedAt.ToString("dd MMM yyyy 'at' HH:mm")</small>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card-wrapper text-center text-muted" style="padding: 40px;">
            <i class="bi bi-bell-slash" style="font-size: 2.5rem; color: #9ca3af; display: block; margin-bottom: 10px;"></i>
            <p style="margin: 0;">There are no notifications at this time.</p>
        </div>
    }
</div>

