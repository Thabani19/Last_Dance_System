@{
    ViewBag.Title = "Quiz Result";

string lessonTitle = ViewBag.LessonTitle as string ?? "Theory Quiz";

    int lessonId = ViewBag.LessonId ?? 0;

    int score = ViewBag.Score ?? 0;

    int totalQuestions = ViewBag.TotalQuestions ?? 0;

    int percentage = ViewBag.Percentage ?? 0;

    DateTime dateTaken = ViewBag.DateTaken ?? DateTime.Now;


}

<style>

    .result-page {
        background-color: #f4f8fc;
        min-height: 100vh;
        padding: 50px 20px;
    }

    .result-wrapper {
        max-width: 750px;
        margin: 0 auto;
    }

    /* =========================
       MAIN RESULT CARD
       ========================= */

    .result-card {
        background-color: white;
        border: 1px solid #dceaf7;
        border-radius: 14px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.07);
    }

    /* =========================
       HEADER
       ========================= */

    .result-header {
        margin-bottom: 30px;
    }

        .result-header h1 {
            color: #1565c0;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .result-header p {
            color: #666;
            font-size: 15px;
            margin: 0;
        }

    .lesson-name {
        color: #333;
        font-size: 20px;
        font-weight: 600;
        margin-top: 15px;
    }

    /* =========================
       PERCENTAGE
       ========================= */

    .percentage-circle {
        width: 170px;
        height: 170px;
        border-radius: 50%;
        background-color: #eaf4ff;
        border: 8px solid #1565c0;
        margin: 0 auto 30px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .percentage-number {
        color: #1565c0;
        font-size: 42px;
        font-weight: 700;
        line-height: 1;
    }

    .percentage-label {
        color: #666;
        font-size: 13px;
        margin-top: 7px;
    }

    /* =========================
       SCORE
       ========================= */

    .score-section {
        background-color: #f7fbff;
        border: 1px solid #dceaf7;
        border-radius: 10px;
        padding: 22px;
        margin-bottom: 20px;
    }

    .score-title {
        color: #666;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .score-value {
        color: #1565c0;
        font-size: 30px;
        font-weight: 700;
    }

    /* =========================
       DETAILS
       ========================= */

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-top: 20px;
        margin-bottom: 25px;
    }

    .detail-box {
        background-color: white;
        border: 1px solid #dceaf7;
        border-radius: 10px;
        padding: 18px;
    }

    .detail-title {
        color: #777;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .detail-value {
        color: #333;
        font-size: 16px;
        font-weight: 600;
    }

    /* =========================
       PERFORMANCE MESSAGE
       ========================= */

    .performance-message {
        background-color: #f7fbff;
        border-left: 4px solid #1565c0;
        border-radius: 6px;
        padding: 18px 20px;
        text-align: left;
        margin-bottom: 30px;
    }

        .performance-message h2 {
            color: #1565c0;
            font-size: 19px;
            margin-top: 0;
            margin-bottom: 8px;
        }

        .performance-message p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }

    /* =========================
       BUTTONS
       ========================= */

    .button-container {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .result-button {
        display: inline-block;
        background-color: #1565c0;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        padding: 12px 22px;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

        .result-button:hover {
            background-color: #0d47a1;
            color: white;
            text-decoration: none;
        }

    .secondary-button {
        display: inline-block;
        background-color: white;
        color: #1565c0;
        border: 1px solid #1565c0;
        text-decoration: none;
        border-radius: 8px;
        padding: 12px 22px;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

        .secondary-button:hover {
            background-color: #eaf4ff;
            color: #1565c0;
            text-decoration: none;
        }

    /* =========================
       MOBILE
       ========================= */

    @@media (max-width: 600px) {

        .result-page {
            padding: 25px 15px;
        }

        .result-card {
            padding: 25px 18px;
        }

        .result-header h1 {
            font-size: 26px;
        }

        .lesson-name {
            font-size: 18px;
        }

        .percentage-circle {
            width: 145px;
            height: 145px;
        }

        .percentage-number {
            font-size: 36px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .button-container {
            flex-direction: column;
        }

        .result-button,
        .secondary-button {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="result-page">

    
    <div class="result-wrapper">

        <div class="result-card">

            <!-- =========================
                 RESULT HEADER
                 ========================= -->

            <div class="result-header">

                <h1>
                    Quiz Completed
                </h1>

                <p>
                    Your theory quiz has been submitted successfully.
                </p>

                <div class="lesson-name">
                    @lessonTitle
                </div>

            </div>


            <!-- =========================
                 PERCENTAGE
                 ========================= -->

            <div class="percentage-circle">

                <div class="percentage-number">
                    @percentage%
                </div>

                <div class="percentage-label">
                    Final Score
                </div>

            </div>


            <!-- =========================
                 SCORE
                 ========================= -->

            <div class="score-section">

                <div class="score-title">
                    Your Score
                </div>

                <div class="score-value">
                    @score / @totalQuestions
                </div>

            </div>


            <!-- =========================
                 RESULT DETAILS
                 ========================= -->

            <div class="details-grid">

                <div class="detail-box">

                    <div class="detail-title">
                        Lesson
                    </div>

                    <div class="detail-value">
                        @lessonTitle
                    </div>

                </div>


                <div class="detail-box">

                    <div class="detail-title">
                        Date Taken
                    </div>

                    <div class="detail-value">
                        @dateTaken.ToString("dd MMM yyyy")
                    </div>

                </div>


                <div class="detail-box">

                    <div class="detail-title">
                        Questions
                    </div>

                    <div class="detail-value">
                        @totalQuestions
                    </div>

                </div>


                <div class="detail-box">

                    <div class="detail-title">
                        Percentage
                    </div>

                    <div class="detail-value">
                        @percentage%
                    </div>

                </div>

            </div>


            <!-- =========================
                 PERFORMANCE MESSAGE
                 ========================= -->

            <div class="performance-message">

                @if (percentage >= 80)
                {
                    <h2>
                        Excellent Work
                    </h2>

                    <p>
                        You achieved a strong result on this theory
                        quiz. Continue reviewing the lessons and
                        practising the quizzes to maintain your
                        understanding.
                    </p>
                }
                else if (percentage >= 50)
                {
                    <h2>
                        Good Progress
                    </h2>

                    <p>
                        You are making progress with your theory
                        preparation. Review the lesson material and
                        practise the quiz again to strengthen your
                        understanding.
                    </p>
                }
                else
                {
                    <h2>
                        Keep Practising
                    </h2>

                    <p>
                        Review the theory lesson carefully and try the
                        quiz again. Practising regularly will help
                        strengthen your understanding of the material.
                    </p>
                }

            </div>


            <!-- =========================
                 NAVIGATION
                 ========================= -->

            <div class="button-container">

                <a href="@Url.Action("Index", "Quiz")"
                   class="result-button">

                    Back to Quizzes

                </a>


                <a href="@Url.Action("Index", "QuizResults")"
                   class="secondary-button">

                    View Quiz Results

                </a>


                <a href="@Url.Action("Index", "Dashboard")"
                   class="secondary-button">

                    Dashboard

                </a>

            </div>

        </div>

    </div>
    

</div>
