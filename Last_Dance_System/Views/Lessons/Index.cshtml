@model IEnumerable<Last_Dance_System.Models.Booking>

@{
    ViewBag.Title = "My Lessons";

    var allLessons = Model ?? Enumerable.Empty<Last_Dance_System.Models.Booking>();

    var bookedLessons = allLessons
        .Where(b => !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .OrderBy(b => b.LessonSchedule.LessonDate)
        .ThenBy(b => b.LessonSchedule.StartTime)
        .ToList();

    var completedLessons = allLessons
        .Where(b => string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.LessonSchedule.LessonDate)
        .ToList();

    var cancelledLessons = allLessons
        .Where(b => string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.LessonSchedule.LessonDate)
        .ToList();

    var totalLessons = allLessons.Count();
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: #ffffff;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .lessons-page {
        min-height: calc(100vh - 50px);
        padding: 35px;
        background: radial-gradient(circle at 80% 10%, rgba(225, 6, 0, 0.08), transparent 30%), linear-gradient(135deg, #07111f 0%, #0a1626 50%, #06101c 100%);
    }

    .lessons-container {
        max-width: 1250px;
        margin: 0 auto;
    }

    /* ============================================================
       HEADER
       ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 25px;
        padding: 25px 28px;
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    .header-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e10600;
        color: white;
        font-size: 20px;
        box-shadow: 0 8px 20px rgba(225,6,0,.20);
    }

    .page-header h1 {
        margin: 0 0 5px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: #6f8196;
        font-size: 12px;
    }

    /* ============================================================
       HEADER BUTTONS
       ============================================================ */

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 11px 17px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: .25s ease;
        white-space: nowrap;
    }

    .dashboard-button {
        background: #101f32;
        border: 1px solid #263b55;
        color: #d8e1eb;
    }

        .dashboard-button:hover {
            background: #182b43;
            border-color: #405775;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    .book-button {
        background: #e10600;
        border: 1px solid #e10600;
        color: white;
        box-shadow: 0 7px 18px rgba(225,6,0,.16);
    }

        .book-button:hover {
            background: #ff211a;
            border-color: #ff211a;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* ============================================================
       SUMMARY
       ============================================================ */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 30px;
    }

    .summary-card {
        padding: 18px;
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        transition: .25s ease;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            border-color: rgba(225,6,0,.35);
        }

    .summary-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(225,6,0,.10);
        color: #e10600;
    }

        .summary-icon.completed {
            background: rgba(0,180,100,.10);
            color: #38d996;
        }

        .summary-icon.cancelled {
            background: rgba(120,130,145,.10);
            color: #8996a5;
        }

    .summary-text strong {
        display: block;
        font-size: 20px;
        font-weight: 800;
    }

    .summary-text span {
        display: block;
        margin-top: 3px;
        color: #65778d;
        font-size: 10px;
    }

    /* ============================================================
       SECTION
       ============================================================ */

    .lesson-section {
        margin-bottom: 35px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
        padding: 0 2px 12px;
        border-bottom: 1px solid #17283d;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(225,6,0,.10);
        color: #e10600;
    }

        .section-title-icon.completed {
            background: rgba(0,180,100,.10);
            color: #38d996;
        }

        .section-title-icon.cancelled {
            background: rgba(120,130,145,.10);
            color: #8996a5;
        }

    .section-title h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
    }

    .section-title span {
        display: block;
        margin-top: 2px;
        color: #637389;
        font-size: 10px;
    }

    /* ============================================================
       LESSON GRID
       ============================================================ */

    .lessons-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .lesson-card {
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 16px;
        overflow: hidden;
        transition: .25s ease;
    }

        .lesson-card:hover {
            transform: translateY(-3px);
            border-color: rgba(225,6,0,.4);
            box-shadow: 0 12px 30px rgba(0,0,0,.20);
        }

    /* ============================================================
       CARD TOP
       ============================================================ */

    .lesson-card-top {
        padding: 18px 20px;
        border-bottom: 1px solid #17283d;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .lesson-date {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .date-box {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e10600;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 7px 18px rgba(225,6,0,.14);
    }

        .date-box.completed {
            background: #16865d;
            box-shadow: 0 7px 18px rgba(22,134,93,.14);
        }

        .date-box.cancelled {
            background: #465160;
            box-shadow: none;
        }

        .date-box strong {
            font-size: 19px;
            line-height: 1;
        }

        .date-box span {
            margin-top: 3px;
            font-size: 8px;
            text-transform: uppercase;
        }

    .lesson-title {
        min-width: 0;
    }

        .lesson-title h2 {
            margin: 0 0 4px;
            font-size: 14px;
            font-weight: 750;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .lesson-title p {
            margin: 0;
            color: #687b90;
            font-size: 10px;
        }

    /* ============================================================
       STATUS
       ============================================================ */

    .status {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .status-booked {
        background: rgba(225,6,0,.10);
        border: 1px solid rgba(225,6,0,.20);
        color: #ff514b;
    }

    .status-completed {
        background: rgba(0,180,100,.10);
        border: 1px solid rgba(0,180,100,.20);
        color: #38d996;
    }

    .status-cancelled {
        background: rgba(120,130,145,.10);
        border: 1px solid rgba(120,130,145,.20);
        color: #8996a5;
    }

    /* ============================================================
       CARD BODY
       ============================================================ */

    .lesson-body {
        padding: 20px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .detail {
        min-width: 0;
        padding: 11px;
        background: #091321;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 9px;
        color: #8291a4;
        font-size: 10px;
    }

        .detail i {
            width: 16px;
            flex-shrink: 0;
            color: #e10600;
            text-align: center;
        }

        .detail span {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .detail strong {
            color: #ffffff;
            font-size: 10px;
        }

    /* ============================================================
       FOOTER BUTTONS
       ============================================================ */

    .lesson-footer {
        margin-top: 15px;
    }

    .attendance-button {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px;
        margin-bottom: 10px;
        background: #16865d;
        border: 1px solid #16865d;
        border-radius: 8px;
        color: white;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: .25s ease;
    }

        .attendance-button:hover {
            background: #1da874;
            border-color: #1da874;
            transform: translateY(-1px);
        }

    .view-button {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px;
        background: #101f32;
        border: 1px solid #1d3149;
        border-radius: 8px;
        color: white;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        transition: .25s ease;
    }

        .view-button:hover {
            background: #e10600;
            border-color: #e10600;
            color: white;
            text-decoration: none;
        }

    /* ============================================================
       EMPTY SECTION
       ============================================================ */

    .section-empty {
        padding: 30px;
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 14px;
        text-align: center;
    }

        .section-empty i {
            display: block;
            margin-bottom: 10px;
            color: #506176;
            font-size: 20px;
        }

        .section-empty p {
            margin: 0;
            color: #637389;
            font-size: 10px;
        }

    /* ============================================================
       NO LESSONS
       ============================================================ */

    .empty-card {
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        padding: 65px 30px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #101f32;
        border: 1px solid #1d3149;
        color: #e10600;
        font-size: 22px;
    }

    .empty-card h2 {
        margin: 0 0 8px;
        font-size: 17px;
    }

    .empty-card p {
        margin: 0 auto 20px;
        max-width: 450px;
        color: #687a8f;
        font-size: 11px;
        line-height: 1.6;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 1000px) {

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .lessons-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .lessons-page {
            padding: 18px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 22px;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

        .action-button {
            width: 100%;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .lesson-card-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .status {
            align-self: flex-start;
        }
    }

    @@media (max-width: 450px) {

        .header-left {
            align-items: flex-start;
        }

        .header-icon {
            width: 45px;
            height: 45px;
        }

        .page-header h1 {
            font-size: 21px;
        }
    }
</style>


<div class="lessons-page">

    <div class="lessons-container">

        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="page-header">

            <div class="header-left">

                <div class="header-icon">
                    <i class="fa-solid fa-car-side"></i>
                </div>

                <div>

                    <h1>My Lessons</h1>

                    <p>
                        View and manage all your driving lessons.
                    </p>

                </div>

            </div>


            <div class="header-actions">

                <a href="@Url.Action("Index", "Dashboard")"
                   class="action-button dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a href="@Url.Action("Create", "Booking")"
                   class="action-button book-button">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book New Lesson

                </a>

            </div>

        </div>


        <!-- ========================================================
             SUMMARY
             ======================================================== -->

        <div class="summary-grid">

            <div class="summary-card">

                <div class="summary-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div class="summary-text">

                    <strong>@totalLessons</strong>

                    <span>Total Lessons</span>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div class="summary-text">

                    <strong>@bookedLessons.Count</strong>

                    <span>Upcoming / Booked</span>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon completed">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div class="summary-text">

                    <strong>@completedLessons.Count</strong>

                    <span>Completed</span>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon cancelled">
                    <i class="fa-solid fa-ban"></i>
                </div>

                <div class="summary-text">

                    <strong>@cancelledLessons.Count</strong>

                    <span>Cancelled</span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             NO LESSONS
             ======================================================== -->

        @if (totalLessons == 0)
        {

            <div class="empty-card">

                <div class="empty-icon">

                    <i class="fa-regular fa-calendar-xmark"></i>

                </div>

                <h2>No Lessons Yet</h2>

                <p>
                    You don't have any driving lessons booked yet.
                    Choose an available lesson date and time to schedule
                    your first driving lesson.
                </p>

                <a href="@Url.Action("Create", "Booking")"
                   class="action-button book-button">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book a Lesson

                </a>

            </div>

        }
        else
        {

            <!-- ====================================================
                 UPCOMING / BOOKED LESSONS
                 ==================================================== -->

            <div class="lesson-section">

                <div class="section-header">

                    <div class="section-title">

                        <div class="section-title-icon">

                            <i class="fa-solid fa-calendar-days"></i>

                        </div>

                        <div>

                            <h2>Upcoming & Booked Lessons</h2>

                            <span>

                                @bookedLessons.Count
                                lesson@(bookedLessons.Count == 1 ? "" : "s")

                            </span>

                        </div>

                    </div>

                </div>


                @if (bookedLessons.Any())
                {

                    <div class="lessons-grid">

                        @foreach (var booking in bookedLessons)
                        {

                            var schedule = booking.LessonSchedule;

                            /*
                             * Combine the lesson date and end time
                             * ONLY for checking whether the lesson ended.
                             */
                            DateTime lessonEndDateTime =
                                schedule.LessonDate.Date.Add(schedule.EndTime);

                            bool lessonHasEnded =
                                DateTime.Now >= lessonEndDateTime;

                            /*
                             * Your Booking model uses AttendanceStatus.
                             */
                            bool attendanceConfirmed =
                                string.Equals(
                                    booking.AttendanceStatus,
                                    "Attended",
                                    StringComparison.OrdinalIgnoreCase);


                            <div class="lesson-card">

                                <!-- CARD HEADER -->

                                <div class="lesson-card-top">

                                    <div class="lesson-date">

                                        <div class="date-box">

                                            <strong>
                                                @schedule.LessonDate.Day
                                            </strong>

                                            <span>
                                                @schedule.LessonDate.ToString("MMM")
                                            </span>

                                        </div>


                                        <div class="lesson-title">

                                            <h2>

                                                @(schedule.LessonType != null
                                                    ? schedule.LessonType.LessonTypeName
                                                    : "Driving Lesson")

                                            </h2>

                                            <p>
                                                @schedule.LessonDate.ToString(
                                                    "dddd, dd MMMM yyyy")
                                            </p>

                                        </div>

                                    </div>


                                    <span class="status status-booked">

                                        @(string.IsNullOrEmpty(booking.Status)
                                            ? "Booked"
                                            : booking.Status)

                                    </span>

                                </div>


                                <!-- CARD BODY -->

                                <div class="lesson-body">

                                    <div class="details-grid">

                                        <!-- TIME -->

                                        <div class="detail">

                                            <i class="fa-solid fa-clock"></i>

                                            <span>

                                                <strong>
                                                    @schedule.StartTime.ToString(@"hh\:mm")
                                                </strong>

                                                -

                                                <strong>
                                                    @schedule.EndTime.ToString(@"hh\:mm")
                                                </strong>

                                            </span>

                                        </div>


                                        <!-- INSTRUCTOR -->

                                        <div class="detail">

                                            <i class="fa-solid fa-user-tie"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Instructor != null)
                                                    {

                                                        @schedule.Instructor.FirstName
                                                        @(" ")
                                                        @schedule.Instructor.LastName

                                                    }
                                                    else
                                                    {

                                                        @:Instructor not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- VEHICLE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-car"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Vehicle != null)
                                                    {

                                                        @schedule.Vehicle.Make
                                                        @(" ")
                                                        @schedule.Vehicle.Model

                                                    }
                                                    else
                                                    {

                                                        @:Vehicle not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- BOOKING DATE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-calendar-plus"></i>

                                            <span>

                                                Booked:

                                                <strong>
                                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                                </strong>

                                            </span>

                                        </div>

                                    </div>


                                    <!-- FOOTER -->

                                    <div class="lesson-footer">

                                        @*
                                            Confirm Attendance appears only
                                            after the lesson has ended.
                                        *@

                                        @if (lessonHasEnded &&
                                             !attendanceConfirmed &&
                                             string.Equals(
                                                 booking.Status,
                                                 "Booked",
                                                 StringComparison.OrdinalIgnoreCase))
                                        {

                                            <form action="@Url.Action(
                                                        "ConfirmAttendance",
                                                        "Booking")"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@booking.BookingId" />

                                                <button type="submit"
                                                        class="attendance-button"
                                                        onclick="return confirm('Did you attend this driving lesson?');">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    Confirm Attendance

                                                </button>

                                            </form>

                                        }


                                        <a href="@Url.Action(
                                                    "Details",
                                                    "Lessons",
                                                    new { id = booking.BookingId })"
                                           class="view-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View Lesson Details

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                }
                else
                {

                    <div class="section-empty">

                        <i class="fa-regular fa-calendar-xmark"></i>

                        <p>
                            You currently have no upcoming booked lessons.
                        </p>

                    </div>

                }

            </div>


            <!-- ====================================================
                 COMPLETED LESSONS
                 ==================================================== -->

            <div class="lesson-section">

                <div class="section-header">

                    <div class="section-title">

                        <div class="section-title-icon completed">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <div>

                            <h2>Completed Lessons</h2>

                            <span>

                                @completedLessons.Count
                                lesson@(completedLessons.Count == 1 ? "" : "s")

                            </span>

                        </div>

                    </div>

                </div>


                @if (completedLessons.Any())
                {

                    <div class="lessons-grid">

                        @foreach (var booking in completedLessons)
                        {

                            var schedule = booking.LessonSchedule;


                            <div class="lesson-card">

                                <div class="lesson-card-top">

                                    <div class="lesson-date">

                                        <div class="date-box completed">

                                            <strong>
                                                @schedule.LessonDate.Day
                                            </strong>

                                            <span>
                                                @schedule.LessonDate.ToString("MMM")
                                            </span>

                                        </div>


                                        <div class="lesson-title">

                                            <h2>

                                                @(schedule.LessonType != null
                                                    ? schedule.LessonType.LessonTypeName
                                                    : "Driving Lesson")

                                            </h2>

                                            <p>
                                                @schedule.LessonDate.ToString(
                                                    "dddd, dd MMMM yyyy")
                                            </p>

                                        </div>

                                    </div>


                                    <span class="status status-completed">

                                        Completed

                                    </span>

                                </div>


                                <div class="lesson-body">

                                    <div class="details-grid">

                                        <!-- TIME -->

                                        <div class="detail">

                                            <i class="fa-solid fa-clock"></i>

                                            <span>

                                                <strong>
                                                    @schedule.StartTime.ToString(@"hh\:mm")
                                                </strong>

                                                -

                                                <strong>
                                                    @schedule.EndTime.ToString(@"hh\:mm")
                                                </strong>

                                            </span>

                                        </div>


                                        <!-- INSTRUCTOR -->

                                        <div class="detail">

                                            <i class="fa-solid fa-user-tie"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Instructor != null)
                                                    {

                                                        @schedule.Instructor.FirstName
                                                        @(" ")
                                                        @schedule.Instructor.LastName

                                                    }
                                                    else
                                                    {

                                                        @:Instructor not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- VEHICLE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-car"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Vehicle != null)
                                                    {

                                                        @schedule.Vehicle.Make
                                                        @(" ")
                                                        @schedule.Vehicle.Model

                                                    }
                                                    else
                                                    {

                                                        @:Vehicle not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- BOOKING DATE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-calendar-plus"></i>

                                            <span>

                                                Booked:

                                                <strong>
                                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                                </strong>

                                            </span>

                                        </div>

                                    </div>


                                    <div class="lesson-footer">

                                        <a href="@Url.Action(
                                                    "Details",
                                                    "Lessons",
                                                    new { id = booking.BookingId })"
                                           class="view-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View Lesson Details

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                }
                else
                {

                    <div class="section-empty">

                        <i class="fa-regular fa-circle-check"></i>

                        <p>
                            You have not completed any lessons yet.
                        </p>

                    </div>

                }

            </div>


            <!-- ====================================================
                 CANCELLED LESSONS
                 ==================================================== -->

            <div class="lesson-section">

                <div class="section-header">

                    <div class="section-title">

                        <div class="section-title-icon cancelled">

                            <i class="fa-solid fa-ban"></i>

                        </div>

                        <div>

                            <h2>Cancelled Lessons</h2>

                            <span>

                                @cancelledLessons.Count
                                lesson@(cancelledLessons.Count == 1 ? "" : "s")

                            </span>

                        </div>

                    </div>

                </div>


                @if (cancelledLessons.Any())
                {

                    <div class="lessons-grid">

                        @foreach (var booking in cancelledLessons)
                        {

                            var schedule = booking.LessonSchedule;


                            <div class="lesson-card">

                                <div class="lesson-card-top">

                                    <div class="lesson-date">

                                        <div class="date-box cancelled">

                                            <strong>
                                                @schedule.LessonDate.Day
                                            </strong>

                                            <span>
                                                @schedule.LessonDate.ToString("MMM")
                                            </span>

                                        </div>


                                        <div class="lesson-title">

                                            <h2>

                                                @(schedule.LessonType != null
                                                    ? schedule.LessonType.LessonTypeName
                                                    : "Driving Lesson")

                                            </h2>

                                            <p>
                                                @schedule.LessonDate.ToString(
                                                    "dddd, dd MMMM yyyy")
                                            </p>

                                        </div>

                                    </div>


                                    <span class="status status-cancelled">

                                        Cancelled

                                    </span>

                                </div>


                                <div class="lesson-body">

                                    <div class="details-grid">

                                        <!-- TIME -->

                                        <div class="detail">

                                            <i class="fa-solid fa-clock"></i>

                                            <span>

                                                <strong>
                                                    @schedule.StartTime.ToString(@"hh\:mm")
                                                </strong>

                                                -

                                                <strong>
                                                    @schedule.EndTime.ToString(@"hh\:mm")
                                                </strong>

                                            </span>

                                        </div>


                                        <!-- INSTRUCTOR -->

                                        <div class="detail">

                                            <i class="fa-solid fa-user-tie"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Instructor != null)
                                                    {

                                                        @schedule.Instructor.FirstName
                                                        @(" ")
                                                        @schedule.Instructor.LastName

                                                    }
                                                    else
                                                    {

                                                        @:Instructor not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- VEHICLE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-car"></i>

                                            <span>

                                                <strong>

                                                    @if (schedule.Vehicle != null)
                                                    {

                                                        @schedule.Vehicle.Make
                                                        @(" ")
                                                        @schedule.Vehicle.Model

                                                    }
                                                    else
                                                    {

                                                        @:Vehicle not assigned

                                                    }

                                                </strong>

                                            </span>

                                        </div>


                                        <!-- BOOKING DATE -->

                                        <div class="detail">

                                            <i class="fa-solid fa-calendar-plus"></i>

                                            <span>

                                                Booked:

                                                <strong>
                                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                                </strong>

                                            </span>

                                        </div>

                                    </div>


                                    <div class="lesson-footer">

                                        <a href="@Url.Action(
                                                    "Details",
                                                    "Lessons",
                                                    new { id = booking.BookingId })"
                                           class="view-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View Lesson Details

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                }
                else
                {

                    <div class="section-empty">

                        <i class="fa-regular fa-circle-xmark"></i>

                        <p>
                            You have no cancelled lessons.
                        </p>

                    </div>

                }

            </div>

        }

    </div>

</div>