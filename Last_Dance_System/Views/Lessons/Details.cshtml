@model Last_Dance_System.Models.Booking

@{
    Layout = null;
    ViewBag.Title = "Lesson Details";

    var lesson = ViewBag.LessonProgress
    as Last_Dance_System.Models.LessonProgress;

    var schedule = Model.LessonSchedule;


}

<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f8fc;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #172033;
    }

    .lesson-page {
        min-height: 100vh;
        padding: 32px 25px 65px;
        background: radial-gradient( circle at 100% 0%, rgba(25, 118, 210, 0.07), transparent 30% ), #f5f8fc;
    }

    .lesson-container {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .lesson-header {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dfe7f0;
        border-radius: 18px;
        padding: 28px 32px;
        margin-bottom: 24px;
        box-shadow: 0 8px 28px rgba(30, 70, 110, 0.07);
    }

        .lesson-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient( 180deg, #1976d2, #0d47a1 );
        }

        .lesson-header::after {
            content: "";
            position: absolute;
            right: -90px;
            top: -110px;
            width: 270px;
            height: 270px;
            background: radial-gradient( circle, rgba(25, 118, 210, 0.09), transparent 70% );
            pointer-events: none;
        }

    .lesson-header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .lesson-header-left {
        display: flex;
        align-items: center;
        gap: 17px;
    }


    /* =========================================================
       HEADER ICON
       ========================================================= */

    .header-icon {
        width: 62px;
        height: 62px;
        border-radius: 15px;
        background: linear-gradient( 135deg, #1976d2, #0d47a1 );
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        flex-shrink: 0;
        box-shadow: 0 8px 20px rgba(25, 118, 210, 0.22);
    }

        .header-icon svg {
            width: 31px;
            height: 31px;
            stroke: currentColor;
        }


    /* =========================================================
       HEADER TEXT
       ========================================================= */

    .lesson-header h1 {
        margin: 0 0 5px;
        color: #142033;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.4px;
    }

        .lesson-header h1 span {
            color: #1976d2;
        }

    .lesson-header p {
        margin: 0;
        color: #78879a;
        font-size: 13px;
    }


    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        min-height: 42px;
        border-radius: 9px;
        background: #ffffff;
        border: 1px solid #cbd8e6;
        color: #1976d2;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .back-button svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

        .back-button:hover {
            background: #eef6ff;
            border-color: #1976d2;
            color: #0d47a1;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(25, 118, 210, 0.10);
        }


    /* =========================================================
       ALERTS
       ========================================================= */

    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 17px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .alert-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .alert-success {
        background: #edf9f1;
        border: 1px solid #cdebd7;
        color: #287a46;
    }

    .alert-error {
        background: #fff1f1;
        border: 1px solid #f0cccc;
        color: #a33a3a;
    }


    /* =========================================================
       MAIN GRID
       ========================================================= */

    .lesson-grid {
        display: grid;
        grid-template-columns: 1.45fr 0.8fr;
        gap: 23px;
        align-items: start;
    }


    /* =========================================================
       CARD
       ========================================================= */

    .card {
        background: #ffffff;
        border: 1px solid #dfe7f0;
        border-radius: 17px;
        padding: 24px;
        box-shadow: 0 8px 25px rgba(30, 70, 110, 0.055);
    }

        .card h2 {
            margin: 0 0 20px;
            color: #172033;
            font-size: 18px;
            font-weight: 750;
        }


    /* =========================================================
       CARD HEADER
       ========================================================= */

    .card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        padding-bottom: 17px;
        margin-bottom: 17px;
        border-bottom: 1px solid #edf1f5;
    }

    .card-heading-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eef6ff;
        color: #1976d2;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .card-heading-icon svg {
            width: 19px;
            height: 19px;
            stroke: currentColor;
        }

    .card-heading-text h2 {
        margin: 0;
        color: #172033;
        font-size: 18px;
        font-weight: 750;
    }

    .card-heading-text p {
        margin: 3px 0 0;
        color: #8794a5;
        font-size: 11px;
    }


    /* =========================================================
       LESSON INFORMATION
       ========================================================= */

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .info-box {
        background: #fbfdff;
        border: 1px solid #e1e9f2;
        border-radius: 11px;
        padding: 15px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .info-box:hover {
            border-color: #c5d9ed;
            box-shadow: 0 5px 15px rgba(30, 70, 110, 0.05);
            transform: translateY(-1px);
        }

        .info-box span {
            display: block;
            color: #7b899a;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .info-box strong {
            display: block;
            color: #172033;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.4;
        }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-confirmed {
        background: #eef6ff;
        border: 1px solid #d4e7fa;
        color: #1976d2;
    }

    .status-progress {
        background: #fff8e5;
        border: 1px solid #f1df9f;
        color: #a97800;
    }

    .status-completed {
        background: #edf9f1;
        border: 1px solid #d0ecd8;
        color: #2e8b57;
    }


    /* =========================================================
       CODE CARD
       ========================================================= */

    .code-card {
        text-align: center;
    }

        .code-card h2 {
            margin-bottom: 8px;
        }

    .code-card-subtitle {
        color: #8794a5;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .code-label {
        color: #78879a;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .code {
        font-size: 32px;
        letter-spacing: 8px;
        font-weight: 900;
        color: #1976d2;
        background: #eef6ff;
        border: 1px solid #d4e7fa;
        border-radius: 12px;
        padding: 18px 10px;
        margin-bottom: 18px;
    }

    .code-hidden {
        color: #718096;
        font-size: 13px;
        line-height: 1.5;
        background: #f7f9fc;
        border: 1px solid #e4eaf1;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 18px;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .code-input {
        width: 100%;
        padding: 14px;
        background: #fbfdff;
        border: 1px solid #cbd8e6;
        border-radius: 9px;
        color: #172033;
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 5px;
        outline: none;
        margin-bottom: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .code-input::placeholder {
            color: #a4afbc;
            font-weight: 500;
        }

        .code-input:focus {
            background: #ffffff;
            border-color: #1976d2;
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.10);
        }


    /* =========================================================
       PRIMARY BUTTON
       ========================================================= */

    .action-button {
        width: 100%;
        min-height: 45px;
        padding: 12px 15px;
        border: 1px solid #1976d2;
        border-radius: 9px;
        background: linear-gradient( 135deg, #1976d2, #0d47a1 );
        color: #ffffff;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        box-shadow: 0 6px 15px rgba(25, 118, 210, 0.16);
    }

        .action-button:hover {
            background: linear-gradient( 135deg, #1565c0, #0b3d91 );
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(25, 118, 210, 0.22);
        }

        .action-button:disabled {
            background: #b8c3cf;
            border-color: #b8c3cf;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }


    /* =========================================================
       TIMER
       ========================================================= */

    .timer-card {
        text-align: center;
        margin-top: 20px;
    }

    .timer-label {
        color: #78879a;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.6px;
        margin-bottom: 8px;
    }

    .timer {
        font-size: 48px;
        font-weight: 900;
        letter-spacing: 3px;
        color: #1976d2;
        margin: 10px 0;
    }

    .timer-message {
        color: #8794a5;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
       COMPLETED
       ========================================================= */

    .completed {
        text-align: center;
        padding: 30px 24px;
    }

    .completed-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #edf9f1;
        border: 1px solid #cdebd7;
        color: #2e8b57;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        font-weight: 800;
    }

    .completed h2 {
        color: #287a46;
        margin-bottom: 8px;
    }

    .completed p {
        color: #8794a5;
        font-size: 13px;
        margin-bottom: 18px;
    }


    /* =========================================================
       BACK LINK
       ========================================================= */

    .bottom-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        color: #1976d2;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

        .bottom-back:hover {
            color: #0d47a1;
            text-decoration: none;
        }

        .bottom-back svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }


    /* =========================================================
       RESPONSIVE - TABLET
       ========================================================= */

    @@media (max-width: 800px) {

        .lesson-header-content {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-button {
            width: 100%;
        }

        .lesson-grid {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr 1fr;
        }
    }


    /* =========================================================
       RESPONSIVE - MOBILE
       ========================================================= */

    @@media (max-width: 576px) {

        .lesson-page {
            padding: 15px 10px 40px;
        }

        .lesson-header {
            padding: 24px 20px;
        }

        .lesson-header-left {
            align-items: flex-start;
        }

        .header-icon {
            width: 52px;
            height: 52px;
        }

            .header-icon svg {
                width: 26px;
                height: 26px;
            }

        .lesson-header h1 {
            font-size: 22px;
        }

        .lesson-grid {
            gap: 15px;
        }

        .card {
            padding: 18px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .timer {
            font-size: 40px;
        }

        .code {
            font-size: 27px;
            letter-spacing: 6px;
        }
    }
</style>

<div class="lesson-page">

    
    <div class="lesson-container">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="lesson-header">

            <div class="lesson-header-content">

                <div class="lesson-header-left">

                    <div class="header-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3"
                                  y="4"
                                  width="18"
                                  height="17"
                                  rx="2" />

                            <line x1="16"
                                  y1="2"
                                  x2="16"
                                  y2="6" />

                            <line x1="8"
                                  y1="2"
                                  x2="8"
                                  y2="6" />

                            <line x1="3"
                                  y1="9"
                                  x2="21"
                                  y2="9" />

                            <circle cx="12"
                                    cy="15"
                                    r="2.5" />

                        </svg>

                    </div>

                    <div>

                        <h1>
                            Lesson <span>Details</span>
                        </h1>

                        <p>
                            Manage your driving lesson attendance and progress.
                        </p>

                    </div>

                </div>


                <a href="@Url.Action("Index", "Lessons")"
                   class="back-button">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <line x1="19"
                              y1="12"
                              x2="5"
                              y2="12" />

                        <polyline points="12 19 5 12 12 5" />

                    </svg>

                    Back to My Lessons

                </a>

            </div>

        </div>


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                <svg class="alert-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <polyline points="20 6 9 17 4 12" />

                </svg>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">

                <svg class="alert-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <line x1="12"
                          y1="8"
                          x2="12"
                          y2="12" />

                    <line x1="12"
                          y1="16"
                          x2="12.01"
                          y2="16" />

                </svg>

                @TempData["Error"]

            </div>
        }


        <!-- =====================================================
             MAIN GRID
        ====================================================== -->

        <div class="lesson-grid">


            <!-- =================================================
                 LESSON INFORMATION
            ================================================== -->

            <div>

                <div class="card">

                    <div class="card-heading">

                        <div class="card-heading-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />

                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />

                            </svg>

                        </div>

                        <div class="card-heading-text">

                            <h2>
                                Lesson Information
                            </h2>

                            <p>
                                Details about your scheduled driving lesson
                            </p>

                        </div>

                    </div>


                    <div class="info-grid">


                        <!-- LESSON TYPE -->

                        <div class="info-box">

                            <span>
                                Lesson Type
                            </span>

                            <strong>
                                @schedule.LessonType.LessonTypeName
                            </strong>

                        </div>


                        <!-- DATE -->

                        <div class="info-box">

                            <span>
                                Date
                            </span>

                            <strong>
                                @schedule.LessonDate.ToString("dddd, dd MMMM yyyy")
                            </strong>

                        </div>


                        <!-- START -->

                        <div class="info-box">

                            <span>
                                Start Time
                            </span>

                            <strong>
                                @schedule.StartTime.ToString(@"hh\:mm")
                            </strong>

                        </div>


                        <!-- END -->

                        <div class="info-box">

                            <span>
                                End Time
                            </span>

                            <strong>
                                @schedule.EndTime.ToString(@"hh\:mm")
                            </strong>

                        </div>


                        <!-- INSTRUCTOR -->

                        <div class="info-box">

                            <span>
                                Instructor
                            </span>

                            <strong>
                                @schedule.Instructor.FirstName
                                @schedule.Instructor.LastName
                            </strong>

                        </div>


                        <!-- VEHICLE -->

                        <div class="info-box">

                            <span>
                                Vehicle
                            </span>

                            <strong>
                                @schedule.Vehicle.Make
                                @schedule.Vehicle.Model
                            </strong>

                        </div>


                        <!-- BOOKING STATUS -->

                        <div class="info-box">

                            <span>
                                Booking Status
                            </span>

                            <strong>

                                @if (Model.Status == "Confirmed")
                                {
                                    <span class="status status-confirmed">

                                        <span class="status-dot"></span>

                                        Confirmed

                                    </span>
                                }
                                else if (Model.Status == "Completed")
                                {
                                    <span class="status status-completed">

                                        <span class="status-dot"></span>

                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="status status-confirmed">

                                        <span class="status-dot"></span>

                                        @Model.Status

                                    </span>
                                }

                            </strong>

                        </div>


                        <!-- LESSON STATUS -->

                        <div class="info-box">

                            <span>
                                Lesson Status
                            </span>

                            <strong>

                                @if (lesson != null)
                                {
                                    if (lesson.LessonStatus == "In Progress")
                                    {
                                        <span class="status status-progress">

                                            <span class="status-dot"></span>

                                            In Progress

                                        </span>
                                    }
                                    else if (lesson.LessonStatus == "Completed")
                                    {
                                        <span class="status status-completed">

                                            <span class="status-dot"></span>

                                            Completed

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-confirmed">

                                            <span class="status-dot"></span>

                                            @lesson.LessonStatus

                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="status status-confirmed">

                                        <span class="status-dot"></span>

                                        Pending

                                    </span>
                                }

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TIMER
                ================================================== -->

                @if (lesson != null &&
                     lesson.CheckInConfirmed &&
                     !lesson.CheckOutConfirmed &&
                     lesson.CheckInTime.HasValue)
                {

                    <div class="card timer-card">

                        <div class="timer-label">
                            LESSON TIME REMAINING
                        </div>

                        <div id="lessonTimer"
                             class="timer">

                            30:00

                        </div>

                        <div id="timerMessage"
                             class="timer-message">

                            Your lesson is currently in progress.

                        </div>

                    </div>


                    <script>

                    var checkInTime =
                        new Date(
                            "@lesson.CheckInTime.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                        );

                    var lessonEnd =
                        new Date(
                            checkInTime.getTime()
                            +
                            (30 * 60 * 1000)
                        );


                    function updateTimer() {

                        var now = new Date();

                        var remaining =
                            lessonEnd.getTime()
                            -
                            now.getTime();


                        if (remaining <= 0) {

                            document.getElementById(
                                "lessonTimer"
                            ).innerHTML = "00:00";


                            document.getElementById(
                                "timerMessage"
                            ).innerHTML =
                                "Your 30-minute lesson is complete. Your checkout code is now available.";

                            return;
                        }


                        var totalSeconds =
                            Math.floor(
                                remaining / 1000
                            );


                        var minutes =
                            Math.floor(
                                totalSeconds / 60
                            );


                        var seconds =
                            totalSeconds % 60;


                        document.getElementById(
                            "lessonTimer"
                        ).innerHTML =
                            String(minutes).padStart(2, "0")
                            +
                            ":"
                            +
                            String(seconds).padStart(2, "0");

                    }


                    updateTimer();


                    setInterval(
                        updateTimer,
                        1000
                    );

                    </script>

                }

            </div>


            <!-- =================================================
                 CHECK-IN / CHECK-OUT
            ================================================== -->

            <div>


                <!-- =================================================
                     CHECK-IN
                ================================================== -->

                @if (lesson != null &&
                     !lesson.CheckInConfirmed &&
                     Model.Status == "Confirmed")
                {

                    <div class="card code-card">

                        <div class="card-heading">

                            <div class="card-heading-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12"
                                            cy="12"
                                            r="9" />

                                    <polyline points="12 7 12 12 15 14" />

                                </svg>

                            </div>

                            <div class="card-heading-text">

                                <h2>
                                    Check-In
                                </h2>

                                <p>
                                    Start your driving lesson
                                </p>

                            </div>

                        </div>


                        <div class="code-label">
                            SYSTEM-GENERATED CHECK-IN CODE
                        </div>


                        @if (!string.IsNullOrEmpty(lesson.CheckInCode))
                        {
                            <div class="code">
                                @lesson.CheckInCode
                            </div>
                        }
                        else
                        {
                            <div class="code-hidden">

                                Your check-in code will be generated automatically.

                            </div>
                        }


                        <p class="code-label">

                            Enter the code shown above to start your lesson.

                        </p>


                        @using (Html.BeginForm(
                            "CheckIn",
                            "Lessons",
                            FormMethod.Post))
                        {

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="id"
                                   value="@Model.BookingId" />


                            <input type="text"
                                   name="checkInCode"
                                   class="code-input"
                                   maxlength="6"
                                   minlength="6"
                                   placeholder="000000"
                                   required />


                            <button type="submit"
                                    class="action-button">

                                Confirm Check-In

                            </button>

                        }

                    </div>

                }


                <!-- =================================================
                     CHECK-OUT
                ================================================== -->

                @if (lesson != null &&
                     lesson.CheckInConfirmed &&
                     !lesson.CheckOutConfirmed)
                {

                    <div class="card code-card">

                        <div class="card-heading">

                            <div class="card-heading-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <polyline points="20 6 9 17 4 12" />

                                </svg>

                            </div>

                            <div class="card-heading-text">

                                <h2>
                                    Check-Out
                                </h2>

                                <p>
                                    Complete your driving lesson
                                </p>

                            </div>

                        </div>


                        @{
                            bool thirtyMinutesPassed =
                                lesson.CheckInTime.HasValue &&
                                DateTime.Now >=
                                lesson.CheckInTime.Value.AddMinutes(30);
                        }


                        @if (thirtyMinutesPassed)
                        {

                            <div class="code-label">
                                SYSTEM-GENERATED CHECK-OUT CODE
                            </div>


                            if (!string.IsNullOrEmpty(lesson.CheckOutCode))
                            {

                                <div class="code">
                                    @lesson.CheckOutCode
                                </div>

                            }
                            else
                            {

                                <div class="code-hidden">

                                    Refresh this page to generate your checkout code.

                                </div>

                            }


                            <p class="code-label">

                                Enter the checkout code to complete your lesson.

                            </p>


                            using (Html.BeginForm(
                                "CheckOut",
                                "Lessons",
                                FormMethod.Post))
                            {

                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="id"
                                       value="@Model.BookingId" />


                                <input type="text"
                                       name="checkOutCode"
                                       class="code-input"
                                       maxlength="6"
                                       minlength="6"
                                       placeholder="000000"
                                       required />


                                <button type="submit"
                                        class="action-button">

                                    Confirm Check-Out

                                </button>

                            }

                        }
                        else
                        {

                            <div class="code-hidden">

                                <strong>
                                    Checkout is locked.
                                </strong>

                                <br />
                                <br />

                                You must complete the full
                                30-minute lesson before checking out.

                            </div>

                        }

                    </div>

                }


                <!-- =================================================
                     COMPLETED
                ================================================== -->

                @if (lesson != null &&
                     lesson.CheckOutConfirmed)
                {

                    <div class="card completed">

                        <div class="completed-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <polyline points="20 6 9 17 4 12" />

                            </svg>

                        </div>


                        <h2>
                            Lesson Completed
                        </h2>


                        <p>
                            Your driving lesson has been successfully completed.
                        </p>


                        <div class="status status-completed">

                            <span class="status-dot"></span>

                            100% COMPLETE

                        </div>

                    </div>

                }

            </div>

        </div>


        <!-- =====================================================
             BOTTOM BACK
        ====================================================== -->

        <a href="@Url.Action("Index", "Lessons")"
           class="bottom-back">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <line x1="19"
                      y1="12"
                      x2="5"
                      y2="12" />

                <polyline points="12 19 5 12 12 5" />

            </svg>

            Back to My Lessons

        </a>

    </div>
    

</div>
