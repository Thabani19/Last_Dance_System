@{
    Layout = null;
    ViewBag.Title = "Contact Us";
}

<style>
    /* ================================
       TK DRIVING SCHOOL - CONTACT PAGE
       BLUE + WHITE DESIGN
       ================================ */

    .contact-page {
        background: #f5f8fc;
        min-height: 100vh;
        padding-bottom: 60px;
    }

    /* HERO */

    .contact-hero {
        background: linear-gradient(135deg, #084298, #0d6efd);
        color: white;
        padding: 70px 20px;
        text-align: center;
    }

    .contact-hero h1 {
        font-size: 46px;
        font-weight: 800;
        margin-bottom: 15px;
        letter-spacing: -1px;
    }

    .contact-hero p {
        max-width: 700px;
        margin: auto;
        font-size: 18px;
        line-height: 1.7;
        color: #eaf3ff;
    }

    .contact-badge {
        display: inline-block;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        padding: 8px 18px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 20px;
    }

    /* CONTAINER */

    .contact-container {
        max-width: 1100px;
        margin: -40px auto 0;
        padding: 0 20px;
        position: relative;
    }

    /* GRID */

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 25px;
    }

    /* CARDS */

    .contact-card {
        background: white;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        border: 1px solid #e1e8f0;
    }

    .contact-card h2 {
        color: #084298;
        font-size: 24px;
        margin-bottom: 10px;
        font-weight: 800;
    }

    .contact-card > p {
        color: #6b7280;
        margin-bottom: 25px;
    }

    /* CONTACT ITEMS */

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 18px 0;
        border-bottom: 1px solid #edf1f5;
    }

    .contact-item:last-child {
        border-bottom: none;
    }

    .contact-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf3ff;
        color: #0d6efd;
        border-radius: 10px;
        font-size: 20px;
        font-weight: 800;
    }

    .contact-item strong {
        display: block;
        color: #1f2937;
        margin-bottom: 3px;
    }

    .contact-item span,
    .contact-item a {
        color: #6b7280;
        text-decoration: none;
    }

    .contact-item a:hover {
        color: #0d6efd;
    }

    /* FORM */

    .contact-form {
        display: grid;
        gap: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 7px;
        font-size: 14px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        max-width: none;
        padding: 12px 14px;
        border: 1px solid #dbe3ec;
        border-radius: 8px;
        background: #f9fbfd;
        color: #1f2937;
        font-family: inherit;
        font-size: 15px;
        transition: all 0.2s ease;
    }

    .form-group textarea {
        min-height: 130px;
        resize: vertical;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        outline: none;
        border-color: #0d6efd;
        background: white;
        box-shadow: 0 0 0 3px rgba(13,110,253,0.12);
    }

    .contact-submit {
        border: none;
        background: #0d6efd;
        color: white;
        padding: 13px 25px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .contact-submit:hover {
        background: #084298;
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(13,110,253,0.25);
    }

    /* ENCOURAGEMENT */

    .encouragement {
        margin-top: 25px;
        background: linear-gradient(135deg, #084298, #0d6efd);
        color: white;
        padding: 30px;
        border-radius: 14px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(13,110,253,0.18);
    }

    .encouragement h2 {
        color: white;
        font-size: 25px;
        margin-bottom: 10px;
    }

    .encouragement p {
        color: #eaf3ff;
        margin: 0;
        line-height: 1.7;
        font-size: 16px;
    }

    /* BUSINESS HOURS */

    .hours {
        margin-top: 25px;
        background: white;
        border-radius: 14px;
        padding: 25px 30px;
        border: 1px solid #e1e8f0;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .hours h2 {
        color: #084298;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .hours-row {
        display: flex;
        justify-content: space-between;
        padding: 9px 0;
        border-bottom: 1px solid #edf1f5;
        color: #4b5563;
    }

    .hours-row:last-child {
        border-bottom: none;
    }

    .hours-row strong {
        color: #1f2937;
    }

    /* MOBILE */

    @@media (max-width: 768px) {

        .contact-hero {
            padding: 50px 20px;
        }

        .contact-hero h1 {
            font-size: 34px;
        }

        .contact-grid {
            grid-template-columns: 1fr;
        }

        .contact-container {
            margin-top: -25px;
        }

        .contact-card {
            padding: 25px;
        }
    }
</style>

<div class="contact-page">

    
    <!-- ================================
         HERO
         ================================ -->

    <section class="contact-hero">

        <div class="contact-badge">
            TK DRIVING SCHOOL
        </div>

        <h1>
            We're Here to Help
        </h1>

        <p>
            Have a question about lessons, packages, instructors or
            bookings? Get in touch with TK Driving School and we'll
            be happy to help you get started.
        </p>

    </section>


    <!-- ================================
         CONTACT CONTENT
         ================================ -->

    <div class="contact-container">

        <div class="contact-grid">


            <!-- ============================
                 CONTACT INFORMATION
                 ============================ -->

            <div class="contact-card">

                <h2>
                    Get in Touch
                </h2>

                <p>
                    Contact our team using any of the options below.
                </p>


                <!-- PHONE -->

                <div class="contact-item">

                    <div class="contact-icon">
                        ☎
                    </div>

                    <div>

                        <strong>
                            Phone
                        </strong>

                        <a href="tel:+27724378667">
                            +27 72 437 8667
                        </a>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="contact-item">

                    <div class="contact-icon">
                        ✉
                    </div>

                    <div>

                        <strong>
                            Email
                        </strong>

                        <a href="mailto:Admin@tkdrivingschool.co.za">
                            Admin@tkdrivingschool.co.za
                        </a>

                    </div>

                </div>


                <!-- LOCATION -->

                <div class="contact-item">

                    <div class="contact-icon">
                        📍
                    </div>

                    <div>

                        <strong>
                            Location
                        </strong>

                        <span>
                            Durban, KwaZulu-Natal<br />
                            South Africa
                        </span>

                    </div>

                </div>


                <!-- SUPPORT -->

                <div class="contact-item">

                    <div class="contact-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            Online Support
                        </strong>

                        <span>
                            Available for students and registered users.
                        </span>

                    </div>

                </div>

            </div>


            <!-- ============================
                 CONTACT FORM
                 ============================ -->

            <div class="contact-card">

                <h2>
                    Send Us a Message
                </h2>

                <p>
                    Fill in the form below and our team will get back
                    to you as soon as possible.
                </p>


                <form class="contact-form"
                      method="post"
                      action="#">

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               placeholder="Enter your full name"
                               required />

                    </div>


                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="Enter your email address"
                               required />

                    </div>


                    <div class="form-group">

                        <label for="subject">
                            What can we help you with?
                        </label>

                        <select id="subject"
                                name="subject">

                            <option value="">
                                Select an option
                            </option>

                            <option value="booking">
                                Booking a driving lesson
                            </option>

                            <option value="packages">
                                Lesson packages
                            </option>

                            <option value="instructor">
                                Instructor information
                            </option>

                            <option value="payment">
                                Payment enquiry
                            </option>

                            <option value="general">
                                General enquiry
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="message">
                            Message
                        </label>

                        <textarea id="message"
                                  name="message"
                                  placeholder="How can we help you?"
                                  required></textarea>

                    </div>


                    <button type="submit"
                            class="contact-submit">

                        Send Message →

                    </button>

                </form>

            </div>

        </div>


        <!-- ================================
             BUSINESS HOURS
             ================================ -->

        <div class="hours">

            <h2>
                Opening Hours
            </h2>

            <div class="hours-row">
                <strong>Monday – Friday</strong>
                <span>08:00 – 15:30</span>
            </div>

            <div class="hours-row">
                <strong>Saturday</strong>
                <span>08:00 – 15:30</span>
            </div>

            <div class="hours-row">
                <strong>Sunday</strong>
                <span>Closed</span>
            </div>

        </div>


        <!-- ================================
             ENCOURAGEMENT
             ================================ -->

        <div class="encouragement">

            <h2>
                🚗 Your Journey Starts With One Decision
            </h2>

            <p>
                Don't worry if you're a complete beginner.
                Every confident driver was once a learner.
                Take your first step today, stay consistent,
                believe in yourself and we'll help you get
                closer to your licence.
            </p>

        </div>

    </div>
    

</div>
