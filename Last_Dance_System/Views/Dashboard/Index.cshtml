@model Last_Dance_System.Models.StudentDashboardViewModel

@{
    Layout = null;
    ViewBag.Title = "Student Dashboard";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f4f7fb;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #172033;
    }

    a {
        text-decoration: none;
    }

    button,
    a {
        -webkit-tap-highlight-color: transparent;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .dashboard-page {
        min-height: 100vh;
        padding: 30px;

        background:
            radial-gradient(
                circle at 80% 10%,
                rgba(21, 101, 192, 0.08),
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #f7faff 0%,
                #f1f5fa 50%,
                #eef3f9 100%
            );
    }


    .dashboard-layout {
        max-width: 1450px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);

        gap: 24px;

        align-items: start;
    }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .dashboard-sidebar {
        position: sticky;
        top: 25px;

        height: fit-content;

        padding: 20px 14px;

        background: #ffffff;

        border: 1px solid #dce5f0;

        border-radius: 18px;

        box-shadow: 0 15px 40px rgba(30, 64, 100, 0.10);
    }


    .sidebar-brand {
        padding: 8px 12px 20px;
        margin-bottom: 10px;

        border-bottom: 1px solid #e5ebf3;
    }


    .sidebar-brand h2 {
        margin: 0;

        font-size: 18px;
        font-weight: 800;

        letter-spacing: -0.3px;

        color: #172033;
    }


    .sidebar-brand h2 span {
        color: #1565c0;
    }


    .sidebar-brand p {
        margin: 5px 0 0;

        color: #8492a6;

        font-size: 10px;

        font-weight: 500;
    }


    .sidebar-menu {
        margin-top: 10px;
    }


    .sidebar-section-title {
        padding: 14px 13px 7px;

        color: #8a98aa;

        font-size: 9px;

        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 1px;
    }


    .sidebar-item {
        margin-bottom: 4px;
    }


    .sidebar-link {
        width: 100%;

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 10px 11px;

        background: transparent;

        border: 1px solid transparent;

        border-radius: 10px;

        color: #66758a;

        font-size: 12px;

        cursor: pointer;

        transition: all 0.25s ease;
    }


    .sidebar-link:hover {
        background: #edf5ff;

        border-color: #d5e7fb;

        color: #1565c0;

        transform: translateX(2px);
    }


    .sidebar-link.active {
        background: #e8f2ff;

        border-color: #cfe2f8;

        color: #1565c0;

        font-weight: 700;
    }


    .sidebar-icon {
        width: 32px;
        height: 32px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #f1f6fc;

        color: #1565c0;

        font-size: 13px;

        transition: all 0.25s ease;
    }


    .sidebar-link:hover .sidebar-icon {
        background: #ffffff;
    }


    .sidebar-link.active .sidebar-icon {
        background: #1565c0;

        color: #ffffff;

        box-shadow: 0 4px 10px rgba(21, 101, 192, 0.18);
    }


    .sidebar-text {
        font-weight: 600;

        line-height: 1.2;
    }


    /* =========================================================
       NOTIFICATION COUNT
       ========================================================= */

    .sidebar-notification-count {
        margin-left: auto;

        min-width: 20px;
        height: 20px;

        padding: 0 6px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        background: #dc2626;

        color: #ffffff;

        border-radius: 20px;

        font-size: 8px;

        font-weight: 800;

        line-height: 1;
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .logout-container {
        margin-top: 15px;

        padding-top: 15px;

        border-top: 1px solid #e5ebf3;
    }


    .logout-link {
        width: 100%;

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 10px 11px;

        background: transparent;

        border: 1px solid transparent;

        border-radius: 10px;

        color: #66758a;

        font-family: inherit;

        font-size: 12px;

        cursor: pointer;

        transition: all 0.25s ease;

        text-align: left;
    }


    .logout-link:hover {
        background: #fff1f1;

        border-color: #ffd5d5;

        color: #dc2626;

        transform: translateX(2px);
    }


    .logout-link:hover .sidebar-icon {
        background: #fff1f1;

        color: #dc2626;
    }


    /* =========================================================
       MAIN
       ========================================================= */

    .dashboard-main {
        min-width: 0;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .dashboard-header {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 20px;

        margin-bottom: 24px;

        padding: 25px 28px;

        background: #ffffff;

        border: 1px solid #dce5f0;

        border-radius: 18px;

        box-shadow: 0 15px 40px rgba(30, 64, 100, 0.08);
    }


    .welcome-section {
        min-width: 0;
    }


    .welcome-section h1 {
        margin: 0 0 7px;

        font-size: 28px;

        font-weight: 800;

        letter-spacing: -0.6px;

        color: #172033;
    }


    .welcome-section h1 span {
        color: #1565c0;
    }


    .welcome-section p {
        margin: 0;

        color: #718096;

        font-size: 13px;
    }


    /* =========================================================
       HEADER ACTIONS
       ========================================================= */

    .header-actions {
        display: flex;

        align-items: center;

        gap: 10px;

        flex-shrink: 0;
    }


    /* =========================================================
       NOTIFICATION BUTTON
       ========================================================= */

    .notification-button {
        position: relative;

        width: 47px;
        height: 47px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #f4f8fd;

        border: 1px solid #dce7f3;

        border-radius: 10px;

        color: #1565c0;

        font-size: 17px;

        transition: all 0.25s ease;
    }


    .notification-button:hover {
        background: #edf5ff;

        border-color: #1565c0;

        color: #0d47a1;

        transform: translateY(-1px);
    }


    .notification-badge {
        position: absolute;

        top: -6px;
        right: -6px;

        min-width: 20px;
        height: 20px;

        padding: 0 5px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #dc2626;

        border: 2px solid #ffffff;

        border-radius: 20px;

        color: #ffffff;

        font-size: 8px;

        font-weight: 800;

        line-height: 1;
    }


    /* =========================================================
       PROFILE BUTTON
       ========================================================= */

    .profile-button {
        display: flex;

        align-items: center;

        gap: 11px;

        padding: 8px 14px 8px 9px;

        border-radius: 10px;

        background: #f4f8fd;

        border: 1px solid #dce7f3;

        color: #172033;

        transition: all 0.25s ease;
    }


    .profile-button:hover {
        border-color: #1565c0;

        color: #1565c0;

        background: #edf5ff;

        transform: translateY(-1px);
    }


    .profile-icon {
        width: 37px;
        height: 37px;

        border-radius: 9px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #1565c0;

        color: #ffffff;
    }


    .profile-text {
        display: flex;

        flex-direction: column;
    }


    .profile-text strong {
        font-size: 12px;
    }


    .profile-text span {
        margin-top: 2px;

        color: #8492a6;

        font-size: 10px;
    }


    /* =========================================================
       STATISTICS
       ========================================================= */

    .stats-grid {
        display: grid;

        grid-template-columns: repeat(4, minmax(0, 1fr));

        gap: 16px;

        margin-bottom: 22px;
    }


    .stat-card {
        position: relative;

        min-width: 0;

        padding: 21px;

        background: #ffffff;

        border: 1px solid #dce5f0;

        border-radius: 15px;

        overflow: hidden;

        transition: all 0.25s ease;

        box-shadow: 0 8px 25px rgba(30, 64, 100, 0.06);
    }


    .stat-card::after {
        content: "";

        position: absolute;

        width: 65px;
        height: 65px;

        right: -20px;
        bottom: -20px;

        border-radius: 50%;

        background: rgba(21, 101, 192, 0.04);
    }


    .stat-card:hover {
        transform: translateY(-3px);

        border-color: #9fc7ed;

        box-shadow: 0 12px 30px rgba(21, 101, 192, 0.10);
    }


    .stat-icon {
        width: 42px;
        height: 42px;

        border-radius: 9px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #edf5ff;

        border: 1px solid #d5e7fb;

        color: #1565c0;

        font-size: 16px;

        margin-bottom: 15px;
    }


    .stat-card h3 {
        margin: 0 0 5px;

        font-size: 24px;

        font-weight: 800;

        color: #172033;
    }


    .stat-card p {
        margin: 0;

        color: #718096;

        font-size: 11px;

        font-weight: 500;
    }


    /* =========================================================
       MAIN GRID
       ========================================================= */

    .dashboard-grid {
        display: grid;

        grid-template-columns:
            minmax(0, 1.5fr)
            minmax(320px, 1fr);

        gap: 20px;

        align-items: start;
    }


    /* =========================================================
       DASHBOARD CARD
       ========================================================= */

    .dashboard-card {
        background: #ffffff;

        border: 1px solid #dce5f0;

        border-radius: 16px;

        overflow: hidden;

        box-shadow: 0 10px 28px rgba(30, 64, 100, 0.07);
    }


    .card-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;

        padding: 20px 22px;

        border-bottom: 1px solid #e5ebf3;
    }


    .card-title {
        display: flex;

        align-items: center;

        gap: 10px;

        min-width: 0;
    }


    .card-title-icon {
        width: 35px;
        height: 35px;

        flex-shrink: 0;

        border-radius: 8px;

        background: #edf5ff;

        border: 1px solid #d5e7fb;

        color: #1565c0;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 13px;
    }


    .card-title h2 {
        margin: 0;

        font-size: 15px;

        font-weight: 750;

        color: #172033;
    }


    .card-header-link {
        color: #1565c0;

        font-size: 11px;

        font-weight: 700;

        white-space: nowrap;

        transition: 0.2s ease;
    }


    .card-header-link:hover {
        color: #0d47a1;
    }


    /* =========================================================
       LESSON
       ========================================================= */

    .lesson-content {
        padding: 22px;
    }


    .lesson-box {
        background: #f7faff;

        border: 1px solid #dce7f3;

        border-radius: 12px;

        padding: 19px;
    }


    .lesson-date {
        display: flex;

        align-items: center;

        gap: 14px;

        margin-bottom: 17px;
    }


    .date-box {
        width: 54px;
        height: 54px;

        border-radius: 9px;

        background: #1565c0;

        display: flex;

        flex-direction: column;

        align-items: center;
        justify-content: center;

        color: #ffffff;

        flex-shrink: 0;

        box-shadow: 0 5px 15px rgba(21, 101, 192, 0.20);
    }


    .date-box strong {
        font-size: 19px;

        line-height: 1;
    }


    .date-box span {
        font-size: 8px;

        text-transform: uppercase;

        margin-top: 3px;
    }


    .lesson-info {
        min-width: 0;
    }


    .lesson-info h3 {
        margin: 0 0 4px;

        font-size: 15px;

        color: #172033;
    }


    .lesson-info p {
        margin: 0;

        color: #718096;

        font-size: 11px;
    }


    .lesson-details {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 9px;
    }


    .lesson-detail {
        display: flex;

        align-items: center;

        gap: 8px;

        min-width: 0;

        padding: 10px;

        background: #ffffff;

        border: 1px solid #e5ebf3;

        border-radius: 7px;

        color: #66758a;

        font-size: 10px;
    }


    .lesson-detail i {
        color: #1565c0;

        width: 15px;

        flex-shrink: 0;

        text-align: center;
    }


    .lesson-detail span {
        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .dashboard-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 10px 17px;

        background: #1565c0;

        color: #ffffff;

        border-radius: 8px;

        border: none;

        font-size: 11px;

        font-weight: 700;

        transition: all 0.25s ease;

        box-shadow:
            0 5px 12px rgba(21, 101, 192, 0.15);
    }


    .dashboard-button:hover {
        background: #0d47a1;

        color: #ffffff;

        transform: translateY(-1px);

        box-shadow:
            0 7px 16px rgba(21, 101, 192, 0.20);
    }


    .secondary-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 10px 14px;

        background: #f4f8fd;

        border: 1px solid #dce7f3;

        color: #172033;

        border-radius: 8px;

        font-size: 10px;

        font-weight: 700;

        transition: all 0.25s ease;
    }


    .secondary-button:hover {
        background: #edf5ff;

        border-color: #1565c0;

        color: #1565c0;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        text-align: center;

        padding: 42px 20px;
    }


    .empty-icon {
        width: 54px;
        height: 54px;

        border-radius: 11px;

        background: #f1f6fc;

        border: 1px solid #dce7f3;

        color: #1565c0;

        display: flex;

        align-items: center;
        justify-content: center;

        margin: 0 auto 14px;

        font-size: 19px;
    }


    .empty-state h3 {
        margin: 0 0 7px;

        font-size: 14px;

        color: #172033;
    }


    .empty-state p {
        max-width: 420px;

        margin: 0 auto 18px;

        color: #718096;

        font-size: 11px;

        line-height: 1.6;
    }


    /* =========================================================
       PACKAGE
       ========================================================= */

    .package-content {
        padding: 22px;
    }


    .package-main {
        padding: 18px;

        background:
            linear-gradient(
                135deg,
                #edf5ff,
                #f8fbff
            );

        border: 1px solid #dce7f3;

        border-radius: 12px;
    }


    .package-heading {
        display: flex;

        align-items: center;

        gap: 13px;

        margin-bottom: 18px;
    }


    .package-icon {
        width: 45px;
        height: 45px;

        flex-shrink: 0;

        border-radius: 10px;

        background: #1565c0;

        color: #ffffff;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 17px;

        box-shadow:
            0 5px 15px rgba(21, 101, 192, 0.18);
    }


    .package-heading h3 {
        margin: 0 0 4px;

        font-size: 15px;

        color: #172033;
    }


    .package-heading p {
        margin: 0;

        color: #718096;

        font-size: 10px;
    }


    .package-details {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 9px;
    }


    .package-detail {
        min-width: 0;

        padding: 12px;

        background: #ffffff;

        border: 1px solid #e1e9f2;

        border-radius: 8px;
    }


    .package-detail span.label {
        display: block;

        color: #718096;

        font-size: 9px;

        margin-bottom: 5px;
    }


    .package-detail strong {
        display: block;

        color: #172033;

        font-size: 12px;

        word-break: break-word;
    }


    .package-status {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding: 5px 9px;

        border-radius: 20px;

        background: #ecfdf3;

        border: 1px solid #c9f2d9;

        color: #16a34a;

        font-size: 8px;

        font-weight: 700;

        text-transform: uppercase;
    }


    .package-progress {
        margin-top: 16px;
    }


    .package-progress-header {
        display: flex;

        justify-content: space-between;

        gap: 10px;

        margin-bottom: 7px;

        font-size: 9px;

        color: #718096;
    }


    .package-progress-header strong {
        color: #1565c0;
    }


    .package-progress-bar {
        height: 7px;

        background: #dfe8f2;

        border-radius: 20px;

        overflow: hidden;
    }


    .package-progress-fill {
        height: 100%;

        width:
            @(Math.Max(
                0,
                Math.Min(
                    100,
                    Model.PackageProgressPercentage
                )
            ))%;

        background: #1565c0;

        border-radius: 20px;

        transition: width 0.5s ease;
    }


    .package-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 15px;
    }


    /* =========================================================
       PROGRESS
       ========================================================= */

    .progress-content {
        padding: 22px;
    }


    .progress-header {
        display: flex;

        justify-content: space-between;

        gap: 10px;

        margin-bottom: 11px;
    }


    .progress-header span {
        font-size: 11px;

        color: #718096;
    }


    .progress-header strong {
        color: #1565c0;

        font-size: 13px;
    }


    .progress-bar {
        height: 8px;

        width: 100%;

        background: #dfe8f2;

        border-radius: 20px;

        overflow: hidden;
    }


    .progress-fill {
        height: 100%;

        width:
            @(Math.Max(
                0,
                Math.Min(
                    100,
                    Model.ProgressPercentage
                )
            ))%;

        background:
            linear-gradient(
                90deg,
                #0d47a1,
                #1565c0
            );

        border-radius: 20px;

        transition: width 0.5s ease;
    }


    .progress-footer {
        display: flex;

        justify-content: space-between;

        gap: 10px;

        margin-top: 11px;

        color: #718096;

        font-size: 10px;
    }


    /* =========================================================
       PAYMENT
       ========================================================= */

    .payment-content {
        padding: 22px;
    }


    .payment-status {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 10px;

        padding: 15px;

        background: #f7faff;

        border-radius: 10px;

        border: 1px solid #dce7f3;
    }


    .payment-left {
        display: flex;

        align-items: center;

        gap: 11px;

        min-width: 0;
    }


    .payment-icon {
        width: 39px;
        height: 39px;

        border-radius: 8px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #edf5ff;

        color: #1565c0;

        flex-shrink: 0;
    }


    .payment-left strong {
        display: block;

        font-size: 11px;

        color: #172033;
    }


    .payment-left span {
        display: block;

        color: #718096;

        font-size: 9px;

        margin-top: 3px;
    }


    .status-badge {
        padding: 6px 9px;

        border-radius: 20px;

        font-size: 8px;

        font-weight: 700;

        text-transform: uppercase;

        background: #fff7ed;

        color: #ea580c;

        border: 1px solid #fed7aa;

        white-space: nowrap;
    }


    .status-badge.paid {
        background: #ecfdf3;

        color: #16a34a;

        border-color: #c9f2d9;
    }


    .payment-amounts {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 9px;

        margin-top: 10px;
    }


    .payment-amount {
        min-width: 0;

        padding: 12px;

        background: #f7faff;

        border: 1px solid #e1e9f2;

        border-radius: 8px;
    }


    .payment-amount span {
        display: block;

        color: #718096;

        font-size: 9px;

        margin-bottom: 4px;
    }


    .payment-amount strong {
        font-size: 13px;

        color: #172033;
    }


    /* =========================================================
       FEEDBACK
       ========================================================= */

    .feedback-content {
        padding: 22px;
    }


    .feedback-box {
        padding: 17px;

        background: #f7faff;

        border: 1px solid #dce7f3;

        border-radius: 10px;

        position: relative;
    }


    .feedback-box::before {
        content: "\f10d";

        font-family: "Font Awesome 6 Free";

        font-weight: 900;

        position: absolute;

        top: 13px;
        right: 15px;

        font-size: 22px;

        color: #dbeafe;
    }


    .feedback-box p {
        margin: 0;

        padding-right: 30px;

        color: #5f6f84;

        font-size: 11px;

        line-height: 1.7;
    }


    .feedback-author {
        margin-top: 14px;

        color: #1565c0;

        font-size: 10px;

        font-weight: 700;
    }


    .feedback-date {
        margin-top: 4px;

        color: #8794a6;

        font-size: 9px;
    }


    .feedback-view-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 6px;

        margin-top: 14px;

        padding: 8px 12px;

        background: #edf5ff;

        border: 1px solid #d5e7fb;

        border-radius: 7px;

        color: #1565c0;

        font-size: 9px;

        font-weight: 700;

        transition: all 0.2s ease;
    }


    .feedback-view-button:hover {
        background: #1565c0;

        border-color: #1565c0;

        color: #ffffff;
    }


    /* =========================================================
       RESPONSIVE - 1150
       ========================================================= */

    @@media (max-width: 1150px) {

        .dashboard-layout {
            grid-template-columns:
                210px minmax(0, 1fr);
        }


        .stats-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }


        .dashboard-grid {
            grid-template-columns: 1fr;
        }

    }


    /* =========================================================
       RESPONSIVE - 850
       ========================================================= */

    @@media (max-width: 850px) {

        .dashboard-page {
            padding: 20px;
        }


        .dashboard-layout {
            grid-template-columns: 1fr;
        }


        .dashboard-sidebar {
            position: static;
        }


        .sidebar-menu {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 5px;
        }


        .sidebar-section-title {
            grid-column: 1 / -1;
        }


        .logout-container {
            grid-column: 1 / -1;
        }

    }


    /* =========================================================
       RESPONSIVE - 650
       ========================================================= */

    @@media (max-width: 650px) {

        .dashboard-page {
            padding: 15px;
        }


        .dashboard-header {
            flex-direction: column;

            align-items: flex-start;

            gap: 18px;
        }


        .welcome-section h1 {
            font-size: 23px;
        }


        .header-actions {
            width: 100%;
        }


        .notification-button {
            flex-shrink: 0;
        }


        .profile-button {
            width: 100%;
        }


        .stats-grid {
            grid-template-columns: 1fr;
        }


        .lesson-date {
            align-items: flex-start;
        }


        .lesson-details {
            grid-template-columns: 1fr;
        }


        .sidebar-menu {
            grid-template-columns: 1fr;
        }


        .sidebar-section-title {
            grid-column: auto;
        }


        .logout-container {
            grid-column: auto;
        }


        .payment-status {
            align-items: flex-start;

            flex-direction: column;
        }


        .status-badge {
            align-self: flex-start;
        }


        .payment-amounts {
            grid-template-columns: 1fr;
        }


        .package-details {
            grid-template-columns: 1fr;
        }


        .package-actions {
            flex-direction: column;
        }


        .package-actions a {
            width: 100%;
        }

    }


    /* =========================================================
       RESPONSIVE - 420
       ========================================================= */

    @@media (max-width: 420px) {

        .dashboard-page {
            padding: 10px;
        }


        .dashboard-header {
            padding: 20px;
        }


        .welcome-section h1 {
            font-size: 21px;
        }


        .profile-button {
            padding-right: 10px;
        }


        .card-header {
            padding: 17px;
        }


        .lesson-content,
        .package-content,
        .progress-content,
        .payment-content,
        .feedback-content {
            padding: 17px;
        }

    }

</style>


<!-- =========================================================
