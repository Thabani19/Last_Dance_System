        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="dashboard-header">

                <div class="welcome-section">

                    <h1>
                        Welcome back,
