                    <div class="stat-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h3>
                        @Model.CompletedLessons
                    </h3>

                    <p>
                        Completed Lessons
                    </p>

                </div>


                <!-- REMAINING -->

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <h3>
                        @Model.RemainingLessons
                    </h3>

                    <p>
                        Remaining Lessons
                    </p>

                </div>


                <!-- PROGRESS -->

                <div class="stat-card">

                    <div class="stat-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <h3>
                        @Model.ProgressPercentage%
                    </h3>

                    <p>
                        Overall Progress
                    </p>

                </div>

            </div>


            <!-- =================================================
                 DASHBOARD GRID
                 ================================================= -->

            <div class="dashboard-grid">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div>


                    <!-- =================================================
                         UPCOMING LESSON
                         ================================================= -->

                    <div class="dashboard-card">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-calendar-check"></i>
                                </div>

                                <h2>
                                    Upcoming Lesson
                                </h2>

                            </div>

                            <a href="@Url.Action("Index", "Lessons")"
                               class="card-header-link">

                                View All

                            </a>

                        </div>


                        @if (Model.HasUpcomingLesson)
                        {

                            <div class="lesson-content">

                                <div class="lesson-box">


                                    <div class="lesson-date">

                                        <div class="date-box">

                                            @if (Model.UpcomingLessonDate.HasValue)
                                            {
                                                <strong>
                                                    @Model.UpcomingLessonDate.Value.Day
                                                </strong>

                                                <span>
                                                    @Model.UpcomingLessonDate.Value.ToString("MMM")
                                                </span>
                                            }
                                            else
                                            {
                                                <strong>--</strong>

                                                <span>
                                                    DATE
                                                </span>
                                            }

                                        </div>


                                        <div class="lesson-info">

                                            <h3>
                                                @Model.UpcomingLessonType
                                            </h3>

                                            <p>

                                                @if (Model.UpcomingLessonDate.HasValue)
                                                {
                                                    @Model.UpcomingLessonDate.Value.ToString(
                                                        "dddd, dd MMMM yyyy")
                                                }

                                            </p>

                                        </div>

                                    </div>


                                    <div class="lesson-details">


                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-clock"></i>

                                            <span>
