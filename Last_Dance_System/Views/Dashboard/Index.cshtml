                        <span class="sidebar-icon">
                            <i class="fa-solid fa-user"></i>
                        </span>

                        <span class="sidebar-text">
                            My Profile
                        </span>

                    </a>

                </div>


                <!-- NOTIFICATIONS -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Notification")"
