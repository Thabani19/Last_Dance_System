@model Last_Dance_System.Models.StudentDashboardViewModel

@{
    ViewBag.Title = "Student Dashboard";
}

<!-- =========================================================
     FONT AWESOME
     ========================================================= -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        background: #07111f;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #ffffff;
    }

    a {
        text-decoration: none;
    }


    /* =========================================================
       DASHBOARD PAGE
       ========================================================= */

    .dashboard-page {
        min-height: calc(100vh - 50px);
        padding: 30px;

        background:
            radial-gradient(
                circle at 80% 10%,
                rgba(225, 6, 0, 0.08),
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #07111f 0%,
                #0a1626 50%,
                #06101c 100%
            );
    }

    .dashboard-layout {
        max-width: 1450px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 24px;
    }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .dashboard-sidebar {
        height: fit-content;

        position: sticky;
        top: 25px;

        padding: 20px 14px;

        background: #0b1727;

        border: 1px solid #17283d;
        border-radius: 18px;

        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.30);
    }


    /* =========================================================
       SIDEBAR BRAND
       ========================================================= */

    .sidebar-brand {
        padding: 8px 12px 22px;
        margin-bottom: 10px;

        border-bottom: 1px solid #17283d;
    }

    .sidebar-brand h2 {
        margin: 0;

        font-size: 18px;
        font-weight: 800;

        letter-spacing: -0.3px;
    }

    .sidebar-brand h2 span {
        color: #e10600;
    }

    .sidebar-brand p {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 10px;
    }


    /* =========================================================
       SIDEBAR MENU
       ========================================================= */

    .sidebar-menu {
        margin-top: 10px;
    }

    .sidebar-item {
        margin-bottom: 5px;
    }

    .sidebar-section-title {
        padding: 15px 13px 7px;

        color: #506176;

        font-size: 9px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: 1px;
    }


    /* =========================================================
       SIDEBAR LINKS
       ========================================================= */

    .sidebar-link {
        width: 100%;

        display: flex;
        align-items: center;

        gap: 13px;

        padding: 12px 13px;

        background: transparent;

        border: 1px solid transparent;
        border-radius: 10px;

        color: #9aa9ba;

        font-family: inherit;
        font-size: 12px;

        cursor: pointer;

        transition: all 0.25s ease;

        text-align: left;
    }

    .sidebar-link:hover {
        background: rgba(225, 6, 0, 0.08);

        border-color: rgba(225, 6, 0, 0.15);

        color: #ffffff;

        text-decoration: none;
    }

    .sidebar-link.active {
        background: rgba(225, 6, 0, 0.12);

        border-color: rgba(225, 6, 0, 0.20);

        color: #ffffff;
    }


    /* =========================================================
       SIDEBAR ICON
       ========================================================= */

    .sidebar-icon {
        width: 32px;
        height: 32px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #101f32;

        color: #e10600;

        font-size: 13px;

        transition: all 0.25s ease;
    }

    .sidebar-link.active .sidebar-icon {
        background: #e10600;
        color: #ffffff;
    }

    .sidebar-link:hover .sidebar-icon {
        background: rgba(225, 6, 0, 0.15);
        color: #ff3b35;
    }

    .sidebar-link.active:hover .sidebar-icon {
        background: #e10600;
        color: #ffffff;
    }

    .sidebar-text {
        font-weight: 600;
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .logout-container {
        margin-top: 15px;
        padding-top: 15px;

        border-top: 1px solid #17283d;
    }

    .logout-link {
        width: 100%;

        display: flex;
        align-items: center;

        gap: 13px;

        padding: 12px 13px;

        background: transparent;

        border: 1px solid transparent;
        border-radius: 10px;

        color: #9aa9ba;

        font-family: inherit;
        font-size: 12px;

        cursor: pointer;

        transition: all 0.25s ease;

        text-align: left;
    }

    .logout-link:hover {
        background: rgba(225, 6, 0, 0.10);

        border-color: rgba(225, 6, 0, 0.20);

        color: #ff3b35;
    }

    .logout-link .sidebar-icon {
        color: #e10600;
    }


    /* =========================================================
       MAIN CONTENT
       ========================================================= */

    .dashboard-main {
        min-width: 0;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .dashboard-header {
        display: flex;

        justify-content: space-between;
        align-items: center;

        margin-bottom: 24px;

        padding: 25px 28px;

        background: #0b1727;

        border: 1px solid #17283d;
        border-radius: 18px;

        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }

    .welcome-section h1 {
        margin: 0 0 7px;

        font-size: 28px;
        font-weight: 800;
    }

    .welcome-section h1 span {
        color: #e10600;
    }

    .welcome-section p {
        margin: 0;

        color: #708197;

        font-size: 13px;
    }


    /* =========================================================
       PROFILE BUTTON
       ========================================================= */

    .profile-button {
        display: flex;
        align-items: center;

        gap: 11px;

        padding: 10px 15px;

        border-radius: 10px;

        background: #101f32;

        border: 1px solid #1d3149;

        color: #ffffff;

        transition: 0.25s ease;
    }

    .profile-button:hover {
        border-color: #e10600;

        color: #ffffff;

        text-decoration: none;
    }

    .profile-icon {
        width: 37px;
        height: 37px;

        border-radius: 9px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #e10600;

        color: #ffffff;
    }

    .profile-text {
        display: flex;
        flex-direction: column;
    }

    .profile-text strong {
        font-size: 12px;
    }

    .profile-text span {
        margin-top: 2px;

        color: #607187;

        font-size: 10px;
    }


    /* =========================================================
       STATISTICS
       ========================================================= */

    .stats-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 16px;

        margin-bottom: 22px;
    }

    .stat-card {
        position: relative;

        padding: 21px;

        background: #0b1727;

        border: 1px solid #17283d;
        border-radius: 15px;

        overflow: hidden;

        transition: 0.25s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);

        border-color: rgba(225, 6, 0, 0.4);
    }

    .stat-card::after {
        content: "";

        position: absolute;

        width: 90px;
        height: 90px;

        right: -35px;
        top: -35px;

        background: rgba(225, 6, 0, 0.06);

        border-radius: 50%;
    }

    .stat-icon {
        width: 42px;
        height: 42px;

        border-radius: 9px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(225, 6, 0, 0.09);

        border: 1px solid rgba(225, 6, 0, 0.18);

        color: #e10600;

        font-size: 16px;

        margin-bottom: 15px;
    }

    .stat-card h3 {
        margin: 0 0 5px;

        font-size: 24px;
        font-weight: 800;
    }

    .stat-card p {
        margin: 0;

        color: #637389;

        font-size: 11px;
    }


    /* =========================================================
       DASHBOARD GRID
       ========================================================= */

    .dashboard-grid {
        display: grid;

        grid-template-columns: 1.5fr 1fr;

        gap: 20px;
    }


    /* =========================================================
       DASHBOARD CARDS
       ========================================================= */

    .dashboard-card {
        background: #0b1727;

        border: 1px solid #17283d;

        border-radius: 16px;

        overflow: hidden;

        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.20);
    }

    .card-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        padding: 20px 22px;

        border-bottom: 1px solid #17283d;
    }

    .card-title {
        display: flex;

        align-items: center;

        gap: 10px;
    }

    .card-title-icon {
        width: 35px;
        height: 35px;

        border-radius: 8px;

        background: rgba(225, 6, 0, 0.09);

        border: 1px solid rgba(225, 6, 0, 0.18);

        color: #e10600;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 13px;
    }

    .card-title h2 {
        margin: 0;

        font-size: 15px;

        font-weight: 750;
    }

    .card-header-link {
        color: #e10600;

        font-size: 11px;

        font-weight: 600;
    }

    .card-header-link:hover {
        color: #ff3b35;

        text-decoration: none;
    }


    /* =========================================================
       UPCOMING LESSON
       ========================================================= */

    .lesson-content {
        padding: 22px;
    }

    .lesson-box {
        background: #0e1b2c;

        border: 1px solid #1a2d43;

        border-radius: 12px;

        padding: 19px;
    }

    .lesson-date {
        display: flex;

        align-items: center;

        gap: 14px;

        margin-bottom: 17px;
    }

    .date-box {
        width: 54px;
        height: 54px;

        border-radius: 9px;

        background: #e10600;

        display: flex;

        flex-direction: column;

        align-items: center;
        justify-content: center;

        color: #ffffff;

        flex-shrink: 0;
    }

    .date-box strong {
        font-size: 19px;

        line-height: 1;
    }

    .date-box span {
        font-size: 8px;

        text-transform: uppercase;

        margin-top: 3px;
    }

    .lesson-info h3 {
        margin: 0 0 4px;

        font-size: 15px;
    }

    .lesson-info p {
        margin: 0;

        color: #6b7d92;

        font-size: 11px;
    }


    /* =========================================================
       LESSON DETAILS
       ========================================================= */

    .lesson-details {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 9px;
    }

    .lesson-detail {
        display: flex;

        align-items: center;

        gap: 8px;

        padding: 10px;

        background: #091321;

        border-radius: 7px;

        color: #7b8ca0;

        font-size: 10px;
    }

    .lesson-detail i {
        color: #e10600;

        width: 15px;

        text-align: center;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        text-align: center;

        padding: 42px 20px;
    }

    .empty-icon {
        width: 54px;
        height: 54px;

        border-radius: 11px;

        background: #101f32;

        border: 1px solid #1d3149;

        color: #e10600;

        display: flex;

        align-items: center;
        justify-content: center;

        margin: 0 auto 14px;

        font-size: 19px;
    }

    .empty-state h3 {
        margin: 0 0 7px;

        font-size: 14px;
    }

    .empty-state p {
        margin: 0 0 18px;

        color: #617186;

        font-size: 11px;
    }


    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .actions-grid {
        padding: 20px;

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 10px;
    }

    .action-card {
        display: flex;

        align-items: center;

        gap: 11px;

        padding: 14px;

        background: #0e1b2c;

        border: 1px solid #1a2d43;

        border-radius: 10px;

        color: #ffffff;

        transition: 0.25s ease;
    }

    .action-card:hover {
        background: #122238;

        border-color: rgba(225, 6, 0, 0.4);

        transform: translateY(-2px);

        color: #ffffff;

        text-decoration: none;
    }

    .action-icon {
        width: 37px;
        height: 37px;

        flex-shrink: 0;

        border-radius: 8px;

        background: rgba(225, 6, 0, 0.09);

        border: 1px solid rgba(225, 6, 0, 0.18);

        color: #e10600;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 13px;
    }

    .action-text strong {
        display: block;

        font-size: 11px;

        margin-bottom: 3px;
    }

    .action-text span {
        display: block;

        color: #637389;

        font-size: 9px;
    }


    /* =========================================================
       PROGRESS
       ========================================================= */

    .progress-content {
        padding: 22px;
    }

    .progress-header {
        display: flex;

        justify-content: space-between;

        margin-bottom: 11px;
    }

    .progress-header span {
        font-size: 11px;

        color: #7b8ca0;
    }

    .progress-header strong {
        color: #e10600;

        font-size: 13px;
    }

    .progress-bar {
        height: 8px;

        width: 100%;

        background: #162437;

        border-radius: 20px;

        overflow: hidden;
    }

    .progress-fill {
        height: 100%;

        width: @(Model.ProgressPercentage)%;

        background: linear-gradient(
            90deg,
            #b00000,
            #e10600
        );

        border-radius: 20px;

        transition: width 0.5s ease;
    }

    .progress-footer {
        display: flex;

        justify-content: space-between;

        margin-top: 11px;

        color: #596a7e;

        font-size: 10px;
    }


    /* =========================================================
       PAYMENT
       ========================================================= */

    .payment-content {
        padding: 22px;
    }

    .payment-status {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 10px;

        padding: 15px;

        background: #0e1b2c;

        border-radius: 10px;

        border: 1px solid #1a2d43;
    }

    .payment-left {
        display: flex;

        align-items: center;

        gap: 11px;
    }

    .payment-icon {
        width: 39px;
        height: 39px;

        border-radius: 8px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: rgba(225, 6, 0, 0.09);

        color: #e10600;

        flex-shrink: 0;
    }

    .payment-left strong {
        display: block;

        font-size: 11px;
    }

    .payment-left span {
        display: block;

        color: #627388;

        font-size: 9px;

        margin-top: 3px;
    }

    .status-badge {
        padding: 6px 9px;

        border-radius: 20px;

        font-size: 8px;

        font-weight: 700;

        text-transform: uppercase;

        background: rgba(225, 6, 0, 0.10);

        color: #ff4b45;

        border: 1px solid rgba(225, 6, 0, 0.18);

        white-space: nowrap;
    }

    .payment-amounts {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 9px;

        margin-top: 10px;
    }

    .payment-amount {
        padding: 12px;

        background: #091321;

        border-radius: 8px;
    }

    .payment-amount span {
        display: block;

        color: #627388;

        font-size: 9px;

        margin-bottom: 4px;
    }

    .payment-amount strong {
        font-size: 13px;

        color: #ffffff;
    }


    /* =========================================================
       FEEDBACK
       ========================================================= */

    .feedback-content {
        padding: 22px;
    }

    .feedback-box {
        padding: 15px;

        background: #0e1b2c;

        border: 1px solid #1a2d43;

        border-radius: 10px;
    }

    .feedback-box p {
        margin: 0;

        color: #8493a5;

        font-size: 11px;

        line-height: 1.6;
    }

    .feedback-author {
        margin-top: 10px;

        color: #e10600;

        font-size: 10px;

        font-weight: 700;
    }


    /* =========================================================
       BUTTON
       ========================================================= */

    .dashboard-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 10px 17px;

        background: #e10600;

        color: #ffffff;

        border-radius: 8px;

        border: none;

        font-size: 11px;

        font-weight: 700;

        transition: 0.25s ease;
    }

    .dashboard-button:hover {
        background: #ff211a;

        color: #ffffff;

        text-decoration: none;

        transform: translateY(-1px);
    }


    /* =========================================================
       PACKAGE PROMO
       ========================================================= */

    .package-promo {
        margin-top: 20px;

        padding: 22px;

        background:
            linear-gradient(
                135deg,
                rgba(225, 6, 0, 0.15),
                rgba(11, 23, 39, 1)
            );

        border: 1px solid rgba(225, 6, 0, 0.25);

        border-radius: 16px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;
    }

    .package-promo-left {
        display: flex;

        align-items: center;

        gap: 15px;
    }

    .package-promo-icon {
        width: 50px;
        height: 50px;

        flex-shrink: 0;

        border-radius: 11px;

        background: #e10600;

        color: #ffffff;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 20px;

        box-shadow: 0 8px 20px rgba(225, 6, 0, 0.25);
    }

    .package-promo-text h3 {
        margin: 0 0 5px;

        font-size: 15px;

        font-weight: 800;
    }

    .package-promo-text p {
        margin: 0;

        color: #738399;

        font-size: 10px;

        line-height: 1.5;
    }

    .package-promo-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 11px 17px;

        background: #e10600;

        color: #ffffff;

        border-radius: 8px;

        font-size: 11px;

        font-weight: 700;

        white-space: nowrap;

        transition: 0.25s ease;
    }

    .package-promo-button:hover {
        background: #ff211a;

        color: #ffffff;

        text-decoration: none;

        transform: translateY(-2px);
    }


    /* =========================================================
       RESPONSIVE - 1150px
       ========================================================= */

    @@media (max-width: 1150px) {

        .dashboard-layout {
            grid-template-columns: 210px 1fr;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }


    /* =========================================================
       RESPONSIVE - 850px
       ========================================================= */

    @@media (max-width: 850px) {

        .dashboard-page {
            padding: 20px;
        }

        .dashboard-layout {
            grid-template-columns: 1fr;
        }

        .dashboard-sidebar {
            position: static;
        }

        .sidebar-menu {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 5px;
        }

        .sidebar-section-title {
            grid-column: 1 / -1;
        }

        .logout-container {
            grid-column: 1 / -1;
        }
    }


    /* =========================================================
       RESPONSIVE - 650px
       ========================================================= */

    @@media (max-width: 650px) {

        .dashboard-page {
            padding: 15px;
        }

        .dashboard-header {
            flex-direction: column;

            align-items: flex-start;

            gap: 18px;
        }

        .welcome-section h1 {
            font-size: 23px;
        }

        .profile-button {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .lesson-details {
            grid-template-columns: 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }

        .sidebar-menu {
            grid-template-columns: 1fr;
        }

        .sidebar-section-title {
            grid-column: auto;
        }

        .logout-container {
            grid-column: auto;
        }

        .payment-status {
            align-items: flex-start;

            flex-direction: column;
        }

        .status-badge {
            align-self: flex-start;
        }

        .payment-amounts {
            grid-template-columns: 1fr;
        }

        .package-promo {
            flex-direction: column;

            align-items: flex-start;
        }

        .package-promo-button {
            width: 100%;
        }
    }


    /* =========================================================
       RESPONSIVE - 450px
       ========================================================= */

    @@media (max-width: 450px) {

        .dashboard-page {
            padding: 10px;
        }

        .dashboard-header {
            padding: 20px;
        }

        .dashboard-card {
            border-radius: 12px;
        }

        .card-header {
            padding: 16px;
        }

        .empty-state {
            padding: 35px 15px;
        }

        .progress-content,
        .payment-content,
        .feedback-content {
            padding: 16px;
        }

        .actions-grid {
            padding: 16px;
        }

        .stat-card {
            padding: 17px;
        }

        .package-promo {
            padding: 18px;
        }
    }

</style>


<!-- =========================================================
     DASHBOARD PAGE
     ========================================================= -->

<div class="dashboard-page">

    <div class="dashboard-layout">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="dashboard-sidebar">


            <!-- BRAND -->

            <div class="sidebar-brand">

                <h2>
                    TK<span>DRIVING</span>
                </h2>

                <p>
                    Student Portal
                </p>

            </div>


            <!-- MENU -->

            <div class="sidebar-menu">


                <!-- =========================
                     MAIN
                     ========================= -->

                <div class="sidebar-section-title">
                    Main
                </div>


                <!-- Dashboard -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Dashboard")"
                       class="sidebar-link active">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-chart-pie"></i>
                        </span>

                        <span class="sidebar-text">
                            Dashboard
                        </span>

                    </a>

                </div>


                <!-- =========================
                     LEARNING
                     ========================= -->

                <div class="sidebar-section-title">
                    Learning
                </div>


                <!-- Book Lesson -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Create", "Booking")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-calendar-plus"></i>
                        </span>

                        <span class="sidebar-text">
                            Book a Lesson
                        </span>

                    </a>

                </div>


                <!-- My Lessons -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Lessons")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-car-side"></i>
                        </span>

                        <span class="sidebar-text">
                            My Lessons
                        </span>

                    </a>

                </div>


                <!-- Daily Reviews -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Review")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </span>

                        <span class="sidebar-text">
                            Daily Reviews
                        </span>

                    </a>

                </div>


                <!-- Instructor Feedback -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Review")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-comment-dots"></i>
                        </span>

                        <span class="sidebar-text">
                            Instructor Feedback
                        </span>

                    </a>

                </div>


                <!-- Overall Review -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Review")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <span class="sidebar-text">
                            Overall Review
                        </span>

                    </a>

                </div>


                <!-- =========================
                     FINANCE
                     ========================= -->

                <div class="sidebar-section-title">
                    Finance
                </div>


                <!-- BUY PACKAGE -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Package")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </span>

                        <span class="sidebar-text">
                            Buy Package
                        </span>

                    </a>

                </div>


                <!-- Payments -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Payment")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-credit-card"></i>
                        </span>

                        <span class="sidebar-text">
                            Payment History
                        </span>

                    </a>

                </div>


                <!-- =========================
                     ACCOUNT
                     ========================= -->

                <div class="sidebar-section-title">
                    Account
                </div>


                <!-- Profile -->

                <div class="sidebar-item">

                    <a href="@Url.Action("Profile", "Dashboard")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-user"></i>
                        </span>

                        <span class="sidebar-text">
                            My Profile
                        </span>

                    </a>

                </div>


                


                <!-- LOGOUT -->

                <div class="logout-container">

                    @using (Html.BeginForm(
                        "LogOff",
                        "Account",
                        FormMethod.Post,
                        new { style = "margin:0;" }))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-link">

                            <span class="sidebar-icon">

                                <i class="fa-solid fa-right-from-bracket"></i>

                            </span>

                            <span class="sidebar-text">
                                Logout
                            </span>

                        </button>
                    }

                </div>

            </div>

        </aside>


        <!-- =====================================================
             MAIN DASHBOARD
             ===================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="dashboard-header">

                <div class="welcome-section">

                    <h1>
                        Welcome back,
                        <span>@Model.FirstName</span>
                    </h1>

                    <p>
                        Manage your driving lessons, bookings and progress.
                    </p>

                </div>


                <a href="@Url.Action("Profile", "Dashboard")"
                   class="profile-button">

                    <div class="profile-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <div class="profile-text">

                        <strong>
                            My Profile
                        </strong>

                        <span>
                            Student Account
                        </span>

                    </div>

                </a>

            </div>


            <!-- =================================================
                 STATISTICS
                 ================================================= -->

            <div class="stats-grid">


                <!-- TOTAL LESSONS -->

                <div class="stat-card">

                    <div class="stat-icon">

                        <i class="fa-solid fa-road"></i>

                    </div>

                    <h3>
                        @Model.TotalLessons
                    </h3>

                    <p>
                        Total Lessons
                    </p>

                </div>


                <!-- COMPLETED -->

                <div class="stat-card">

                    <div class="stat-icon">

                        <i class="fa-solid fa-circle-check"></i>

                    </div>

                    <h3>
                        @Model.CompletedLessons
                    </h3>

                    <p>
                        Completed Lessons
                    </p>

                </div>


                <!-- REMAINING -->

                <div class="stat-card">

                    <div class="stat-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <h3>
                        @Model.RemainingLessons
                    </h3>

                    <p>
                        Remaining Lessons
                    </p>

                </div>


                <!-- PROGRESS -->

                <div class="stat-card">

                    <div class="stat-icon">

                        <i class="fa-solid fa-chart-line"></i>

                    </div>

                    <h3>
                        @Model.ProgressPercentage%
                    </h3>

                    <p>
                        Overall Progress
                    </p>

                </div>

            </div>


            <!-- =================================================
                 MAIN GRID
                 ================================================= -->

            <div class="dashboard-grid">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div>


                    <!-- =============================================
                         UPCOMING LESSON
                         ============================================= -->

                    <div class="dashboard-card">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-calendar-check"></i>

                                </div>

                                <h2>
                                    Upcoming Lesson
                                </h2>

                            </div>

                            <a href="@Url.Action("Index", "Booking")"
                               class="card-header-link">

                                View All

                            </a>

                        </div>


                        @if (Model.HasUpcomingLesson)
                        {

                            <div class="lesson-content">

                                <div class="lesson-box">


                                    <!-- LESSON DATE -->

                                    <div class="lesson-date">

                                        <div class="date-box">

                                            @if (Model.UpcomingLessonDate.HasValue)
                                            {
                                                <strong>
                                                    @Model.UpcomingLessonDate.Value.Day
                                                </strong>

                                                <span>
                                                    @Model.UpcomingLessonDate.Value.ToString("MMM")
                                                </span>
                                            }
                                            else
                                            {
                                                <strong>
                                                    --
                                                </strong>

                                                <span>
                                                    DATE
                                                </span>
                                            }

                                        </div>


                                        <div class="lesson-info">

                                            <h3>

                                                @(string.IsNullOrEmpty(Model.UpcomingLessonType)
                                                    ? "Driving Lesson"
                                                    : Model.UpcomingLessonType)

                                            </h3>

                                            <p>

                                                @if (Model.UpcomingLessonDate.HasValue)
                                                {
                                                    @Model.UpcomingLessonDate.Value.ToString("dddd, dd MMMM yyyy")
                                                }

                                            </p>

                                        </div>

                                    </div>


                                    <!-- LESSON DETAILS -->

                                    <div class="lesson-details">


                                        <!-- TIME -->

                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-clock"></i>

                                            <span>

                                                @(string.IsNullOrEmpty(Model.UpcomingLessonTime)
                                                    ? "Time not available"
                                                    : Model.UpcomingLessonTime)

                                            </span>

                                        </div>


                                        <!-- INSTRUCTOR -->

                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-user-tie"></i>

                                            <span>

                                                @(string.IsNullOrEmpty(Model.UpcomingInstructor)
                                                    ? "Instructor not assigned"
                                                    : Model.UpcomingInstructor)

                                            </span>

                                        </div>


                                        <!-- VEHICLE -->

                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-car"></i>

                                            <span>

                                                @(string.IsNullOrEmpty(Model.UpcomingVehicle)
                                                    ? "Vehicle not assigned"
                                                    : Model.UpcomingVehicle)

                                            </span>

                                        </div>


                                        <!-- LOCATION -->

                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-location-dot"></i>

                                            <span>

                                                @(string.IsNullOrEmpty(Model.UpcomingLocation)
                                                    ? "Location not available"
                                                    : Model.UpcomingLocation)

                                            </span>

                                        </div>

                                    </div>


                                    <!-- VIEW LESSON BUTTON -->

                                    <div style="margin-top:15px;">

                                        <a href="@Url.Action("Details", "Booking", new { id = Model.UpcomingLessonID })"
                                           class="dashboard-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View Lesson

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }
                        else
                        {

                            <!-- NO UPCOMING LESSON -->

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-regular fa-calendar-xmark"></i>

                                </div>

                                <h3>
                                    No Upcoming Lessons
                                </h3>

                                <p>
                                    You currently don't have a lesson scheduled.
                                </p>

                                <a href="@Url.Action("Create", "Booking")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-plus"></i>

                                    Book a Lesson

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =============================================
                         PACKAGE PROMO
                         ============================================= -->

                    <div class="package-promo">

                        <div class="package-promo-left">

                            <div class="package-promo-icon">

                                <i class="fa-solid fa-box-open"></i>

                            </div>

                            <div class="package-promo-text">

                                <h3>
                                    Ready for More Driving Lessons?
                                </h3>

                                <p>
                                    Choose a lesson package that suits your
                                    training needs and purchase it from our
                                    available packages.
                                </p>

                            </div>

                        </div>

                        <a href="@Url.Action("Index", "Package")"
                           class="package-promo-button">

                            <i class="fa-solid fa-cart-shopping"></i>

                            View Packages

                        </a>

                    </div>


                    <!-- =============================================
                         QUICK ACTIONS
                         ============================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-bolt"></i>

                                </div>

                                <h2>
                                    Quick Actions
                                </h2>

                            </div>

                        </div>


                        <div class="actions-grid">


                            <!-- BOOK LESSON -->

                            <a href="@Url.Action("Create", "Booking")"
                               class="action-card">

                                <div class="action-icon">

                                    <i class="fa-solid fa-calendar-plus"></i>

                                </div>

                                <div class="action-text">

                                    <strong>
                                        Book Lesson
                                    </strong>

                                    <span>
                                        Schedule a driving lesson
                                    </span>

                                </div>

                            </a>


                            <!-- BUY PACKAGE -->

                            <a href="@Url.Action("Index", "Package")"
                               class="action-card">

                                <div class="action-icon">

                                    <i class="fa-solid fa-box-open"></i>

                                </div>

                                <div class="action-text">

                                    <strong>
                                        Buy Package
                                    </strong>

                                    <span>
                                        View and purchase lesson packages
                                    </span>

                                </div>

                            </a>


                            <!-- PAYMENTS -->

                            <a href="@Url.Action("Index", "Payment")"
                               class="action-card">

                                <div class="action-icon">

                                    <i class="fa-solid fa-credit-card"></i>

                                </div>

                                <div class="action-text">

                                    <strong>
                                        Payments
                                    </strong>

                                    <span>
                                        Manage your payments
                                    </span>

                                </div>

                            </a>


                            <!-- MY LESSONS -->

                            <a href="@Url.Action("Index", "Lessons")"
                               class="action-card">

                                <div class="action-icon">

                                    <i class="fa-solid fa-car-side"></i>

                                </div>

                                <div class="action-text">

                                    <strong>
                                        My Lessons
                                    </strong>

                                    <span>
                                        View your lessons
                                    </span>

                                </div>

                            </a>


                            <!-- REVIEWS -->

                            <a href="@Url.Action("Index", "Review")"
                               class="action-card">

                                <div class="action-icon">

                                    <i class="fa-solid fa-star"></i>

                                </div>

                                <div class="action-text">

                                    <strong>
                                        Reviews
                                    </strong>

                                    <span>
                                        Review your lessons
                                    </span>

                                </div>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RIGHT COLUMN
                     ================================================= -->

                <div>


                    <!-- =============================================
                         LESSON PROGRESS
                         ============================================= -->

                    <div class="dashboard-card">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-chart-simple"></i>

                                </div>

                                <h2>
                                    Lesson Progress
                                </h2>

                            </div>

                        </div>


                        <div class="progress-content">

                            <div class="progress-header">

                                <span>
                                    Course Progress
                                </span>

                                <strong>
                                    @Model.ProgressPercentage%
                                </strong>

                            </div>


                            <div class="progress-bar">

                                <div class="progress-fill"></div>

                            </div>


                            <div class="progress-footer">

                                <span>
                                    @Model.CompletedLessons completed
                                </span>

                                <span>
                                    @Model.TotalLessons total
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         PAYMENT STATUS
                         ============================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-wallet"></i>

                                </div>

                                <h2>
                                    Payment Status
                                </h2>

                            </div>

                            <a href="@Url.Action("Index", "Payment")"
                               class="card-header-link">

                                View

                            </a>

                        </div>


                        <div class="payment-content">

                            <div class="payment-status">


                                <div class="payment-left">

                                    <div class="payment-icon">

                                        <i class="fa-solid fa-credit-card"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Course Payment
                                        </strong>

                                        <span>
                                            Current payment status
                                        </span>

                                    </div>

                                </div>


                                <div class="status-badge">

                                    @(string.IsNullOrEmpty(Model.PaymentStatus)
                                        ? "Pending"
                                        : Model.PaymentStatus)

                                </div>

                            </div>


                            <!-- PAYMENT AMOUNTS -->

                            <div class="payment-amounts">

                                <div class="payment-amount">

                                    <span>
                                        Total Paid
                                    </span>

                                    <strong>
                                        R @Model.TotalPaid.ToString("N2")
                                    </strong>

                                </div>


                                <div class="payment-amount">

                                    <span>
                                        Outstanding
                                    </span>

                                    <strong>
                                        R @Model.OutstandingAmount.ToString("N2")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         DAILY REVIEW
                         ============================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-clipboard-check"></i>

                                </div>

                                <h2>
                                    Daily Review
                                </h2>

                            </div>

                        </div>


                        @if (Model.HasPendingReview)
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-solid fa-clipboard-list"></i>

                                </div>

                                <h3>
                                    Lesson Review Pending
                                </h3>

                                <p>
                                    You have a completed lesson waiting for your review.
                                </p>

                                <a href="@Url.Action("Create", "Review", new { id = Model.ReviewLessonID })"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                    Complete Review

                                </a>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-solid fa-circle-check"></i>

                                </div>

                                <h3>
                                    No Pending Reviews
                                </h3>

                                <p>
                                    You are all caught up with your lesson reviews.
                                </p>

                                <a href="@Url.Action("Index", "Review")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-arrow-right"></i>

                                    View Reviews

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =============================================
                         INSTRUCTOR FEEDBACK
                         ============================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">

                                    <i class="fa-solid fa-comment-dots"></i>

                                </div>

                                <h2>
                                    Instructor Feedback
                                </h2>

                            </div>

                            <a href="@Url.Action("Index", "Review")"
                               class="card-header-link">

                                View All

                            </a>

                        </div>


                        @if (Model.HasInstructorFeedback &&
                             !string.IsNullOrEmpty(Model.LatestFeedback))
                        {

                            <div class="feedback-content">

                                <div class="feedback-box">

                                    <p>
                                        "@Model.LatestFeedback"
                                    </p>

                                    <div class="feedback-author">

                                        <i class="fa-solid fa-user-tie"></i>

                                        Instructor Feedback

                                    </div>

                                </div>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-regular fa-comment"></i>

                                </div>

                                <h3>
                                    No Feedback Yet
                                </h3>

                                <p>
                                    Your instructor feedback will appear here after your lessons.
                                </p>

                            </div>

                        }

                    </div>

                </div>

            </div>

        </main>

    </div>

</div>


<!-- =========================================================
     SCRIPTS
     ========================================================= -->

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}