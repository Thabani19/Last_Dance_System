                                            </span>

                                        </div>


                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-user-tie"></i>

                                            <span>
                                                @Model.UpcomingInstructor
                                            </span>

                                        </div>


                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-car"></i>

                                            <span>
                                                @Model.UpcomingVehicle
                                            </span>

                                        </div>


                                        <div class="lesson-detail">

                                            <i class="fa-solid fa-location-dot"></i>

                                            <span>
                                                @Model.UpcomingLocation
                                            </span>

                                        </div>

                                    </div>


                                    <div style="margin-top:15px;">

                                        <a href="@Url.Action("Index", "Lessons")"
                                           class="dashboard-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View Lesson

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-regular fa-calendar-xmark"></i>

                                </div>

                                <h3>
                                    No Upcoming Lessons
                                </h3>

                                <p>
                                    You currently don't have a lesson scheduled.
                                </p>

                                <a href="@Url.Action("Create", "Booking")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-plus"></i>

                                    Book a Lesson

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         CURRENT PACKAGE
                         ================================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-box-open"></i>
                                </div>

                                <h2>
                                    Current Package
                                </h2>

                            </div>

                            <a href="@Url.Action("MyPackages", "Package")"
                               class="card-header-link">

                                View All

                            </a>

                        </div>


                        @if (Model.HasActivePackage)
                        {

                            <div class="package-content">

                                <div class="package-main">


                                    <div class="package-heading">

                                        <div class="package-icon">

                                            <i class="fa-solid fa-box"></i>

                                        </div>

                                        <div>

                                            <h3>
                                                @Model.CurrentPackageName
                                            </h3>

                                            <p>
                                                Your currently active lesson package
                                            </p>

                                        </div>

                                    </div>


                                    <div class="package-details">


                                        <div class="package-detail">

                                            <span class="label">
                                                Lessons Purchased
                                            </span>

                                            <strong>
                                                @Model.CurrentPackageLessons
                                            </strong>

                                        </div>


                                        <div class="package-detail">

                                            <span class="label">
                                                Lessons Remaining
                                            </span>

                                            <strong>
                                                @Model.CurrentPackageLessonsRemaining
                                            </strong>

                                        </div>


                                        <div class="package-detail">

                                            <span class="label">
                                                Package Price
                                            </span>

                                            <strong>
                                                R @(Model.CurrentPackagePrice.ToString("N2"))
                                            </strong>

                                        </div>


                                        <div class="package-detail">

                                            <span class="label">
                                                Payment Status
                                            </span>

                                            <strong>

                                                <span class="package-status">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    @Model.CurrentPackagePaymentStatus

                                                </span>

                                            </strong>

                                        </div>

                                    </div>


                                    <!-- PACKAGE PROGRESS -->

                                    <div class="package-progress">

                                        <div class="package-progress-header">

                                            <span>
                                                Package Usage
                                            </span>

                                            <strong>
                                                @Model.PackageProgressPercentage%
                                            </strong>

                                        </div>


                                        <div class="package-progress-bar">

                                            <div class="package-progress-fill"></div>

                                        </div>

                                    </div>


                                    <div class="package-actions">

                                        <a href="@Url.Action("MyPackages", "Package")"
                                           class="dashboard-button">

                                            <i class="fa-solid fa-eye"></i>

                                            View My Package

                                        </a>


                                        <a href="@Url.Action("Index", "Package")"
                                           class="secondary-button">

                                            <i class="fa-solid fa-plus"></i>

                                            Browse Packages

                                        </a>

                                    </div>

                                </div>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-solid fa-box-open"></i>

                                </div>

                                <h3>
                                    No Active Package
                                </h3>

                                <p>
                                    You don't currently have an active lesson package.
                                    Choose a package to continue your driving training.
                                </p>

                                <a href="@Url.Action("Index", "Package")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-cart-shopping"></i>

                                    Browse Packages

                                </a>

                            </div>

                        }

                    </div>

                </div>


                <!-- =================================================
                     RIGHT COLUMN
                     ================================================= -->

                <div>


                    <!-- =================================================
                         LESSON PROGRESS
                         ================================================= -->

                    <div class="dashboard-card">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-chart-simple"></i>
                                </div>

                                <h2>
                                    Lesson Progress
                                </h2>

                            </div>

                        </div>


                        <div class="progress-content">

                            <div class="progress-header">

                                <span>
                                    Course Progress
                                </span>

                                <strong>
                                    @Model.ProgressPercentage%
                                </strong>

                            </div>


                            <div class="progress-bar">

                                <div class="progress-fill"></div>

                            </div>


                            <div class="progress-footer">

                                <span>
                                    @Model.CompletedLessons completed
                                </span>

                                <span>
                                    @Model.TotalLessons total
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         PAYMENT
                         ================================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-wallet"></i>
                                </div>

                                <h2>
                                    Payment Status
                                </h2>

                            </div>


                            <a href="@Url.Action("Index", "Payment")"
                               class="card-header-link">

                                View

                            </a>

                        </div>


                        <div class="payment-content">

                            <div class="payment-status">

                                <div class="payment-left">

                                    <div class="payment-icon">

                                        <i class="fa-solid fa-credit-card"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Current Package
                                        </strong>

                                        <span>
                                            Current payment status
                                        </span>

                                    </div>

                                </div>


                                <div class="status-badge @(Model.PaymentStatus == "Paid" ? "paid" : "")">

                                    @(string.IsNullOrEmpty(Model.PaymentStatus)
                                        ? "Pending"
                                        : Model.PaymentStatus)

                                </div>

                            </div>


                            <div class="payment-amounts">

                                <div class="payment-amount">

                                    <span>
                                        Total Paid
                                    </span>

                                    <strong>
                                        R @(Model.TotalPaid.ToString("N2"))
                                    </strong>

                                </div>


                                <div class="payment-amount">

                                    <span>
                                        Outstanding
                                    </span>

                                    <strong>
                                        R @(Model.OutstandingAmount.ToString("N2"))
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         DAILY REVIEW
                         ================================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-clipboard-check"></i>
                                </div>

                                <h2>
                                    Daily Review
                                </h2>

                            </div>

                        </div>


                        @if (Model.HasPendingReview)
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-solid fa-clipboard-list"></i>

                                </div>

                                <h3>
                                    Lesson Review Pending
                                </h3>

                                <p>
                                    You have a completed lesson waiting for your review.
                                </p>

                                <a href="@Url.Action(
                                    "Create",
                                    "Review",
                                    new { id = Model.ReviewLessonID })"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                    Complete Review

                                </a>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-solid fa-circle-check"></i>

                                </div>

                                <h3>
                                    No Pending Reviews
                                </h3>

                                <p>
                                    You are all caught up with your lesson reviews.
                                </p>

                                <a href="@Url.Action("Index", "Review")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-arrow-right"></i>

                                    View Reviews

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         INSTRUCTOR FEEDBACK
                         ================================================= -->

                    <div class="dashboard-card"
                         style="margin-top:20px;">

                        <div class="card-header">

                            <div class="card-title">

                                <div class="card-title-icon">
                                    <i class="fa-solid fa-comment-dots"></i>
                                </div>

                                <h2>
                                    Instructor Feedback
                                </h2>

                            </div>


                            <a href="@Url.Action("Index", "Lessons")"
                               class="card-header-link">

                                View Lessons

                            </a>

                        </div>


                        @if (Model.HasInstructorFeedback)
                        {

                            <div class="feedback-content">

                                <div class="feedback-box">

                                    <p>
                                        "@Model.LatestFeedback"
                                    </p>


                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.FeedbackInstructor))
                                    {

                                        <div class="feedback-author">

                                            <i class="fa-solid fa-user-tie"></i>

                                            @Model.FeedbackInstructor

                                        </div>

                                    }


                                    @if (Model.FeedbackDate.HasValue)
                                    {

                                        <div class="feedback-date">

                                            <i class="fa-regular fa-calendar"></i>

                                            @Model.FeedbackDate.Value.ToString(
                                                "dd MMMM yyyy")

                                        </div>

                                    }


                                    <a href="@Url.Action("Index", "Lessons")"
                                       class="feedback-view-button">

                                        <i class="fa-solid fa-eye"></i>

                                        View Lesson Feedback

                                    </a>

                                </div>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="fa-regular fa-comment"></i>

                                </div>

                                <h3>
                                    No Feedback Yet
                                </h3>

                                <p>
                                    Your instructor feedback will appear here
                                    after your lessons.
                                </p>

                                <a href="@Url.Action("Index", "Lessons")"
                                   class="dashboard-button">

                                    <i class="fa-solid fa-car-side"></i>

                                    View My Lessons

                                </a>

                            </div>

                        }

                    </div>

                </div>

            </div>

        </main>

    </div>

</div>