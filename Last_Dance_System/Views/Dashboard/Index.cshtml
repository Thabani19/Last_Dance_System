                        <span class="sidebar-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </span>

                        <span class="sidebar-text">
                            Buy Package
                        </span>

                    </a>

                </div>


                <div class="sidebar-item">

                    <a href="@Url.Action("MyPackages", "Package")"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-box"></i>
                        </span>

                        <span class="sidebar-text">
                            My Packages
                        </span>

                    </a>

                </div>


                <div class="sidebar-item">

                    <a href="@Url.Action("Index", "Payment")"
