                    ================================================= -->

                    <div class="lessons-list">

                        @foreach (var booking in cancelledLessons)
                        {

                            var schedule = booking.LessonSchedule;

                            string cancellationReason =
                                booking.Notes;

                            if (!string.IsNullOrWhiteSpace(
                                cancellationReason))
                            {

                                const string prefix =
                                    "Cancelled by instructor. Reason:";

                                if (cancellationReason.StartsWith(
                                    prefix,
                                    StringComparison.OrdinalIgnoreCase))
                                {

                                    cancellationReason =
                                        cancellationReason
                                            .Substring(prefix.Length)
                                            .Trim();

                                }

                            }


                            <div class="lesson-list-item">

                                <div class="list-date cancelled">

                                    <strong>
                                        @schedule.LessonDate.Day
                                    </strong>

                                    <span>
                                        @schedule.LessonDate.ToString("MMM")
                                    </span>

                                </div>


                                <div class="list-main">

                                    <strong>

                                        @(schedule.LessonType != null
                                        ? schedule.LessonType.LessonTypeName
                                        : "Driving Lesson")

                                    </strong>

                                    <span>

                                        @schedule.LessonDate.ToString(
                                            "dddd, dd MMMM yyyy")

                                    </span>

                                </div>


                                <div class="list-info">

                                    <span class="list-info-label">
                                        Time
                                    </span>

                                    <span class="list-info-value">

                                        <i class="fa-solid fa-clock"></i>

                                        @schedule.StartTime.ToString(@"hh\:mm")
                                        -
                                        @schedule.EndTime.ToString(@"hh\:mm")

                                    </span>

                                </div>


                                <div class="list-info">

                                    <span class="list-info-label">
                                        Instructor
                                    </span>

                                    <span class="list-info-value">

                                        <i class="fa-solid fa-user-tie"></i>

                                        @if (schedule.Instructor != null)
                                        {
                                            @schedule.Instructor.FirstName
                                            @(" ")
                                            @schedule.Instructor.LastName
                                        }
                                        else
                                        {
                                            @:Not assigned
                                        }

                                    </span>

                                </div>


                                <div class="list-status">

                                    <span class="status status-cancelled">

                                        Cancelled

                                    </span>

                                </div>


                                <div class="list-action">

                                    <a href="@Url.Action(
                                        "Details",
                                        "Lessons",
                                        new { id = booking.BookingId })"
                                       class="list-view-button"
                                       title="View Details">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>

                                </div>

                            </div>

                        }

                    </div>

                }
                else
                {

                    <div class="section-empty">

                        <i class="fa-regular fa-circle-xmark"></i>

                        <p>
                            You have no cancelled lessons.
                        </p>

                    </div>

                }

            </div>

        }

    </div>

</div>


<script>

    /* ============================================================
       CARD / LIST VIEW SWITCHER
       ============================================================ */

    function setLessonView(view) {

        var cardButton =
            document.getElementById("cardViewButton");

        var listButton =
            document.getElementById("listViewButton");


        if (view === "list") {

            document.body.classList.add("list-mode");

            cardButton.classList.remove("active");

            listButton.classList.add("active");

            sessionStorage.setItem(
                "myLessonsView",
                "list"
            );

        }
        else {

            document.body.classList.remove("list-mode");

            listButton.classList.remove("active");

            cardButton.classList.add("active");

            sessionStorage.setItem(
                "myLessonsView",
                "card"
            );

        }

    }


    /* ============================================================
       LOAD SAVED VIEW
       ============================================================ */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var savedView =
                sessionStorage.getItem("myLessonsView");


            if (savedView === "list") {

                setLessonView("list");

            }
            else {

                setLessonView("card");

            }

        }
    );

</script>

