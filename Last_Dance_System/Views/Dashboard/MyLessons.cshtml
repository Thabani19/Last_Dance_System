
@model IEnumerable<Last_Dance_System.Models.Booking>

@{
    Layout = null;
    ViewBag.Title = "My Lessons";

    var allLessons = Model ??
        Enumerable.Empty<Last_Dance_System.Models.Booking>();

    // ============================================================
    // UPCOMING / BOOKED
    // ============================================================

    var bookedLessons = allLessons
        .Where(b =>
            !string.Equals(
                b.Status,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase)
            &&
            !string.Equals(
                b.Status,
                "Completed",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(b => b.LessonSchedule.LessonDate)
        .ThenBy(b => b.LessonSchedule.StartTime)
        .ToList();

    // ============================================================
    // COMPLETED
    // ============================================================

    var completedLessons = allLessons
        .Where(b =>
            string.Equals(
                b.Status,
                "Completed",
                StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.LessonSchedule.LessonDate)
        .ThenByDescending(b => b.LessonSchedule.StartTime)
        .ToList();

    // ============================================================
    // CANCELLED
    // ============================================================

    var cancelledLessons = allLessons
        .Where(b =>
            string.Equals(
                b.Status,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.LessonSchedule.LessonDate)
        .ThenByDescending(b => b.LessonSchedule.StartTime)
        .ToList();

    var totalLessons = allLessons.Count();
}

