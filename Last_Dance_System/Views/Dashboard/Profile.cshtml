@model Last_Dance_System.Models.Registration

@{
    ViewBag.Title = "My Profile";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: white;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    /* ============================================================
       PAGE
       ============================================================ */

    .profile-page {
        min-height: calc(100vh - 50px);
        padding: 35px;
        background: radial-gradient( circle at 80% 10%, rgba(225, 6, 0, 0.08), transparent 30% ), linear-gradient( 135deg, #07111f 0%, #0a1626 50%, #06101c 100% );
    }

    .profile-container {
        max-width: 1050px;
        margin: 0 auto;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 25px 28px;
        margin-bottom: 20px;
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e10600;
        color: white;
        font-size: 21px;
    }

    .profile-header h1 {
        margin: 0 0 5px;
        font-size: 25px;
        font-weight: 800;
    }

    .profile-header p {
        margin: 0;
        color: #6f8196;
        font-size: 11px;
    }


    /* ============================================================
       PROFILE CARD
       ============================================================ */

    .profile-card {
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }


    /* ============================================================
       PROFILE TOP
       ============================================================ */

    .profile-top {
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 18px;
        border-bottom: 1px solid #17283d;
        background: linear-gradient( 135deg, rgba(225,6,0,.08), transparent );
    }

    .profile-avatar {
        width: 75px;
        height: 75px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #e10600;
        color: white;
        font-size: 28px;
        font-weight: 800;
    }

    .profile-name h2 {
        margin: 0 0 5px;
        font-size: 21px;
        font-weight: 800;
    }

    .profile-name p {
        margin: 0;
        color: #6f8196;
        font-size: 11px;
    }


    /* ============================================================
       INFORMATION
       ============================================================ */

    .profile-body {
        padding: 28px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .section-title-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(225,6,0,.10);
        color: #e10600;
    }

    .section-title h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 800;
    }

    .section-title span {
        display: block;
        margin-top: 2px;
        color: #637389;
        font-size: 9px;
    }


    /* ============================================================
       INFORMATION GRID
       ============================================================ */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .info-item {
        padding: 15px;
        background: #091321;
        border: 1px solid #13243a;
        border-radius: 10px;
        min-height: 72px;
    }

    .info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #687b90;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }

        .info-label i {
            color: #e10600;
        }

    .info-value {
        color: white;
        font-size: 12px;
        font-weight: 600;
        word-break: break-word;
    }


    /* ============================================================
       SUCCESS MESSAGE
       ============================================================ */

    .success-message {
        margin-bottom: 20px;
        padding: 13px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(0,180,100,.08);
        border: 1px solid rgba(0,180,100,.20);
        border-radius: 9px;
        color: #38d996;
        font-size: 11px;
        font-weight: 600;
    }

        .success-message i {
            font-size: 14px;
        }


    /* ============================================================
       ACTION BUTTONS
       ============================================================ */

    .profile-actions {
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #17283d;
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .action-button {
        min-width: 180px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 9px;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        transition: .25s ease;
    }


    /* EDIT */

    .edit-button {
        background: #e10600;
        border: 1px solid #e10600;
        color: white;
    }

        .edit-button:hover {
            background: #ff211a;
            border-color: #ff211a;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* DASHBOARD */

    .dashboard-button {
        background: #101f32;
        border: 1px solid #1d3149;
        color: white;
    }

        .dashboard-button:hover {
            background: #172b43;
            border-color: #e10600;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 700px) {

        .profile-page {
            padding: 15px;
        }

        .profile-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .profile-top {
            padding: 22px;
        }

        .profile-body {
            padding: 20px;
        }

        .profile-actions {
            flex-direction: column;
        }

        .action-button {
            width: 100%;
        }
    }
</style>


<div class="profile-page">

    <div class="profile-container">


        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="profile-header">

            <div class="header-left">

                <div class="header-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h1>
                        My Profile
                    </h1>

                    <p>
                        View and manage your personal information.
                    </p>

                </div>

            </div>

        </div>


        <!-- ========================================================
             SUCCESS MESSAGE
             ======================================================== -->

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="success-message">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    @TempData["ProfileSuccess"]
                </span>

            </div>
        }


        <!-- ========================================================
             PROFILE CARD
             ======================================================== -->

        <div class="profile-card">


            <!-- ====================================================
                 PROFILE HEADER
                 ==================================================== -->

            <div class="profile-top">

                <div class="profile-avatar">

                    @if (!string.IsNullOrEmpty(Model.FirstName))
                    {
                        @Model.FirstName.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        @:U
                    }

                </div>


                <div class="profile-name">

                    <h2>

                        @Model.FirstName
                        @(" ")
                        @Model.LastName

                    </h2>

                    <p>
                        Student Profile
                    </p>

                </div>

            </div>


            <!-- ====================================================
                 PROFILE INFORMATION
                 ==================================================== -->

            <div class="profile-body">


                <div class="section-title">

                    <div class="section-title-icon">

                        <i class="fa-solid fa-id-card"></i>

                    </div>

                    <div>

                        <h3>
                            Personal Information
                        </h3>

                        <span>
                            Your registered student information
                        </span>

                    </div>

                </div>


                <div class="info-grid">


                    <!-- FIRST NAME -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-user"></i>

                            First Name

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.FirstName)
                                ? "Not provided"
                                : Model.FirstName)

                        </div>

                    </div>


                    <!-- LAST NAME -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-user"></i>

                            Last Name

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.LastName)
                                ? "Not provided"
                                : Model.LastName)

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-envelope"></i>

                            Email Address

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Email)
                                ? "Not provided"
                                : Model.Email)

                        </div>

                    </div>


                    <!-- PHONE -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-phone"></i>

                            Phone Number

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Phone)
                                ? "Not provided"
                                : Model.Phone)

                        </div>

                    </div>


                    <!-- GENDER -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-venus-mars"></i>

                            Gender

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Gender)
                                ? "Not provided"
                                : Model.Gender)

                        </div>

                    </div>


                    <!-- DATE OF BIRTH -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-cake-candles"></i>

                            Date of Birth

                        </div>

                        <div class="info-value">

                            @Model.DateOfBirth.ToString("dd MMMM yyyy")

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div class="info-item"
                         style="grid-column: 1 / -1;">

                        <div class="info-label">

                            <i class="fa-solid fa-location-dot"></i>

                            Address

                        </div>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Address)
                                ? "Not provided"
                                : Model.Address)

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     ACTION BUTTONS
                     ================================================= -->

                <div class="profile-actions">


                    <!-- EDIT PROFILE -->

                    <a href="@Url.Action("EditProfile", "Dashboard")"
                       class="action-button edit-button">

                        <i class="fa-solid fa-pen-to-square"></i>

                        Edit Profile

                    </a>


                    <!-- BACK TO DASHBOARD -->

                    <a href="@Url.Action("Index", "Dashboard")"
                       class="action-button dashboard-button">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Dashboard

                    </a>


                </div>


            </div>

        </div>

    </div>

</div>