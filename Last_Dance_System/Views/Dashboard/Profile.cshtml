
@model Last_Dance_System.Models.Registration

@{
    Layout = null;
    ViewBag.Title = "My Profile";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    /* =========================================================
       LAST DANCE - STUDENT PROFILE
       PROFESSIONAL WHITE + BLUE THEME
       ========================================================= */


    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }


    body {
        margin: 0;
        background: #f5f8fc !important;
        color: #1f2937;
        font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .profile-page {
        min-height: calc(100vh - 100px);
        padding: 40px 20px 60px;
        background: #f5f8fc !important;
        color: #1f2937;
    }


    .profile-container {
        max-width: 1050px;
        margin: 0 auto;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .profile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 25px 28px;
        margin-bottom: 22px;
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 16px;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.06);
    }


    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    /* HEADER ICON */

    .header-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eaf3ff;
        color: #0d6efd;
        font-size: 21px;
    }


    .profile-header h1 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 26px;
        font-weight: 800;
    }


    .profile-header p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
    }


    /* =========================================================
       SUCCESS MESSAGE
       ========================================================= */

    .success-message {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding: 13px 16px;
        background: #e9f8f0;
        border: 1px solid #a8dfc1;
        border-radius: 10px;
        color: #146c43;
        font-size: 12px;
        font-weight: 600;
    }


        .success-message i {
            font-size: 15px;
        }


    /* =========================================================
       PROFILE CARD
       ========================================================= */

    .profile-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 16px;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.06);
    }


    /* =========================================================
       PROFILE TOP
       ========================================================= */

    .profile-top {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 30px;
        background: linear-gradient( 135deg, #f8fbff 0%, #eaf3ff 100% );
        border-bottom: 1px solid #dce7f2;
    }


    /* AVATAR */

    .profile-avatar {
        width: 78px;
        height: 78px;
        min-width: 78px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #0d6efd;
        color: #ffffff;
        font-size: 29px;
        font-weight: 800;
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.20);
    }


    .profile-name h2 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 22px;
        font-weight: 800;
    }


    .profile-name p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
    }


    /* =========================================================
       PROFILE BODY
       ========================================================= */

    .profile-body {
        padding: 30px;
    }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }


    .section-title-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eaf3ff;
        color: #0d6efd;
        font-size: 14px;
    }


    .section-title h3 {
        margin: 0;
        color: #172033;
        font-size: 15px;
        font-weight: 800;
    }


    .section-title span {
        display: block;
        margin-top: 2px;
        color: #6b7280;
        font-size: 10px;
    }


    /* =========================================================
       INFORMATION GRID
       ========================================================= */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }


    /* =========================================================
       INFORMATION ITEM
       ========================================================= */

    .info-item {
        min-height: 76px;
        padding: 15px 16px;
        background: #f8fafc;
        border: 1px solid #e1e8f0;
        border-radius: 10px;
        transition: all 0.2s ease;
    }


        .info-item:hover {
            background: #f8fbff;
            border-color: #b6d4fe;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
        }


    /* =========================================================
       INFORMATION LABEL
       ========================================================= */

    .info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #6b7280;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }


        .info-label i {
            color: #0d6efd;
            width: 14px;
            text-align: center;
        }


    /* =========================================================
       INFORMATION VALUE
       ========================================================= */

    .info-value {
        color: #172033;
        font-size: 13px;
        font-weight: 600;
        word-break: break-word;
    }


    /* =========================================================
       ACTION BUTTON AREA
       ========================================================= */

    .profile-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #e1e8f0;
    }


    /* =========================================================
       ACTION BUTTON
       ========================================================= */

    .action-button {
        min-width: 190px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s ease;
    }


    /* =========================================================
       EDIT PROFILE
       ========================================================= */

    .edit-button {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: #ffffff !important;
    }


        .edit-button:hover {
            background: #084298;
            border-color: #084298;
            color: #ffffff !important;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(13, 110, 253, .20);
        }


    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    .dashboard-button {
        background: #ffffff;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
    }


        .dashboard-button:hover {
            background: #eaf3ff;
            border-color: #0d6efd;
            color: #084298 !important;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 700px) {

        .profile-page {
            padding: 20px 12px 40px;
        }


        .profile-header {
            padding: 22px;
            align-items: flex-start;
        }


            .profile-header h1 {
                font-size: 22px;
            }


        .profile-top {
            padding: 24px;
            align-items: flex-start;
        }


        .profile-avatar {
            width: 65px;
            height: 65px;
            min-width: 65px;
            border-radius: 15px;
            font-size: 24px;
        }


        .profile-name h2 {
            font-size: 19px;
        }


        .profile-body {
            padding: 22px;
        }


        .info-grid {
            grid-template-columns: 1fr;
        }


        .profile-actions {
            flex-direction: column;
        }


        .action-button {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL MOBILE
       ========================================================= */

    @@media (max-width: 450px) {

        .profile-top {
            flex-direction: column;
            align-items: flex-start;
        }


        .header-left {
            align-items: flex-start;
        }


        .header-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            font-size: 18px;
        }
    }
</style>


<div class="profile-page">

    <div class="profile-container">


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="profile-header">

            <div class="header-left">

                <div class="header-icon">

                    <i class="fa-solid fa-user"></i>

                </div>


                <div>

                    <h1>
                        My Profile
                    </h1>

                    <p>
                        View and manage your personal information.
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->

        @if (TempData["ProfileSuccess"] != null)
        {

            <div class="success-message">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    @TempData["ProfileSuccess"]
                </span>

            </div>

        }


        <!-- =====================================================
             PROFILE CARD
             ===================================================== -->

        <div class="profile-card">


            <!-- =================================================
                 PROFILE TOP
                 ================================================= -->

            <div class="profile-top">

                <div class="profile-avatar">

                    @if (!string.IsNullOrEmpty(Model.FirstName))
                    {
                        @Model.FirstName.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        @:U
                    }

                </div>


                <div class="profile-name">

                    <h2>

                        @Model.FirstName
                        @(" ")
                        @Model.LastName

                    </h2>

                    <p>
                        Student Profile
                    </p>

                </div>

            </div>


            <!-- =================================================
                 PROFILE INFORMATION
                 ================================================= -->

            <div class="profile-body">


                <!-- SECTION TITLE -->

                <div class="section-title">

                    <div class="section-title-icon">

                        <i class="fa-solid fa-id-card"></i>

                    </div>


                    <div>

                        <h3>
                            Personal Information
                        </h3>

                        <span>
                            Your registered student information
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     INFORMATION GRID
                     ================================================= -->

                <div class="info-grid">


                    <!-- FIRST NAME -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-user"></i>

                            First Name

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.FirstName)
                                ? "Not provided"
                                : Model.FirstName)

                        </div>

                    </div>


                    <!-- LAST NAME -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-user"></i>

                            Last Name

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.LastName)
                                ? "Not provided"
                                : Model.LastName)

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-envelope"></i>

                            Email Address

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Email)
                                ? "Not provided"
                                : Model.Email)

                        </div>

                    </div>


                    <!-- PHONE -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-phone"></i>

                            Phone Number

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Phone)
                                ? "Not provided"
                                : Model.Phone)

                        </div>

                    </div>


                    <!-- GENDER -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-venus-mars"></i>

                            Gender

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Gender)
                                ? "Not provided"
                                : Model.Gender)

                        </div>

                    </div>


                    <!-- DATE OF BIRTH -->

                    <div class="info-item">

                        <div class="info-label">

                            <i class="fa-solid fa-cake-candles"></i>

                            Date of Birth

                        </div>


                        <div class="info-value">

                            @Model.DateOfBirth.ToString("dd MMMM yyyy")

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div class="info-item"
                         style="grid-column: 1 / -1;">

                        <div class="info-label">

                            <i class="fa-solid fa-location-dot"></i>

                            Address

                        </div>


                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Address)
                                ? "Not provided"
                                : Model.Address)

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     ACTION BUTTONS
                     ================================================= -->

                <div class="profile-actions">


                    <!-- EDIT PROFILE -->

                    <a href="@Url.Action("EditProfile", "Dashboard")"
                       class="action-button edit-button">

                        <i class="fa-solid fa-pen-to-square"></i>

                        Edit Profile

                    </a>


                    <!-- BACK TO DASHBOARD -->

                    <a href="@Url.Action("Index", "Dashboard")"
                       class="action-button dashboard-button">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Dashboard

                    </a>


                </div>


            </div>

        </div>

    </div>

</div>

