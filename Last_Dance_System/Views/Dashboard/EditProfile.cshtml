@model Last_Dance_System.Models.Registration

@{
    ViewBag.Title = "Edit Profile";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: white;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .profile-page {
        min-height: calc(100vh - 50px);
        padding: 40px 20px;
        background: radial-gradient( circle at 80% 10%, rgba(225, 6, 0, 0.10), transparent 30% ), linear-gradient( 135deg, #07111f 0%, #0a1626 50%, #06101c 100% );
    }

    .profile-container {
        max-width: 850px;
        margin: 0 auto;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    .profile-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
        padding: 25px;
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .profile-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e10600;
        border-radius: 12px;
        font-size: 21px;
    }

    .profile-header h1 {
        margin: 0 0 5px;
        font-size: 24px;
        font-weight: 800;
    }

    .profile-header p {
        margin: 0;
        color: #71839a;
        font-size: 11px;
    }


    /* ============================================================
       FORM CARD
       ============================================================ */

    .form-card {
        background: #0b1727;
        border: 1px solid #17283d;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .form-section-title {
        margin-bottom: 22px;
        padding-bottom: 12px;
        border-bottom: 1px solid #17283d;
    }

        .form-section-title h2 {
            margin: 0 0 5px;
            font-size: 15px;
        }

        .form-section-title p {
            margin: 0;
            color: #687b90;
            font-size: 10px;
        }


    /* ============================================================
       FORM
       ============================================================ */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .form-group {
        margin-bottom: 5px;
    }

        .form-group.full {
            grid-column: span 2;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #a9b7c7;
            font-size: 10px;
            font-weight: 700;
        }

    .form-control {
        width: 100%;
        height: 44px;
        padding: 0 13px;
        background: #091321;
        border: 1px solid #1d3149;
        border-radius: 8px;
        color: white;
        font-size: 11px;
        outline: none;
        transition: .25s ease;
    }

    textarea.form-control {
        height: 90px;
        padding: 12px 13px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: #e10600;
        box-shadow: 0 0 0 3px rgba(225,6,0,.08);
    }

    .form-control[readonly] {
        opacity: .65;
        cursor: not-allowed;
    }


    /* ============================================================
       VALIDATION
       ============================================================ */

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #ff514b;
        font-size: 9px;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 15px;
        background: rgba(225,6,0,.08);
        border: 1px solid rgba(225,6,0,.25);
        border-radius: 8px;
        color: #ff514b;
        font-size: 10px;
    }


    /* ============================================================
       BUTTONS
       ============================================================ */

    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #17283d;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 130px;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: .25s ease;
    }

    .btn-cancel {
        background: #101f32;
        border: 1px solid #1d3149;
        color: #a9b7c7;
    }

        .btn-cancel:hover {
            background: #17283d;
            color: white;
            text-decoration: none;
        }

    .btn-save {
        background: #e10600;
        border: 1px solid #e10600;
        color: white;
    }

        .btn-save:hover {
            background: #ff211a;
            border-color: #ff211a;
            color: white;
            transform: translateY(-2px);
        }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 650px) {

        .profile-page {
            padding: 20px 12px;
        }

        .form-card {
            padding: 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: span 1;
        }

        .button-row {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }
    }
</style>


<div class="profile-page">

    <div class="profile-container">


        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="profile-header">

            <div class="profile-icon">
                <i class="fa-solid fa-user-pen"></i>
            </div>

            <div>

                <h1>
                    Edit Profile
                </h1>

                <p>
                    Update your personal information below.
                </p>

            </div>

        </div>


        <!-- ========================================================
             FORM
             ======================================================== -->

        <div class="form-card">

            <div class="form-section-title">

                <h2>
                    Personal Information
                </h2>

                <p>
                    Make sure your information is accurate and up to date.
                </p>

            </div>


            @using (Html.BeginForm("EditProfile",
                                   "Dashboard",
                                   FormMethod.Post,
                                   new { @class = "profile-form" }))
            {

                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.RegistrationId)


                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "validation-summary-errors" }
                )


                <div class="form-grid">


                    <!-- FIRST NAME -->

                    <div class="form-group">

                        <label>
                            First Name
                        </label>

                        @Html.TextBoxFor(
                            model => model.FirstName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter first name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.FirstName
                        )

                    </div>


                    <!-- LAST NAME -->

                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        @Html.TextBoxFor(
                            model => model.LastName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter last name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.LastName
                        )

                    </div>


                    <!-- GENDER -->

                    <div class="form-group">

                        <label>
                            Gender
                        </label>

                        @Html.TextBoxFor(
                            model => model.Gender,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter gender"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Gender
                        )

                    </div>


                    <!-- DATE OF BIRTH -->

                    <div class="form-group">

                        <label>
                            Date of Birth
                        </label>

                        @Html.TextBoxFor(
                            model => model.DateOfBirth,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control",
                                type = "date"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.DateOfBirth
                        )

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label>
                            Phone Number
                        </label>

                        @Html.TextBoxFor(
                            model => model.Phone,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter phone number"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Phone
                        )

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label>
                            Email Address
                        </label>

                        @Html.TextBoxFor(
                            model => model.Email,
                            new
                            {
                                @class = "form-control",
                                type = "email",
                                placeholder = "Enter email address"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Email
                        )

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-group full">

                        <label>
                            Address
                        </label>

                        @Html.TextAreaFor(
                            model => model.Address,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter your address"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Address
                        )

                    </div>


                </div>


                <!-- ====================================================
                     BUTTONS
                     ==================================================== -->

                <div class="button-row">


                    <a href="@Url.Action("Profile", "Dashboard")"
                       class="btn btn-cancel">

                        <i class="fa-solid fa-arrow-left"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-save">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Changes

                    </button>

                </div>

            }

        </div>

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}