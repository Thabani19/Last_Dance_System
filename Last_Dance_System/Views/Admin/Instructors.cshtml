@model IEnumerable<Last_Dance_System.Models.Instructor>

@{
    Layout = null;
    ViewBag.Title = "Instructors";
}

<!DOCTYPE html>

<html>

<head>

    <meta name="viewport" content="width=device-width" />

    <title>Instructors</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #172033;
        }

        .page {
            min-height: 100vh;
            padding: 35px 20px;
        }

        .container {
            max-width: 1250px;
            margin: auto;
        }

        .card {
            background: white;
            border: 1px solid #e1e8f0;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 8px 25px rgba(30,70,110,.07);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .title {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon {
            width: 55px;
            height: 55px;
            border-radius: 14px;
            background: linear-gradient(135deg,#1976d2,#0d47a1);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        h1 {
            margin: 0;
            font-size: 25px;
        }

        .subtitle {
            margin-top: 4px;
            color: #718096;
            font-size: 13px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border-radius: 8px;
            background: #ffffff;
            border: 1px solid #cbd7e4;
            color: #425466;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: .2s;
        }

            .back-button:hover {
                background: #edf6ff;
                border-color: #1976d2;
                color: #1565c0;
            }

        .success-message {
            margin-bottom: 20px;
            padding: 13px 16px;
            background: #eefaf5;
            border: 1px solid #c9eedf;
            color: #159463;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 14px;
            background: #f4f8fd;
            color: #526275;
            font-size: 12px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        td {
            padding: 15px 14px;
            border-bottom: 1px solid #edf1f5;
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr:hover {
            background: #f9fcff;
        }

        .name {
            font-weight: 700;
            color: #172033;
        }

        .vehicle {
            font-weight: 700;
            color: #1976d2;
        }

        .no-vehicle {
            color: #9aa6b5;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .active {
            background: #edf9f1;
            color: #2e8b57;
        }

        .inactive {
            background: #fff1f1;
            color: #c62828;
        }

        .edit-button {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: 7px;
            background: #1976d2;
            color: white;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

            .edit-button:hover {
                background: #0d47a1;
                color: white;
            }

        .empty-message {
            text-align: center;
            padding: 40px;
            color: #8193a7;
            font-size: 13px;
        }

        @@media(max-width:800px) {

            .header {
                flex-direction: column;
                align-items: stretch;
            }

            .header-actions {
                width: 100%;
            }

            .back-button {
                justify-content: center;
                width: 100%;
            }

            .card {
                padding: 20px;
            }
        }
    </style>

</head>

<body>

    <div class="page">

        <div class="container">

            <div class="card">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <div class="header">

                    <div class="title">

                        <div class="icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <div>

                            <h1>
                                Instructors
                            </h1>

                            <div class="subtitle">
                                Manage instructors and their assigned vehicles.
                            </div>

                        </div>

                    </div>


                    <div class="header-actions">

                        <a href="@Url.Action("Index", "Admin")"
                           class="back-button">

                            <i class="fa-solid fa-arrow-left"></i>

                            Back to Dashboard

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     SUCCESS MESSAGE
                     ================================================= -->

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-message">

                        <i class="fa-solid fa-circle-check"></i>

                        @TempData["SuccessMessage"]

                    </div>
                }


                <!-- =================================================
                     INSTRUCTOR TABLE
                     ================================================= -->

                <div class="table-wrapper">

                    @if (Model != null && Model.Any())
                    {

                        <table>

                            <thead>

                                <tr>

                                    <th>Name</th>

                                    <th>Phone</th>

                                    <th>Email</th>

                                    <th>License</th>

                                    <th>Vehicle</th>

                                    <th>Status</th>

                                    <th>Action</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var instructor in Model)
                                {
                                    <tr>

                                        <!-- NAME -->

                                        <td>

                                            <span class="name">

                                                @instructor.FirstName
                                                @instructor.LastName

                                            </span>

                                        </td>


                                        <!-- PHONE -->

                                        <td>

                                            @instructor.Phone

                                        </td>


                                        <!-- EMAIL -->

                                        <td>

                                            @instructor.Email

                                        </td>


                                        <!-- LICENSE -->

                                        <td>

                                            @instructor.LicenseNumber

                                        </td>


                                        <!-- VEHICLE -->

                                        <td>

                                            @if (instructor.Vehicle != null)
                                            {
                                                <span class="vehicle">

                                                    <i class="fa-solid fa-car"></i>

                                                    @instructor.Vehicle.RegistrationNumber

                                                    -

                                                    @instructor.Vehicle.Make

                                                    @instructor.Vehicle.Model

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="no-vehicle">

                                                    <i class="fa-solid fa-car-side"></i>

                                                    No vehicle assigned

                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @if (instructor.IsActive)
                                            {
                                                <span class="status active">

                                                    <i class="fa-solid fa-circle"></i>

                                                    Active

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status inactive">

                                                    <i class="fa-solid fa-circle"></i>

                                                    Inactive

                                                </span>
                                            }

                                        </td>


                                        <!-- ACTION -->

                                        <td>

                                            <a href="@Url.Action(
                                                "EditInstructor",
                                                "Admin",
                                                new { id = instructor.InstructorId })"
                                               class="edit-button">

                                                <i class="fa-solid fa-pen"></i>

                                                Edit

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    }
                    else
                    {

                        <div class="empty-message">

                            <i class="fa-solid fa-users-slash"
                               style="font-size:28px;margin-bottom:10px;">
                            </i>

                            <br />

                            No instructors have been registered yet.

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</body>

</html>