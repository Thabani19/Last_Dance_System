@model IEnumerable<Last_Dance_System.Models.LessonSchedule>

@{
    Layout = null;
    ViewBag.Title = "Lesson Schedules";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f4f8fc;
        color: #172033;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    /* =========================================================
       PAGE
       ========================================================= */

    .schedule-page {
        min-height: calc(100vh - 50px);
        padding: 35px;
        background: #f4f8fc;
    }

    .schedule-container {
        max-width: 1450px;
        margin: 0 auto;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
        padding: 25px 28px;
        background: #ffffff;
        border: 1px solid #e3ebf4;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(30, 74, 120, 0.07);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #1769d1;
        color: #ffffff;
        font-size: 21px;
        box-shadow: 0 8px 18px rgba(23, 105, 209, 0.20);
    }

    .page-header h1 {
        margin: 0 0 5px;
        color: #142033;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: #718096;
        font-size: 12px;
    }

    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    .dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 11px 18px;
        background: #ffffff;
        border: 1px solid #d6e2ef;
        border-radius: 9px;
        color: #31506f;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: .25s ease;
    }

        .dashboard-button:hover {
            background: #1769d1;
            border-color: #1769d1;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(23, 105, 209, 0.18);
        }

    /* =========================================================
       SUMMARY
       ========================================================= */

    .summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding: 18px 20px;
        background: #ffffff;
        border: 1px solid #e3ebf4;
        border-radius: 14px;
        box-shadow: 0 7px 22px rgba(30, 74, 120, 0.05);
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eaf3ff;
        color: #1769d1;
        font-size: 17px;
    }

    .summary-text strong {
        display: block;
        color: #142033;
        font-size: 21px;
        font-weight: 800;
    }

    .summary-text span {
        display: block;
        margin-top: 2px;
        color: #718096;
        font-size: 10px;
    }

    /* =========================================================
       SCHEDULE PANEL
       ========================================================= */

    .schedule-panel {
        background: #ffffff;
        border: 1px solid #e3ebf4;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 28px rgba(30, 74, 120, 0.06);
    }

    /* =========================================================
       PANEL HEADER
       ========================================================= */

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px;
        border-bottom: 1px solid #e7eef6;
        background: #ffffff;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .panel-title-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eef5ff;
        color: #1769d1;
        font-size: 13px;
    }

    .panel-title h2 {
        margin: 0;
        color: #1a2738;
        font-size: 14px;
        font-weight: 800;
    }

    .panel-title span {
        color: #8391a3;
        font-size: 10px;
    }

    /* =========================================================
       TABLE WRAPPER
       ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .schedule-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .schedule-table thead {
            background: #f7faff;
        }

        .schedule-table th {
            padding: 14px 18px;
            border-bottom: 1px solid #dfe8f2;
            color: #718096;
            font-size: 9px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .schedule-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #edf2f7;
            color: #34455b;
            font-size: 10px;
            vertical-align: middle;
        }

        .schedule-table tbody tr {
            transition: .20s ease;
        }

            .schedule-table tbody tr:hover {
                background: #f8fbff;
            }

            .schedule-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* =========================================================
       SCHEDULE ID
       ========================================================= */

    .schedule-id {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        background: #eef5ff;
        border-radius: 6px;
        color: #1769d1;
        font-size: 10px;
        font-weight: 800;
    }

    /* =========================================================
       DATE
       ========================================================= */

    .lesson-date {
        display: block;
        color: #1a2738;
        font-size: 11px;
        font-weight: 800;
    }

    .lesson-day {
        display: block;
        margin-top: 3px;
        color: #8391a3;
        font-size: 9px;
    }

    /* =========================================================
       TIME
       ========================================================= */

    .time-box {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        background: #f5f9fe;
        border: 1px solid #dce8f5;
        border-radius: 8px;
        color: #31506f;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

        .time-box i {
            color: #1769d1;
        }

    /* =========================================================
       LESSON TYPE
       ========================================================= */

    .lesson-type {
        display: block;
        color: #1a2738;
        font-size: 10px;
        font-weight: 800;
    }

    .lesson-type-description {
        display: block;
        margin-top: 3px;
        max-width: 180px;
        color: #8391a3;
        font-size: 8px;
        line-height: 1.4;
    }

    /* =========================================================
       PERSON INFO
       ========================================================= */

    .person-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .small-avatar {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eaf3ff;
        border: 1px solid #d5e6fa;
        color: #1769d1;
        font-size: 9px;
        font-weight: 800;
    }

    .person-name {
        color: #34455b;
        font-size: 10px;
        font-weight: 700;
    }

    /* =========================================================
       VEHICLE
       ========================================================= */

    .vehicle-name {
        display: block;
        color: #1a2738;
        font-size: 10px;
        font-weight: 800;
    }

    .vehicle-registration {
        display: inline-block;
        margin-top: 4px;
        padding: 3px 6px;
        background: #f5f7fa;
        border: 1px solid #e3e9f0;
        border-radius: 5px;
        color: #718096;
        font-size: 8px;
        font-weight: 700;
    }

    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .status-available {
        background: #eaf8f1;
        border: 1px solid #ccebdc;
        color: #168455;
    }

    .status-booked {
        background: #eaf3ff;
        border: 1px solid #d1e3fa;
        color: #1769d1;
    }

    .status-cancelled {
        background: #f2f4f7;
        border: 1px solid #e1e5ea;
        color: #788596;
    }

    .status-completed {
        background: #eaf8f1;
        border: 1px solid #ccebdc;
        color: #168455;
    }

    .status-default {
        background: #f2f5f8;
        border: 1px solid #e1e7ed;
        color: #788596;
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-card {
        padding: 70px 30px;
        text-align: center;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eaf3ff;
        color: #1769d1;
        font-size: 25px;
    }

    .empty-card h3 {
        margin: 0 0 7px;
        color: #1a2738;
        font-size: 17px;
        font-weight: 800;
    }

    .empty-card p {
        margin: 0;
        color: #8391a3;
        font-size: 11px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 750px) {

        .schedule-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .dashboard-button {
            width: 100%;
        }

        .panel-header {
            align-items: flex-start;
        }
    }

    @@media (max-width: 500px) {

        .page-header {
            padding: 20px;
        }

        .header-left {
            align-items: flex-start;
        }

        .page-header h1 {
            font-size: 21px;
        }

        .header-icon {
            width: 47px;
            height: 47px;
        }

        .summary-card {
            padding: 16px;
        }
    }
</style>


<div class="schedule-page">

    <div class="schedule-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div class="header-left">

                <div class="header-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <div>

                    <h1>
                        Lesson Schedules
                    </h1>

                    <p>
                        View and monitor all driving lesson schedules.
                    </p>

                </div>

            </div>

            <a href="@Url.Action("Index", "Admin")"
               class="dashboard-button">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="summary-card">

            <div class="summary-icon">

                <i class="fa-solid fa-calendar-check"></i>

            </div>

            <div class="summary-text">

                <strong>
                    @(Model == null ? 0 : Model.Count())
                </strong>

                <span>
                    Total Lesson Schedules
                </span>

            </div>

        </div>


        <!-- =====================================================
             SCHEDULE PANEL
             ===================================================== -->

        <div class="schedule-panel">

            <div class="panel-header">

                <div class="panel-title">

                    <div class="panel-title-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <div>

                        <h2>
                            Lesson Schedule List
                        </h2>

                        <span>
                            All schedules registered in the system
                        </span>

                    </div>

                </div>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="table-wrapper">

                    <table class="schedule-table">

                        <thead>

                            <tr>

                                <th>Schedule</th>

                                <th>Date</th>

                                <th>Time</th>

                                <th>Lesson Type</th>

                                <th>Instructor</th>

                                <th>Vehicle</th>

                                <th>Status</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var schedule in Model)
                            {

                                string instructorInitial = "I";

                                if (schedule.Instructor != null &&
                                    !string.IsNullOrEmpty(schedule.Instructor.FirstName))
                                {
                                    instructorInitial =
                                        schedule.Instructor.FirstName
                                            .Substring(0, 1)
                                            .ToUpper();
                                }


                                string instructorName = "Not Assigned";

                                if (schedule.Instructor != null)
                                {
                                    instructorName =
                                        (schedule.Instructor.FirstName ?? "")
                                        + " "
                                        + (schedule.Instructor.LastName ?? "");

                                    instructorName =
                                        instructorName.Trim();

                                    if (string.IsNullOrEmpty(instructorName))
                                    {
                                        instructorName = "Not Assigned";
                                    }
                                }


                                string vehicleName = "Not Assigned";

                                if (schedule.Vehicle != null)
                                {
                                    vehicleName =
                                        (schedule.Vehicle.Make ?? "")
                                        + " "
                                        + (schedule.Vehicle.Model ?? "");

                                    vehicleName =
                                        vehicleName.Trim();

                                    if (string.IsNullOrEmpty(vehicleName))
                                    {
                                        vehicleName = "Vehicle";
                                    }
                                }


                                string lessonTypeName = "Not Assigned";

                                if (schedule.LessonType != null)
                                {
                                    lessonTypeName =
                                        schedule.LessonType.LessonTypeName;
                                }


                                string lessonDescription = "";

                                if (schedule.LessonType != null)
                                {
                                    lessonDescription =
                                        schedule.LessonType.Description;
                                }


                                string statusClass = "status-default";

                                string statusIcon = "fa-circle-info";

                                if (string.Equals(
                                    schedule.Status,
                                    "Available",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-available";
                                    statusIcon = "fa-check";
                                }
                                else if (string.Equals(
                                    schedule.Status,
                                    "Booked",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-booked";
                                    statusIcon = "fa-calendar-check";
                                }
                                else if (string.Equals(
                                    schedule.Status,
                                    "Cancelled",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-cancelled";
                                    statusIcon = "fa-ban";
                                }
                                else if (string.Equals(
                                    schedule.Status,
                                    "Completed",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-completed";
                                    statusIcon = "fa-circle-check";
                                }


                                string statusText =
                                    string.IsNullOrEmpty(schedule.Status)
                                    ? "Unknown"
                                    : schedule.Status;


                                <tr>

                                    <!-- SCHEDULE ID -->

                                    <td>

                                        <span class="schedule-id">
                                            #@schedule.LessonScheduleId
                                        </span>

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <span class="lesson-date">

                                            @schedule.LessonDate.ToString(
                                                "dd MMM yyyy")

                                        </span>

                                        <span class="lesson-day">

                                            @schedule.LessonDate.ToString(
                                                "dddd")

                                        </span>

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        <div class="time-box">

                                            <i class="fa-solid fa-clock"></i>

                                            @schedule.StartTime.ToString(
                                                @"hh\:mm")

                                            -

                                            @schedule.EndTime.ToString(
                                                @"hh\:mm")

                                        </div>

                                    </td>


                                    <!-- LESSON TYPE -->

                                    <td>

                                        <span class="lesson-type">

                                            @lessonTypeName

                                        </span>

                                        @if (!string.IsNullOrEmpty(
                                            lessonDescription))
                                        {

                                            <span class="lesson-type-description">

                                                @lessonDescription

                                            </span>

                                        }

                                    </td>


                                    <!-- INSTRUCTOR -->

                                    <td>

                                        <div class="person-info">

                                            <div class="small-avatar">

                                                @instructorInitial

                                            </div>

                                            <span class="person-name">

                                                @instructorName

                                            </span>

                                        </div>

                                    </td>


                                    <!-- VEHICLE -->

                                    <td>

                                        @if (schedule.Vehicle != null)
                                        {

                                            <span class="vehicle-name">

                                                @vehicleName

                                            </span>

                                            <span class="vehicle-registration">

                                                @schedule.Vehicle.RegistrationNumber

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="vehicle-name">

                                                Not Assigned

                                            </span>

                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status @statusClass">

                                            <i class="fa-solid @statusIcon"></i>

                                            @statusText

                                        </span>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h3>
                        No Lesson Schedules Found
                    </h3>

                    <p>
                        There are currently no lesson schedules
                        available in the system.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     FONT AWESOME
     ========================================================= -->

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />