
@model Last_Dance_System.Models.Vehicle

@{
    ViewBag.Title = "Edit Vehicle";
    Layout = null;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: #f4f8fc;
        color: #172b4d;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    /* =========================================================
       PAGE
       ========================================================= */

    .edit-page {
        min-height: 100vh;
        padding: 45px 25px 70px;
        background: radial-gradient(circle at 10% 10%, rgba(33, 150, 243, 0.10), transparent 28%), radial-gradient(circle at 90% 90%, rgba(13, 71, 161, 0.07), transparent 30%), linear-gradient(135deg, #f8fbff 0%, #f1f6fb 50%, #eaf2f9 100%);
    }

    .edit-container {
        width: 100%;
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================================================
       CARD
       ========================================================= */

    .edit-card {
        background: #ffffff;
        border: 1px solid #dce7f1;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 20px 55px rgba(23, 43, 77, 0.10), 0 4px 15px rgba(23, 43, 77, 0.05);
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 30px 40px;
        background: linear-gradient(135deg, #ffffff 0%, #f7fbff 55%, #eaf4ff 100%);
        border-bottom: 1px solid #dbe7f2;
    }

        .page-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            right: -110px;
            top: -155px;
            background: rgba(33, 150, 243, 0.06);
        }

    .header-left {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient(135deg, #2196f3, #1565c0);
        color: #ffffff;
        font-size: 23px;
        box-shadow: 0 8px 22px rgba(33, 150, 243, 0.25);
    }

    .header-text h1 {
        margin: 0 0 5px;
        color: #172b4d;
        font-size: 26px;
        font-weight: 800;
    }

    .header-text p {
        margin: 0;
        color: #71859a;
        font-size: 12px;
    }

    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .back-button {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 15px;
        border-radius: 9px;
        background: #ffffff;
        border: 1px solid #d4e0eb;
        color: #526b84;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

        .back-button:hover {
            background: #f4f9fe;
            border-color: #b9d3ea;
            color: #1565c0;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* =========================================================
       FORM AREA
       ========================================================= */

    .form-area {
        padding: 38px 45px 42px;
        background: #ffffff;
    }

    /* =========================================================
       VALIDATION SUMMARY
       ========================================================= */

    .validation-summary-errors {
        background: #fff4f4;
        border: 1px solid #f3c7c7;
        border-left: 4px solid #dc3545;
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 25px;
        color: #b4232f;
        font-size: 13px;
    }

    .validation-summary-valid {
        display: none;
    }

    .text-danger {
        display: block;
        color: #d93025;
        font-size: 11px;
        margin-top: 6px;
    }

    /* =========================================================
       SECTION
       ========================================================= */

    .form-section {
        margin-bottom: 30px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e5edf5;
    }

    .section-number {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf6ff;
        border: 1px solid #cfe6fa;
        color: #1976d2;
        font-size: 11px;
        font-weight: 800;
    }

    .section-heading h2 {
        margin: 0 0 3px;
        color: #172b4d;
        font-size: 17px;
        font-weight: 800;
    }

    .section-heading p {
        margin: 0;
        color: #8193a7;
        font-size: 12px;
    }

    /* =========================================================
       FORM GRID
       ========================================================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        margin-bottom: 3px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #34495e;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .2px;
    }

    /* =========================================================
       INPUT WRAPPER
       ========================================================= */

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        color: #7d93aa;
        font-size: 14px;
        text-align: center;
        pointer-events: none;
        z-index: 2;
    }

    /* =========================================================
       INPUTS
       ========================================================= */

    .form-control {
        width: 100%;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #d4e0eb;
        background: #fbfdff;
        color: #172b4d;
        padding: 12px 15px 12px 44px;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .form-control:hover {
            border-color: #b8cadb;
            background: #ffffff;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: #2196f3;
            box-shadow: 0 0 0 3px rgba(33, 150, 243, .10), 0 4px 12px rgba(33, 150, 243, .06);
        }

    /* =========================================================
       SELECT
       ========================================================= */

    select.form-control {
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
        padding-right: 40px;
    }

    .select-wrapper::after {
        content: "\f078";
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        color: #7d93aa;
        pointer-events: none;
        font-size: 11px;
    }

    /* =========================================================
       CHECKBOX / ACTIVE
       ========================================================= */

    .active-box {
        margin-top: 26px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f7fbff;
        border: 1px solid #dce9f5;
        border-radius: 10px;
    }

        .active-box input {
            width: 18px;
            height: 18px;
            accent-color: #1976d2;
            cursor: pointer;
        }

    .active-content strong {
        display: block;
        color: #34495e;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .active-content span {
        display: block;
        color: #8193a7;
        font-size: 10px;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 8px;
        padding-top: 25px;
        border-top: 1px solid #e5edf5;
    }

    .btn {
        min-height: 48px;
        border-radius: 10px;
        padding: 11px 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s ease;
    }

    .btn-save {
        flex: 1;
        border: 1px solid #1976d2;
        background: linear-gradient(135deg, #2196f3, #1565c0);
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(33, 150, 243, .18);
    }

        .btn-save:hover {
            background: linear-gradient(135deg, #42a5f5, #1976d2);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(33, 150, 243, .25);
        }

    .btn-cancel {
        min-width: 120px;
        background: #f5f8fb;
        border: 1px solid #d7e2ec;
        color: #60758a;
    }

        .btn-cancel:hover {
            background: #edf3f8;
            color: #34495e;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* =========================================================
       FOOTER NOTE
       ========================================================= */

    .form-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 18px;
        color: #8193a7;
        font-size: 10px;
        text-align: center;
    }

        .form-note i {
            color: #2196f3;
        }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 750px) {

        .edit-page {
            padding: 20px 15px 50px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 25px;
        }

        .back-button {
            width: 100%;
        }

        .form-area {
            padding: 28px 25px 32px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }

        .btn-cancel {
            min-width: 0;
        }
    }

    @@media (max-width: 450px) {

        .edit-page {
            padding: 10px;
        }

        .edit-card {
            border-radius: 17px;
        }

        .page-header {
            padding: 22px 18px;
        }

        .header-icon {
            width: 50px;
            height: 50px;
        }

        .header-text h1 {
            font-size: 22px;
        }

        .form-area {
            padding: 25px 18px 30px;
        }
    }
</style>

<div class="edit-page">

    <div class="edit-container">

        <div class="edit-card">

            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="page-header">

                <div class="header-left">

                    <div class="header-icon">
                        <i class="fa-solid fa-car-side"></i>
                    </div>

                    <div class="header-text">

                        <h1>
                            Edit Vehicle
                        </h1>

                        <p>
                            Update vehicle information and availability.
                        </p>

                    </div>

                </div>

                <a href="@Url.Action("Vehicles", "Admin")"
                   class="back-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Vehicles

                </a>

            </div>

            <!-- =================================================
                 FORM
                 ================================================= -->

            <div class="form-area">

                @using (Html.BeginForm(
                    "EditVehicle",
                    "Admin",
                    FormMethod.Post))
                {

                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(m => m.VehicleId)

                    <!-- VALIDATION -->

                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "validation-summary-errors"
                        })

                    <!-- =================================================
                         VEHICLE INFORMATION
                         ================================================= -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                01
                            </div>

                            <div>

                                <h2>
                                    Vehicle Information
                                </h2>

                                <p>
                                    Update the vehicle's basic details and licence code.
                                </p>

                            </div>

                        </div>

                        <div class="form-grid">

                            <!-- MAKE -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Make,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-car"></i>
                                    </span>

                                    @Html.TextBoxFor(
                                        m => m.Make,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "e.g. Toyota"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.Make,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                            <!-- MODEL -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Model,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-car-side"></i>
                                    </span>

                                    @Html.TextBoxFor(
                                        m => m.Model,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "e.g. Corolla"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.Model,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                            <!-- REGISTRATION -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.RegistrationNumber,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-id-card"></i>
                                    </span>

                                    @Html.TextBoxFor(
                                        m => m.RegistrationNumber,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "e.g. ND 123-456"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.RegistrationNumber,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                            <!-- VEHICLE TYPE -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.VehicleType,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper select-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-tags"></i>
                                    </span>

                                    @Html.DropDownListFor(
                                        m => m.VehicleType,
                                        new SelectList(
                                            new[]
                                            {
                                                "Manual",
                                                "Automatic"
                                            },
                                            Model.VehicleType),
                                        "Select vehicle type",
                                        new
                                        {
                                            @class = "form-control"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.VehicleType,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                            <!-- =================================================
                                 LICENCE CODE
                                 ================================================= -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.LicenseCode,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper select-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-id-card-clip"></i>
                                    </span>

                                    @Html.DropDownListFor(
                                        m => m.LicenseCode,
                                        new SelectList(
                                            new[]
                                            {
                                                "Code 8",
                                                "Code 10",
                                                "Code 14"
                                            },
                                            Model.LicenseCode),
                                        "Select licence code",
                                        new
                                        {
                                            @class = "form-control"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.LicenseCode,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                        </div>

                    </div>

                    <!-- =================================================
                         VEHICLE STATUS
                         ================================================= -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                02
                            </div>

                            <div>

                                <h2>
                                    Vehicle Status
                                </h2>

                                <p>
                                    Manage the current vehicle condition and availability.
                                </p>

                            </div>

                        </div>

                        <div class="form-grid">

                            <!-- STATUS -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Status,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper select-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-circle-check"></i>
                                    </span>

                                    @Html.DropDownListFor(
                                        m => m.Status,
                                        new SelectList(
                                            new[]
                                            {
                                                "Available",
                                                "In Use",
                                                "Maintenance",
                                                "Unavailable"
                                            },
                                            Model.Status),
                                        "Select status",
                                        new
                                        {
                                            @class = "form-control"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.Status,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                            <!-- MILEAGE -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.CurrentMileage,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <i class="fa-solid fa-gauge-high"></i>
                                    </span>

                                    @Html.TextBoxFor(
                                        m => m.CurrentMileage,
                                        new
                                        {
                                            @class = "form-control",
                                            type = "number",
                                            min = "0",
                                            placeholder = "Current mileage"
                                        })

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.CurrentMileage,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                            </div>

                        </div>

                        <!-- ACTIVE -->

                        <label class="active-box">

                            @Html.CheckBoxFor(
                                m => m.IsActive)

                            <span class="active-content">

                                <strong>
                                    Vehicle is active
                                </strong>

                                <span>
                                    Active vehicles can be assigned to lesson schedules.
                                </span>

                            </span>

                        </label>

                    </div>

                    <!-- =================================================
                         ACTIONS
                         ================================================= -->

                    <div class="form-actions">

                        <a href="@Url.Action("Vehicles", "Admin")"
                           class="btn btn-cancel">

                            <i class="fa-solid fa-xmark"></i>

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-save">

                            <i class="fa-solid fa-floppy-disk"></i>

                            SAVE VEHICLE CHANGES

                        </button>

                    </div>

                    <!-- NOTE -->

                    <div class="form-note">

                        <i class="fa-solid fa-shield-halved"></i>

                        Licence code determines which driving package and students can use this vehicle.

                    </div>

                }

            </div>

        </div>

    </div>

</div>

