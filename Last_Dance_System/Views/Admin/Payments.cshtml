
@model IEnumerable<Last_Dance_System.Models.Payment>

@{
    Layout = null;
    ViewBag.Title = "Payments";

    var totalPayments = Model == null ? 0 : Model.Count();

    var totalAmount = Model == null
        ? 0m
        : Model.Sum(p => p.Amount);

    var successfulPayments = Model == null
        ? 0
        : Model.Count(p =>
            string.Equals(
                p.PaymentStatus,
                "Paid",
                StringComparison.OrdinalIgnoreCase
            )
        );

    var pendingPayments = Model == null
        ? 0
        : Model.Count(p =>
            string.Equals(
                p.PaymentStatus,
                "Pending",
                StringComparison.OrdinalIgnoreCase
            )
        );
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f8fc;
        color: #172033;
        font-family: "Segoe UI", Arial, sans-serif;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .payment-page {
        min-height: calc(100vh - 50px);
        padding: 32px;
        background: #f5f8fc;
    }

    .payment-container {
        max-width: 1450px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
        padding: 24px 28px;
        background: #ffffff;
        border: 1px solid #e4eaf2;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(30, 64, 110, 0.06);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #2563eb;
        color: #ffffff;
        font-size: 21px;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.20);
    }

    .page-header h1 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: #718096;
        font-size: 12px;
    }


    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    .dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 11px 18px;
        background: #ffffff;
        border: 1px solid #d9e2ef;
        border-radius: 9px;
        color: #334155;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: .25s ease;
    }

        .dashboard-button:hover {
            background: #eff6ff;
            border-color: #2563eb;
            color: #2563eb;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* =========================================================
       SUMMARY GRID
       ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }


    /* =========================================================
       SUMMARY CARD
       ========================================================= */

    .summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 19px 20px;
        background: #ffffff;
        border: 1px solid #e4eaf2;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(30, 64, 110, 0.05);
        transition: .25s ease;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 25px rgba(30, 64, 110, 0.08);
        }


    .summary-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 16px;
    }

        .summary-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .summary-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

    .summary-text strong {
        display: block;
        color: #172033;
        font-size: 20px;
        font-weight: 800;
    }

    .summary-text span {
        display: block;
        margin-top: 2px;
        color: #7b8798;
        font-size: 10px;
    }


    /* =========================================================
       PAYMENTS PANEL
       ========================================================= */

    .payments-panel {
        background: #ffffff;
        border: 1px solid #e4eaf2;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 7px 25px rgba(30, 64, 110, 0.06);
    }


    /* =========================================================
       PANEL HEADER
       ========================================================= */

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 19px 22px;
        border-bottom: 1px solid #e8edf4;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .panel-title-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 12px;
    }

    .panel-title h2 {
        margin: 0;
        color: #172033;
        font-size: 14px;
        font-weight: 800;
    }

    .panel-title span {
        color: #8490a3;
        font-size: 10px;
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .payment-table {
        width: 100%;
        min-width: 1150px;
        border-collapse: collapse;
    }


        .payment-table thead {
            background: #f8fafc;
        }

        .payment-table th {
            padding: 14px 18px;
            border-bottom: 1px solid #e5eaf1;
            color: #718096;
            font-size: 9px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }


        .payment-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #edf1f6;
            color: #334155;
            font-size: 10px;
            vertical-align: middle;
        }


        .payment-table tbody tr {
            transition: .20s ease;
        }

            .payment-table tbody tr:hover {
                background: #f8fbff;
            }

            .payment-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================================================
       PAYMENT ID
       ========================================================= */

    .payment-id {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 6px;
        color: #2563eb;
        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================================
       STUDENT
       ========================================================= */

    .student-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .student-avatar {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff;
        font-size: 10px;
        font-weight: 800;
    }

    .student-details {
        min-width: 0;
    }

    .student-name {
        display: block;
        color: #172033;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .student-id {
        display: block;
        margin-top: 3px;
        color: #8a96a8;
        font-size: 8px;
    }


    /* =========================================================
       AMOUNT
       ========================================================= */

    .amount {
        color: #172033;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* =========================================================
       PAYMENT METHOD
       ========================================================= */

    .payment-method {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #475569;
        font-size: 9px;
        font-weight: 700;
    }

        .payment-method i {
            color: #2563eb;
            font-size: 11px;
        }


    /* =========================================================
       PAYMENT TYPE
       ========================================================= */

    .payment-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        color: #475569;
        font-size: 8px;
        font-weight: 700;
    }

        .payment-type i {
            color: #2563eb;
        }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }


    .status-paid {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #059669;
    }

    .status-pending {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #ea580c;
    }

    .status-failed {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }

    .status-cancelled {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
    }


    /* =========================================================
       REFERENCE
       ========================================================= */

    .reference {
        display: block;
        max-width: 180px;
        color: #475569;
        font-size: 9px;
        font-weight: 600;
        word-break: break-word;
    }

    .no-reference {
        color: #94a3b8;
        font-size: 9px;
    }


    /* =========================================================
       DATE
       ========================================================= */

    .payment-date {
        display: block;
        color: #172033;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .payment-time {
        display: block;
        margin-top: 3px;
        color: #8995a7;
        font-size: 9px;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-card {
        padding: 75px 30px;
        text-align: center;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        font-size: 25px;
    }

    .empty-card h3 {
        margin: 0 0 7px;
        color: #172033;
        font-size: 16px;
        font-weight: 800;
    }

    .empty-card p {
        margin: 0;
        color: #7b8798;
        font-size: 11px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1100px) {

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 750px) {

        .payment-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .dashboard-button {
            width: 100%;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 500px) {

        .page-header {
            padding: 20px;
        }

        .header-left {
            align-items: flex-start;
        }

        .page-header h1 {
            font-size: 21px;
        }

        .header-icon {
            width: 46px;
            height: 46px;
        }
    }
</style>


<div class="payment-page">

    <div class="payment-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div class="header-left">

                <div class="header-icon">

                    <i class="fa-solid fa-wallet"></i>

                </div>

                <div>

                    <h1>
                        Payments
                    </h1>

                    <p>
                        View and monitor all student payments.
                    </p>

                </div>

            </div>


            <a href="@Url.Action("Index", "Admin")"
               class="dashboard-button">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="summary-grid">


            <!-- TOTAL PAYMENTS -->

            <div class="summary-card">

                <div class="summary-icon">

                    <i class="fa-solid fa-receipt"></i>

                </div>

                <div class="summary-text">

                    <strong>
                        @totalPayments
                    </strong>

                    <span>
                        Total Payments
                    </span>

                </div>

            </div>


            <!-- TOTAL VALUE -->

            <div class="summary-card">

                <div class="summary-icon green">

                    <i class="fa-solid fa-money-bill-wave"></i>

                </div>

                <div class="summary-text">

                    <strong>
                        R @totalAmount.ToString("N2")
                    </strong>

                    <span>
                        Total Payment Value
                    </span>

                </div>

            </div>


            <!-- SUCCESSFUL -->

            <div class="summary-card">

                <div class="summary-icon green">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div class="summary-text">

                    <strong>
                        @successfulPayments
                    </strong>

                    <span>
                        Successful Payments
                    </span>

                </div>

            </div>


            <!-- PENDING -->

            <div class="summary-card">

                <div class="summary-icon orange">

                    <i class="fa-solid fa-clock"></i>

                </div>

                <div class="summary-text">

                    <strong>
                        @pendingPayments
                    </strong>

                    <span>
                        Pending Payments
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PAYMENTS PANEL
             ===================================================== -->

        <div class="payments-panel">


            <div class="panel-header">

                <div class="panel-title">

                    <div class="panel-title-icon">

                        <i class="fa-solid fa-credit-card"></i>

                    </div>

                    <div>

                        <h2>
                            Payment Transactions
                        </h2>

                        <span>
                            All recorded payment activity
                        </span>

                    </div>

                </div>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="table-wrapper">

                    <table class="payment-table">

                        <thead>

                            <tr>

                                <th>
                                    Payment
                                </th>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Method
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Reference
                                </th>

                                <th>
                                    Payment Date
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var payment in Model)
                            {
                                var studentName = "Unknown Student";
                                var studentId = "";
                                var studentInitials = "S";

                                if (payment.Registration != null)
                                {
                                    studentName =
                                        ((payment.Registration.FirstName ?? "")
                                        + " "
                                        + (payment.Registration.LastName ?? ""))
                                        .Trim();

                                    studentId =
                                        payment.Registration.RegistrationId ?? "";

                                    if (!string.IsNullOrEmpty(payment.Registration.FirstName))
                                    {
                                        studentInitials =
                                            payment.Registration.FirstName
                                                .Substring(0, 1)
                                                .ToUpper();
                                    }

                                    if (!string.IsNullOrEmpty(payment.Registration.LastName))
                                    {
                                        studentInitials +=
                                            payment.Registration.LastName
                                                .Substring(0, 1)
                                                .ToUpper();
                                    }
                                }


                                var paymentStatus =
                                    string.IsNullOrEmpty(payment.PaymentStatus)
                                    ? "Unknown"
                                    : payment.PaymentStatus;

                                var statusClass = "status-pending";
                                var statusIcon = "fa-clock";

                                if (string.Equals(
                                    payment.PaymentStatus,
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-paid";
                                    statusIcon = "fa-check";
                                }
                                else if (string.Equals(
                                    payment.PaymentStatus,
                                    "Failed",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-failed";
                                    statusIcon = "fa-xmark";
                                }
                                else if (string.Equals(
                                    payment.PaymentStatus,
                                    "Cancelled",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    statusClass = "status-cancelled";
                                    statusIcon = "fa-ban";
                                }


                                var paymentType = "Payment";
                                var paymentTypeIcon = "fa-receipt";

                                if (payment.StudentPackage != null)
                                {
                                    paymentType = "Package";
                                    paymentTypeIcon = "fa-box";
                                }
                                else if (payment.Booking != null)
                                {
                                    paymentType = "Lesson";
                                    paymentTypeIcon = "fa-car";
                                }


                                var methodName =
                                    string.IsNullOrEmpty(payment.PaymentMethod)
                                    ? "Unknown"
                                    : payment.PaymentMethod;

                                var methodIcon = "fa-wallet";

                                if (string.Equals(
                                    payment.PaymentMethod,
                                    "Card",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    methodIcon = "fa-credit-card";
                                }
                                else if (string.Equals(
                                    payment.PaymentMethod,
                                    "Cash",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    methodIcon = "fa-money-bill";
                                }
                                else if (string.Equals(
                                    payment.PaymentMethod,
                                    "EFT",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    methodIcon = "fa-building-columns";
                                }


                                <tr>

                                    <!-- PAYMENT -->

                                    <td>

                                        <span class="payment-id">

                                            #@payment.PaymentId

                                        </span>

                                    </td>


                                    <!-- STUDENT -->

                                    <td>

                                        <div class="student-info">

                                            <div class="student-avatar">

                                                @studentInitials

                                            </div>

                                            <div class="student-details">

                                                <span class="student-name">

                                                    @studentName

                                                </span>

                                                @if (!string.IsNullOrEmpty(studentId))
                                                {
                                                    <span class="student-id">

                                                        ID: @studentId

                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- AMOUNT -->

                                    <td>

                                        <span class="amount">

                                            R @payment.Amount.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- METHOD -->

                                    <td>

                                        <span class="payment-method">

                                            <i class="fa-solid @methodIcon"></i>

                                            @methodName

                                        </span>

                                    </td>


                                    <!-- TYPE -->

                                    <td>

                                        <span class="payment-type">

                                            <i class="fa-solid @paymentTypeIcon"></i>

                                            @paymentType

                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status @statusClass">

                                            <i class="fa-solid @statusIcon"></i>

                                            @paymentStatus

                                        </span>

                                    </td>


                                    <!-- REFERENCE -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(
                                            payment.TransactionReference))
                                        {
                                            <span class="reference">

                                                @payment.TransactionReference

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-reference">

                                                No reference

                                            </span>
                                        }

                                    </td>


                                    <!-- PAYMENT DATE -->

                                    <td>

                                        <span class="payment-date">

                                            @payment.PaymentDate.ToString(
                                                "dd MMM yyyy")

                                        </span>

                                        <span class="payment-time">

                                            @payment.PaymentDate.ToString(
                                                "HH:mm")

                                        </span>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="fa-solid fa-wallet"></i>

                    </div>

                    <h3>
                        No Payments Found
                    </h3>

                    <p>
                        There are currently no payments recorded
                        in the system.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     FONT AWESOME
     ========================================================= -->

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

