@model IEnumerable<Last_Dance_System.Models.Booking>

@{
    Layout = null;
    ViewBag.Title = "Bookings";
}

<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>Bookings</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            color: #172033;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        /* =========================================================
           PAGE
           ========================================================= */

        .booking-page {
            min-height: 100vh;
            padding: 35px 20px;
            background: #f4f7fb;
        }

        .booking-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* =========================================================
           HEADER
           ========================================================= */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 22px;
            padding: 25px 28px;
            background: #ffffff;
            border: 1px solid #e1e8f0;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(30, 70, 110, 0.07);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-icon {
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: linear-gradient(135deg, #1976d2, #0d47a1);
            color: white;
            font-size: 21px;
            box-shadow: 0 8px 18px rgba(25, 118, 210, 0.20);
        }

        .page-header h1 {
            margin: 0 0 5px;
            color: #172033;
            font-size: 25px;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #718096;
            font-size: 12px;
        }

        /* =========================================================
           DASHBOARD BUTTON
           ========================================================= */

        .dashboard-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 11px 18px;
            background: #ffffff;
            border: 1px solid #cbd7e4;
            border-radius: 8px;
            color: #425466;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            transition: .25s ease;
        }

            .dashboard-button:hover {
                background: #f4f8fd;
                border-color: #1976d2;
                color: #1976d2;
                text-decoration: none;
                transform: translateY(-2px);
            }

        /* =========================================================
           SUMMARY CARDS
           ========================================================= */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }

        .summary-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 18px 20px;
            background: #ffffff;
            border: 1px solid #e1e8f0;
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(30, 70, 110, 0.05);
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #eaf3ff;
            color: #1976d2;
            font-size: 17px;
        }

        .summary-text strong {
            display: block;
            color: #172033;
            font-size: 21px;
            font-weight: 800;
        }

        .summary-text span {
            display: block;
            margin-top: 2px;
            color: #718096;
            font-size: 10px;
        }

        /* =========================================================
           BOOKINGS PANEL
           ========================================================= */

        .bookings-panel {
            background: #ffffff;
            border: 1px solid #e1e8f0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(30, 70, 110, 0.07);
        }

        /* =========================================================
           PANEL HEADER
           ========================================================= */

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 22px;
            background: #ffffff;
            border-bottom: 1px solid #edf1f5;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .panel-title-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #eaf3ff;
            color: #1976d2;
            font-size: 13px;
        }

        .panel-title h2 {
            margin: 0;
            color: #172033;
            font-size: 15px;
            font-weight: 800;
        }

        .panel-title span {
            color: #718096;
            font-size: 10px;
        }

        /* =========================================================
           TABLE
           ========================================================= */

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .booking-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px;
        }

            .booking-table thead {
                background: #f7f9fc;
            }

            .booking-table th {
                padding: 14px 18px;
                border-bottom: 1px solid #e1e8f0;
                color: #718096;
                font-size: 9px;
                font-weight: 800;
                text-align: left;
                text-transform: uppercase;
                letter-spacing: .5px;
                white-space: nowrap;
            }

            .booking-table td {
                padding: 16px 18px;
                border-bottom: 1px solid #edf1f5;
                color: #425466;
                font-size: 10px;
                vertical-align: middle;
            }

            .booking-table tbody tr {
                transition: .2s ease;
            }

                .booking-table tbody tr:hover {
                    background: #f8fbff;
                }

                .booking-table tbody tr:last-child td {
                    border-bottom: none;
                }

        /* =========================================================
           BOOKING ID
           ========================================================= */

        .booking-id {
            display: inline-flex;
            align-items: center;
            padding: 5px 8px;
            background: #eaf3ff;
            border-radius: 6px;
            color: #1976d2;
            font-size: 10px;
            font-weight: 800;
        }

        /* =========================================================
           STUDENT
           ========================================================= */

        .student-name {
            display: block;
            color: #172033;
            font-size: 11px;
            font-weight: 800;
        }

        .student-id {
            display: block;
            margin-top: 3px;
            color: #8a98a9;
            font-size: 8px;
        }

        /* =========================================================
           LESSON
           ========================================================= */

        .lesson-date {
            display: block;
            color: #172033;
            font-size: 10px;
            font-weight: 700;
        }

        .lesson-time {
            display: block;
            margin-top: 3px;
            color: #718096;
            font-size: 9px;
        }

        /* =========================================================
           PERSON
           ========================================================= */

        .person-info {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .small-avatar {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eaf3ff;
            color: #1976d2;
            font-size: 10px;
            font-weight: 800;
        }

        .person-name {
            color: #425466;
            font-size: 10px;
            font-weight: 700;
        }

        /* =========================================================
           VEHICLE
           ========================================================= */

        .vehicle-info {
            display: block;
            color: #172033;
            font-size: 10px;
            font-weight: 700;
        }

        .vehicle-registration {
            display: block;
            margin-top: 3px;
            color: #718096;
            font-size: 8px;
        }

        /* =========================================================
           STATUS
           ========================================================= */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 9px;
            border-radius: 20px;
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .status-booked {
            background: #eaf3ff;
            border: 1px solid #cfe3fa;
            color: #1976d2;
        }

        .status-completed {
            background: #eafaf3;
            border: 1px solid #cdeedf;
            color: #159a68;
        }

        .status-cancelled {
            background: #f1f3f5;
            border: 1px solid #e0e4e8;
            color: #7b8794;
        }

        /* =========================================================
           ATTENDANCE
           ========================================================= */

        .attendance {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }

        .attendance-confirmed {
            color: #159a68;
        }

        .attendance-pending {
            color: #d88900;
        }

        .attendance-absent {
            color: #d64545;
        }

        /* =========================================================
           EMPTY STATE
           ========================================================= */

        .empty-card {
            padding: 75px 30px;
            text-align: center;
        }

        .empty-icon {
            width: 68px;
            height: 68px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eaf3ff;
            color: #1976d2;
            font-size: 25px;
        }

        .empty-card h3 {
            margin: 0 0 7px;
            color: #172033;
            font-size: 17px;
            font-weight: 800;
        }

        .empty-card p {
            margin: 0;
            color: #718096;
            font-size: 11px;
        }

        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 900px) {

            .summary-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 750px) {

            .booking-page {
                padding: 20px 15px;
            }

            .page-header {
                flex-direction: column;
                align-items: stretch;
            }

            .dashboard-button {
                width: 100%;
            }

            .header-left {
                align-items: flex-start;
            }
        }
    </style>

</head>

<body>

    <div class="booking-page">

        <div class="booking-container">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <div class="page-header">

                <div class="header-left">

                    <div class="header-icon">

                        <i class="fa-solid fa-calendar-check"></i>

                    </div>

                    <div>

                        <h1>
                            Bookings
                        </h1>

                        <p>
                            View and monitor all driving lesson bookings.
                        </p>

                    </div>

                </div>

                <a href="@Url.Action("Index", "Admin")"
                   class="dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Dashboard

                </a>

            </div>


            <!-- =====================================================
                 SUMMARY
                 ===================================================== -->

            <div class="summary-grid">

                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fa-solid fa-calendar-check"></i>

                    </div>

                    <div class="summary-text">

                        <strong>
                            @(Model == null ? 0 : Model.Count())
                        </strong>

                        <span>
                            Total Bookings
                        </span>

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <div class="summary-text">

                        <strong>
                            @(Model == null
                            ? 0
                            : Model.Count(b =>
                                b.Status != null &&
                                b.Status.Equals(
                                    "Booked",
                                    StringComparison.OrdinalIgnoreCase)))
                        </strong>

                        <span>
                            Active Bookings
                        </span>

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fa-solid fa-circle-check"></i>

                    </div>

                    <div class="summary-text">

                        <strong>
                            @(Model == null
                            ? 0
                            : Model.Count(b =>
                                b.Status != null &&
                                b.Status.Equals(
                                    "Completed",
                                    StringComparison.OrdinalIgnoreCase)))
                        </strong>

                        <span>
                            Completed Lessons
                        </span>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 BOOKINGS PANEL
                 ===================================================== -->

            <div class="bookings-panel">


                <!-- PANEL HEADER -->

                <div class="panel-header">

                    <div class="panel-title">

                        <div class="panel-title-icon">

                            <i class="fa-solid fa-list"></i>

                        </div>

                        <div>

                            <h2>
                                All Bookings
                            </h2>

                            <span>
                                Student lesson booking records
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOOKINGS
                     ================================================= -->

                @if (Model != null && Model.Any())
                {

                    <div class="table-wrapper">

                        <table class="booking-table">

                            <thead>

                                <tr>

                                    <th>
                                        Booking
                                    </th>

                                    <th>
                                        Student
                                    </th>

                                    <th>
                                        Lesson
                                    </th>

                                    <th>
                                        Instructor
                                    </th>

                                    <th>
                                        Vehicle
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Attendance
                                    </th>

                                    <th>
                                        Booked On
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var booking in Model)
                                {

                                    /*
                                     * =================================================
                                     * STUDENT INFORMATION
                                     * =================================================
                                     */

                                    var studentName = "Unknown Student";
                                    var studentId = "";

                                    if (booking.Registration != null)
                                    {
                                        studentName =
                                            (booking.Registration.FirstName ?? "")
                                            + " "
                                            + (booking.Registration.LastName ?? "");

                                        studentName = studentName.Trim();

                                        studentId =
                                            booking.Registration.RegistrationId ?? "";
                                    }


                                    /*
                                     * =================================================
                                     * INSTRUCTOR INFORMATION
                                     * =================================================
                                     */

                                    var instructorName = "Not Assigned";
                                    var instructorInitial = "I";

                                    if (booking.LessonSchedule != null &&
                                        booking.LessonSchedule.Instructor != null)
                                    {
                                        var instructor =
                                            booking.LessonSchedule.Instructor;

                                        instructorName =
                                            (instructor.FirstName ?? "")
                                            + " "
                                            + (instructor.LastName ?? "");

                                        instructorName =
                                            instructorName.Trim();

                                        if (!string.IsNullOrEmpty(
                                            instructor.FirstName))
                                        {
                                            instructorInitial =
                                                instructor.FirstName
                                                    .Substring(0, 1)
                                                    .ToUpper();
                                        }
                                    }


                                    /*
                                     * =================================================
                                     * VEHICLE INFORMATION
                                     * =================================================
                                     */

                                    var vehicleName = "Not Assigned";
                                    var vehicleRegistration = "";

                                    if (booking.LessonSchedule != null &&
                                        booking.LessonSchedule.Vehicle != null)
                                    {
                                        var vehicle =
                                            booking.LessonSchedule.Vehicle;

                                        vehicleName =
                                            (vehicle.Make ?? "")
                                            + " "
                                            + (vehicle.Model ?? "");

                                        vehicleName =
                                            vehicleName.Trim();

                                        vehicleRegistration =
                                            vehicle.RegistrationNumber ?? "";
                                    }


                                    /*
                                     * =================================================
                                     * LESSON INFORMATION
                                     * =================================================
                                     */

                                    var lessonDate = "";
                                    var lessonTime = "Schedule unavailable";

                                    if (booking.LessonSchedule != null)
                                    {
                                        lessonDate =
                                            booking.LessonSchedule.LessonDate
                                                .ToString("dd MMM yyyy");

                                        lessonTime =
                                            booking.LessonSchedule.StartTime
                                                .ToString(@"hh\:mm")
                                            + " - "
                                            + booking.LessonSchedule.EndTime
                                                .ToString(@"hh\:mm");
                                    }


                                    /*
                                     * =================================================
                                     * STATUS
                                     * =================================================
                                     */

                                    var statusText =
                                        string.IsNullOrEmpty(booking.Status)
                                        ? "Unknown"
                                        : booking.Status;

                                    var statusClass = "status-booked";
                                    var statusIcon = "fa-calendar-check";

                                    if (string.Equals(
                                        booking.Status,
                                        "Completed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        statusClass = "status-completed";
                                        statusIcon = "fa-check";
                                    }
                                    else if (string.Equals(
                                        booking.Status,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        statusClass = "status-cancelled";
                                        statusIcon = "fa-ban";
                                    }


                                    /*
                                     * =================================================
                                     * ATTENDANCE
                                     * =================================================
                                     */

                                    var attendanceText =
                                        string.IsNullOrEmpty(
                                            booking.AttendanceStatus)
                                        ? "Pending"
                                        : booking.AttendanceStatus;

                                    var attendanceClass =
                                        "attendance-pending";

                                    var attendanceIcon = "fa-clock";

                                    if (string.Equals(
                                        booking.AttendanceStatus,
                                        "Confirmed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        attendanceClass =
                                            "attendance-confirmed";

                                        attendanceIcon = "fa-check";
                                    }
                                    else if (string.Equals(
                                        booking.AttendanceStatus,
                                        "Absent",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        attendanceClass =
                                            "attendance-absent";

                                        attendanceIcon = "fa-xmark";
                                    }


                                    <!-- =================================================
                                         ROW
                                         ================================================= -->

                                    <tr>


                                        <!-- BOOKING -->

                                        <td>

                                            <span class="booking-id">

                                                #@booking.BookingId

                                            </span>

                                        </td>


                                        <!-- STUDENT -->

                                        <td>

                                            <span class="student-name">

                                                @studentName

                                            </span>

                                            @if (!string.IsNullOrEmpty(studentId))
                                            {
                                                <span class="student-id">

                                                    ID: @studentId

                                                </span>
                                            }

                                        </td>


                                        <!-- LESSON -->

                                        <td>

                                            @if (booking.LessonSchedule != null)
                                            {
                                                <span class="lesson-date">

                                                    @lessonDate

                                                </span>

                                                <span class="lesson-time">

                                                    @lessonTime

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="lesson-time">

                                                    Schedule unavailable

                                                </span>
                                            }

                                        </td>


                                        <!-- INSTRUCTOR -->

                                        <td>

                                            <div class="person-info">

                                                <div class="small-avatar">

                                                    @instructorInitial

                                                </div>

                                                <span class="person-name">

                                                    @instructorName

                                                </span>

                                            </div>

                                        </td>


                                        <!-- VEHICLE -->

                                        <td>

                                            @if (booking.LessonSchedule != null &&
                                                booking.LessonSchedule.Vehicle != null)
                                            {
                                                <span class="vehicle-info">

                                                    @vehicleName

                                                </span>

                                                <span class="vehicle-registration">

                                                    @vehicleRegistration

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vehicle-info">

                                                    Not Assigned

                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <span class="status @statusClass">

                                                <i class="fa-solid @statusIcon"></i>

                                                @statusText

                                            </span>

                                        </td>


                                        <!-- ATTENDANCE -->

                                        <td>

                                            <span class="attendance @attendanceClass">

                                                <i class="fa-solid @attendanceIcon"></i>

                                                @attendanceText

                                            </span>

                                        </td>


                                        <!-- BOOKED ON -->

                                        <td>

                                            <span class="lesson-date">

                                                @booking.BookingDate.ToString(
                                                    "dd MMM yyyy")

                                            </span>

                                            <span class="lesson-time">

                                                @booking.BookingDate.ToString(
                                                    "HH:mm")

                                            </span>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <!-- =================================================
                         EMPTY STATE
                         ================================================= -->

                    <div class="empty-card">

                        <div class="empty-icon">

                            <i class="fa-solid fa-calendar-xmark"></i>

                        </div>

                        <h3>
                            No Bookings Found
                        </h3>

                        <p>
                            There are currently no driving lesson bookings
                            in the system.
                        </p>

                    </div>

                }

            </div>

        </div>

    </div>

</body>
</html>