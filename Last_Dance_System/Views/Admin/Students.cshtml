@model IEnumerable<Last_Dance_System.Models.Registration>

@{
    Layout = null;
    ViewBag.Title = "Students";
}

<!DOCTYPE html>

<html>
<head>

    
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Students - Last Dance Driving School</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

            /* =========================================================
           GLOBAL
        ========================================================= */

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                background: #f4f8fc;
                color: #172b4d;
                font-family: "Segoe UI", Arial, sans-serif;
            }


            /* =========================================================
           PAGE
        ========================================================= */

            .student-page {
                min-height: 100vh;
                padding: 35px 25px 60px;
                background: radial-gradient( circle at 10% 10%, rgba(33, 150, 243, 0.10), transparent 28% ), radial-gradient( circle at 90% 90%, rgba(13, 71, 161, 0.07), transparent 30% ), linear-gradient( 135deg, #f8fbff 0%, #f1f6fb 50%, #eaf2f9 100% );
            }


            .student-container {
                width: 100%;
                max-width: 1350px;
                margin: 0 auto;
            }


            /* =========================================================
           HEADER
        ========================================================= */

            .page-header {
                position: relative;
                overflow: hidden;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 25px;
                margin-bottom: 22px;
                padding: 25px 30px;
                background: linear-gradient( 135deg, #ffffff 0%, #f7fbff 55%, #eaf4ff 100% );
                border: 1px solid #dce7f1;
                border-radius: 18px;
                box-shadow: 0 15px 40px rgba(23, 43, 77, 0.08), 0 4px 12px rgba(23, 43, 77, 0.04);
            }


                .page-header::before {
                    content: "";
                    position: absolute;
                    width: 280px;
                    height: 280px;
                    right: -120px;
                    top: -160px;
                    border-radius: 50%;
                    background: rgba(33, 150, 243, 0.06);
                }


            .header-left {
                position: relative;
                z-index: 2;
                display: flex;
                align-items: center;
                gap: 15px;
            }


            /* =========================================================
           HEADER ICON
        ========================================================= */

            .header-icon {
                width: 55px;
                height: 55px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 13px;
                background: linear-gradient( 135deg, #2196f3, #1565c0 );
                color: #ffffff;
                font-size: 21px;
                box-shadow: 0 8px 20px rgba(33, 150, 243, 0.22);
            }


            /* =========================================================
           HEADER TEXT
        ========================================================= */

            .page-header h1 {
                margin: 0 0 5px;
                color: #172b4d;
                font-size: 25px;
                font-weight: 800;
                letter-spacing: -0.3px;
            }


            .page-header p {
                margin: 0;
                color: #71859a;
                font-size: 12px;
            }


            /* =========================================================
           HEADER ACTIONS
        ========================================================= */

            .header-actions {
                position: relative;
                z-index: 3;
                display: flex;
                align-items: center;
                gap: 10px;
            }


            .action-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 42px;
                padding: 11px 17px;
                border-radius: 9px;
                font-size: 11px;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
                transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
            }


            /* =========================================================
           BACK BUTTON
        ========================================================= */

            .back-button {
                background: #ffffff;
                border: 1px solid #d4e0eb;
                color: #34495e;
            }


                .back-button i {
                    color: #1976d2;
                }


                .back-button:hover {
                    background: #edf6ff;
                    border-color: #2196f3;
                    color: #1565c0;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 15px rgba(33, 150, 243, 0.10);
                }


            /* =========================================================
           TOP CONTROLS
        ========================================================= */

            .controls-card {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                margin-bottom: 20px;
                padding: 17px 20px;
                background: #ffffff;
                border: 1px solid #dce7f1;
                border-radius: 14px;
                box-shadow: 0 8px 25px rgba(23, 43, 77, 0.06);
            }


            /* =========================================================
           SUMMARY
        ========================================================= */

            .summary {
                display: flex;
                align-items: center;
                gap: 12px;
            }


            .summary-icon {
                width: 42px;
                height: 42px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                background: #edf6ff;
                color: #1976d2;
                font-size: 16px;
            }


            .summary-text strong {
                display: block;
                color: #172b4d;
                font-size: 20px;
                font-weight: 800;
            }


            .summary-text span {
                display: block;
                margin-top: 1px;
                color: #8193a7;
                font-size: 9px;
            }


            /* =========================================================
           SEARCH
        ========================================================= */

            .search-wrapper {
                position: relative;
                width: 300px;
            }


                .search-wrapper i {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #8aa0b5;
                    font-size: 12px;
                }


            .search-input {
                width: 100%;
                height: 40px;
                padding: 0 14px 0 37px;
                background: #f8fbff;
                border: 1px solid #dce7f1;
                border-radius: 9px;
                outline: none;
                color: #34495e;
                font-size: 11px;
            }


                .search-input:focus {
                    background: #ffffff;
                    border-color: #2196f3;
                    box-shadow: 0 0 0 3px rgba(33, 150, 243, .08);
                }


            /* =========================================================
           VIEW TOGGLE
        ========================================================= */

            .view-toggle {
                display: flex;
                padding: 4px;
                background: #f1f6fb;
                border: 1px solid #dce7f1;
                border-radius: 10px;
            }


            .view-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                padding: 8px 12px;
                border: none;
                border-radius: 7px;
                background: transparent;
                color: #71859a;
                font-size: 10px;
                font-weight: 800;
                cursor: pointer;
                transition: .2s ease;
            }


                .view-btn.active {
                    background: #ffffff;
                    color: #1976d2;
                    box-shadow: 0 3px 8px rgba(23, 43, 77, .08);
                }


                .view-btn i {
                    font-size: 11px;
                }


            /* =========================================================
           STUDENT GRID
        ========================================================= */

            .student-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
            }


            /* =========================================================
           STUDENT CARD
        ========================================================= */

            .student-card {
                overflow: hidden;
                background: #ffffff;
                border: 1px solid #dce7f1;
                border-radius: 16px;
                box-shadow: 0 8px 25px rgba(23, 43, 77, 0.06);
                transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
            }


                .student-card:hover {
                    transform: translateY(-4px);
                    border-color: #b9d9f5;
                    box-shadow: 0 15px 35px rgba(23, 43, 77, 0.11);
                }


            /* =========================================================
           CARD TOP
        ========================================================= */

            .card-top {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 20px;
                background: linear-gradient( 135deg, #ffffff, #f8fbff );
                border-bottom: 1px solid #e5edf5;
            }


            /* =========================================================
           AVATAR
        ========================================================= */

            .student-avatar {
                width: 58px;
                height: 58px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: linear-gradient( 135deg, #2196f3, #1565c0 );
                color: #ffffff;
                font-size: 18px;
                font-weight: 800;
                box-shadow: 0 7px 18px rgba(33, 150, 243, 0.20);
            }


            /* =========================================================
           STUDENT NAME
        ========================================================= */

            .student-name {
                min-width: 0;
            }


                .student-name h3 {
                    margin: 0 0 4px;
                    color: #172b4d;
                    font-size: 15px;
                    font-weight: 800;
                    word-break: break-word;
                }


                .student-name span {
                    color: #8193a7;
                    font-size: 10px;
                }


            /* =========================================================
           CARD BODY
        ========================================================= */

            .card-body {
                padding: 20px;
            }


            /* =========================================================
           INFO ROW
        ========================================================= */

            .info-row {
                display: flex;
                align-items: flex-start;
                gap: 11px;
                margin-bottom: 14px;
            }


                .info-row:last-child {
                    margin-bottom: 0;
                }


            /* =========================================================
           INFO ICON
        ========================================================= */

            .info-icon {
                width: 29px;
                height: 29px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 7px;
                background: #edf6ff;
                color: #1976d2;
                font-size: 11px;
            }


            /* =========================================================
           INFO CONTENT
        ========================================================= */

            .info-content {
                min-width: 0;
            }


            .info-label {
                display: block;
                margin-bottom: 2px;
                color: #8193a7;
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: .4px;
            }


            .info-value {
                display: block;
                color: #34495e;
                font-size: 11px;
                font-weight: 600;
                word-break: break-word;
            }


            /* =========================================================
           STATUS
        ========================================================= */

            .status {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 5px 9px;
                border-radius: 20px;
                font-size: 8px;
                font-weight: 800;
                text-transform: uppercase;
            }


            .status-active {
                background: #eefaf5;
                border: 1px solid #c9eedf;
                color: #159463;
            }


            .status-inactive {
                background: #fff8ed;
                border: 1px solid #f6d7a5;
                color: #b76e00;
            }


            /* =========================================================
           CARD FOOTER
        ========================================================= */

            .card-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                padding: 15px 20px;
                background: #f8fbff;
                border-top: 1px solid #e5edf5;
            }


            .registration-text {
                color: #8193a7;
                font-size: 9px;
            }


                .registration-text strong {
                    color: #34495e;
                }


            /* =========================================================
           LIST VIEW
        ========================================================= */

            .list-container {
                display: none;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid #dce7f1;
                border-radius: 16px;
                box-shadow: 0 8px 25px rgba(23, 43, 77, 0.06);
            }


            .list-wrapper {
                width: 100%;
                overflow-x: auto;
            }


            .student-table {
                width: 100%;
                border-collapse: collapse;
                min-width: 900px;
            }


                .student-table th {
                    padding: 14px 18px;
                    text-align: left;
                    background: #f7fbff;
                    border-bottom: 1px solid #e1eaf3;
                    color: #71859a;
                    font-size: 9px;
                    font-weight: 800;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                }


                .student-table td {
                    padding: 14px 18px;
                    border-bottom: 1px solid #edf2f7;
                    color: #34495e;
                    font-size: 11px;
                }


                .student-table tbody tr:last-child td {
                    border-bottom: none;
                }


                .student-table tbody tr:hover td {
                    background: #f8fbff;
                }


            .list-student {
                display: flex;
                align-items: center;
                gap: 10px;
            }


            .list-avatar {
                width: 38px;
                height: 38px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: linear-gradient( 135deg, #2196f3, #1565c0 );
                color: #ffffff;
                font-size: 11px;
                font-weight: 800;
            }


            .list-name strong {
                display: block;
                color: #172b4d;
                font-size: 11px;
            }


            .list-name span {
                display: block;
                margin-top: 2px;
                color: #8193a7;
                font-size: 8px;
            }


            .list-info {
                display: flex;
                align-items: center;
                gap: 7px;
            }


                .list-info i {
                    color: #1976d2;
                    font-size: 10px;
                }


            /* =========================================================
           EMPTY STATE
        ========================================================= */

            .empty-card {
                padding: 60px 30px;
                background: #ffffff;
                border: 1px solid #dce7f1;
                border-radius: 16px;
                text-align: center;
                box-shadow: 0 8px 25px rgba(23, 43, 77, 0.06);
            }


            .empty-icon {
                width: 65px;
                height: 65px;
                margin: 0 auto 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #edf6ff;
                color: #1976d2;
                font-size: 25px;
            }


            .empty-card h3 {
                margin: 0 0 7px;
                color: #172b4d;
                font-size: 16px;
                font-weight: 800;
            }


            .empty-card p {
                margin: 0;
                color: #8193a7;
                font-size: 11px;
            }


            /* =========================================================
           NO SEARCH RESULTS
        ========================================================= */

            .no-results {
                display: none;
                padding: 50px 20px;
                text-align: center;
            }


            .no-results-icon {
                width: 55px;
                height: 55px;
                margin: 0 auto 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #edf6ff;
                color: #1976d2;
                font-size: 20px;
            }


            .no-results h3 {
                margin: 0 0 5px;
                color: #172b4d;
                font-size: 15px;
            }


            .no-results p {
                margin: 0;
                color: #8193a7;
                font-size: 10px;
            }


            /* =========================================================
           RESPONSIVE
        ========================================================= */

            @@media (max-width: 1100px) {

                .student-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }


            @@media (max-width: 800px) {

                .controls-card {
                    flex-direction: column;
                    align-items: stretch;
                }


                .search-wrapper {
                    width: 100%;
                }


                .view-toggle {
                    width: 100%;
                }


                .view-btn {
                    flex: 1;
                }
            }


            @@media (max-width: 750px) {

                .student-page {
                    padding: 20px 15px;
                }


                .page-header {
                    flex-direction: column;
                    align-items: stretch;
                }


                .header-left {
                    width: 100%;
                }


                .header-actions {
                    width: 100%;
                }


                .action-button {
                    width: 100%;
                }


                .student-grid {
                    grid-template-columns: 1fr;
                }
            }


            @@media (max-width: 500px) {

                .page-header {
                    padding: 20px;
                }


                .header-left {
                    align-items: flex-start;
                }


                .page-header h1 {
                    font-size: 21px;
                }


                .header-icon {
                    width: 46px;
                    height: 46px;
                }


                .card-top {
                    padding: 17px;
                }


                .card-body {
                    padding: 17px;
                }


                .card-footer {
                    padding: 13px 17px;
                }
            }
    </style>
    

</head>

<body>

    
    <div class="student-page">

        <div class="student-container">


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <div class="page-header">

                <div class="header-left">

                    <div class="header-icon">

                        <i class="fa-solid fa-users"></i>

                    </div>


                    <div>

                        <h1>
                            Students
                        </h1>

                        <p>
                            View and manage all registered students.
                        </p>

                    </div>

                </div>


                <!-- BACK TO DASHBOARD -->

                <div class="header-actions">

                    <a href="@Url.Action("Index", "Admin")"
                       class="action-button back-button">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Dashboard

                    </a>

                </div>

            </div>


            <!-- =====================================================
                 CONTROLS
            ====================================================== -->

            <div class="controls-card">


                <!-- SUMMARY -->

                <div class="summary">

                    <div class="summary-icon">

                        <i class="fa-solid fa-user-group"></i>

                    </div>


                    <div class="summary-text">

                        <strong id="studentCount">

                            @(Model == null ? 0 : Model.Count())

                        </strong>

                        <span>
                            Registered Students
                        </span>

                    </div>

                </div>


                <!-- SEARCH -->

                <div class="search-wrapper">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           id="studentSearch"
                           class="search-input"
                           placeholder="Search students..." />

                </div>


                <!-- VIEW TOGGLE -->

                <div class="view-toggle">

                    <button type="button"
                            id="cardViewBtn"
                            class="view-btn active">

                        <i class="fa-solid fa-grip"></i>

                        Cards

                    </button>


                    <button type="button"
                            id="listViewBtn"
                            class="view-btn">

                        <i class="fa-solid fa-list"></i>

                        List

                    </button>

                </div>

            </div>


            @if (Model != null && Model.Any())
            {


                <!-- =================================================
                     CARD VIEW
                ================================================== -->

                <div id="cardView"
                     class="student-grid">


                    @foreach (var student in Model)
                    {

                        var initials = "";

                        if (!string.IsNullOrEmpty(student.FirstName))
                        {
                            initials += student.FirstName
                                .Substring(0, 1)
                                .ToUpper();
                        }


                        if (!string.IsNullOrEmpty(student.LastName))
                        {
                            initials += student.LastName
                                .Substring(0, 1)
                                .ToUpper();
                        }


                        if (string.IsNullOrEmpty(initials))
                        {
                            initials = "?";
                        }


                        <div class="student-card student-item"
                             data-search="@(
                             (student.FirstName ?? "") + " " +
                             (student.LastName ?? "") + " " +
                             (student.Email ?? "") + " " +
                             (student.Phone ?? "") + " " +
                             (student.RegistrationId ?? "")
                         )">


                            <!-- CARD TOP -->

                            <div class="card-top">

                                <div class="student-avatar">

                                    @initials

                                </div>


                                <div class="student-name">

                                    <h3>

                                        @student.FirstName
                                        @student.LastName

                                    </h3>


                                    <span>

                                        Driving School Student

                                    </span>

                                </div>

                            </div>


                            <!-- CARD BODY -->

                            <div class="card-body">


                                <!-- EMAIL -->

                                <div class="info-row">

                                    <div class="info-icon">

                                        <i class="fa-solid fa-envelope"></i>

                                    </div>


                                    <div class="info-content">

                                        <span class="info-label">
                                            Email
                                        </span>

                                        <span class="info-value">

                                            @(string.IsNullOrEmpty(student.Email)
                                            ? "Not provided"
                                            : student.Email)

                                        </span>

                                    </div>

                                </div>


                                <!-- PHONE -->

                                <div class="info-row">

                                    <div class="info-icon">

                                        <i class="fa-solid fa-phone"></i>

                                    </div>


                                    <div class="info-content">

                                        <span class="info-label">
                                            Phone
                                        </span>

                                        <span class="info-value">

                                            @(string.IsNullOrEmpty(student.Phone)
                                            ? "Not provided"
                                            : student.Phone)

                                        </span>

                                    </div>

                                </div>


                                <!-- ID NUMBER -->

                                <div class="info-row">

                                    <div class="info-icon">

                                        <i class="fa-solid fa-id-card"></i>

                                    </div>


                                    <div class="info-content">

                                        <span class="info-label">
                                            ID Number
                                        </span>

                                        <span class="info-value">

                                            @student.RegistrationId

                                        </span>

                                    </div>

                                </div>


                                <!-- GENDER -->

                                <div class="info-row">

                                    <div class="info-icon">

                                        <i class="fa-solid fa-venus-mars"></i>

                                    </div>


                                    <div class="info-content">

                                        <span class="info-label">
                                            Gender
                                        </span>

                                        <span class="info-value">

                                            @(string.IsNullOrEmpty(student.Gender)
                                            ? "Not provided"
                                            : student.Gender)

                                        </span>

                                    </div>

                                </div>


                                <!-- ACCOUNT STATUS -->

                                <div class="info-row">

                                    <div class="info-icon">

                                        <i class="fa-solid fa-user-check"></i>

                                    </div>


                                    <div class="info-content">

                                        <span class="info-label">
                                            Account Status
                                        </span>


                                        @if (student.ApplicationUser != null)
                                        {

                                            <span class="status status-active">

                                                <i class="fa-solid fa-circle-check"></i>

                                                Active

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status status-inactive">

                                                <i class="fa-solid fa-link-slash"></i>

                                                Not Linked

                                            </span>

                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- CARD FOOTER -->

                            <div class="card-footer">

                                <div class="registration-text">

                                    Registered:

                                    <strong>

                                        @student.RegistrationDate.ToString("dd MMM yyyy")

                                    </strong>

                                </div>

                            </div>


                        </div>

                    }

                </div>


                <!-- =================================================
                     LIST VIEW
                ================================================== -->

                <div id="listView"
                     class="list-container">


                    <div class="list-wrapper">

                        <table class="student-table">

                            <thead>

                                <tr>

                                    <th>
                                        Student
                                    </th>

                                    <th>
                                        Email
                                    </th>

                                    <th>
                                        Phone
                                    </th>

                                    <th>
                                        ID Number
                                    </th>

                                    <th>
                                        Gender
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Registered
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                @foreach (var student in Model)
                                {

                                    var initials = "";

                                    if (!string.IsNullOrEmpty(student.FirstName))
                                    {
                                        initials += student.FirstName
                                            .Substring(0, 1)
                                            .ToUpper();
                                    }


                                    if (!string.IsNullOrEmpty(student.LastName))
                                    {
                                        initials += student.LastName
                                            .Substring(0, 1)
                                            .ToUpper();
                                    }


                                    if (string.IsNullOrEmpty(initials))
                                    {
                                        initials = "?";
                                    }


                                    <tr class="student-list-item"
                                        data-search="@(
                                        (student.FirstName ?? "") + " " +
                                        (student.LastName ?? "") + " " +
                                        (student.Email ?? "") + " " +
                                        (student.Phone ?? "") + " " +
                                        (student.RegistrationId ?? "")
                                    )">


                                        <!-- STUDENT -->

                                        <td>

                                            <div class="list-student">

                                                <div class="list-avatar">

                                                    @initials

                                                </div>


                                                <div class="list-name">

                                                    <strong>

                                                        @student.FirstName
                                                        @student.LastName

                                                    </strong>

                                                    <span>
                                                        Driving School Student
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- EMAIL -->

                                        <td>

                                            <div class="list-info">

                                                <i class="fa-solid fa-envelope"></i>

                                                @(string.IsNullOrEmpty(student.Email)
                                                ? "Not provided"
                                                : student.Email)

                                            </div>

                                        </td>


                                        <!-- PHONE -->

                                        <td>

                                            <div class="list-info">

                                                <i class="fa-solid fa-phone"></i>

                                                @(string.IsNullOrEmpty(student.Phone)
                                                ? "Not provided"
                                                : student.Phone)

                                            </div>

                                        </td>


                                        <!-- ID -->

                                        <td>

                                            @student.RegistrationId

                                        </td>


                                        <!-- GENDER -->

                                        <td>

                                            @(string.IsNullOrEmpty(student.Gender)
                                            ? "Not provided"
                                            : student.Gender)

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @if (student.ApplicationUser != null)
                                            {

                                                <span class="status status-active">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    Active

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="status status-inactive">

                                                    <i class="fa-solid fa-link-slash"></i>

                                                    Not Linked

                                                </span>

                                            }

                                        </td>


                                        <!-- DATE -->

                                        <td>

                                            @student.RegistrationDate.ToString("dd MMM yyyy")

                                        </td>


                                    </tr>

                                }


                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     NO SEARCH RESULTS
                ================================================== -->

                <div id="noResults"
                     class="empty-card"
                     style="display:none;">

                    <div class="no-results-icon">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </div>

                    <h3>
                        No Students Found
                    </h3>

                    <p>
                        No registered student matches your search.
                    </p>

                </div>

            }
            else
            {

                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="fa-solid fa-users"></i>

                    </div>


                    <h3>

                        No Students Found

                    </h3>


                    <p>

                        There are currently no students registered
                        in the system.

                    </p>

                </div>

            }


        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var cardViewBtn =
                document.getElementById("cardViewBtn");

            var listViewBtn =
                document.getElementById("listViewBtn");

            var cardView =
                document.getElementById("cardView");

            var listView =
                document.getElementById("listView");

            var searchInput =
                document.getElementById("studentSearch");

            var noResults =
                document.getElementById("noResults");


            /* =====================================================
               CARD VIEW
            ===================================================== */

            cardViewBtn.addEventListener("click", function () {

                cardView.style.display = "grid";

                listView.style.display = "none";

                cardViewBtn.classList.add("active");

                listViewBtn.classList.remove("active");

                performSearch();

            });


            /* =====================================================
               LIST VIEW
            ===================================================== */

            listViewBtn.addEventListener("click", function () {

                cardView.style.display = "none";

                listView.style.display = "block";

                listViewBtn.classList.add("active");

                cardViewBtn.classList.remove("active");

                performSearch();

            });


            /* =====================================================
               SEARCH
            ===================================================== */

            searchInput.addEventListener(
                "input",
                performSearch
            );


            function performSearch() {

                var searchValue =
                    searchInput.value
                        .toLowerCase()
                        .trim();


                var cardItems =
                    document.querySelectorAll(
                        ".student-item"
                    );


                var listItems =
                    document.querySelectorAll(
                        ".student-list-item"
                    );


                var visibleCount = 0;


                /* CARD SEARCH */

                cardItems.forEach(function (item) {

                    var searchText =
                        item
                            .getAttribute("data-search")
                            .toLowerCase();


                    if (
                        searchText.indexOf(searchValue) !== -1
                    ) {

                        item.style.display = "";

                        visibleCount++;

                    }
                    else {

                        item.style.display = "none";

                    }

                });


                /* LIST SEARCH */

                listItems.forEach(function (item) {

                    var searchText =
                        item
                            .getAttribute("data-search")
                            .toLowerCase();


                    if (
                        searchText.indexOf(searchValue) !== -1
                    ) {

                        item.style.display = "";

                    }
                    else {

                        item.style.display = "none";

                    }

                });


                /* NO RESULTS */

                if (
                    searchValue !== "" &&
                    visibleCount === 0
                ) {

                    noResults.style.display = "block";

                    cardView.style.display = "none";

                    listView.style.display = "none";

                }
                else {

                    noResults.style.display = "none";

                    if (
                        cardViewBtn.classList.contains("active")
                    ) {

                        cardView.style.display = "grid";

                    }
                    else {

                        listView.style.display = "block";

                    }

                }

            }

        });

    </script>
    
</body>
</html>
