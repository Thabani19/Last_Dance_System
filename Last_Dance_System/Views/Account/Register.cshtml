@model Last_Dance_System.Models.RegisterViewModel

@{
    ViewBag.Title = "TK Driving School — Student Registration";
}

<style>

    /* =========================================
       TK DRIVING SCHOOL - RED AUTOMOTIVE THEME
       ========================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        background: #050a12;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================
       MAIN PAGE
       ========================================= */

    .register-page {
        min-height: 100vh;
        background: radial-gradient( circle at 85% 15%, rgba(229, 57, 53, 0.12), transparent 28% ), radial-gradient( circle at 10% 90%, rgba(229, 57, 53, 0.07), transparent 25% ), linear-gradient( 135deg, #050a12 0%, #07111e 50%, #03070d 100% );
    }


    /* =========================================
       RED HAZARD STRIPE
       ========================================= */

    .hazard-stripe {
        height: 8px;
        width: 100%;
        background: repeating-linear-gradient( -45deg, #e53935 0, #e53935 14px, #07111e 14px, #07111e 28px );
    }


    /* =========================================
       NAVIGATION
       ========================================= */

    .register-nav {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 22px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    /* BRAND */

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .logo {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #ef5350, #b71c1c );
        color: #ffffff;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: -1px;
        box-shadow: 0 8px 25px rgba(229, 57, 53, 0.30);
    }


    .brand-text {
        display: flex;
        flex-direction: column;
    }


    .brand-name {
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .brand-subtitle {
        color: #718397;
        font-size: 11px;
        margin-top: 2px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }


    /* LOGIN NAV BUTTON */

    .nav-login {
        color: #ffffff;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.25s ease;
    }


        .nav-login:hover {
            background: #e53935;
            border-color: #e53935;
            color: #ffffff;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(229,57,53,0.25);
        }


    /* =========================================
       MAIN
       ========================================= */

    .register-main {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 25px 30px 70px;
    }


    .register-layout {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        min-height: 780px;
        background: #0b1420;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0,0,0,0.65), 0 0 60px rgba( 229, 57, 53, 0.06 );
    }


    /* =========================================
       LEFT AUTOMOTIVE SIDE
       ========================================= */

    .register-intro {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(2,7,14,0.96), rgba(5,18,32,0.82) ), url("https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1400&q=85") center / cover no-repeat;
    }


        .register-intro::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(3,8,15,0.97) 0%, rgba(3,8,15,0.70) 55%, rgba(3,8,15,0.88) 100% );
        }


        .register-intro::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 180px;
            background: linear-gradient( to top, rgba(3,8,15,0.95), transparent );
        }


    .intro-content {
        position: relative;
        z-index: 2;
        min-height: 780px;
        padding: 50px;
        display: flex;
        flex-direction: column;
    }


    /* =========================================
       INTRO LABEL
       ========================================= */

    .intro-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 8px 13px;
        border-radius: 50px;
        background: rgba(229,57,53,0.10);
        border: 1px solid rgba(229,57,53,0.25);
        color: #ef5350;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }


    .intro-label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #e53935;
        box-shadow: 0 0 10px rgba( 229, 57, 53, 0.8 );
    }


    /* =========================================
       HERO
       ========================================= */

    .intro-hero {
        margin-top: auto;
        margin-bottom: auto;
        max-width: 430px;
    }


        .intro-hero h1 {
            margin: 22px 0 18px;
            font-size: 52px;
            line-height: 1.03;
            font-weight: 900;
            letter-spacing: -2px;
        }


            .intro-hero h1 span {
                color: #e53935;
            }


        .intro-hero p {
            margin: 0;
            max-width: 400px;
            color: #b7c3d0;
            font-size: 15px;
            line-height: 1.7;
        }


    /* =========================================
       FEATURES
       ========================================= */

    .intro-features {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: auto;
    }


    .intro-feature {
        width: fit-content;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 15px;
        background: rgba(255,255,255,0.045);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 9px;
        color: #d6e0ea;
        font-size: 12px;
        font-weight: 600;
    }


    .intro-feature-icon {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(229,57,53,0.12);
        color: #ef5350;
        font-size: 11px;
        font-weight: 900;
    }


    /* =========================================
       RIGHT FORM SIDE
       ========================================= */

    .register-form-side {
        background: #0c1724;
        padding: 48px 55px;
        max-height: 900px;
        overflow-y: auto;
    }


    .register-form-container {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }


    /* =========================================
       FORM HEADER
       ========================================= */

    .form-header {
        margin-bottom: 30px;
    }


        .form-header h2 {
            margin: 0 0 8px;
            color: #ffffff;
            font-size: 31px;
            font-weight: 800;
            letter-spacing: -0.7px;
        }


        .form-header p {
            margin: 0;
            color: #718397;
            font-size: 13px;
            line-height: 1.6;
        }


    .form-header-line {
        width: 55px;
        height: 3px;
        margin-top: 17px;
        border-radius: 5px;
        background: #e53935;
        box-shadow: 0 0 12px rgba( 229, 57, 53, 0.45 );
    }


    /* =========================================
       VALIDATION SUMMARY
       ========================================= */

    .validation-summary-errors {
        background: rgba(220,53,69,0.10);
        border: 1px solid rgba(220,53,69,0.25);
        border-radius: 10px;
        padding: 12px 15px;
        color: #ff7b86;
        margin-bottom: 22px;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================
       SECTION TITLE
       ========================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 29px 0 19px;
        padding-bottom: 11px;
        border-bottom: 1px solid #1c2b3b;
        color: #ffffff;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }


    .section-number {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(229,57,53,0.11);
        border: 1px solid rgba(229,57,53,0.24);
        color: #ef5350;
        font-size: 11px;
        font-weight: 900;
    }


    /* =========================================
       ROW
       ========================================= */

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-left: -8px;
        margin-right: -8px;
    }


    .col-md-6 {
        width: 50%;
        padding-left: 8px;
        padding-right: 8px;
    }


    /* =========================================
       FORM GROUP
       ========================================= */

    .form-group {
        margin-bottom: 17px;
    }


    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #d9e2ec;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }


    /* =========================================
       INPUTS
       ========================================= */

    .form-control {
        width: 100%;
        height: 48px;
        padding: 10px 13px;
        border: 1px solid #26384b;
        border-radius: 9px;
        background: #09121d;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }


        .form-control::placeholder {
            color: #52667b;
        }


        .form-control:hover {
            border-color: #35506b;
        }


        .form-control:focus {
            border-color: #e53935;
            background: #0a1522;
            box-shadow: 0 0 0 3px rgba(229,57,53,0.09), 0 0 18px rgba(229,57,53,0.07);
        }


    textarea.form-control {
        min-height: 85px;
        height: 85px;
        resize: vertical;
    }


    input[type="date"] {
        color-scheme: dark;
    }


    /* =========================================
       GENDER
       ========================================= */

    .gender-container {
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 25px;
        padding-left: 3px;
    }


        .gender-container label {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 0;
            color: #9aabba;
            font-size: 12px;
            cursor: pointer;
        }


        .gender-container input {
            width: 16px;
            height: 16px;
            accent-color: #e53935;
            cursor: pointer;
        }


    /* =========================================
       VALIDATION
       ========================================= */

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #ff7b86;
        font-size: 11px;
    }


    /* =========================================
       REGISTER BUTTON
       ========================================= */

    .register-button {
        width: 100%;
        height: 53px;
        margin-top: 10px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #e53935, #b71c1c );
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 8px 25px rgba(229,57,53,0.20);
    }


        .register-button:hover {
            transform: translateY(-2px);
            background: linear-gradient( 135deg, #ef5350, #d32f2f );
            box-shadow: 0 12px 32px rgba(229,57,53,0.32);
        }


        .register-button:active {
            transform: translateY(0);
        }


    /* =========================================
       LOGIN LINK
       ========================================= */

    .login-link {
        text-align: center;
        margin-top: 20px;
        color: #718397;
        font-size: 12px;
    }


        .login-link a {
            color: #ef5350;
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s ease;
        }


            .login-link a:hover {
                color: #ff8a80;
                text-decoration: none;
            }


    /* =========================================
       SECURITY
       ========================================= */

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 19px;
        color: #52667b;
        font-size: 10px;
    }


        .security-note span {
            color: #ef5350;
        }


    /* =========================================
       SCROLLBAR
       ========================================= */

    .register-form-side::-webkit-scrollbar {
        width: 7px;
    }


    .register-form-side::-webkit-scrollbar-track {
        background: #08111c;
    }


    .register-form-side::-webkit-scrollbar-thumb {
        background: #26384b;
        border-radius: 10px;
    }


        .register-form-side::-webkit-scrollbar-thumb:hover {
            background: #35506b;
        }


    /* =========================================
       FOOTER
       ========================================= */

    .register-footer {
        max-width: 1250px;
        margin: 0 auto;
        padding: 0 30px 30px;
        text-align: center;
        color: #52667b;
        font-size: 11px;
    }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 1000px) {

        .register-nav {
            padding: 20px;
        }

        .register-main {
            padding: 20px;
        }

        .register-layout {
            grid-template-columns: 1fr;
        }

        .register-intro {
            min-height: 430px;
        }

        .intro-content {
            min-height: 430px;
            padding: 40px;
        }

        .intro-hero {
            margin-top: 50px;
            margin-bottom: 40px;
        }

            .intro-hero h1 {
                font-size: 43px;
            }

        .register-form-side {
            max-height: none;
            padding: 40px;
        }
    }


    @@media (max-width: 700px) {

        .register-nav {
            padding: 16px;
        }

        .brand-subtitle {
            display: none;
        }

        .brand-name {
            font-size: 16px;
        }

        .logo {
            width: 42px;
            height: 42px;
            font-size: 17px;
        }

        .nav-login {
            padding: 9px 13px;
            font-size: 11px;
        }

        .register-main {
            padding: 12px;
        }

        .register-layout {
            border-radius: 17px;
        }

        .register-intro {
            min-height: 390px;
        }

        .intro-content {
            min-height: 390px;
            padding: 28px;
        }

        .intro-hero h1 {
            font-size: 36px;
            letter-spacing: -1px;
        }

        .intro-hero p {
            font-size: 13px;
        }

        .intro-features {
            display: none;
        }

        .register-form-side {
            padding: 30px 20px;
        }

        .form-header h2 {
            font-size: 26px;
        }

        .col-md-6 {
            width: 100%;
        }

        .register-footer {
            padding: 0 15px 25px;
        }
    }
</style>


<div class="register-page">


    <!-- =========================================
         HAZARD STRIPE
         ========================================= -->

    <div class="hazard-stripe"></div>


    <!-- =========================================
         NAVIGATION
         ========================================= -->

    <nav class="register-nav">


        <!-- BRAND -->

        <div class="brand">

            <div class="logo">
                TK
            </div>


            <div class="brand-text">

                <div class="brand-name">
                    TK Driving School
                </div>

                <div class="brand-subtitle">
                    Learn to drive with confidence
                </div>

            </div>

        </div>


        <!-- LOGIN -->

        <a href="@Url.Action("Login", "Account")"
           class="nav-login">

            Already have an account?

            &nbsp;

            Log in

        </a>

    </nav>



    <!-- =========================================
         MAIN REGISTRATION AREA
         ========================================= -->

    <main class="register-main">

        <div class="register-layout">


            <!-- =====================================
                 LEFT AUTOMOTIVE SIDE
                 ===================================== -->

            <div class="register-intro">

                <div class="intro-content">


                    <!-- LABEL -->

                    <div class="intro-label">

                        <span class="intro-label-dot"></span>

                        Student Registration

                    </div>


                    <!-- HERO -->

                    <div class="intro-hero">

                        <h1>

                            Start your

                            <span>
                                journey.
                            </span>

                        </h1>


                        <p>

                            Create your TK Driving School
                            account and take the first step
                            toward becoming a confident,
                            responsible driver.

                        </p>

                    </div>


                    <!-- FEATURES -->

                    <div class="intro-features">


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Professional Instructors

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Easy Lesson Booking

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Track Your Progress

                        </div>

                    </div>

                </div>

            </div>



            <!-- =====================================
                 RIGHT REGISTRATION FORM
                 ===================================== -->

            <div class="register-form-side">

                <div class="register-form-container">


                    <!-- HEADER -->

                    <div class="form-header">

                        <h2>
                            Create Your Account
                        </h2>

                        <p>
                            Register as a student to begin
                            your driving journey.
                        </p>

                        <div class="form-header-line"></div>

                    </div>


                    @using (Html.BeginForm(
                        "Register",
                        "Account",
                        FormMethod.Post,
                        new { role = "form" }))
                    {

                        @Html.AntiForgeryToken()


                        @Html.ValidationSummary(
                            "",
                            new
                            {
                                @class =
                                    "validation-summary-errors"
                            }
                        )


                        <!-- =================================
                             PERSONAL INFORMATION
                             ================================= -->

                        <div class="section-title">

                            <div class="section-number">
                                1
                            </div>

                            Personal Information

                        </div>


                        <!-- ID + FIRST NAME -->

                        <div class="row">


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.RegistrationId,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.RegistrationId,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "13-digit ID number",

                                            maxlength = "13"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.RegistrationId,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>



                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.FirstName,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.FirstName,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Enter first name"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.FirstName,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>

                        </div>



                        <!-- LAST NAME + GENDER -->

                        <div class="row">


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.LastName,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.LastName,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Enter last name"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.LastName,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>



                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Gender,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    <div class="gender-container">


                                        <label>

                                            @Html.RadioButtonFor(
                                                m => m.Gender,
                                                "Male"
                                            )

                                            Male

                                        </label>


                                        <label>

                                            @Html.RadioButtonFor(
                                                m => m.Gender,
                                                "Female"
                                            )

                                            Female

                                        </label>

                                    </div>


                                    @Html.ValidationMessageFor(
                                        m => m.Gender,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>

                        </div>



                        <!-- DOB + PHONE -->

                        <div class="row">


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.DateOfBirth,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.DateOfBirth,
                                        "{0:yyyy-MM-dd}",
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            type = "date"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.DateOfBirth,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>



                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Phone,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.Phone,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Enter phone number",

                                            maxlength = "15"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.Phone,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>

                        </div>



                        <!-- ADDRESS -->

                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.Address,
                                new
                                {
                                    @class =
                                        "form-label"
                                }
                            )


                            @Html.TextAreaFor(
                                m => m.Address,
                                new
                                {
                                    @class =
                                        "form-control",

                                    placeholder =
                                        "Enter residential address"
                                }
                            )


                            @Html.ValidationMessageFor(
                                m => m.Address,
                                "",
                                new
                                {
                                    @class =
                                        "field-validation-error"
                                }
                            )

                        </div>



                        <!-- =================================
                             ACCOUNT INFORMATION
                             ================================= -->

                        <div class="section-title">

                            <div class="section-number">
                                2
                            </div>

                            Account Information

                        </div>



                        <!-- EMAIL -->

                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.Email,
                                new
                                {
                                    @class =
                                        "form-label"
                                }
                            )


                            @Html.TextBoxFor(
                                m => m.Email,
                                new
                                {
                                    @class =
                                        "form-control",

                                    placeholder =
                                        "Enter email address",

                                    type = "email",

                                    autocomplete =
                                        "email"
                                }
                            )


                            @Html.ValidationMessageFor(
                                m => m.Email,
                                "",
                                new
                                {
                                    @class =
                                        "field-validation-error"
                                }
                            )

                        </div>



                        <!-- PASSWORDS -->

                        <div class="row">


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.Password,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.PasswordFor(
                                        m => m.Password,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Create password",

                                            autocomplete =
                                                "new-password"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.Password,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>



                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.ConfirmPassword,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.PasswordFor(
                                        m => m.ConfirmPassword,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Confirm password",

                                            autocomplete =
                                                "new-password"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.ConfirmPassword,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>

                        </div>



                        <!-- =================================
                             REGISTER BUTTON
                             ================================= -->

                        <button type="submit"
                                class="register-button">

                            CREATE STUDENT ACCOUNT

                        </button>



                        <!-- =================================
                             LOGIN LINK
                             ================================= -->

                        <div class="login-link">

                            Already have an account?

                            @Html.ActionLink(
                                "Login",
                                "Login",
                                "Account"
                            )

                        </div>



                        <!-- =================================
                             SECURITY
                             ================================= -->

                        <div class="security-note">

                            <span>
                                🔒
                            </span>

                            Your information is securely protected.

                        </div>

                    }

                </div>

            </div>

        </div>

    </main>



    <!-- =========================================
         FOOTER
         ========================================= -->

    <footer class="register-footer">

        © @DateTime.Now.Year

        TK Driving School.

        Student, instructor and administrator portal.

    </footer>

</div>



@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}