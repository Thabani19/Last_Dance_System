@model Last_Dance_System.Models.RegisterViewModel

@{
    Layout = null;
    ViewBag.Title = "TK Driving School — Student Registration";
}

<style>

    /* =========================================================
       TK DRIVING SCHOOL
       BLUE + WHITE REGISTRATION DESIGN
       SHOW PASSWORD INCLUDED
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f3f7fc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       MAIN PAGE
       ========================================================= */

    .register-page {
        min-height: 100vh;
        background: radial-gradient( circle at 10% 20%, rgba(37, 99, 235, 0.08), transparent 25% ), radial-gradient( circle at 90% 80%, rgba(14, 165, 233, 0.08), transparent 25% ), #f4f7fb;
    }


    /* =========================================================
       TOP BLUE LINE
       ========================================================= */

    .hazard-stripe {
        width: 100%;
        height: 6px;
        background: linear-gradient( 90deg, #0b3b8f, #1769d1, #2196f3 );
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .register-nav {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 22px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    /* =========================================================
       BRAND
       ========================================================= */

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .logo {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #0b3b8f, #1976d2 );
        color: #ffffff;
        font-size: 19px;
        font-weight: 900;
        letter-spacing: -1px;
        box-shadow: 0 8px 22px rgba(11, 59, 143, 0.22);
    }


    .brand-text {
        display: flex;
        flex-direction: column;
    }


    .brand-name {
        color: #12213a;
        font-size: 19px;
        font-weight: 900;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }


    .brand-subtitle {
        margin-top: 3px;
        color: #718096;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }


    /* =========================================================
       NAVIGATION ACTIONS
       ========================================================= */

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    /* =========================================================
       HOME BUTTON
       ========================================================= */

    .nav-home {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        border: 1px solid #d8e2ef;
        border-radius: 8px;
        background: #ffffff;
        color: #0b3b8f;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 3px 12px rgba(20, 50, 90, 0.05);
        transition: all 0.25s ease;
    }


        .nav-home:hover {
            background: #eaf2ff;
            border-color: #1976d2;
            color: #0b3b8f;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 7px 20px rgba(25, 118, 210, 0.15);
        }


    /* =========================================================
       LOGIN NAV BUTTON
       ========================================================= */

    .nav-login {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        border: 1px solid #d8e2ef;
        border-radius: 8px;
        background: #ffffff;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 3px 12px rgba(20, 50, 90, 0.05);
        transition: all 0.25s ease;
    }


        .nav-login:hover {
            background: #0b3b8f;
            border-color: #0b3b8f;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 7px 20px rgba(11, 59, 143, 0.22);
        }


    /* =========================================================
       MAIN
       ========================================================= */

    .register-main {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 20px 30px 60px;
    }


    .register-layout {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        min-height: 780px;
        background: #ffffff;
        border: 1px solid #dce6f2;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(24, 55, 90, 0.12);
    }


    /* =========================================================
       LEFT BLUE INTRO
       ========================================================= */

    .register-intro {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(5, 31, 78, 0.97), rgba(13, 78, 161, 0.92) ), url("https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1400&q=85") center / cover no-repeat;
    }


        .register-intro::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 85% 15%, rgba(255,255,255,0.16), transparent 25% ), linear-gradient( 135deg, rgba(5,31,78,0.90), rgba(13,78,161,0.80) );
        }


        .register-intro::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 220px;
            background: linear-gradient( to top, rgba(3,24,61,0.85), transparent );
        }


    .intro-content {
        position: relative;
        z-index: 2;
        min-height: 780px;
        padding: 50px;
        display: flex;
        flex-direction: column;
    }


    /* =========================================================
       INTRO LABEL
       ========================================================= */

    .intro-label {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 50px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.20);
        color: #ffffff;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }


    .intro-label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #60a5fa;
        box-shadow: 0 0 12px rgba(96,165,250,0.9);
    }


    /* =========================================================
       INTRO HERO
       ========================================================= */

    .intro-hero {
        max-width: 440px;
        margin-top: auto;
        margin-bottom: auto;
    }


        .intro-hero h1 {
            margin: 22px 0 18px;
            color: #ffffff;
            font-size: 52px;
            line-height: 1.04;
            font-weight: 900;
            letter-spacing: -2px;
        }


            .intro-hero h1 span {
                display: block;
                color: #60a5fa;
            }


        .intro-hero p {
            max-width: 410px;
            margin: 0;
            color: #dbeafe;
            font-size: 15px;
            line-height: 1.75;
        }


    /* =========================================================
       ENCOURAGEMENT
       ========================================================= */

    .encouragement {
        margin-top: 25px;
        padding: 16px 18px;
        border-left: 3px solid #60a5fa;
        background: rgba(255,255,255,0.08);
        border-radius: 0 10px 10px 0;
        color: #ffffff;
        font-size: 13px;
        line-height: 1.6;
    }


        .encouragement strong {
            display: block;
            margin-bottom: 4px;
            color: #93c5fd;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }


    /* =========================================================
       INTRO FEATURES
       ========================================================= */

    .intro-features {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: auto;
    }


    .intro-feature {
        width: fit-content;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 15px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 9px;
        color: #e5efff;
        font-size: 12px;
        font-weight: 700;
    }


    .intro-feature-icon {
        width: 21px;
        height: 21px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffffff;
        color: #1455a0;
        font-size: 11px;
        font-weight: 900;
    }


    /* =========================================================
       RIGHT FORM SIDE
       ========================================================= */

    .register-form-side {
        background: #ffffff;
        padding: 48px 55px;
        max-height: 900px;
        overflow-y: auto;
    }


    .register-form-container {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }


    /* =========================================================
       FORM HEADER
       ========================================================= */

    .form-header {
        margin-bottom: 30px;
    }


        .form-header h2 {
            margin: 0 0 8px;
            color: #132238;
            font-size: 31px;
            font-weight: 900;
            letter-spacing: -0.8px;
        }


        .form-header p {
            margin: 0;
            color: #718096;
            font-size: 13px;
            line-height: 1.6;
        }


    .form-header-line {
        width: 55px;
        height: 4px;
        margin-top: 17px;
        border-radius: 5px;
        background: linear-gradient( 90deg, #0b3b8f, #2196f3 );
    }


    /* =========================================================
       VALIDATION SUMMARY
       ========================================================= */

    .validation-summary-errors {
        margin-bottom: 22px;
        padding: 12px 15px;
        background: #fff5f5;
        border: 1px solid #fecaca;
        border-radius: 9px;
        color: #dc2626;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 29px 0 19px;
        padding-bottom: 11px;
        border-bottom: 1px solid #e3eaf2;
        color: #172b4d;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }


    .section-number {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eaf2ff;
        border: 1px solid #c7dcfa;
        color: #1558b0;
        font-size: 11px;
        font-weight: 900;
    }


    /* =========================================================
       ROW
       ========================================================= */

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-left: -8px;
        margin-right: -8px;
    }


    .col-md-6 {
        width: 50%;
        padding-left: 8px;
        padding-right: 8px;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .form-group {
        margin-bottom: 17px;
    }


    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1px;
    }


    /* =========================================================
       INPUTS
       ========================================================= */

    .form-control {
        width: 100%;
        height: 48px;
        padding: 10px 13px;
        border: 1px solid #d5dfeb;
        border-radius: 9px;
        background: #f8fafc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }


        .form-control::placeholder {
            color: #94a3b8;
        }


        .form-control:hover {
            border-color: #a9bfd8;
            background: #ffffff;
        }


        .form-control:focus {
            border-color: #1976d2;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(25,118,210,0.10);
        }


    textarea.form-control {
        min-height: 85px;
        height: 85px;
        resize: vertical;
    }


    input[type="date"] {
        color-scheme: light;
    }


    /* =========================================================
       PASSWORD WRAPPER
       ========================================================= */

    .password-wrapper {
        position: relative;
        width: 100%;
    }


        .password-wrapper .form-control {
            padding-right: 75px;
        }


    /* =========================================================
       SHOW PASSWORD
       ========================================================= */

    .show-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        gap: 5px;
        margin: 0;
        padding: 3px;
        color: #1769d1;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        user-select: none;
        z-index: 3;
        white-space: nowrap;
    }


        .show-password:hover {
            color: #0b3b8f;
        }


        .show-password input {
            width: 14px;
            height: 14px;
            margin: 0;
            padding: 0;
            accent-color: #1976d2;
            cursor: pointer;
        }


    /* =========================================================
       GENDER
       ========================================================= */

    .gender-container {
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 25px;
        padding-left: 3px;
    }


        .gender-container label {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }


        .gender-container input {
            width: 16px;
            height: 16px;
            accent-color: #1976d2;
            cursor: pointer;
        }


    /* =========================================================
       VALIDATION
       ========================================================= */

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }


    /* =========================================================
       REGISTER BUTTON
       ========================================================= */

    .register-button {
        width: 100%;
        height: 53px;
        margin-top: 10px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #0b3b8f, #1976d2 );
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 8px 22px rgba(25,118,210,0.20);
    }


        .register-button:hover {
            transform: translateY(-2px);
            background: linear-gradient( 135deg, #082e70, #1565c0 );
            box-shadow: 0 12px 30px rgba(25,118,210,0.30);
        }


        .register-button:active {
            transform: translateY(0);
        }


    /* =========================================================
       LOGIN LINK
       ========================================================= */

    .login-link {
        text-align: center;
        margin-top: 20px;
        color: #718096;
        font-size: 12px;
    }


        .login-link a {
            color: #1769d1;
            font-weight: 800;
            text-decoration: none;
            transition: color 0.2s ease;
        }


            .login-link a:hover {
                color: #0b3b8f;
                text-decoration: none;
            }


    /* =========================================================
       SECURITY
       ========================================================= */

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 19px;
        color: #94a3b8;
        font-size: 10px;
    }


        .security-note span {
            color: #1976d2;
        }


    /* =========================================================
       SCROLLBAR
       ========================================================= */

    .register-form-side::-webkit-scrollbar {
        width: 7px;
    }


    .register-form-side::-webkit-scrollbar-track {
        background: #f1f5f9;
    }


    .register-form-side::-webkit-scrollbar-thumb {
        background: #c5d2e2;
        border-radius: 10px;
    }


        .register-form-side::-webkit-scrollbar-thumb:hover {
            background: #9fb3ca;
        }


    /* =========================================================
       FOOTER
       ========================================================= */

    .register-footer {
        max-width: 1250px;
        margin: 0 auto;
        padding: 0 30px 30px;
        text-align: center;
        color: #8290a3;
        font-size: 11px;
    }


    /* =========================================================
       RESPONSIVE - TABLET
       ========================================================= */

    @@media (max-width: 1000px) {

        .register-nav {
            padding: 20px;
        }


        .register-main {
            padding: 20px;
        }


        .register-layout {
            grid-template-columns: 1fr;
        }


        .register-intro {
            min-height: 470px;
        }


        .intro-content {
            min-height: 470px;
            padding: 40px;
        }


        .intro-hero {
            margin-top: 50px;
            margin-bottom: 40px;
        }


            .intro-hero h1 {
                font-size: 43px;
            }


        .register-form-side {
            max-height: none;
            padding: 40px;
        }
    }


    /* =========================================================
       RESPONSIVE - MOBILE
       ========================================================= */

    @@media (max-width: 700px) {

        .register-nav {
            padding: 16px;
        }


        .brand-subtitle {
            display: none;
        }


        .brand-name {
            font-size: 16px;
        }


        .logo {
            width: 42px;
            height: 42px;
            font-size: 17px;
        }


        .nav-actions {
            gap: 6px;
        }


        .nav-home {
            padding: 9px 11px;
            font-size: 11px;
        }


        .nav-login {
            padding: 9px 11px;
            font-size: 10px;
        }


        .register-main {
            padding: 12px;
        }


        .register-layout {
            border-radius: 17px;
        }


        .register-intro {
            min-height: 440px;
        }


        .intro-content {
            min-height: 440px;
            padding: 28px;
        }


        .intro-hero h1 {
            font-size: 36px;
            letter-spacing: -1px;
        }


        .intro-hero p {
            font-size: 13px;
        }


        .intro-features {
            display: none;
        }


        .encouragement {
            font-size: 12px;
        }


        .register-form-side {
            padding: 30px 20px;
        }


        .form-header h2 {
            font-size: 26px;
        }


        .col-md-6 {
            width: 100%;
        }


        .register-footer {
            padding: 0 15px 25px;
        }


        .show-password {
            right: 9px;
            font-size: 9px;
        }


        .password-wrapper .form-control {
            padding-right: 68px;
        }
    }
</style>


<div class="register-page">


    <!-- =====================================================
         TOP BLUE LINE
         ===================================================== -->

    <div class="hazard-stripe"></div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <nav class="register-nav">


        <!-- BRAND -->

        <div class="brand">

            <div class="logo">
                TK
            </div>


            <div class="brand-text">

                <div class="brand-name">
                    TK Driving School
                </div>


                <div class="brand-subtitle">
                    Learn to drive with confidence
                </div>

            </div>

        </div>


        <!-- NAVIGATION BUTTONS -->

        <div class="nav-actions">


            <!-- HOME BUTTON -->

            <a href="@Url.Action("Index", "Home")"
               class="nav-home">

                Home

            </a>


            <!-- LOGIN BUTTON -->

            <a href="@Url.Action("Login", "Account")"
               class="nav-login">

                Already have an account?
                &nbsp;
                Log in

            </a>

        </div>

    </nav>


    <!-- =====================================================
         MAIN REGISTRATION AREA
         ===================================================== -->

    <main class="register-main">

        <div class="register-layout">


            <!-- =================================================
                 LEFT INTRODUCTION
                 ================================================= -->

            <div class="register-intro">

                <div class="intro-content">


                    <!-- LABEL -->

                    <div class="intro-label">

                        <span class="intro-label-dot"></span>

                        Student Registration

                    </div>


                    <!-- HERO -->

                    <div class="intro-hero">

                        <h1>

                            Start your

                            <span>
                                journey.
                            </span>

                        </h1>


                        <p>

                            Create your TK Driving School
                            account and take the first step
                            toward becoming a confident,
                            responsible driver.

                        </p>


                        <!-- ENCOURAGEMENT -->

                        <div class="encouragement">

                            <strong>
                                Believe in yourself
                            </strong>

                            Every confident driver started
                            exactly where you are today.
                            Take the first step, keep learning,
                            and we'll help you get closer to
                            your licence.

                        </div>

                    </div>


                    <!-- FEATURES -->

                    <div class="intro-features">


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Professional Instructors

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Easy Lesson Booking

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Track Your Progress

                        </div>


                    </div>

                </div>

            </div>


            <!-- =================================================
                 RIGHT REGISTRATION FORM
                 ================================================= -->

            <div class="register-form-side">

                <div class="register-form-container">


                    <!-- FORM HEADER -->

                    <div class="form-header">

                        <h2>
                            Create Your Account
                        </h2>


                        <p>
                            Register as a student to begin
                            your driving journey.
                        </p>


                        <div class="form-header-line"></div>

                    </div>


                    @using (Html.BeginForm(
                        "Register",
                        "Account",
                        FormMethod.Post,
                        new { role = "form" }))
                    {

                        @Html.AntiForgeryToken()


                        @Html.ValidationSummary(
                            "",
                            new
                            {
                                @class =
                                    "validation-summary-errors"
                            }
                        )


                        <!-- =================================================
                             PERSONAL INFORMATION
                             ================================================= -->

                        <div class="section-title">

                            <div class="section-number">
                                1
                            </div>

                            Personal Information

                        </div>


                        <!-- ID + FIRST NAME -->

                        <div class="row">


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.RegistrationId,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.RegistrationId,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "13-digit ID number",

                                            maxlength = "13"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.RegistrationId,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="form-group">

                                    @Html.LabelFor(
                                        m => m.FirstName,
                                        new
                                        {
                                            @class =
                                                "form-label"
                                        }
                                    )


                                    @Html.TextBoxFor(
                                        m => m.FirstName,
                                        new
                                        {
                                            @class =
                                                "form-control",

                                            placeholder =
                                                "Enter first name"
                                        }
                                    )


                                    @Html.ValidationMessageFor(
                                        m => m.FirstName,
                                        "",
                                        new
                                        {
                                            @class =
                                                "field-validation-error"
                                        }
                                    )

