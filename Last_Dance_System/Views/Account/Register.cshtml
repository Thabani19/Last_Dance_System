@model Last_Dance_System.Models.RegisterViewModel

@{
    ViewBag.Title = "Student Registration";
}

<style>
    /* =========================================
       DRIVE SMART - DARK AUTOMOTIVE REGISTER
       ========================================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #050a12;
    }

    .automotive-register {
        min-height: calc(100vh - 50px);
        background: radial-gradient( circle at 85% 50%, rgba(25, 118, 210, 0.12), transparent 30% ), linear-gradient( 135deg, #03070d 0%, #07111e 50%, #02060b 100% );
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px;
        color: #ffffff;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .register-wrapper {
        width: 100%;
        max-width: 1250px;
        display: grid;
        grid-template-columns: 0.82fr 1.18fr;
        background: #0b1420;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.65), 0 0 60px rgba(25, 118, 210, 0.06);
    }


    /* =========================================
       LEFT AUTOMOTIVE SECTION
       ========================================= */

    .automotive-side {
        position: relative;
        min-height: 850px;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(2, 7, 14, 0.93), rgba(5, 18, 32, 0.78) ), url("https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=85") center / cover no-repeat;
    }

        .automotive-side::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(3, 8, 15, 0.95) 0%, rgba(3, 8, 15, 0.55) 55%, rgba(3, 8, 15, 0.78) 100% );
            pointer-events: none;
        }

    .automotive-content {
        position: relative;
        z-index: 2;
        height: 100%;
        min-height: 850px;
        padding: 50px;
        display: flex;
        flex-direction: column;
    }


    /* BRAND */

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: linear-gradient( 135deg, #2196f3, #0d47a1 );
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 0 25px rgba(33, 150, 243, 0.35);
    }

    .brand-name {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

        .brand-name span {
            color: #2196f3;
        }


    /* HERO */

    .register-hero {
        margin-top: auto;
        margin-bottom: auto;
        max-width: 420px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 50px;
        background: rgba(33, 150, 243, 0.12);
        border: 1px solid rgba(33, 150, 243, 0.25);
        color: #64b5f6;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .register-hero h1 {
        font-size: 46px;
        line-height: 1.08;
        margin: 0 0 20px;
        font-weight: 800;
        letter-spacing: -1px;
    }

        .register-hero h1 span {
            color: #2196f3;
        }

    .register-hero p {
        color: #b7c3d0;
        font-size: 16px;
        line-height: 1.7;
        margin: 0;
        max-width: 390px;
    }


    /* FEATURES */

    .features {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .feature {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 15px;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        color: #d7e0ea;
        font-size: 13px;
        width: fit-content;
    }

    .feature-icon {
        color: #42a5f5;
        font-weight: bold;
    }


    /* =========================================
       RIGHT REGISTRATION SECTION
       ========================================= */

    .register-side {
        background: #0c1724;
        padding: 48px 55px;
        max-height: 900px;
        overflow-y: auto;
    }

    .register-container {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }


    /* HEADER */

    .register-header {
        margin-bottom: 28px;
    }

        .register-header h2 {
            margin: 0 0 8px;
            font-size: 32px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .register-header p {
            margin: 0;
            color: #7f91a5;
            font-size: 14px;
        }


    /* VALIDATION */

    .validation-summary-errors {
        background: rgba(220, 53, 69, 0.10);
        border: 1px solid rgba(220, 53, 69, 0.25);
        border-radius: 10px;
        padding: 12px 15px;
        color: #ff7b86;
        margin-bottom: 22px;
        font-size: 13px;
    }


    /* SECTION TITLE */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 28px 0 20px;
        padding-bottom: 11px;
        border-bottom: 1px solid #1c2b3b;
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .section-number {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: rgba(33, 150, 243, 0.12);
        border: 1px solid rgba(33, 150, 243, 0.25);
        color: #42a5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }


    /* FORM */

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #d9e2ec;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        height: 49px;
        padding: 10px 14px;
        border: 1px solid #26384b;
        border-radius: 10px;
        background: #09121d;
        color: #ffffff;
        font-size: 14px;
        outline: none;
        transition: all 0.25s ease;
    }

        .form-control::placeholder {
            color: #52667b;
        }

        .form-control:hover {
            border-color: #35506b;
        }

        .form-control:focus {
            border-color: #2196f3;
            background: #0a1522;
            box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.10), 0 0 20px rgba(33, 150, 243, 0.08);
            outline: none;
        }

    textarea.form-control {
        height: 90px;
        resize: vertical;
    }


    /* DATE INPUT */

    input[type="date"] {
        color-scheme: dark;
    }


    /* GENDER */

    .gender-container {
        height: 49px;
        display: flex;
        align-items: center;
        gap: 25px;
        padding-left: 5px;
    }

        .gender-container label {
            color: #9aabba;
            font-size: 13px;
            font-weight: 400;
            cursor: pointer;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .gender-container input {
            width: 16px;
            height: 16px;
            accent-color: #2196f3;
            cursor: pointer;
        }


    /* VALIDATION MESSAGE */

    .field-validation-error {
        display: block;
        color: #ff7b86;
        font-size: 12px;
        margin-top: 6px;
    }


    /* REGISTER BUTTON */

    .register-button {
        width: 100%;
        height: 54px;
        margin-top: 12px;
        border: none;
        border-radius: 11px;
        background: linear-gradient( 135deg, #2196f3, #1565c0 );
        color: #ffffff;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.8px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 8px 25px rgba(33, 150, 243, 0.20);
    }

        .register-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(33, 150, 243, 0.32);
            background: linear-gradient( 135deg, #42a5f5, #1976d2 );
        }

        .register-button:active {
            transform: translateY(0);
        }


    /* LOGIN LINK */

    .login-link {
        text-align: center;
        margin-top: 22px;
        color: #718397;
        font-size: 13px;
    }

        .login-link a {
            color: #42a5f5;
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                color: #90caf9;
                text-decoration: none;
            }


    /* SECURITY */

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 22px;
        color: #52667b;
        font-size: 11px;
    }

        .security-note span {
            color: #42a5f5;
        }


    /* =========================================
       SCROLLBAR
       ========================================= */

    .register-side::-webkit-scrollbar {
        width: 7px;
    }

    .register-side::-webkit-scrollbar-track {
        background: #08111c;
    }

    .register-side::-webkit-scrollbar-thumb {
        background: #26384b;
        border-radius: 10px;
    }

        .register-side::-webkit-scrollbar-thumb:hover {
            background: #35506b;
        }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 1000px) {

        .automotive-register {
            padding: 20px;
        }

        .register-wrapper {
            grid-template-columns: 1fr;
            max-width: 700px;
        }

        .automotive-side {
            min-height: 400px;
        }

        .automotive-content {
            min-height: 400px;
            padding: 35px;
        }

        .register-hero {
            margin-top: 60px;
            margin-bottom: 40px;
        }

        .register-side {
            max-height: none;
            padding: 40px 35px;
        }
    }


    @@media (max-width: 600px) {

        .automotive-register {
            padding: 10px;
        }

        .register-wrapper {
            border-radius: 18px;
        }

        .automotive-side {
            min-height: 350px;
        }

        .automotive-content {
            min-height: 350px;
            padding: 25px;
        }

        .register-hero h1 {
            font-size: 34px;
        }

        .register-hero p {
            font-size: 14px;
        }

        .features {
            display: none;
        }

        .register-side {
            padding: 30px 20px;
        }

        .register-header h2 {
            font-size: 27px;
        }
    }
</style>


<div class="automotive-register">

    <div class="register-wrapper">


        <!-- =====================================
             LEFT AUTOMOTIVE BRANDING
             ===================================== -->

        <div class="automotive-side">

            <div class="automotive-content">


                <!-- BRAND -->

                <div class="brand">

                    <div class="brand-icon">
                        🚗
                    </div>

                    <div class="brand-name">
                        DRIVE <span>SMART</span>
                    </div>

                </div>


                <!-- HERO -->

                <div class="register-hero">

                    <div class="hero-badge">
                        ● Student Registration
                    </div>

                    <h1>
                        Start your
                        <span>journey.</span>
                    </h1>

                    <p>
                        Create your account and take the first
                        step toward becoming a confident,
                        responsible driver.
                    </p>

                </div>


                <!-- FEATURES -->

                <div class="features">

                    <div class="feature">

                        <span class="feature-icon">
                            ✓
                        </span>

                        Professional Instructors

                    </div>


                    <div class="feature">

                        <span class="feature-icon">
                            ✓
                        </span>

                        Easy Lesson Booking

                    </div>


                    <div class="feature">

                        <span class="feature-icon">
                            ✓
                        </span>

                        Track Your Progress

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================
             REGISTRATION FORM
             ===================================== -->

        <div class="register-side">

            <div class="register-container">


                <!-- HEADER -->

                <div class="register-header">

                    <h2>
                        Create Your Account 👋
                    </h2>

                    <p>
                        Register as a student to begin your
                        driving journey.
                    </p>

                </div>


                @using (Html.BeginForm(
                    "Register",
                    "Account",
                    FormMethod.Post,
                    new { role = "form" }))
                {

                    @Html.AntiForgeryToken()


                    @Html.ValidationSummary(
                        "",
                        new
                        {
                            @class = "validation-summary-errors"
                        }
                    )


                    <!-- =================================
                         PERSONAL INFORMATION
                         ================================= -->

                    <div class="section-title">

                        <div class="section-number">
                            1
                        </div>

                        Personal Information

                    </div>


                    <!-- ID + FIRST NAME -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.RegistrationId,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    m => m.RegistrationId,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "13-digit ID number",
                                        maxlength = "13"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.RegistrationId,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.FirstName,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    m => m.FirstName,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "Enter first name"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.FirstName,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>

                    </div>


                    <!-- LAST NAME + GENDER -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.LastName,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    m => m.LastName,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "Enter last name"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.LastName,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Gender,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                <div class="gender-container">

                                    <label>

                                        @Html.RadioButtonFor(
                                            m => m.Gender,
                                            "Male"
                                        )

                                        Male

                                    </label>


                                    <label>

                                        @Html.RadioButtonFor(
                                            m => m.Gender,
                                            "Female"
                                        )

                                        Female

                                    </label>

                                </div>

                                @Html.ValidationMessageFor(
                                    m => m.Gender,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>

                    </div>


                    <!-- DOB + PHONE -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.DateOfBirth,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    m => m.DateOfBirth,
                                    "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "date"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.DateOfBirth,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Phone,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    m => m.Phone,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "Enter phone number",
                                        maxlength = "15"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.Phone,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.Address,
                            new
                            {
                                @class = "form-label"
                            }
                        )

                        @Html.TextAreaFor(
                            m => m.Address,
                            new
                            {
                                @class = "form-control",
                                placeholder =
                                    "Enter residential address"
                            }
                        )

                        @Html.ValidationMessageFor(
                            m => m.Address,
                            "",
                            new
                            {
                                @class =
                                    "field-validation-error"
                            }
                        )

                    </div>


                    <!-- =================================
                         ACCOUNT INFORMATION
                         ================================= -->

                    <div class="section-title">

                        <div class="section-number">
                            2
                        </div>

                        Account Information

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.Email,
                            new
                            {
                                @class = "form-label"
                            }
                        )

                        @Html.TextBoxFor(
                            m => m.Email,
                            new
                            {
                                @class = "form-control",
                                placeholder =
                                    "Enter email address",
                                type = "email",
                                autocomplete = "email"
                            }
                        )

                        @Html.ValidationMessageFor(
                            m => m.Email,
                            "",
                            new
                            {
                                @class =
                                    "field-validation-error"
                            }
                        )

                    </div>


                    <!-- PASSWORDS -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.Password,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.PasswordFor(
                                    m => m.Password,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "Create password",
                                        autocomplete =
                                            "new-password"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.Password,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group">

                                @Html.LabelFor(
                                    m => m.ConfirmPassword,
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.PasswordFor(
                                    m => m.ConfirmPassword,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder =
                                            "Confirm password",
                                        autocomplete =
                                            "new-password"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    m => m.ConfirmPassword,
                                    "",
                                    new
                                    {
                                        @class =
                                            "field-validation-error"
                                    }
                                )

                            </div>

                        </div>

                    </div>


                    <!-- CREATE ACCOUNT -->

                    <button type="submit"
                            class="register-button">

                        CREATE STUDENT ACCOUNT

                    </button>


                    <!-- LOGIN -->

                    <div class="login-link">

                        Already have an account?

                        @Html.ActionLink(
                            "Login",
                            "Login",
                            "Account"
                        )

                    </div>


                    <!-- SECURITY -->

                    <div class="security-note">

                        <span>🔒</span>

                        Your information is securely protected.

                    </div>

                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}