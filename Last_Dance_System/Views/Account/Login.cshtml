@using Last_Dance_System.Models
@model LoginViewModel

@{
    Layout = null;
    ViewBag.Title = "TK Driving School — Login";
}

<style>
    /* =========================================================
       TK DRIVING SCHOOL
       BLUE + WHITE PROFESSIONAL LOGIN DESIGN
       FUNCTIONALITY UNCHANGED
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f3f7fc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       MAIN PAGE
       ========================================================= */

    .login-page {
        min-height: 100vh;
        background: radial-gradient( circle at 10% 20%, rgba(37, 99, 235, 0.08), transparent 25% ), radial-gradient( circle at 90% 80%, rgba(14, 165, 233, 0.08), transparent 25% ), #f4f7fb;
    }


    /* =========================================================
       TOP BLUE LINE
       ========================================================= */

    .hazard-stripe {
        width: 100%;
        height: 6px;
        background: linear-gradient( 90deg, #0b3b8f, #1769d1, #2196f3 );
    }


    /* =========================================================
       TOP NAVIGATION
       ========================================================= */

    .login-nav {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 22px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    /* =========================================================
       BRAND
       ========================================================= */

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .logo {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #0b3b8f, #1976d2 );
        color: #ffffff;
        font-size: 19px;
        font-weight: 900;
        letter-spacing: -1px;
        box-shadow: 0 8px 22px rgba(11, 59, 143, 0.22);
    }


    .brand-text {
        display: flex;
        flex-direction: column;
    }


    .brand-name {
        color: #12213a;
        font-size: 19px;
        font-weight: 900;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }


    .brand-subtitle {
        margin-top: 3px;
        color: #718096;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }


    /* =========================================================
       HOME BUTTON
       ========================================================= */

    .home-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 18px;
        border: 1px solid #d8e2ef;
        border-radius: 8px;
        background: #ffffff;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 3px 12px rgba(20, 50, 90, 0.05);
        transition: all 0.25s ease;
    }


        .home-button:hover {
            background: #0b3b8f;
            border-color: #0b3b8f;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 7px 20px rgba(11, 59, 143, 0.22);
        }


    /* =========================================================
       MAIN
       ========================================================= */

    .login-main {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 20px 30px 60px;
    }


    /* =========================================================
       LOGIN CARD
       ========================================================= */

    .login-layout {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        min-height: 680px;
        background: #ffffff;
        border: 1px solid #dce6f2;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(24, 55, 90, 0.12);
    }


    /* =========================================================
       LEFT BLUE SECTION
       ========================================================= */

    .login-intro {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(5, 31, 78, 0.97), rgba(13, 78, 161, 0.92) ), url("https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1400&q=85") center / cover no-repeat;
    }


        .login-intro::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 85% 15%, rgba(255,255,255,0.16), transparent 25% ), linear-gradient( 135deg, rgba(5,31,78,0.90), rgba(13,78,161,0.80) );
        }


        .login-intro::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 220px;
            background: linear-gradient( to top, rgba(3,24,61,0.85), transparent );
        }


    /* =========================================================
       INTRO CONTENT
       ========================================================= */

    .intro-content {
        position: relative;
        z-index: 2;
        min-height: 680px;
        padding: 50px;
        display: flex;
        flex-direction: column;
    }


    /* =========================================================
       LABEL
       ========================================================= */

    .intro-label {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 50px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.20);
        color: #ffffff;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }


    .intro-label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #60a5fa;
        box-shadow: 0 0 12px rgba(96,165,250,0.9);
    }


    /* =========================================================
       HERO
       ========================================================= */

    .intro-hero {
        max-width: 440px;
        margin-top: auto;
        margin-bottom: auto;
    }


        .intro-hero h1 {
            margin: 22px 0 18px;
            color: #ffffff;
            font-size: 52px;
            line-height: 1.04;
            font-weight: 900;
            letter-spacing: -2px;
        }


            .intro-hero h1 span {
                display: block;
                color: #60a5fa;
            }


        .intro-hero p {
            max-width: 410px;
            margin: 0;
            color: #dbeafe;
            font-size: 15px;
            line-height: 1.75;
        }


    /* =========================================================
       MOTIVATIONAL MESSAGE
       ========================================================= */

    .motivation-box {
        margin-top: 25px;
        padding: 16px 18px;
        border-left: 3px solid #60a5fa;
        background: rgba(255,255,255,0.08);
        border-radius: 0 10px 10px 0;
        color: #ffffff;
        font-size: 13px;
        line-height: 1.6;
    }


        .motivation-box strong {
            display: block;
            margin-bottom: 4px;
            color: #93c5fd;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }


    /* =========================================================
       FEATURES
       ========================================================= */

    .intro-features {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: auto;
    }


    .intro-feature {
        width: fit-content;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 15px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 9px;
        color: #e5efff;
        font-size: 12px;
        font-weight: 700;
    }


    .intro-feature-icon {
        width: 21px;
        height: 21px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffffff;
        color: #1455a0;
        font-size: 11px;
        font-weight: 900;
    }


    /* =========================================================
       RIGHT LOGIN SIDE
       ========================================================= */

    .login-form-side {
        background: #ffffff;
        padding: 55px 65px;
        display: flex;
        align-items: center;
    }


    .login-form-container {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
    }


    /* =========================================================
       FORM HEADER
       ========================================================= */

    .form-header {
        margin-bottom: 30px;
    }


        .form-header h2 {
            margin: 0 0 8px;
            color: #132238;
            font-size: 32px;
            font-weight: 900;
            letter-spacing: -0.8px;
        }


        .form-header p {
            margin: 0;
            color: #718096;
            font-size: 13px;
            line-height: 1.6;
        }


    .form-header-line {
        width: 55px;
        height: 4px;
        margin-top: 17px;
        border-radius: 5px;
        background: linear-gradient( 90deg, #0b3b8f, #2196f3 );
    }


    /* =========================================================
       VALIDATION SUMMARY
       ========================================================= */

    .validation-summary-errors {
        margin-bottom: 22px;
        padding: 12px 15px;
        background: #fff5f5;
        border: 1px solid #fecaca;
        border-radius: 9px;
        color: #dc2626;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .form-group {
        margin-bottom: 20px;
    }


    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
    }


    /* =========================================================
       INPUT WRAPPER
       ========================================================= */

    .input-wrapper {
        position: relative;
    }


    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #7890aa;
        font-size: 15px;
        z-index: 2;
        pointer-events: none;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .form-control {
        width: 100%;
        height: 50px;
        padding: 10px 13px 10px 44px;
        border: 1px solid #d5dfeb;
        border-radius: 9px;
        background: #f8fafc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }


        .form-control::placeholder {
            color: #94a3b8;
        }


        .form-control:hover {
            border-color: #a9bfd8;
            background: #ffffff;
        }


        .form-control:focus {
            border-color: #1976d2;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(25,118,210,0.10);
        }


    /* =========================================================
       VALIDATION MESSAGE
       ========================================================= */

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }


    /* =========================================================
       REMEMBER ME
       ========================================================= */

    .remember-row {
        display: flex;
        align-items: center;
        margin: 4px 0 24px;
    }


        .remember-row input {
            width: 16px;
            height: 16px;
            accent-color: #1976d2;
            margin-right: 9px;
            cursor: pointer;
        }


        .remember-row label {
            margin: 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }


    /* =========================================================
       LOGIN BUTTON
       ========================================================= */

    .login-button {
        width: 100%;
        height: 53px;
        margin-top: 5px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #0b3b8f, #1976d2 );
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 8px 22px rgba(25,118,210,0.20);
    }


        .login-button:hover {
            transform: translateY(-2px);
            background: linear-gradient( 135deg, #082e70, #1565c0 );
            box-shadow: 0 12px 30px rgba(25,118,210,0.30);
        }


        .login-button:active {
            transform: translateY(0);
        }


    /* =========================================================
       LINKS
       ========================================================= */

    .login-links {
        text-align: center;
        margin-top: 22px;
    }


        .login-links p {
            margin: 10px 0;
            color: #718096;
            font-size: 12px;
        }


        .login-links a {
            color: #1769d1;
            text-decoration: none;
            font-weight: 800;
            transition: color 0.2s ease;
        }


            .login-links a:hover {
                color: #0b3b8f;
                text-decoration: none;
            }


    /* =========================================================
       SECURITY
       ========================================================= */

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 22px;
        color: #94a3b8;
        font-size: 10px;
    }


        .security-note span {
            color: #1976d2;
        }


    /* =========================================================
       FOOTER
       ========================================================= */

    .login-footer {
        max-width: 1250px;
        margin: 0 auto;
        padding: 0 30px 30px;
        text-align: center;
        color: #8290a3;
        font-size: 11px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1000px) {

        .login-nav {
            padding: 20px;
        }


        .login-main {
            padding: 20px;
        }


        .login-layout {
            grid-template-columns: 1fr;
        }


        .login-intro {
            min-height: 470px;
        }


        .intro-content {
            min-height: 470px;
            padding: 40px;
        }


        .intro-hero {
            margin-top: 50px;
            margin-bottom: 40px;
        }


            .intro-hero h1 {
                font-size: 43px;
            }


        .login-form-side {
            padding: 45px;
        }
    }


    @@media (max-width: 700px) {

        .login-nav {
            padding: 16px;
        }


        .brand-subtitle {
            display: none;
        }


        .brand-name {
            font-size: 16px;
        }


        .logo {
            width: 42px;
            height: 42px;
            font-size: 17px;
        }


        .home-button {
            padding: 9px 13px;
            font-size: 11px;
        }


        .login-main {
            padding: 12px;
        }


        .login-layout {
            border-radius: 17px;
        }


        .login-intro {
            min-height: 440px;
        }


        .intro-content {
            min-height: 440px;
            padding: 28px;
        }


        .intro-hero h1 {
            font-size: 36px;
            letter-spacing: -1px;
        }


        .intro-hero p {
            font-size: 13px;
        }


        .intro-features {
            display: none;
        }


        .motivation-box {
            font-size: 12px;
        }


        .login-form-side {
            padding: 35px 20px;
        }


        .form-header h2 {
            font-size: 27px;
        }


        .login-footer {
            padding: 0 15px 25px;
        }
    }
</style>

<!-- =========================================================
     LOGIN PAGE
     ========================================================= -->

<div class="login-page">

   
    <!-- =====================================================
         TOP BLUE LINE
         ===================================================== -->

    <div class="hazard-stripe"></div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <nav class="login-nav">


        <!-- BRAND -->

        <div class="brand">

            <div class="logo">
                TK
            </div>


            <div class="brand-text">

                <div class="brand-name">
                    TK Driving School
                </div>


                <div class="brand-subtitle">
                    Learn to drive with confidence
                </div>

            </div>

        </div>


        <!-- HOME BUTTON -->

        <a href="@Url.Action("Index", "Home")"
           class="home-button">

            

            Homepage

        </a>

    </nav>



    <!-- =====================================================
         MAIN LOGIN AREA
         ===================================================== -->

    <main class="login-main">


        <div class="login-layout">


            <!-- =================================================
                 LEFT INTRODUCTION
                 ================================================= -->

            <div class="login-intro">


                <div class="intro-content">


                    <!-- LABEL -->

                    <div class="intro-label">

                        <span class="intro-label-dot"></span>

                        Student Portal

                    </div>



                    <!-- HERO -->

                    <div class="intro-hero">


                        <h1>

                            Drive with

                            <span>
                                confidence.
                            </span>

                        </h1>


                        <p>

                            Welcome back to TK Driving School.
                            Sign in to manage your lessons,
                            bookings and driving progress.

                        </p>



                        <!-- MOTIVATION -->

                        <div class="motivation-box">

                            <strong>
                                Keep moving forward
                            </strong>

                            Every lesson brings you one step
                            closer to becoming a confident,
                            responsible driver.

                        </div>

                    </div>



                    <!-- FEATURES -->

                    <div class="intro-features">


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Professional Instructors

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Easy Lesson Booking

                        </div>


                        <div class="intro-feature">

                            <span class="intro-feature-icon">
                                ✓
                            </span>

                            Track Your Progress

                        </div>


                    </div>

                </div>

            </div>



            <!-- =================================================
                 RIGHT LOGIN FORM
                 ================================================= -->

            <div class="login-form-side">


                <div class="login-form-container">


                    <!-- FORM HEADER -->

                    <div class="form-header">

                        <h2>
                            Welcome Back
                        </h2>


                        <p>
                            Sign in to continue to your account.
                        </p>


                        <div class="form-header-line"></div>

                    </div>



                    @using (Html.BeginForm(
                        "Login",
                        "Account",
                        new
                        {
                            ReturnUrl =
                                ViewBag.ReturnUrl
                        },
                        FormMethod.Post,
                        new
                        {
                            role = "form"
                        }))
                    {

                        @Html.AntiForgeryToken()



                        <!-- =================================================
             VALIDATION SUMMARY
             ================================================= -->

                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class =
                                    "validation-summary-errors"
                            }
                        )



                        <!-- =================================================
             EMAIL
             ================================================= -->

                        <div class="form-group">


                            @Html.LabelFor(
                                m => m.Email,
                                new
                                {
                                    @class =
                                        "form-label"
                                }
                            )


                            <div class="input-wrapper">


                                <span class="input-icon">
                                    ✉
                                </span>


                                @Html.TextBoxFor(
                                    m => m.Email,
                                    new
                                    {
                                        @class =
                                            "form-control",

                                        placeholder =
                                            "Enter your email",

                                        autocomplete =
                                            "email"
                                    }
                                )

                            </div>


                            @Html.ValidationMessageFor(
                                m => m.Email,
                                "",
                                new
                                {
                                    @class =
                                        "field-validation-error"
                                }
                            )

                        </div>



                        <!-- =================================================
        PASSWORD
        ================================================= -->

                        <div class="form-group">

                            
                            @Html.LabelFor(
                                m => m.Password,
                                new
                                {
                                    @class = "form-label"
                                }
                            )

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    🔒
                                </span>

                                @Html.PasswordFor(
                                    m => m.Password,
                                    new
                                    {
                                        @class = "form-control password-input",
                                        placeholder = "Enter your password",
                                        autocomplete = "current-password",
                                        id = "Password"
                                    }
                                )

                                <!-- SHOW PASSWORD BUTTON -->

                                <button type="button"
                                        class="show-password"
                                        id="showPassword"
                                        onclick="togglePassword()">

                                    Show

                                </button>

                            </div>

                            @Html.ValidationMessageFor(
                                m => m.Password,
                                "",
                                new
                                {
                                    @class = "field-validation-error"
                                }
                            )
                            

                        </div>

                        <style>

                            /* =========================================
                            SHOW PASSWORD BUTTON
                            ========================================= */

                                                 .show-password {
                                                     position: absolute;
                                                     right: 12px;
                                                     top: 50%;
                                                     transform: translateY(-50%);
                                                     border: none;
                                                     background: transparent;
                                                     color: #1769d1;
                                                     font-size: 11px;
                                                     font-weight: 800;
                                                     cursor: pointer;
                                                     padding: 5px 6px;
                                                     z-index: 3;
                                                     transition: color 0.2s ease;
                                                 }


                                                     .show-password:hover {
                                                         color: #0b3b8f;
                                                     }


                                                 /* Make room for Show button */

                                                 .password-input {
                                                     padding-right: 65px !important;
                                                 }
                                                            </style>

                                                            <script>

                                        function togglePassword() {

                                            var passwordInput =
                                                document.getElementById("Password");

                                            var showPasswordButton =
                                                document.getElementById("showPassword");


                                            if (passwordInput.type === "password") {

                                                passwordInput.type = "text";

                                                showPasswordButton.innerText = "Hide";

                                            }
                                            else {

                                                passwordInput.type = "password";

                                                showPasswordButton.innerText = "Show";

                                            }

                                        }

                        </script>




             <!-- =================================================
             REMEMBER ME
             ================================================= -->

                        <div class="remember-row">


                            @Html.CheckBoxFor(
                                m => m.RememberMe
                            )


                            @Html.LabelFor(
                                m => m.RememberMe
                            )

                        </div>



             <!-- =================================================
             LOGIN BUTTON
             ================================================= -->

                        <button type="submit"
                                class="login-button">

                          LOGIN

                        </button>



                        <!-- =================================================
             ACCOUNT LINKS
             ================================================= -->

                        <div class="login-links">


                            <p>

                                Don't have an account?

                                @Html.ActionLink(
                                    "Create Student Account",
                                    "Register",
                                    "Account"
                                )

                            </p>


                            <p>

                                @Html.ActionLink(
                                    "Forgot Password?",
                                    "ForgotPassword",
                                    "Account"
                                )

                            </p>

                        </div>



                        <!-- =================================================
             SECURITY
             ================================================= -->

                        <div class="security-note">

                            <span>
                                🔒
                            </span>

                            Your account information is securely protected.

                        </div>

                    }

                </div>

            </div>

        </div>

    </main>



    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="login-footer">

        © @DateTime.Now.Year

        TK Driving School.

        Student, instructor and administrator portal.

    </footer>
    

</div>

@section Scripts {

    
    @Scripts.Render(
        "~/bundles/jqueryval"
    )
    

}
