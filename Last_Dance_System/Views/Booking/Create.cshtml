@model IEnumerable<Last_Dance_System.Models.LessonSchedule>

@{
    Layout = null;
    ViewBag.Title = "Book a Lesson";

    var schedules = Model ?? Enumerable.Empty<Last_Dance_System.Models.LessonSchedule>();

    var groupedSchedules = schedules
        .GroupBy(x => x.LessonDate.Date)
        .OrderBy(x => x.Key)
        .ToList();

    var firstDate = groupedSchedules.Any()
        ? groupedSchedules.First().Key
        : DateTime.Today;

    var firstMonth = new DateTime(firstDate.Year, firstDate.Month, 1);

    var previousMonth = firstMonth.AddMonths(-1);
    var nextMonth = firstMonth.AddMonths(1);

    var calendarStart = firstMonth.AddDays(-(int)firstMonth.DayOfWeek + 1);

    if (firstMonth.DayOfWeek == DayOfWeek.Sunday)
    {
        calendarStart = firstMonth.AddDays(-6);
    }

    var calendarEnd = calendarStart.AddDays(41);

    var availableDates = groupedSchedules
        .Select(x => x.Key.ToString("yyyy-MM-dd"))
        .ToList();
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Book a Lesson</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

        /* =========================================================
           GLOBAL
           ========================================================= */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f4f7fb;
            color: #172033;
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }


        /* =========================================================
           PAGE
           ========================================================= */

        .booking-page {
            min-height: 100vh;
            padding: 40px 25px 70px;
            background: radial-gradient( circle at 90% 0%, rgba(37, 99, 235, .08), transparent 30% ), linear-gradient( 180deg, #f8fbff 0%, #f3f7fc 100% );
        }

        .booking-container {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
        }


        /* =========================================================
           HEADER
           ========================================================= */

        .page-header {
            margin-bottom: 30px;
        }

        .header-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 10px;
            color: #2563eb;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

            .header-label::before {
                content: "";
                width: 27px;
                height: 2px;
                background: #2563eb;
                border-radius: 10px;
            }

            .header-label i {
                font-size: 12px;
            }

        .page-header h1 {
            margin: 0 0 8px;
            color: #14213d;
            font-size: 38px;
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -.6px;
        }

            .page-header h1 span {
                color: #2563eb;
            }

        .page-header p {
            margin: 0;
            color: #6b778c;
            font-size: 14px;
            line-height: 1.6;
        }


        /* =========================================================
           BACK BUTTON
           ========================================================= */

        .back-dashboard-button {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-top: 18px;
            padding: 11px 17px;
            background: #ffffff;
            border: 1px solid #d9e2ef;
            border-radius: 9px;
            color: #455468;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(20, 33, 61, .04);
            transition: all .2s ease;
        }

            .back-dashboard-button i {
                color: #2563eb;
            }

            .back-dashboard-button:hover {
                background: #2563eb;
                border-color: #2563eb;
                color: #ffffff;
                text-decoration: none;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(37, 99, 235, .18);
            }

                .back-dashboard-button:hover i {
                    color: #ffffff;
                }


        /* =========================================================
           ALERTS
           ========================================================= */

        .alert {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 17px;
            margin-bottom: 20px;
            border-radius: 10px;
            font-size: 12px;
            line-height: 1.5;
        }

            .alert i {
                flex-shrink: 0;
                font-size: 16px;
            }

        .alert-danger {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #be123c;
        }

        .alert-success {
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
            color: #15803d;
        }


        /* =========================================================
           PACKAGE SUMMARY
           ========================================================= */

        .package-summary {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 170px 190px;
            gap: 16px;
            align-items: stretch;
            margin-bottom: 30px;
        }

        .package-info {
            position: relative;
            padding: 24px;
            background: #ffffff;
            border: 1px solid #e1e8f2;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(20, 33, 61, .05);
        }

            .package-info::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 4px;
                height: 100%;
                background: #2563eb;
            }

        .package-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 11px;
            color: #2563eb;
            font-size: 17px;
        }

        .package-info h3 {
            margin: 0 0 6px;
            color: #14213d;
            font-size: 20px;
            font-weight: 800;
        }

        .package-info p {
            margin: 0;
            color: #7b8799;
            font-size: 12px;
        }


        /* =========================================================
           STAT CARDS
           ========================================================= */

        .stat {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 18px;
            text-align: center;
            background: #ffffff;
            border: 1px solid #e1e8f2;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(20, 33, 61, .05);
            transition: all .2s ease;
        }

            .stat:hover {
                border-color: #bfdbfe;
                transform: translateY(-2px);
                box-shadow: 0 12px 28px rgba(37, 99, 235, .08);
            }

        .stat-icon {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 7px;
            background: #eff6ff;
            border-radius: 9px;
            color: #2563eb;
            font-size: 14px;
        }

        .stat-number {
            display: block;
            color: #1d4ed8;
            font-size: 26px;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #7b8799;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }


        /* =========================================================
           BOOKING AREA
           ========================================================= */

        .booking-area {
            display: grid;
            grid-template-columns: 1fr;
            gap: 22px;
        }


        /* =========================================================
           SECTION HEADER
           ========================================================= */

        .section-title {
            margin-bottom: 16px;
        }

            .section-title h2 {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 0 0 6px;
                color: #17213a;
                font-size: 22px;
                font-weight: 800;
            }

                .section-title h2 i {
                    color: #2563eb;
                    font-size: 18px;
                }

            .section-title p {
                margin: 0;
                color: #748196;
                font-size: 12px;
            }


        /* =========================================================
           CALENDAR CARD
           ========================================================= */

        .calendar-card {
            background: #ffffff;
            border: 1px solid #e1e8f2;
            border-radius: 17px;
            padding: 22px;
            box-shadow: 0 10px 30px rgba(20, 33, 61, .06);
        }


        /* =========================================================
           CALENDAR HEADER
           ========================================================= */

        .calendar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 22px;
        }

        .calendar-month {
            color: #17213a;
            font-size: 20px;
            font-weight: 800;
        }

        .calendar-navigation {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .calendar-nav {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid #dbe3ee;
            border-radius: 9px;
            color: #506078;
            cursor: pointer;
            transition: all .2s ease;
        }

            .calendar-nav:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: #2563eb;
            }


        /* =========================================================
           CALENDAR WEEKDAYS
           ========================================================= */

        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 7px;
            margin-bottom: 7px;
        }

        .weekday {
            padding: 9px 4px;
            text-align: center;
            color: #8a96a8;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
        }


        /* =========================================================
           CALENDAR DAYS
           ========================================================= */

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 7px;
        }

        .calendar-day {
            position: relative;
            min-height: 76px;
            padding: 9px;
            background: #ffffff;
            border: 1px solid #edf1f6;
            border-radius: 10px;
            text-align: left;
            cursor: default;
            transition: all .2s ease;
        }

            .calendar-day.other-month {
                background: #fafbfd;
                color: #c5ccd6;
            }

        .calendar-day-number {
            display: block;
            margin-bottom: 8px;
            color: #455468;
            font-size: 12px;
            font-weight: 700;
        }

        .calendar-day.other-month .calendar-day-number {
            color: #bdc5d0;
        }

        .calendar-day.available {
            background: #f8fbff;
            border-color: #bfdbfe;
            cursor: pointer;
        }

            .calendar-day.available:hover {
                background: #eff6ff;
                border-color: #60a5fa;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(37, 99, 235, .10);
            }

        .calendar-day.selected {
            background: #2563eb;
            border-color: #2563eb;
            box-shadow: 0 7px 18px rgba(37, 99, 235, .20);
        }

            .calendar-day.selected .calendar-day-number {
                color: #ffffff;
            }

        .calendar-day.today {
            box-shadow: inset 0 0 0 2px #93c5fd;
        }

        .calendar-day.selected.today {
            box-shadow: 0 7px 18px rgba(37, 99, 235, .20);
        }

        .available-dot {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 6px;
            background: #dcfce7;
            border-radius: 20px;
            color: #15803d;
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

            .available-dot::before {
                content: "";
                width: 5px;
                height: 5px;
                background: #22c55e;
                border-radius: 50%;
            }

        .calendar-day.selected .available-dot {
            background: rgba(255,255,255,.18);
            color: #ffffff;
        }

            .calendar-day.selected .available-dot::before {
                background: #ffffff;
            }


        /* =========================================================
           CALENDAR LEGEND
           ========================================================= */

        .calendar-legend {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid #edf1f6;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #748196;
            font-size: 10px;
        }

        .legend-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

            .legend-dot.available {
                background: #22c55e;
            }

            .legend-dot.selected {
                background: #2563eb;
            }


        /* =========================================================
           SELECTED DATE PANEL
           ========================================================= */

        .selected-date-panel {
            margin-top: 22px;
            background: #ffffff;
            border: 1px solid #e1e8f2;
            border-radius: 17px;
            padding: 22px;
            box-shadow: 0 10px 30px rgba(20, 33, 61, .06);
        }

        .selected-date-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 18px;
        }

        .selected-date-heading {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .selected-date-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            color: #2563eb;
        }

        .selected-date-heading h3 {
            margin: 0 0 3px;
            color: #17213a;
            font-size: 17px;
            font-weight: 800;
        }

        .selected-date-heading p {
            margin: 0;
            color: #7b8799;
            font-size: 11px;
        }

        .slot-count {
            padding: 7px 11px;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 20px;
            color: #2563eb;
            font-size: 10px;
            font-weight: 800;
        }


        /* =========================================================
           LESSON SLOTS
           ========================================================= */

        .lesson-slots {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .lesson-slot {
            position: relative;
            padding: 17px;
            background: #f9fbfd;
            border: 1px solid #e1e8f2;
            border-radius: 12px;
            transition: all .2s ease;
        }

            .lesson-slot:hover {
                background: #ffffff;
                border-color: #bfdbfe;
                box-shadow: 0 7px 18px rgba(37, 99, 235, .07);
            }

        .slot-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 13px;
        }

        .slot-time {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #17213a;
            font-size: 14px;
            font-weight: 800;
        }

            .slot-time i {
                color: #2563eb;
                font-size: 13px;
            }

        .slot-status {
            padding: 5px 8px;
            background: #dcfce7;
            border-radius: 20px;
            color: #15803d;
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .slot-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 14px;
        }

        .slot-detail {
            padding: 9px;
            background: #ffffff;
            border: 1px solid #edf1f6;
            border-radius: 8px;
        }

        .slot-detail-label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 4px;
            color: #8a96a8;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

            .slot-detail-label i {
                color: #2563eb;
            }

        .slot-detail-value {
            display: block;
            overflow: hidden;
            color: #455468;
            font-size: 10px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        /* =========================================================
           BOOK FORM
           ========================================================= */

        .booking-form {
            padding-top: 13px;
            border-top: 1px solid #edf1f6;
        }

        .notes-label {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 7px;
            color: #68768a;
            font-size: 10px;
            font-weight: 700;
        }

            .notes-label i {
                color: #2563eb;
            }

            .notes-label span {
                color: #a0aaba;
                font-weight: 500;
            }

        .notes-input {
            width: 100%;
            min-height: 65px;
            padding: 10px 12px;
            resize: vertical;
            background: #ffffff;
            border: 1px solid #d9e2ef;
            border-radius: 8px;
            outline: none;
            color: #17213a;
            font-size: 11px;
            transition: all .2s ease;
        }

            .notes-input::placeholder {
                color: #a2acba;
            }

            .notes-input:focus {
                border-color: #60a5fa;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, .07);
            }


        /* =========================================================
           BOOK BUTTON
           ========================================================= */

        .book-button {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
            padding: 12px 16px;
            background: #2563eb;
            border: 1px solid #2563eb;
            border-radius: 8px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            transition: all .2s ease;
            box-shadow: 0 5px 14px rgba(37, 99, 235, .13);
        }

            .book-button:hover {
                background: #1d4ed8;
                border-color: #1d4ed8;
                transform: translateY(-1px);
                box-shadow: 0 8px 18px rgba(37, 99, 235, .20);
            }

            .book-button i {
                font-size: 11px;
            }


        /* =========================================================
           NO SELECTED DATE
           ========================================================= */

        .choose-date {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 190px;
            padding: 30px;
            text-align: center;
            background: #f8fafc;
            border: 1px dashed #d5deea;
            border-radius: 12px;
        }

        .choose-date-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            background: #eff6ff;
            border-radius: 12px;
            color: #2563eb;
            font-size: 18px;
        }

        .choose-date h3 {
            margin: 0 0 6px;
            color: #344054;
            font-size: 15px;
        }

        .choose-date p {
            margin: 0;
            color: #8793a5;
            font-size: 11px;
        }


        /* =========================================================
           EMPTY STATE
           ========================================================= */

        .empty-state {
            padding: 65px 25px;
            text-align: center;
            background: #ffffff;
            border: 1px solid #e1e8f2;
            border-radius: 17px;
            box-shadow: 0 10px 30px rgba(20, 33, 61, .05);
        }

        .empty-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 17px;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 14px;
            color: #2563eb;
            font-size: 22px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #17213a;
            font-size: 20px;
        }

        .empty-state p {
            margin: 0;
            color: #748196;
            font-size: 12px;
        }


        /* =========================================================
           HIDDEN
           ========================================================= */

        .hidden {
            display: none !important;
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 900px) {

            .package-summary {
                grid-template-columns: 1fr 1fr;
            }

            .package-info {
                grid-column: 1 / -1;
            }

            .lesson-slots {
                grid-template-columns: 1fr;
            }
        }


        @@media (max-width: 650px) {

            .booking-page {
                padding: 28px 14px 50px;
            }

            .page-header h1 {
                font-size: 30px;
            }

            .package-summary {
                grid-template-columns: 1fr;
            }

            .package-info {
                grid-column: auto;
            }

            .calendar-card,
            .selected-date-panel {
                padding: 15px;
            }

            .calendar-grid,
            .calendar-weekdays {
                gap: 4px;
            }

            .calendar-day {
                min-height: 58px;
                padding: 6px;
            }

            .calendar-day-number {
                font-size: 11px;
                margin-bottom: 5px;
            }

            .available-dot {
                padding: 2px 4px;
                font-size: 7px;
            }

                .available-dot::before {
                    width: 4px;
                    height: 4px;
                }

            .weekday {
                padding: 6px 2px;
                font-size: 8px;
            }

            .selected-date-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .slot-details {
                grid-template-columns: 1fr;
            }

            .back-dashboard-button {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

</head>


<body>

    <div class="booking-page">

        <div class="booking-container">


            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <div class="page-header">

                <div class="header-label">

                    <i class="fa-solid fa-car"></i>

                    Lesson Scheduling

                </div>

                <h1>
                    Book Your <span>Lesson</span>
                </h1>

                <p>
                    Select a date from the calendar to view available lesson times.
                </p>

                <a href="@Url.Action("Index", "Dashboard")"
                   class="back-dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Dashboard

                </a>

            </div>


            <!-- =====================================================
                 ALERTS
                 ===================================================== -->

            @if (TempData["BookingError"] != null)
            {
                <div class="alert alert-danger">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <span>
                        @TempData["BookingError"]
                    </span>

                </div>
            }


            @if (TempData["BookingSuccess"] != null)
            {
                <div class="alert alert-success">

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        @TempData["BookingSuccess"]
                    </span>

                </div>
            }


            <!-- =====================================================
                 PACKAGE SUMMARY
                 ===================================================== -->

            <div class="package-summary">

                <div class="package-info">

                    <div class="package-icon">

                        <i class="fa-solid fa-car-side"></i>

                    </div>

                    <h3>
                        @ViewBag.PackageName
                    </h3>

                    <p>
                        Your current lesson package
                    </p>

                </div>


                <div class="stat">

                    <div class="stat-icon">

                        <i class="fa-solid fa-cart-shopping"></i>

                    </div>

                    <span class="stat-number">
                        @ViewBag.LessonsPurchased
                    </span>

                    <span class="stat-label">
                        Purchased
                    </span>

                </div>


                <div class="stat">

                    <div class="stat-icon">

                        <i class="fa-solid fa-road"></i>

                    </div>

                    <span class="stat-number">
                        @ViewBag.LessonsRemaining
                    </span>

                    <span class="stat-label">
                        Lessons Remaining
                    </span>

                </div>

            </div>


            @if (schedules.Any())
            {

                <!-- =================================================
                     CALENDAR
                     ================================================= -->

                <div class="section-title">

                    <h2>

                        <i class="fa-solid fa-calendar-days"></i>

                        Choose a Date

                    </h2>

                    <p>
                        Dates with available lessons are highlighted in blue.
                    </p>

                </div>


                <div class="calendar-card">


                    <!-- CALENDAR HEADER -->

                    <div class="calendar-header">

                        <div class="calendar-month"
                             id="calendarMonth">

                            @firstMonth.ToString("MMMM yyyy")

                        </div>


                        <div class="calendar-navigation">

                            <button type="button"
                                    class="calendar-nav"
                                    id="previousMonth"
                                    title="Previous month">

                                <i class="fa-solid fa-chevron-left"></i>

                            </button>


                            <button type="button"
                                    class="calendar-nav"
                                    id="nextMonth"
                                    title="Next month">

                                <i class="fa-solid fa-chevron-right"></i>

                            </button>

                        </div>

                    </div>


                    <!-- WEEK DAYS -->

                    <div class="calendar-weekdays">

                        <div class="weekday">Mon</div>
                        <div class="weekday">Tue</div>
                        <div class="weekday">Wed</div>
                        <div class="weekday">Thu</div>
                        <div class="weekday">Fri</div>
                        <div class="weekday">Sat</div>
                        <div class="weekday">Sun</div>

                    </div>


                    <!-- CALENDAR -->

                    <div class="calendar-grid"
                         id="calendarGrid">

                        @for (var i = 0; i < 42; i++)
                        {
                            var currentDate = calendarStart.AddDays(i);

                            var dateKey = currentDate.ToString("yyyy-MM-dd");

                            var hasLessons = availableDates.Contains(dateKey);

                            var isCurrentMonth =
                                currentDate.Month == firstMonth.Month &&
                                currentDate.Year == firstMonth.Year;

                            var isToday =
                                currentDate.Date == DateTime.Today;

                            <div class="calendar-day
                             @(isCurrentMonth ? "" : "other-month")
                             @(hasLessons ? "available" : "")
                             @(isToday ? "today" : "")"
                                 data-date="@dateKey"
                                 data-available="@hasLessons.ToString().ToLower()">

                                <span class="calendar-day-number">
                                    @currentDate.Day
                                </span>

                                @if (hasLessons)
                                {
                                    <span class="available-dot">
                                        Available
                                    </span>
                                }

                            </div>
                        }

                    </div>


                    <!-- LEGEND -->

                    <div class="calendar-legend">

                        <div class="legend-item">

                            <span class="legend-dot available"></span>

                            Available lessons

                        </div>

                        <div class="legend-item">

                            <span class="legend-dot selected"></span>

                            Selected date

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SELECTED DATE
                     ================================================= -->

                <div class="selected-date-panel"
                     id="selectedDatePanel">


                    <div class="selected-date-header">

                        <div class="selected-date-heading">

                            <div class="selected-date-icon">

                                <i class="fa-solid fa-calendar-check"></i>

                            </div>

                            <div>

                                <h3 id="selectedDateTitle">
                                    Select a Date
                                </h3>

                                <p id="selectedDateSubtitle">
                                    Choose a highlighted date above to view lesson times.
                                </p>

                            </div>

                        </div>


                        <div class="slot-count hidden"
                             id="slotCount">

                        </div>

                    </div>


                    <!-- =================================================
                         LESSON SLOTS
                         ================================================= -->

                    <div id="lessonSlots"
                         class="lesson-slots">

                        <div class="choose-date"
                             style="grid-column: 1 / -1;">

                            <div class="choose-date-icon">

                                <i class="fa-regular fa-calendar"></i>

                            </div>

                            <h3>
                                Choose a lesson date
                            </h3>

                            <p>
                                Select a blue date on the calendar to see the available times.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     HIDDEN DATA FOR JAVASCRIPT
                     ================================================= -->

                <div id="scheduleData"
                     class="hidden">

                    @foreach (var schedule in schedules)
                    {
                        <div class="schedule-item"
                             data-date="@schedule.LessonDate.ToString("yyyy-MM-dd")"
                             data-id="@schedule.LessonScheduleId"
                             data-start="@schedule.StartTime.ToString(@"hh\:mm")"
                             data-end="@schedule.EndTime.ToString(@"hh\:mm")"
                             data-lesson="@(schedule.LessonType != null ? schedule.LessonType.LessonTypeName : "Not Assigned")"
                             data-instructor="@(schedule.Instructor != null ? schedule.Instructor.FirstName + " " + schedule.Instructor.LastName : "Not Assigned")"
                             data-vehicle="@(schedule.Vehicle != null ? schedule.Vehicle.Make + " " + schedule.Vehicle.Model : "Not Assigned")">
                        </div>
                    }

                </div>

            }
            else
            {

                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h3>
                        No Lessons Available
                    </h3>

                    <p>
                        There are currently no available lesson slots.
                        Please check again later.
                    </p>

                </div>

            }


        </div>

    </div>


    <script>

    /* =========================================================
       LESSON DATA
       ========================================================= */

    var scheduleItems = [];

    document
        .querySelectorAll(".schedule-item")
        .forEach(function (item) {

            scheduleItems.push({

                date: item.dataset.date,

                id: item.dataset.id,

                start: item.dataset.start,

                end: item.dataset.end,

                lesson: item.dataset.lesson,

                instructor: item.dataset.instructor,

                vehicle: item.dataset.vehicle

            });

        });


    /* =========================================================
       CALENDAR
       ========================================================= */

    var calendarMonth =
        new Date(
            @firstMonth.Year,
            @(firstMonth.Month - 1),
            1
        );


    var selectedDate = null;


    var availableDateSet = new Set(
        scheduleItems.map(function (item) {

            return item.date;

        })
    );


    /* =========================================================
       FORMAT DATE
       ========================================================= */

    function formatDate(dateString) {

        var date = new Date(dateString + "T00:00:00");

        return date.toLocaleDateString(
            "en-ZA",
            {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric"
            }
        );

    }


    /* =========================================================
       RENDER CALENDAR
       ========================================================= */

    function renderCalendar() {

        var year = calendarMonth.getFullYear();

        var month = calendarMonth.getMonth();


        document.getElementById("calendarMonth").textContent =

            calendarMonth.toLocaleDateString(
                "en-ZA",
                {
                    month: "long",
                    year: "numeric"
                }
            );


        var firstDay = new Date(year, month, 1);


        /*
         * Convert Sunday = 0 to Monday-based index.
         */

        var startDay = firstDay.getDay();

        if (startDay === 0) {

            startDay = 6;

        } else {

            startDay = startDay - 1;

        }


        var daysInMonth =
            new Date(
                year,
                month + 1,
                0
            ).getDate();


        var previousMonthDays =
            new Date(
                year,
                month,
                0
            ).getDate();


        var html = "";


        for (var i = 0; i < 42; i++) {

            var dayNumber =
                i - startDay + 1;


            var date;


            if (dayNumber <= 0) {

                date =
                    new Date(
                        year,
                        month - 1,
                        previousMonthDays + dayNumber
                    );

            }
            else if (dayNumber > daysInMonth) {

                date =
                    new Date(
                        year,
                        month + 1,
                        dayNumber - daysInMonth
                    );

            }
            else {

                date =
                    new Date(
                        year,
                        month,
                        dayNumber
                    );

            }


            var dateKey =
                date.getFullYear() +
                "-" +
                String(date.getMonth() + 1).padStart(2, "0") +
                "-" +
                String(date.getDate()).padStart(2, "0");


            var isCurrentMonth =
                date.getMonth() === month &&
                date.getFullYear() === year;


            var isAvailable =
                availableDateSet.has(dateKey);


            var today =
                new Date();


            var isToday =
                date.getFullYear() === today.getFullYear() &&
                date.getMonth() === today.getMonth() &&
                date.getDate() === today.getDate();


            var isSelected =
                selectedDate === dateKey;


            html +=

                '<div class="calendar-day ' +

                (!isCurrentMonth
                    ? "other-month "
                    : "") +

                (isAvailable
                    ? "available "
                    : "") +

                (isToday
                    ? "today "
                    : "") +

                (isSelected
                    ? "selected "
                    : "") +

                '" data-date="' +
                dateKey +
                '" data-available="' +
                isAvailable +
                '">';


            html +=

                '<span class="calendar-day-number">' +

                date.getDate() +

                '</span>';


            if (isAvailable) {

                html +=

                    '<span class="available-dot">' +

                    'Available' +

                    '</span>';

            }


            html += '</div>';

        }


        document.getElementById("calendarGrid").innerHTML = html;


        /*
         * Attach click events.
         */

        document
            .querySelectorAll(".calendar-day.available")
            .forEach(function (day) {

                day.addEventListener(
                    "click",
                    function () {

                        selectDate(
                            this.dataset.date
                        );

                    }
                );

            });

    }


    /* =========================================================
       SELECT DATE
       ========================================================= */

    function selectDate(dateKey) {

        selectedDate = dateKey;


        renderCalendar();


        var selectedLessons =
            scheduleItems.filter(
                function (item) {

                    return item.date === dateKey;

                }
            );


        var title =
            document.getElementById(
                "selectedDateTitle"
            );


        var subtitle =
            document.getElementById(
                "selectedDateSubtitle"
            );


        var slots =
            document.getElementById(
                "lessonSlots"
            );


        var count =
            document.getElementById(
                "slotCount"
            );


        title.textContent =
            formatDate(dateKey);


        subtitle.textContent =
            "Available lesson times for this date.";


        count.classList.remove("hidden");


        count.textContent =
            selectedLessons.length +
            (
                selectedLessons.length === 1
                    ? " slot"
                    : " slots"
            );


        slots.innerHTML = "";


        selectedLessons.forEach(
            function (lesson) {


                var card =
                    document.createElement("div");


                card.className =
                    "lesson-slot";


                card.innerHTML =

                    '<div class="slot-top">' +

                        '<div class="slot-time">' +

                            '<i class="fa-regular fa-clock"></i>' +

                            escapeHtml(lesson.start) +

                            ' - ' +

                            escapeHtml(lesson.end) +

                        '</div>' +

                        '<div class="slot-status">' +

                            'Available' +

                        '</div>' +

                    '</div>' +


                    '<div class="slot-details">' +

                        '<div class="slot-detail">' +

                            '<span class="slot-detail-label">' +

                                '<i class="fa-solid fa-book-open"></i>' +

                                'Lesson' +

                            '</span>' +

                            '<span class="slot-detail-value">' +

                                escapeHtml(lesson.lesson) +

                            '</span>' +

                        '</div>' +


                        '<div class="slot-detail">' +

                            '<span class="slot-detail-label">' +

                                '<i class="fa-solid fa-user-tie"></i>' +

                                'Instructor' +

                            '</span>' +

                            '<span class="slot-detail-value">' +

                                escapeHtml(lesson.instructor) +

                            '</span>' +

                        '</div>' +


                        '<div class="slot-detail">' +

                            '<span class="slot-detail-label">' +

                                '<i class="fa-solid fa-car"></i>' +

                                'Vehicle' +

                            '</span>' +

                            '<span class="slot-detail-value">' +

                                escapeHtml(lesson.vehicle) +

                            '</span>' +

                        '</div>' +

                    '</div>' +


                    '<div class="booking-form">' +

                        '<form method="post" action="@Url.Action("Create", "Booking")">' +

                            '@Html.AntiForgeryToken()' +

                            '<input type="hidden" name="LessonScheduleId" value="' +

                                escapeHtml(lesson.id) +

                            '" />' +

                            '<label class="notes-label">' +

                                '<i class="fa-regular fa-note-sticky"></i>' +

                                'Notes ' +

                                '<span>(Optional)</span>' +

                            '</label>' +

                            '<textarea name="Notes" class="notes-input" placeholder="Add any notes or special requests for your instructor..."></textarea>' +

                            '<button type="submit" class="book-button">' +

                                '<i class="fa-solid fa-calendar-plus"></i>' +

                                'Book This Lesson' +

                                '<i class="fa-solid fa-arrow-right"></i>' +

                            '</button>' +

                        '</form>' +

                    '</div>';


                slots.appendChild(card);

            }
        );


        /*
         * Scroll the selected lesson area into view
         * on smaller screens.
         */

        if (window.innerWidth <= 650) {

            document
                .getElementById("selectedDatePanel")
                .scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

        }

    }


    /* =========================================================
       ESCAPE HTML
       ========================================================= */

    function escapeHtml(value) {

        if (value === null ||
            value === undefined) {

            return "";

        }


        return String(value)

            .replace(/&/g, "&amp;")

            .replace(/</g, "&lt;")

            .replace(/>/g, "&gt;")

            .replace(/"/g, "&quot;")

            .replace(/'/g, "&#039;");

    }


    /* =========================================================
       MONTH NAVIGATION
       ========================================================= */

    document
        .getElementById("previousMonth")
        .addEventListener(
            "click",
            function () {

                calendarMonth.setMonth(
                    calendarMonth.getMonth() - 1
                );

                renderCalendar();

            }
        );


    document
        .getElementById("nextMonth")
        .addEventListener(
            "click",
            function () {

                calendarMonth.setMonth(
                    calendarMonth.getMonth() + 1
                );

                renderCalendar();

            }
        );


    /* =========================================================
       INITIALIZE
       ========================================================= */

    renderCalendar();


    /*
     * Automatically select the first available date.
     */

    @if (groupedSchedules.Any())
    {
        <text>

        selectDate(
            "@firstDate.ToString("yyyy-MM-dd")"
        );

        </text>
    }

    </script>

</body>
</html>