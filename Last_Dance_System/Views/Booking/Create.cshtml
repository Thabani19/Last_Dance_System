@model IEnumerable<Last_Dance_System.Models.LessonSchedule>

@{
    ViewBag.Title = "Book a Lesson";
}

<style>

    body {
        background: #07111f;
        color: white;
    }

    .booking-page {
        min-height: 90vh;
        padding: 40px 20px;
        background: radial-gradient(circle at top right, rgba(225,6,0,.12), transparent 30%), #07111f;
    }

    .booking-container {
        max-width: 1100px;
        margin: auto;
    }

    .booking-header {
        margin-bottom: 30px;
    }

        .booking-header h1 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 8px;
        }

            .booking-header h1 span {
                color: #e10600;
            }

        .booking-header p {
            color: #8290a3;
            margin: 0;
        }

    .alert-error {
        background: rgba(225,6,0,.12);
        border: 1px solid rgba(225,6,0,.3);
        color: #ff6b6b;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .schedule-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .schedule-card {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 16px;
        padding: 24px;
        transition: .25s;
    }

        .schedule-card:hover {
            transform: translateY(-3px);
            border-color: rgba(225,6,0,.5);
        }

    .schedule-date {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }

    .date-box {
        width: 58px;
        height: 58px;
        background: #e10600;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .date-box strong {
            font-size: 20px;
        }

        .date-box span {
            font-size: 10px;
            text-transform: uppercase;
        }

    .schedule-date h3 {
        margin: 0 0 5px;
        font-size: 17px;
    }

    .schedule-date p {
        margin: 0;
        color: #718096;
        font-size: 12px;
    }

    .details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    .detail {
        background: #08111d;
        padding: 12px;
        border-radius: 8px;
        color: #8b98a9;
        font-size: 12px;
    }

        .detail strong {
            display: block;
            color: white;
            margin-top: 4px;
        }

    .book-button {
        width: 100%;
        border: none;
        padding: 12px;
        background: #e10600;
        color: white;
        border-radius: 9px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .book-button:hover {
            background: #ff211a;
        }

    .empty {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 15px;
        padding: 50px;
        text-align: center;
    }

        .empty h3 {
            margin-bottom: 8px;
        }

        .empty p {
            color: #718096;
        }

    @@media(max-width: 750px) {
        .schedule-grid {
            grid-template-columns: 1fr;
        }

        .details {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="booking-page">

    <div class="booking-container">

        <div class="booking-header">

            <h1>
                Book a <span>Driving Lesson</span>
            </h1>

            <p>
                Select an available lesson schedule.
                Your instructor and vehicle will be assigned automatically.
            </p>

        </div>


        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                @TempData["Error"]
            </div>
        }


        @if (Model != null && Model.Any())
        {

            <div class="schedule-grid">

                @foreach (var schedule in Model)
                {

                    <div class="schedule-card">

                        <div class="schedule-date">

                            <div class="date-box">

                                <strong>
                                    @schedule.LessonDate.Day
                                </strong>

                                <span>
                                    @schedule.LessonDate.ToString("MMM")
                                </span>

                            </div>

                            <div>

                                <h3>
                                    @schedule.LessonType.LessonTypeName
                                </h3>

                                <p>
                                    @schedule.LessonDate.ToString("dddd, dd MMMM yyyy")
                                </p>

                            </div>

                        </div>


                        <div class="details">

                            <div class="detail">

                                Time

                                <strong>
                                    @schedule.StartTime.ToString(@"hh\:mm")
                                    -
                                    @schedule.EndTime.ToString(@"hh\:mm")
                                </strong>

                            </div>


                            <div class="detail">

                                Duration

                                <strong>
                                    @schedule.LessonType.DurationMinutes minutes
                                </strong>

                            </div>


                            <div class="detail">

                                Instructor

                                <strong>
                                    @schedule.Instructor.FirstName
                                    @schedule.Instructor.LastName
                                </strong>

                            </div>


                            <div class="detail">

                                Vehicle

                                <strong>
                                    @schedule.Vehicle.Make
                                    @schedule.Vehicle.Model
                                </strong>

                            </div>

                        </div>


                        @using (Html.BeginForm(
                            "Create",
                            "Booking",
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="lessonScheduleId"
                                   value="@schedule.LessonScheduleId" />

                            <button type="submit"
                                    class="book-button">

                                Book This Lesson

                            </button>
                        }

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty">

                <h3>
                    No Available Lessons
                </h3>

                <p>
                    There are currently no available lesson schedules.
                    Please check again later.
                </p>

            </div>

        }

    </div>

</div>