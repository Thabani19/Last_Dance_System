@model IEnumerable<Last_Dance_System.Models.Booking>

@{
    Layout = null;
    ViewBag.Title = "My Lessons";
}

<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f4f7fb;
        color: #172033;
        font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    }

    button,
    input,
    textarea {
        font-family: inherit;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .lessons-page {
        min-height: 100vh;
        padding: 40px 25px 70px;
        background: radial-gradient( circle at 90% 0%, rgba(37, 99, 235, .08), transparent 30% ), linear-gradient( 180deg, #f8fbff 0%, #f3f7fc 100% );
    }

    .lessons-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        margin-bottom: 28px;
    }

    .header-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 10px;
        color: #2563eb;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.6px;
        text-transform: uppercase;
    }

        .header-label::before {
            content: "";
            width: 27px;
            height: 2px;
            background: #2563eb;
            border-radius: 10px;
        }

        .header-label i {
            font-size: 12px;
        }

    .page-header h1 {
        margin: 0 0 8px;
        color: #14213d;
        font-size: 38px;
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -.6px;
    }

        .page-header h1 span {
            color: #2563eb;
        }

    .page-header p {
        margin: 0;
        color: #6b778c;
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: all .2s ease;
    }

        .action-btn:hover {
            text-decoration: none;
            transform: translateY(-2px);
        }

    .dashboard-btn {
        background: #ffffff;
        border: 1px solid #d9e2ef;
        color: #455468;
        box-shadow: 0 4px 12px rgba(20, 33, 61, .04);
    }

        .dashboard-btn i {
            color: #2563eb;
        }

        .dashboard-btn:hover {
            background: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(37, 99, 235, .18);
        }

            .dashboard-btn:hover i {
                color: #ffffff;
            }

    .new-booking-btn {
        background: #2563eb;
        border: 1px solid #2563eb;
        color: #ffffff;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .13);
    }

        .new-booking-btn:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(37, 99, 235, .20);
        }


    /* =========================================================
       ALERT
       ========================================================= */

    .alert {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px 17px;
        margin-bottom: 22px;
        border-radius: 10px;
        font-size: 12px;
        line-height: 1.5;
    }

        .alert i {
            flex-shrink: 0;
            font-size: 15px;
        }

    .alert-success {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }


    /* =========================================================
       PACKAGE SUMMARY
       ========================================================= */

    .package-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 170px 190px;
        gap: 16px;
        align-items: stretch;
        margin-bottom: 30px;
    }

    .package-name {
        position: relative;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #e1e8f2;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(20, 33, 61, .05);
    }

        .package-name::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: #2563eb;
        }

    .package-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 13px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 11px;
        color: #2563eb;
        font-size: 17px;
    }

    .package-name h3 {
        margin: 0 0 6px;
        color: #14213d;
        font-size: 20px;
        font-weight: 800;
    }

    .package-name p {
        margin: 0;
        color: #7b8799;
        font-size: 12px;
    }


    /* =========================================================
       STATS
       ========================================================= */

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 18px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e1e8f2;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(20, 33, 61, .05);
        transition: all .2s ease;
    }

        .stat:hover {
            border-color: #bfdbfe;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, .08);
        }

    .stat-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 7px;
        background: #eff6ff;
        border-radius: 9px;
        color: #2563eb;
        font-size: 14px;
    }

    .stat-number {
        display: block;
        color: #1d4ed8;
        font-size: 26px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #7b8799;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }


    /* =========================================================
       SECTION HEADER
       ========================================================= */

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 17px;
    }

    .section-title h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 6px;
        color: #17213a;
        font-size: 22px;
        font-weight: 800;
    }

        .section-title h2 i {
            color: #2563eb;
            font-size: 18px;
        }

    .section-title p {
        margin: 0;
        color: #748196;
        font-size: 12px;
    }


    /* =========================================================
       LESSON CARD
       ========================================================= */

    .lesson-card {
        position: relative;
        margin-bottom: 16px;
        padding: 22px;
        background: #ffffff;
        border: 1px solid #e1e8f2;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(20, 33, 61, .05);
        transition: all .2s ease;
    }

        .lesson-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: #2563eb;
        }

        .lesson-card:hover {
            border-color: #c7d9f4;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(37, 99, 235, .08);
        }


    /* =========================================================
       LESSON TOP
       ========================================================= */

    .lesson-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .lesson-date {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .date-box {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 13px;
        color: #2563eb;
        font-size: 24px;
        font-weight: 900;
    }

    .date-info strong {
        display: block;
        margin-bottom: 4px;
        color: #17213a;
        font-size: 17px;
        font-weight: 800;
    }

    .date-info span {
        color: #7b8799;
        font-size: 11px;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 30px;
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

        .status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #22c55e;
        }


    /* =========================================================
       DETAILS
       ========================================================= */

    .details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .detail {
        padding: 13px;
        background: #f8fafc;
        border: 1px solid #edf1f6;
        border-radius: 10px;
        transition: all .2s ease;
    }

        .detail:hover {
            background: #ffffff;
            border-color: #dbeafe;
        }

    .detail-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        color: #8a96a8;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

        .detail-label i {
            color: #2563eb;
            font-size: 10px;
        }

    .detail-value {
        display: block;
        overflow: hidden;
        color: #455468;
        font-size: 11px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .lesson-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 17px;
        padding-top: 15px;
        border-top: 1px solid #edf1f6;
    }

    .booking-date {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #8793a5;
        font-size: 10px;
    }

        .booking-date i {
            color: #2563eb;
        }


    /* =========================================================
       CANCEL BUTTON
       ========================================================= */

    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 14px;
        background: #fff7f7;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #dc2626;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        transition: all .2s ease;
    }

        .cancel-btn:hover {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #b91c1c;
            transform: translateY(-1px);
        }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        padding: 65px 25px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e1e8f2;
        border-radius: 17px;
        box-shadow: 0 10px 30px rgba(20, 33, 61, .05);
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        color: #2563eb;
        font-size: 23px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #17213a;
        font-size: 20px;
        font-weight: 800;
    }

    .empty-state p {
        max-width: 450px;
        margin: 0 auto 22px;
        color: #748196;
        font-size: 12px;
        line-height: 1.6;
    }

    .book-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 9px;
        color: #ffffff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .13);
        transition: all .2s ease;
    }

        .book-btn:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(37, 99, 235, .20);
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {

        .package-summary {
            grid-template-columns: 1fr 1fr;
        }

        .package-name {
            grid-column: 1 / -1;
        }

        .details {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 600px) {

        .lessons-page {
            padding: 28px 14px 50px;
        }

        .page-header h1 {
            font-size: 30px;
        }

        .package-summary {
            grid-template-columns: 1fr;
        }

        .package-name {
            grid-column: auto;
        }

        .details {
            grid-template-columns: 1fr;
        }

        .lesson-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .status {
            align-self: flex-start;
        }

        .lesson-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .cancel-btn {
            width: 100%;
        }

        .page-actions {
            flex-direction: column;
        }

        .action-btn {
            width: 100%;
        }
    }
</style>

<div class="lessons-page">

   
    <div class="lessons-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div class="header-label">

                <i class="fa-solid fa-car"></i>

                Student Portal

            </div>

            <h1>
                My <span>Lessons</span>
            </h1>

            <p>
                View and manage all your scheduled driving lessons.
            </p>


            <div class="page-actions">

                <a href="@Url.Action("Index", "Dashboard")"
                   class="action-btn dashboard-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Dashboard

                </a>


                <a href="@Url.Action("Create", "Booking")"
                   class="action-btn new-booking-btn">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book New Lesson

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="alert alert-success">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    @TempData["BookingSuccess"]
                </span>

            </div>
        }


        <!-- =====================================================
             PACKAGE SUMMARY
             ===================================================== -->

        <div class="package-summary">


            <div class="package-name">

                <div class="package-icon">

                    <i class="fa-solid fa-car-side"></i>

                </div>

                <h3>
                    @ViewBag.PackageName
                </h3>

                <p>
                    Your current lesson package
                </p>

            </div>


            <div class="stat">

                <div class="stat-icon">

                    <i class="fa-solid fa-cart-shopping"></i>

                </div>

                <span class="stat-number">
                    @ViewBag.LessonsPurchased
                </span>

                <span class="stat-label">
                    Purchased
                </span>

            </div>


            <div class="stat">

                <div class="stat-icon">

                    <i class="fa-solid fa-road"></i>

                </div>

                <span class="stat-number">
                    @ViewBag.LessonsRemaining
                </span>

                <span class="stat-label">
                    Remaining
                </span>

            </div>

        </div>


        <!-- =====================================================
             SECTION HEADER
             ===================================================== -->

        @if (Model != null && Model.Any())
        {

            <div class="section-header">

                <div class="section-title">

                    <h2>

                        <i class="fa-solid fa-calendar-check"></i>

                        Scheduled Lessons

                    </h2>

                    <p>
                        Your upcoming and booked driving lessons.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 LESSONS
                 ================================================= -->

            foreach (var booking in Model)
            {

                <div class="lesson-card">


                    <!-- LESSON HEADER -->

                    <div class="lesson-top">

                        <div class="lesson-date">

                            <div class="date-box">

                                @booking.LessonSchedule.LessonDate.Day

                            </div>


                            <div class="date-info">

                                <strong>

                                    @booking.LessonSchedule.LessonDate.ToString("dddd")

                                </strong>

                                <span>

                                    @booking.LessonSchedule.LessonDate.ToString("dd MMMM yyyy")

                                </span>

                            </div>

                        </div>


                        <div class="status">

                            @booking.Status.ToUpper()

                        </div>

                    </div>


                    <!-- =================================================
                         DETAILS
                         ================================================= -->

                    <div class="details">


                        <!-- TIME -->

                        <div class="detail">

                            <span class="detail-label">

                                <i class="fa-regular fa-clock"></i>

                                Time

                            </span>

                            <span class="detail-value">

                                @booking.LessonSchedule.StartTime.ToString(@"hh\:mm")

                                -

                                @booking.LessonSchedule.EndTime.ToString(@"hh\:mm")

                            </span>

                        </div>


                        <!-- LESSON -->

                        <div class="detail">

                            <span class="detail-label">

                                <i class="fa-solid fa-book-open"></i>

                                Lesson

                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.LessonType != null)
                                {
                                    @booking.LessonSchedule.LessonType.LessonTypeName
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>


                        <!-- INSTRUCTOR -->

                        <div class="detail">

                            <span class="detail-label">

                                <i class="fa-solid fa-user-tie"></i>

                                Instructor

                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.Instructor != null)
                                {
                                    @booking.LessonSchedule.Instructor.FirstName
                                    @: @booking.LessonSchedule.Instructor.LastName
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>


                        <!-- VEHICLE -->

                        <div class="detail">

                            <span class="detail-label">

                                <i class="fa-solid fa-car"></i>

                                Vehicle

                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.Vehicle != null)
                                {
                                    @booking.LessonSchedule.Vehicle.Make
                                    @: @booking.LessonSchedule.Vehicle.Model
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <div class="lesson-footer">


                        <div class="booking-date">

                            <i class="fa-regular fa-calendar-plus"></i>

                            Booked on

                            @booking.BookingDate.ToString("dd MMM yyyy HH:mm")

                        </div>


                        <!-- =================================================
                             CANCEL BUTTON
                             ================================================= -->

                        @if (booking.Status != "Cancelled" &&
                             booking.LessonSchedule.LessonDate >= DateTime.Today)
                        {

                            using (Html.BeginForm(
                                "Cancel",
                                "Booking",
                                FormMethod.Post,
                                new
                                {
                                    onsubmit = "return confirm('Are you sure you want to cancel this lesson?');"
                                }))
                            {

                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="id"
                                       value="@booking.BookingId" />


                                <button type="submit"
                                        class="cancel-btn">

                                    <i class="fa-solid fa-calendar-xmark"></i>

                                    Cancel Lesson

                                </button>

                            }

                        }

                    </div>

                </div>

            }

        }
        else
        {

            <!-- =====================================================
                 EMPTY STATE
                 ===================================================== -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="fa-regular fa-calendar-xmark"></i>

                </div>

                <h3>
                    You Have No Lessons Yet
                </h3>

                <p>
                    You currently have no booked driving lessons.
                    Select an available date and time to schedule your first lesson.
                </p>


                <a href="@Url.Action("Create", "Booking")"
                   class="book-btn">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book a Lesson

                </a>

            </div>

        }


    </div>
    

</div>
