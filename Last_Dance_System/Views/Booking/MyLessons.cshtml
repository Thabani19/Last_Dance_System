@model IEnumerable<Last_Dance_System.Models.Booking>

@{
    ViewBag.Title = "My Lessons";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: white;
        font-family: Arial, Helvetica, sans-serif;
    }

    .lessons-page {
        min-height: 100vh;
        padding: 45px 25px;
        background: radial-gradient(circle at top right, rgba(225, 6, 0, 0.15), transparent 35%), #07111f;
    }

    .lessons-container {
        max-width: 1200px;
        margin: auto;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 800;
        }

        .page-header p {
            color: #9ba7b7;
            margin-top: 10px;
        }

    .package-summary {
        background: #0d1929;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 25px;
        display: grid;
        grid-template-columns: 1fr 150px 150px;
        gap: 20px;
        align-items: center;
        margin-bottom: 35px;
    }

    .package-name h3 {
        margin: 0 0 7px;
        font-size: 20px;
    }

    .package-name p {
        margin: 0;
        color: #8f9aaa;
    }

    .stat {
        text-align: center;
        padding: 15px;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
    }

    .stat-number {
        display: block;
        font-size: 27px;
        font-weight: 800;
        color: #ff3028;
    }

    .stat-label {
        color: #8f9aaa;
        font-size: 12px;
    }

    .alert {
        padding: 15px 18px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .alert-success {
        background: rgba(25, 135, 84, 0.15);
        border: 1px solid rgba(25, 135, 84, 0.35);
        color: #8ff0bb;
    }

    .lesson-card {
        background: #0d1929;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .lesson-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .lesson-date {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .date-box {
        width: 60px;
        height: 60px;
        min-width: 60px;
        border-radius: 14px;
        background: rgba(225,6,0,0.15);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #ff3028;
        font-size: 25px;
        font-weight: 800;
    }

    .date-info strong {
        display: block;
        font-size: 18px;
    }

    .date-info span {
        color: #8f9aaa;
        font-size: 13px;
    }

    .status {
        padding: 8px 14px;
        border-radius: 50px;
        background: rgba(25,135,84,0.15);
        color: #79e7a7;
        font-size: 12px;
        font-weight: 700;
    }

    .details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .detail {
        background: rgba(255,255,255,0.03);
        padding: 15px;
        border-radius: 12px;
    }

    .detail-label {
        display: block;
        color: #8f9aaa;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .detail-value {
        font-weight: 600;
    }

    .lesson-footer {
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .booking-date {
        color: #7f8a9a;
        font-size: 12px;
    }

    .cancel-btn {
        border: 1px solid rgba(225,6,0,0.4);
        background: rgba(225,6,0,0.08);
        color: #ff7772;
        border-radius: 10px;
        padding: 10px 16px;
        cursor: pointer;
        font-weight: 700;
    }

        .cancel-btn:hover {
            background: rgba(225,6,0,0.2);
        }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        background: #0d1929;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
    }

        .empty-state h3 {
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #8f9aaa;
            margin-bottom: 25px;
        }

    .book-btn {
        display: inline-block;
        padding: 13px 22px;
        background: #e10600;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
    }

        .book-btn:hover {
            background: #ff1b14;
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 800px) {

        .package-summary {
            grid-template-columns: 1fr 1fr;
        }

        .package-name {
            grid-column: 1 / -1;
        }

        .details {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 550px) {

        .page-header h1 {
            font-size: 30px;
        }

        .package-summary {
            grid-template-columns: 1fr;
        }

        .package-name {
            grid-column: auto;
        }

        .details {
            grid-template-columns: 1fr;
        }

        .lesson-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .lesson-footer {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>


<div class="lessons-page">

    <div class="lessons-container">

        <!-- HEADER -->

        <div class="page-header">

            <h1>My Lessons</h1>

            <p>
                View and manage all your booked driving lessons.
            </p>

        </div>


        <!-- SUCCESS MESSAGE -->

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["BookingSuccess"]
            </div>
        }


        <!-- PACKAGE SUMMARY -->

        <div class="package-summary">

            <div class="package-name">

                <h3>
                    @ViewBag.PackageName
                </h3>

                <p>
                    Current lesson package
                </p>

            </div>


            <div class="stat">

                <span class="stat-number">
                    @ViewBag.LessonsPurchased
                </span>

                <span class="stat-label">
                    Purchased
                </span>

            </div>


            <div class="stat">

                <span class="stat-number">
                    @ViewBag.LessonsRemaining
                </span>

                <span class="stat-label">
                    Remaining
                </span>

            </div>

        </div>


        <!-- LESSONS -->

        @if (Model != null && Model.Any())
        {
            foreach (var booking in Model)
            {
                <div class="lesson-card">

                    <!-- LESSON HEADER -->

                    <div class="lesson-top">

                        <div class="lesson-date">

                            <div class="date-box">

                                @booking.LessonSchedule.LessonDate.Day

                            </div>

                            <div class="date-info">

                                <strong>
                                    @booking.LessonSchedule.LessonDate.ToString("dddd")
                                </strong>

                                <span>
                                    @booking.LessonSchedule.LessonDate.ToString("dd MMMM yyyy")
                                </span>

                            </div>

                        </div>


                        <div class="status">

                            @booking.Status.ToUpper()

                        </div>

                    </div>


                    <!-- DETAILS -->

                    <div class="details">


                        <!-- TIME -->

                        <div class="detail">

                            <span class="detail-label">
                                Time
                            </span>

                            <span class="detail-value">

                                @booking.LessonSchedule.StartTime.ToString(@"hh\:mm")

                                -

                                @booking.LessonSchedule.EndTime.ToString(@"hh\:mm")

                            </span>

                        </div>


                        <!-- LESSON -->

                        <div class="detail">

                            <span class="detail-label">
                                Lesson
                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.LessonType != null)
                                {
                                    @booking.LessonSchedule.LessonType.LessonTypeName
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>


                        <!-- INSTRUCTOR -->

                        <div class="detail">

                            <span class="detail-label">
                                Instructor
                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.Instructor != null)
                                {
                                    @booking.LessonSchedule.Instructor.FirstName
                                    @booking.LessonSchedule.Instructor.LastName
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>


                        <!-- VEHICLE -->

                        <div class="detail">

                            <span class="detail-label">
                                Vehicle
                            </span>

                            <span class="detail-value">

                                @if (booking.LessonSchedule.Vehicle != null)
                                {
                                    @booking.LessonSchedule.Vehicle.Make
                                    @booking.LessonSchedule.Vehicle.Model
                                }
                                else
                                {
                                    @:Not Assigned
                                }

                            </span>

                        </div>

                    </div>


                    <!-- FOOTER -->

                    <div class="lesson-footer">

                        <div class="booking-date">

                            Booked on

                            @booking.BookingDate.ToString("dd MMM yyyy HH:mm")

                        </div>


                        <!-- CANCEL BUTTON -->

                        @if (booking.Status != "Cancelled" &&
                             booking.LessonSchedule.LessonDate >= DateTime.Today)
                        {
                            using (Html.BeginForm(
                                "Cancel",
                                "Booking",
                                FormMethod.Post,
                                new
                                {
                                    onsubmit = "return confirm('Are you sure you want to cancel this lesson?');"
                                }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@booking.BookingId" />

                                <button type="submit"
                                        class="cancel-btn">

                                    Cancel Lesson

                                </button>
                            }
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="empty-state">

                <h3>
                    You Have No Lessons Yet
                </h3>

                <p>
                    Purchase a package and book your first lesson to get started.
                </p>

                <a href="@Url.Action("Create", "Booking")"
                   class="book-btn">

                    Book a Lesson

                </a>

            </div>
        }

    </div>

</div>