@model IEnumerable<Last_Dance_System.Models.StudentPackage>

@{
    ViewBag.Title = "My Packages";
}

<style>
    .cancel-package-button {
        display: block;
        width: 100%;
        padding: 13px 18px;
        margin-top: 10px;
        background: rgba(225, 6, 0, .08);
        border: 1px solid rgba(225, 6, 0, .30);
        color: #ff817d;
        border-radius: 9px;
        text-decoration: none;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
    }

        .cancel-package-button:hover {
            background: #e10600;
            border-color: #e10600;
            color: #ffffff;
            text-decoration: none;
        }
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }

    .packages-page {
        min-height: 90vh;
        padding: 40px 20px;
        background: radial-gradient( circle at top right, rgba(225, 6, 0, .12), transparent 30% ), #07111f;
    }

    .packages-container {
        max-width: 1100px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 30px;
            font-weight: 800;
        }

            .page-header h1 span {
                color: #e10600;
            }

        .page-header p {
            margin: 0;
            color: #8290a3;
            font-size: 13px;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }


    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    .dashboard-button {
        display: inline-block;
        padding: 12px 18px;
        background: #16263a;
        color: #ffffff;
        border: 1px solid #29415c;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        white-space: nowrap;
    }

        .dashboard-button:hover {
            background: #243b55;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }

        .dashboard-button i {
            margin-right: 6px;
        }


    /* =========================================================
       BROWSE BUTTON
       ========================================================= */

    .browse-button {
        display: inline-block;
        padding: 12px 18px;
        background: #e10600;
        color: #ffffff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        white-space: nowrap;
    }

        .browse-button:hover {
            background: #ff211a;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       MESSAGES
       ========================================================= */

    .success-message {
        background: rgba(34, 197, 94, .10);
        border: 1px solid rgba(34, 197, 94, .25);
        color: #86efac;
        padding: 14px 16px;
        border-radius: 9px;
        margin-bottom: 25px;
        font-size: 13px;
    }

    .error-message {
        background: rgba(225, 6, 0, .10);
        border: 1px solid rgba(225, 6, 0, .25);
        color: #ff817d;
        padding: 14px 16px;
        border-radius: 9px;
        margin-bottom: 25px;
        font-size: 13px;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-card {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 16px;
        padding: 60px 30px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(225, 6, 0, .10);
        border: 1px solid rgba(225, 6, 0, .20);
        border-radius: 15px;
        font-size: 30px;
    }

    .empty-card h2 {
        margin: 0 0 10px;
        font-size: 22px;
    }

    .empty-card p {
        color: #8290a3;
        font-size: 13px;
        margin-bottom: 25px;
    }


    /* =========================================================
       PACKAGE GRID
       ========================================================= */

    .packages-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }


    /* =========================================================
       PACKAGE CARD
       ========================================================= */

    .package-card {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 16px;
        padding: 25px;
        position: relative;
        overflow: hidden;
        transition: .25s ease;
    }

        .package-card:hover {
            border-color: rgba(225, 6, 0, .35);
            transform: translateY(-2px);
        }

        .package-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #e10600;
        }


    /* =========================================================
       PACKAGE HEADER
       ========================================================= */

    .package-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .package-title {
        margin: 0;
        font-size: 21px;
        font-weight: 800;
    }

    .package-date {
        color: #718096;
        font-size: 11px;
        margin-top: 5px;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .status-paid {
        background: rgba(34, 197, 94, .12);
        border: 1px solid rgba(34, 197, 94, .25);
        color: #86efac;
    }

    .status-pending {
        background: rgba(234, 179, 8, .12);
        border: 1px solid rgba(234, 179, 8, .25);
        color: #fde047;
    }

    .status-failed {
        background: rgba(225, 6, 0, .12);
        border: 1px solid rgba(225, 6, 0, .25);
        color: #ff817d;
    }


    /* =========================================================
       DESCRIPTION
       ========================================================= */

    .package-description {
        color: #8290a3;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 20px;
    }


    /* =========================================================
       PENDING NOTICE
       ========================================================= */

    .pending-notice {
        background: rgba(234, 179, 8, .07);
        border: 1px solid rgba(234, 179, 8, .18);
        color: #fde68a;
        padding: 12px 14px;
        border-radius: 9px;
        font-size: 11px;
        line-height: 1.5;
        margin-bottom: 15px;
    }

        .pending-notice i {
            margin-right: 7px;
        }


    /* =========================================================
       LESSON CREDITS
       ========================================================= */

    .lesson-box {
        background: #08111d;
        border: 1px solid #16263a;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .lesson-box-title {
        color: #718096;
        font-size: 11px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .lesson-numbers {
        display: flex;
        justify-content: space-between;
        gap: 15px;
    }

    .lesson-number {
        flex: 1;
    }

        .lesson-number span {
            display: block;
            color: #8290a3;
            font-size: 11px;
            margin-bottom: 5px;
        }

        .lesson-number strong {
            font-size: 24px;
        }

    .remaining {
        color: #e10600;
    }

    .pending-credit {
        color: #fde047 !important;
    }


    /* =========================================================
       DETAILS
       ========================================================= */

    .details {
        border-top: 1px solid #1b2a3d;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #16263a;
        font-size: 12px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span {
            color: #718096;
        }

        .detail-row strong {
            color: #ffffff;
        }


    /* =========================================================
       STATUS COLORS
       ========================================================= */

    .active {
        color: #86efac !important;
    }

    .inactive {
        color: #ff817d !important;
    }

    .pending {
        color: #fde047 !important;
    }


    /* =========================================================
       PAYMENT ACTIONS
       ========================================================= */

    .payment-actions {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    /* =========================================================
       PAY NOW
       ========================================================= */

    .pay-now-button {
        display: block;
        width: 100%;
        padding: 14px 18px;
        background: #e10600;
        color: #ffffff;
        border-radius: 9px;
        text-decoration: none;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
    }

        .pay-now-button:hover {
            background: #ff211a;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       ACTIVE PACKAGE
       ========================================================= */

    .active-package-button {
        display: block;
        width: 100%;
        padding: 14px 18px;
        background: rgba(34, 197, 94, .10);
        border: 1px solid rgba(34, 197, 94, .25);
        color: #86efac;
        border-radius: 9px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================================================
       CANCEL PACKAGE
       ========================================================= */

    .cancel-package-button {
        display: block;
        width: 100%;
        padding: 13px 18px;
        background: rgba(225, 6, 0, .08);
        border: 1px solid rgba(225, 6, 0, .30);
        color: #ff817d;
        border-radius: 9px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

        .cancel-package-button:hover {
            background: #e10600;
            border-color: #e10600;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width: 750px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .packages-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media(max-width: 500px) {

        .packages-page {
            padding: 30px 15px;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

            .header-actions a {
                width: 100%;
                text-align: center;
            }

        .package-header {
            flex-direction: column;
        }

        .lesson-numbers {
            flex-direction: column;
        }
    }
</style>


<div class="packages-page">

    <div class="packages-container">


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <h1>
                    My <span>Packages</span>
                </h1>

                <p>
                    View your purchased lesson packages and
                    remaining driving lesson credits.
                </p>

            </div>


            <div class="header-actions">

                <a href="@Url.Action("Index", "Dashboard")"
                   class="dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard

                </a>


                <a href="@Url.Action("Index", "Package")"
                   class="browse-button">

                    + Browse Packages

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->

        @if (TempData["Success"] != null)
        {
            <div class="success-message">

                ✓ @TempData["Success"]

            </div>
        }


        <!-- =====================================================
             ERROR MESSAGE
             ===================================================== -->

        @if (TempData["Error"] != null)
        {
            <div class="error-message">

                ⚠ @TempData["Error"]

            </div>
        }


        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->

        @if (Model == null || !Model.Any())
        {
            <div class="empty-card">

                <div class="empty-icon">

                    <i class="fa-solid fa-box-open"></i>

                </div>

                <h2>
                    No Packages Yet
                </h2>

                <p>
                    You haven't purchased a lesson package yet.
                    Browse our available packages and choose the
                    one that suits your driving needs.
                </p>

                <a href="@Url.Action("Index", "Package")"
                   class="browse-button">

                    Browse Lesson Packages

                </a>

            </div>
        }
        else
        {
            <div class="packages-grid">

                @foreach (var studentPackage in Model)
                {
                    bool isPaid =
                        studentPackage.PaymentStatus == "Paid";

                    bool isPending =
                        studentPackage.PaymentStatus == "Pending";

                    bool isFailed =
                        studentPackage.PaymentStatus == "Failed";


                    <div class="package-card">


                        <!-- =====================================
                             PACKAGE HEADER
                             ===================================== -->

                        <div class="package-header">

                            <div>

                                <h2 class="package-title">

                                    @studentPackage.LessonPackage.PackageName

                                </h2>

                                <div class="package-date">

                                    Purchased:
                                    @studentPackage.PurchaseDate.ToString("dd MMM yyyy")

                                </div>

                            </div>


                            <!-- PAYMENT STATUS -->

                            @if (isPaid)
                            {
                                <span class="status status-paid">

                                    Paid

                                </span>
                            }
                            else if (isPending)
                            {
                                <span class="status status-pending">

                                    Pending

                                </span>
                            }
                            else
                            {
                                <span class="status status-failed">

                                    @studentPackage.PaymentStatus

                                </span>
                            }

                        </div>


                        <!-- =====================================
                             DESCRIPTION
                             ===================================== -->

                        @if (!string.IsNullOrWhiteSpace(
                            studentPackage.LessonPackage.Description))
                        {
                            <div class="package-description">

                                @studentPackage.LessonPackage.Description

                            </div>
                        }


                        <!-- =====================================
                             PENDING NOTICE
                             ===================================== -->

                        @if (isPending)
                        {
                            <div class="pending-notice">

                                <i class="fa-solid fa-clock"></i>

                                Your package is currently
                                <strong>pending payment</strong>.

                                Please complete your payment to
                                activate your driving lesson credits.

                            </div>
                        }


                        <!-- =====================================
                             LESSON CREDITS
                             ===================================== -->

                        <div class="lesson-box">

                            <div class="lesson-box-title">

                                Lesson Credits

                            </div>


                            <div class="lesson-numbers">


                                <div class="lesson-number">

                                    <span>
                                        Purchased
                                    </span>

                                    <strong>

                                        @studentPackage.LessonsPurchased

                                    </strong>

                                </div>


                                <div class="lesson-number">

                                    <span>
                                        Remaining
                                    </span>

                                    <strong class="@(isPending ? "pending-credit" : "remaining")">

                                        @studentPackage.LessonsRemaining

                                    </strong>

                                </div>


                            </div>

                        </div>


                        <!-- =====================================
                             PACKAGE DETAILS
                             ===================================== -->

                        <div class="details">


                            <div class="detail-row">

                                <span>
                                    Package Price
                                </span>

                                <strong>

                                    R @studentPackage.LessonPackage.Price.ToString("N2")

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Payment Method
                                </span>

                                <strong>

                                    @studentPackage.PaymentMethod

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Payment Status
                                </span>

                                @if (isPaid)
                                {
                                    <strong class="active">

                                        Paid

                                    </strong>
                                }
                                else if (isPending)
                                {
                                    <strong class="pending">

                                        Pending

                                    </strong>
                                }
                                else
                                {
                                    <strong class="inactive">

                                        @studentPackage.PaymentStatus

                                    </strong>
                                }

                            </div>


                            <div class="detail-row">

                                <span>
                                    Purchase Date
                                </span>

                                <strong>

                                    @studentPackage.PurchaseDate.ToString("dd/MM/yyyy")

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Package Status
                                </span>

                                @if (isPaid && studentPackage.IsActive)
                                {
                                    <strong class="active">

                                        Active

                                    </strong>
                                }
                                else if (isPending)
                                {
                                    <strong class="pending">

                                        Pending

                                    </strong>
                                }
                                else
                                {
                                    <strong class="inactive">

                                        Inactive

                                    </strong>
                                }

                            </div>


                        </div>


                        <!-- =====================================
                             PAYMENT / PACKAGE ACTIONS
                             ===================================== -->

                        <div class="payment-actions">

                            @if (isPending)
                            {
                                                    <a href="@Url.Action(
                                "Pay",
                                "Package",
                                new { id = studentPackage.StudentPackageId })"
                                   class="pay-now-button">

                                    💳 Pay Now

                                </a>
                            }
                            else if (isPaid && studentPackage.IsActive)
                            {
                                <div class="active-package-button">

                                    ✓ Package Active

                                </div>

                                                        <a href="@Url.Action(
                                    "CancelPackage",
                                    "Package",
                                    new { id = studentPackage.StudentPackageId })"
                                                           class="cancel-package-button">

                                    ✕ Cancel Package

                                </a>
                            }

                        </div>


                    </div>
                }

            </div>
        }

    </div>

</div>