
@model IEnumerable<Last_Dance_System.Models.StudentPackage>

@{
    Layout = null;
    ViewBag.Title = "My Packages";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f8fc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }

    .packages-page {
        min-height: 90vh;
        padding: 45px 20px;
        background: #f5f8fc;
    }

    .packages-container {
        max-width: 1120px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 32px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 32px;
            font-weight: 800;
            color: #172033;
            letter-spacing: -.5px;
        }

            .page-header h1 span {
                color: #1769e0;
            }

        .page-header p {
            margin: 0;
            color: #6b778c;
            font-size: 14px;
            line-height: 1.6;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .dashboard-button,
    .browse-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        white-space: nowrap;
    }

    .dashboard-button {
        background: #ffffff;
        color: #26364d;
        border: 1px solid #dce4ef;
    }

        .dashboard-button:hover {
            background: #eef5ff;
            border-color: #1769e0;
            color: #1769e0;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .browse-button {
        background: #1769e0;
        color: #ffffff;
        border: 1px solid #1769e0;
        box-shadow: 0 5px 14px rgba(23, 105, 224, .18);
    }

        .browse-button:hover {
            background: #0d57c7;
            border-color: #0d57c7;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .success-message {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #ecfdf3;
        border: 1px solid #b7ebca;
        color: #16794a;
        padding: 14px 16px;
        border-radius: 10px;
        margin-bottom: 25px;
        font-size: 13px;
    }

    .error-message {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff1f1;
        border: 1px solid #f3c1c1;
        color: #c53030;
        padding: 14px 16px;
        border-radius: 10px;
        margin-bottom: 25px;
        font-size: 13px;
    }

    .empty-card {
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 16px;
        padding: 65px 30px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(26, 55, 92, .05);
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf5ff;
        border: 1px solid #cfe2ff;
        border-radius: 16px;
        color: #1769e0;
        font-size: 29px;
    }

    .empty-card h2 {
        margin: 0 0 10px;
        font-size: 23px;
        color: #172033;
    }

    .empty-card p {
        max-width: 550px;
        margin: 0 auto 25px;
        color: #718096;
        font-size: 13px;
        line-height: 1.7;
    }

    .packages-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .package-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #dfe7f1;
        border-radius: 16px;
        padding: 27px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(26, 55, 92, .055);
        transition: .25s ease;
    }

        .package-card:hover {
            transform: translateY(-3px);
            border-color: #b9d4fa;
            box-shadow: 0 12px 28px rgba(26, 55, 92, .10);
        }

        .package-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #1769e0;
        }

    .package-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .package-title {
        margin: 0;
        font-size: 21px;
        font-weight: 800;
        color: #172033;
    }

    .package-date {
        color: #8995a7;
        font-size: 11px;
        margin-top: 6px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .status-paid {
        background: #ecfdf3;
        border: 1px solid #b7ebca;
        color: #16804d;
    }

    .status-pending {
        background: #fff8e6;
        border: 1px solid #f4df9c;
        color: #9a6b00;
    }

    .status-failed {
        background: #fff1f1;
        border: 1px solid #f3c1c1;
        color: #c53030;
    }

    .package-description {
        color: #68768b;
        font-size: 13px;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .pending-notice {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        background: #fff9e9;
        border: 1px solid #f2dfaa;
        color: #866300;
        padding: 13px 14px;
        border-radius: 9px;
        font-size: 11px;
        line-height: 1.6;
        margin-bottom: 17px;
    }

        .pending-notice i {
            margin-top: 2px;
            color: #d49b00;
        }

    .lesson-box {
        background: #f7faff;
        border: 1px solid #dce8f7;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .lesson-box-title {
        color: #6f7d91;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
        margin-bottom: 14px;
    }

    .lesson-numbers {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .lesson-number {
        flex: 1;
    }

        .lesson-number span {
            display: block;
            color: #7b8798;
            font-size: 11px;
            margin-bottom: 5px;
        }

        .lesson-number strong {
            font-size: 27px;
            color: #172033;
            font-weight: 800;
        }

    .remaining {
        color: #1769e0 !important;
    }

    .pending-credit {
        color: #d49b00 !important;
    }

    .details {
        border-top: 1px solid #e5ebf3;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 12px 0;
        border-bottom: 1px solid #edf1f6;
        font-size: 12px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span {
            color: #7b8798;
        }

        .detail-row strong {
            color: #26364d;
            text-align: right;
        }

    .active {
        color: #16804d !important;
    }

    .inactive {
        color: #c53030 !important;
    }

    .pending {
        color: #b27b00 !important;
    }

    .payment-actions {
        margin-top: 21px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pay-now-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 14px 18px;
        background: #1769e0;
        color: #ffffff;
        border: 1px solid #1769e0;
        border-radius: 9px;
        text-decoration: none;
        text-align: center;
        font-size: 13px;
        font-weight: 800;
        box-shadow: 0 5px 14px rgba(23, 105, 224, .18);
        transition: .2s ease;
    }

        .pay-now-button:hover {
            background: #0d57c7;
            border-color: #0d57c7;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .active-package-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 14px 18px;
        background: #ecfdf3;
        border: 1px solid #b7ebca;
        color: #16804d;
        border-radius: 9px;
        text-align: center;
        font-size: 13px;
        font-weight: 800;
    }

    .proof-payment-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 18px;
        background: #eef5ff;
        border: 1px solid #b9d4fa;
        color: #1769e0;
        border-radius: 9px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

        .proof-payment-button:hover {
            background: #dcecff;
            border-color: #1769e0;
            color: #0d57c7;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .cancel-package-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 18px;
        background: #ffffff;
        border: 1px solid #e2a5a5;
        color: #c53030;
        border-radius: 9px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

        .cancel-package-button:hover {
            background: #fff1f1;
            border-color: #c53030;
            color: #c53030;
            text-decoration: none;
            transform: translateY(-1px);
        }

    @@media (max-width: 850px) {
        .packages-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .packages-page {
            padding: 30px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

            .header-actions a {
                width: 100%;
                text-align: center;
            }

        .package-header {
            flex-direction: column;
        }

        .status {
            align-self: flex-start;
        }
    }

    @@media (max-width: 450px) {
        .package-card {
            padding: 21px;
        }

        .lesson-numbers {
            flex-direction: column;
            gap: 15px;
        }

        .page-header h1 {
            font-size: 27px;
        }
    }
</style>


<div class="packages-page">

    <div class="packages-container">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h1>
                    My <span>Packages</span>
                </h1>

                <p>
                    View your purchased lesson packages and
                    remaining driving lesson credits.
                </p>

            </div>

            <div class="header-actions">

                <a href="@Url.Action("Index", "Dashboard")"
                   class="dashboard-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Dashboard

                </a>

                <a href="@Url.Action("Index", "Package")"
                   class="browse-button">

                    <i class="fa-solid fa-plus"></i>

                    Browse Packages

                </a>

            </div>

        </div>


        <!-- SUCCESS MESSAGE -->

        @if (TempData["Success"] != null)
        {

            <div class="success-message">

                <i class="fa-solid fa-circle-check"></i>

                @TempData["Success"]

            </div>

        }


        <!-- ERROR MESSAGE -->

        @if (TempData["Error"] != null)
        {

            <div class="error-message">

                <i class="fa-solid fa-circle-exclamation"></i>

                @TempData["Error"]

            </div>

        }


        <!-- EMPTY STATE -->

        @if (Model == null || !Model.Any())
        {

            <div class="empty-card">

                <div class="empty-icon">

                    <i class="fa-solid fa-box-open"></i>

                </div>

                <h2>
                    No Packages Yet
                </h2>

                <p>
                    You haven't purchased a lesson package yet.
                    Browse our available packages and choose the
                    one that suits your driving needs.
                </p>

                <a href="@Url.Action("Index", "Package")"
                   class="browse-button">

                    <i class="fa-solid fa-car"></i>

                    Browse Lesson Packages

                </a>

            </div>

        }
        else
        {

            <div class="packages-grid">

                @foreach (var studentPackage in Model)
                {

                    bool isPaid =
                        studentPackage.PaymentStatus == "Paid";

                    bool isPending =
                        studentPackage.PaymentStatus == "Pending";

                    bool isFailed =
                        studentPackage.PaymentStatus == "Failed";


                    <div class="package-card">


                        <!-- PACKAGE HEADER -->

                        <div class="package-header">

                            <div>

                                <h2 class="package-title">

                                    @studentPackage.LessonPackage.PackageName

                                </h2>

                                <div class="package-date">

                                    Purchased:
                                    @studentPackage.PurchaseDate.ToString("dd MMM yyyy")

                                </div>

                            </div>


                            <!-- PAYMENT STATUS -->

                            @if (isPaid)
                            {

                                <span class="status status-paid">

                                    <i class="fa-solid fa-check"></i>

                                    Paid

                                </span>

                            }
                            else if (isPending)
                            {

                                <span class="status status-pending">

                                    <i class="fa-solid fa-clock"></i>

                                    Pending

                                </span>

                            }
                            else
                            {

                                <span class="status status-failed">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    @studentPackage.PaymentStatus

                                </span>

                            }

                        </div>


                        <!-- DESCRIPTION -->

                        @if (!string.IsNullOrWhiteSpace(
                            studentPackage.LessonPackage.Description))
                        {

                            <div class="package-description">

                                @studentPackage.LessonPackage.Description

                            </div>

                        }


                        <!-- PENDING NOTICE -->

                        @if (isPending)
                        {

                            <div class="pending-notice">

                                <i class="fa-solid fa-clock"></i>

                                <div>

                                    Your package is currently
                                    <strong>pending payment</strong>.

                                    Please complete your payment to
                                    activate your driving lesson credits.

                                </div>

                            </div>

                        }


                        <!-- LESSON CREDITS -->

                        <div class="lesson-box">

                            <div class="lesson-box-title">

                                Lesson Credits

                            </div>

                            <div class="lesson-numbers">

                                <div class="lesson-number">

                                    <span>
                                        Purchased
                                    </span>

                                    <strong>

                                        @studentPackage.LessonsPurchased

                                    </strong>

                                </div>

                                <div class="lesson-number">

                                    <span>
                                        Remaining
                                    </span>

                                    <strong class="@(isPending
                                        ? "pending-credit"
                                        : "remaining")">

                                        @studentPackage.LessonsRemaining

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- PACKAGE DETAILS -->

                        <div class="details">

                            <div class="detail-row">

                                <span>
                                    Package Price
                                </span>

                                <strong>

                                    R @studentPackage.LessonPackage.Price.ToString("N2")

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Payment Method
                                </span>

                                <strong>

                                    @studentPackage.PaymentMethod

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Payment Status
                                </span>

                                @if (isPaid)
                                {

                                    <strong class="active">

                                        Paid

                                    </strong>

                                }
                                else if (isPending)
                                {

                                    <strong class="pending">

                                        Pending

                                    </strong>

                                }
                                else
                                {

                                    <strong class="inactive">

                                        @studentPackage.PaymentStatus

                                    </strong>

                                }

                            </div>


                            <div class="detail-row">

                                <span>
                                    Purchase Date
                                </span>

                                <strong>

                                    @studentPackage.PurchaseDate.ToString("dd/MM/yyyy")

                                </strong>

                            </div>


                            <div class="detail-row">

                                <span>
                                    Package Status
                                </span>

                                @if (isPaid && studentPackage.IsActive)
                                {

                                    <strong class="active">

                                        Active

                                    </strong>

                                }
                                else if (isPending)
                                {

                                    <strong class="pending">

                                        Pending

                                    </strong>

                                }
                                else
                                {

                                    <strong class="inactive">

                                        Inactive

                                    </strong>

                                }

                            </div>

                        </div>


                        <!-- PAYMENT / PACKAGE ACTIONS -->

                        <div class="payment-actions">

                            @if (isPending)
                            {

                                <a href="@Url.Action(
                                    "Pay",
                                    "Package",
                                    new
                                    {
                                        id = studentPackage.StudentPackageId
                                    })"
                                   class="pay-now-button">

                                    <i class="fa-solid fa-credit-card"></i>

                                    Pay Now

                                </a>

                            }
                            else if (isPaid && studentPackage.IsActive)
                            {

                                <div class="active-package-button">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Package Active

                                </div>


                                <!-- PROOF OF PAYMENT -->

                                <a href="@Url.Action(
                                    "ProofOfPayment",
                                    "Package",
                                    new
                                    {
                                        id = studentPackage.StudentPackageId
                                    })"
                                   class="proof-payment-button">

                                    <i class="fa-solid fa-file-invoice-dollar"></i>

                                    Proof of Payment

                                </a>


                                <!-- CANCEL PACKAGE -->

                                <a href="@Url.Action(
                                    "CancelPackage",
                                    "Package",
                                    new
                                    {
                                        id = studentPackage.StudentPackageId
                                    })"
                                   class="cancel-package-button">

                                    <i class="fa-solid fa-xmark"></i>

                                    Cancel Package

                                </a>

                            }

                        </div>

                    </div>

                }

            </div>

        }

    </div>

</div>

