@model Last_Dance_System.Models.LessonPackage

@{
    ViewBag.Title = "Purchase Package";
}

<style>

    /* =========================================================
       PURCHASE PAGE - WHITE & BLUE THEME
       ========================================================= */

    .purchase-page {
        min-height: calc(100vh - 100px);
        background: #f5f8fc;
        padding: 40px 20px 60px;
        color: #1f2937;
        font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    }

    .purchase-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .purchase-header {
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 18px;
        padding: 28px 30px;
        margin-bottom: 25px;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.06);
    }

    .purchase-header-content {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .purchase-header-icon {
        width: 55px;
        height: 55px;
        min-width: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eaf3ff;
        color: #0d6efd;
        font-size: 23px;
    }

    .purchase-header h1 {
        margin: 0 0 5px;
        font-size: 27px;
        font-weight: 800;
        color: #172033;
    }

    .purchase-header p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }

    /* =========================================================
       MAIN GRID
       ========================================================= */

    .purchase-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 25px;
        align-items: start;
    }

    /* =========================================================
       PACKAGE CARD
       ========================================================= */

    .package-card {
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.06);
    }

    .package-top {
        background: linear-gradient(135deg, #0d6efd, #084298);
        padding: 30px;
        color: #ffffff;
    }

    .package-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
        opacity: .9;
        margin-bottom: 12px;
    }

        .package-label i {
            font-size: 15px;
        }

    .package-top h2 {
        margin: 0 0 10px;
        font-size: 25px;
        font-weight: 800;
    }

    .package-description {
        margin: 0;
        font-size: 13px;
        line-height: 1.7;
        opacity: .92;
    }

    /* =========================================================
       PACKAGE BODY
       ========================================================= */

    .package-body {
        padding: 28px;
    }

    .price-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding-bottom: 25px;
        margin-bottom: 25px;
        border-bottom: 1px solid #e5eaf0;
    }

    .price-label {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .price-label i {
            color: #0d6efd;
        }

    .price {
        color: #0d6efd;
        font-size: 34px;
        font-weight: 800;
        line-height: 1;
    }

    .lesson-count {
        text-align: right;
    }

    .lesson-count-number {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 7px;
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

        .lesson-count-number i {
            color: #0d6efd;
            font-size: 18px;
        }

    .lesson-count-label {
        color: #6b7280;
        font-size: 11px;
    }

    /* =========================================================
       INCLUDED
       ========================================================= */

    .included-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 15px;
        color: #172033;
        font-size: 16px;
        font-weight: 800;
    }

        .included-title i {
            color: #0d6efd;
            font-size: 15px;
        }

    .included-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .included-list li {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 11px 0;
            border-bottom: 1px solid #edf1f5;
            color: #4b5563;
            font-size: 12px;
        }

            .included-list li:last-child {
                border-bottom: none;
            }

    .included-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eaf3ff;
        color: #0d6efd;
        font-size: 12px;
    }

    .included-text {
        flex: 1;
    }

    /* =========================================================
       PAYMENT CARD
       ========================================================= */

    .payment-card {
        background: #ffffff;
        border: 1px solid #e1e8f0;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.06);
    }

        .payment-card h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 7px;
            color: #172033;
            font-size: 20px;
            font-weight: 800;
        }

            .payment-card h2 > i {
                color: #0d6efd;
                font-size: 18px;
            }

        .payment-card > p {
            margin: 0 0 22px;
            color: #6b7280;
            font-size: 12px;
            line-height: 1.6;
        }

    /* =========================================================
       ORDER SUMMARY
       ========================================================= */

    .order-summary {
        background: #f5f8fc;
        border: 1px solid #e1e8f0;
        border-radius: 12px;
        padding: 17px;
        margin-bottom: 22px;
    }

    .order-summary-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 13px;
        color: #172033;
        font-size: 13px;
        font-weight: 800;
    }

        .order-summary-title i {
            color: #0d6efd;
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        color: #6b7280;
        font-size: 11px;
    }

        .summary-row strong {
            color: #172033;
            font-weight: 700;
            text-align: right;
        }

    .summary-total {
        margin-top: 8px;
        padding-top: 13px;
        border-top: 1px solid #dce4ed;
    }

        .summary-total span {
            color: #172033;
            font-weight: 800;
        }

        .summary-total strong {
            color: #0d6efd;
            font-size: 18px;
        }

    /* =========================================================
       PAYMENT METHODS
       ========================================================= */

    .payment-method-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 12px;
        color: #172033;
        font-size: 13px;
        font-weight: 800;
    }

        .payment-method-title i {
            color: #0d6efd;
        }

    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 20px;
    }

    .payment-option {
        position: relative;
    }

        .payment-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .payment-label {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 14px;
        background: #ffffff;
        border: 1px solid #0d6efd;
        border-radius: 11px;
        cursor: default;
        transition: all .2s ease;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, .08);
    }

    .payment-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #0d6efd;
        color: #ffffff;
        font-size: 17px;
    }

    .payment-info {
        flex: 1;
        min-width: 0;
    }

        .payment-info strong {
            display: block;
            margin-bottom: 3px;
            color: #172033;
            font-size: 12px;
        }

        .payment-info span {
            display: block;
            color: #6b7280;
            font-size: 10px;
        }

    .radio-circle {
        width: 18px;
        height: 18px;
        min-width: 18px;
        border: 2px solid #0d6efd;
        border-radius: 50%;
        position: relative;
    }

        .radio-circle::after {
            content: "";
            position: absolute;
            width: 8px;
            height: 8px;
            top: 3px;
            left: 3px;
            background: #0d6efd;
            border-radius: 50%;
        }

    /* =========================================================
       BUY BUTTON
       ========================================================= */

    .buy-button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: all .25s ease;
    }

        .buy-button:hover {
            background: #084298;
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(13, 110, 253, .20);
        }

        .buy-button i {
            font-size: 14px;
        }

    /* =========================================================
       SECURITY NOTE
       ========================================================= */

    .security-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 15px;
        padding: 12px;
        background: #f5f8fc;
        border-radius: 9px;
        color: #6b7280;
        font-size: 10px;
        line-height: 1.5;
    }

    .security-note-icon {
        width: 24px;
        height: 24px;
        min-width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #eaf3ff;
        color: #0d6efd;
    }

    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 20px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

        .back-button:hover {
            color: #084298;
            text-decoration: none;
            transform: translateX(-2px);
        }

    /* =========================================================
       VALIDATION
       ========================================================= */

    .field-validation-error,
    .validation-summary-errors {
        color: #b02a37;
        font-size: 11px;
    }

    .validation-summary-errors {
        background: #fff0f1;
        border: 1px solid #f5b7bd;
        border-radius: 9px;
        padding: 12px;
        margin-bottom: 15px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 850px) {

        .purchase-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {

        .purchase-page {
            padding: 20px 12px 40px;
        }

        .purchase-header {
            padding: 22px;
        }

            .purchase-header h1 {
                font-size: 22px;
            }

        .package-top {
            padding: 24px;
        }

            .package-top h2 {
                font-size: 21px;
            }

        .package-body,
        .payment-card {
            padding: 22px;
        }

        .price-section {
            align-items: flex-start;
        }

        .price {
            font-size: 30px;
        }
    }
</style>

<div class="purchase-page">

    
    <div class="purchase-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="purchase-header">

            <div class="purchase-header-content">

                <div class="purchase-header-icon">
                    <i class="fa-solid fa-car"></i>
                </div>

                <div>

                    <h1>
                        Purchase Driving Package
                    </h1>

                    <p>
                        Choose your package and pay securely online.
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <div class="purchase-grid">


            <!-- =================================================
                 PACKAGE INFORMATION
                 ================================================= -->

            <div class="package-card">

                <div class="package-top">

                    <div class="package-label">

                        <i class="fa-solid fa-car-side"></i>

                        Driving Lesson Package

                    </div>


                    <h2>
                        @Model.PackageName
                    </h2>


                    <p class="package-description">

                        @Model.Description

                    </p>

                </div>


                <div class="package-body">


                    <!-- PRICE -->

                    <div class="price-section">

                        <div>

                            <div class="price-label">

                                <i class="fa-solid fa-tag"></i>

                                Package Price

                            </div>

                            <div class="price">

                                R @Model.Price.ToString("N0")

                            </div>

                        </div>


                        <div class="lesson-count">

                            <span class="lesson-count-number">

                                <i class="fa-solid fa-book-open"></i>

                                @Model.NumberOfLessons

                            </span>

                            <span class="lesson-count-label">

                                Lessons Included

                            </span>

                        </div>

                    </div>


                    <!-- INCLUDED -->

                    <h3 class="included-title">

                        <i class="fa-solid fa-list-check"></i>

                        What's Included

                    </h3>


                    <ul class="included-list">

                        <li>

                            <span class="included-icon">

                                <i class="fa-solid fa-user-tie"></i>

                            </span>

                            <span class="included-text">

                                Professional driving instructor

                            </span>

                        </li>


                        <li>

                            <span class="included-icon">

                                <i class="fa-solid fa-calendar-days"></i>

                            </span>

                            <span class="included-text">

                                Flexible lesson scheduling

                            </span>

                        </li>


                        <li>

                            <span class="included-icon">

                                <i class="fa-solid fa-gauge-high"></i>

                            </span>

                            <span class="included-text">

                                Lessons managed through your dashboard

                            </span>

                        </li>


                        <li>

                            <span class="included-icon">

                                <i class="fa-solid fa-chart-line"></i>

                            </span>

                            <span class="included-text">

                                Track your lesson progress

                            </span>

                        </li>


                        <li>

                            <span class="included-icon">

                                <i class="fa-solid fa-comment-dots"></i>

                            </span>

                            <span class="included-text">

                                Receive instructor feedback

                            </span>

                        </li>

                    </ul>

                </div>

            </div>


            <!-- =================================================
                 PAYMENT
                 ================================================= -->

            <div class="payment-card">

                <h2>

                    <i class="fa-solid fa-credit-card"></i>

                    Secure Card Payment

                </h2>

                <p>

                    Review your package and continue to secure payment
                    through Stripe.

                </p>


                @using (Html.BeginForm(
                    "Purchase",
                    "Package",
                    FormMethod.Post))
                {

                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "validation-summary-errors" })


                    <!-- ORDER SUMMARY -->

                    <div class="order-summary">

                        <h3 class="order-summary-title">

                            <i class="fa-solid fa-receipt"></i>

                            Order Summary

                        </h3>


                        <div class="summary-row">

                            <span>
                                Package
                            </span>

                            <strong>
                                @Model.PackageName
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Lessons
                            </span>

                            <strong>
                                @Model.NumberOfLessons
                            </strong>

                        </div>


                        <div class="summary-row summary-total">

                            <span>
                                Total
                            </span>

                            <strong>
                                R @Model.Price.ToString("N0")
                            </strong>

                        </div>

                    </div>


                    <!-- PAYMENT METHOD -->

                    <h3 class="payment-method-title">

                        <i class="fa-solid fa-wallet"></i>

                        Payment Method

                    </h3>


                    <div class="payment-options">

                        <!-- CARD ONLY -->

                        <div class="payment-option">

                            <input type="radio"
                                   id="paymentCard"
                                   name="paymentMethod"
                                   value="Card"
                                   checked />

                            <label for="paymentCard"
                                   class="payment-label">

                                <div class="payment-icon">

                                    <i class="fa-solid fa-credit-card"></i>

                                </div>

                                <div class="payment-info">

                                    <strong>
                                        Card Payment
                                    </strong>

                                    <span>
                                        Secure online payment with Stripe
                                    </span>

                                </div>

                                <div class="radio-circle"></div>

                            </label>

                        </div>

                    </div>


                    <!-- BUY -->

                    <button type="submit"
                            class="buy-button">

                        <i class="fa-solid fa-lock"></i>

                        Continue to Secure Payment

                    </button>


                    <!-- SECURITY -->

                    <div class="security-note">

                        <span class="security-note-icon">

                            <i class="fa-solid fa-shield-halved"></i>

                        </span>

                        <span>

                            Your payment information is securely processed.
                            Card payments are handled through Stripe.
                            Your package will be activated after successful
                            payment.

                        </span>

                    </div>

                }


                <!-- BACK -->

                <a href="@Url.Action("Index", "Package")"
                   class="back-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Packages

                </a>

            </div>

        </div>

    </div>
    

</div>
