@model Last_Dance_System.Models.StudentPackage

@{
    ViewBag.Title = "Package Payment";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }

    .payment-page {
        min-height: 90vh;
        padding: 50px 20px;
        background: radial-gradient( circle at top right, rgba(225, 6, 0, .12), transparent 30% ), #07111f;
    }

    .payment-container {
        max-width: 850px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 30px;
            font-weight: 800;
        }

            .page-header h1 span {
                color: #e10600;
            }

        .page-header p {
            margin: 0;
            color: #8290a3;
            font-size: 13px;
        }


    /* =========================================================
       CARD
       ========================================================= */

    .payment-card {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }


    /* =========================================================
       PACKAGE
       ========================================================= */

    .package-summary {
        background: #08111d;
        border: 1px solid #16263a;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
    }

        .package-summary h2 {
            margin: 0 0 8px;
            font-size: 20px;
        }

        .package-summary p {
            margin: 0;
            color: #8290a3;
            font-size: 12px;
            line-height: 1.6;
        }


    /* =========================================================
       PRICE
       ========================================================= */

    .price-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #1b2a3d;
        margin-bottom: 25px;
    }

        .price-box span {
            color: #8290a3;
            font-size: 13px;
        }

        .price-box strong {
            color: #e10600;
            font-size: 24px;
        }


    /* =========================================================
       PAYMENT METHOD
       ========================================================= */

    .section-title {
        margin: 0 0 15px;
        font-size: 14px;
        font-weight: 700;
    }

    .payment-methods {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 25px;
    }

    .payment-option {
        position: relative;
    }

        .payment-option input {
            position: absolute;
            opacity: 0;
        }

        .payment-option label {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 110px;
            padding: 15px;
            background: #08111d;
            border: 1px solid #1b2a3d;
            border-radius: 10px;
            color: #8290a3;
            cursor: pointer;
            transition: .2s;
        }

            .payment-option label i {
                font-size: 22px;
                color: #e10600;
            }

            .payment-option label span {
                font-size: 11px;
                font-weight: 700;
            }

        .payment-option input:checked + label {
            border-color: #e10600;
            background: rgba(225, 6, 0, .08);
            color: #ffffff;
        }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .buttons {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .pay-button,
    .back-button {
        flex: 1;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 13px 18px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

    .pay-button {
        background: #e10600;
        color: #ffffff;
        border: none;
    }

        .pay-button:hover {
            background: #ff211a;
            color: #ffffff;
        }

    .back-button {
        background: #101f32;
        color: #ffffff;
        border: 1px solid #1d3149;
    }

        .back-button:hover {
            background: #16263a;
            color: #ffffff;
            text-decoration: none;
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width: 650px) {

        .payment-methods {
            grid-template-columns: 1fr;
        }

        .buttons {
            flex-direction: column;
        }

        .payment-card {
            padding: 20px;
        }
    }
</style>


<div class="payment-page">

    <div class="payment-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <h1>
                Package <span>Payment</span>
            </h1>

            <p>
                Complete your payment to activate your driving package.
            </p>

        </div>


        <!-- =====================================================
             PAYMENT CARD
             ===================================================== -->

        <div class="payment-card">


            <!-- PACKAGE SUMMARY -->

            <div class="package-summary">

                <h2>
                    @Model.LessonPackage.PackageName
                </h2>

                <p>
                    @Model.LessonPackage.Description
                </p>

            </div>


            <!-- PRICE -->

            <div class="price-box">

                <span>
                    Package Price
                </span>

                <strong>
                    R @Model.LessonPackage.Price.ToString("N2")
                </strong>

            </div>


            <!-- PAYMENT METHOD -->

            <h3 class="section-title">
                Select Payment Method
            </h3>


            @using (Html.BeginForm(
                "Pay",
                "Package",
                FormMethod.Post))
            {

                @Html.AntiForgeryToken()

                @Html.HiddenFor(
                    model => model.StudentPackageId)


                <div class="payment-methods">


                    <!-- CARD -->

                    <div class="payment-option">

                        <input type="radio"
                               id="card"
                               name="paymentMethod"
                               value="Card"
                               checked />

                        <label for="card">

                            <i class="fa-solid fa-credit-card"></i>

                            <span>
                                Card
                            </span>

                        </label>

                    </div>


                    <!-- EFT -->

                    <div class="payment-option">

                        <input type="radio"
                               id="eft"
                               name="paymentMethod"
                               value="EFT" />

                        <label for="eft">

                            <i class="fa-solid fa-building-columns"></i>

                            <span>
                                EFT
                            </span>

                        </label>

                    </div>


                    <!-- CASH -->

                    <div class="payment-option">

                        <input type="radio"
                               id="cash"
                               name="paymentMethod"
                               value="Cash" />

                        <label for="cash">

                            <i class="fa-solid fa-money-bill-wave"></i>

                            <span>
                                Cash
                            </span>

                        </label>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="buttons">

                    <a href="@Url.Action("MyPackages", "Package")"
                       class="back-button">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back

                    </a>


                    <button type="submit"
                            class="pay-button">

                        <i class="fa-solid fa-lock"></i>

                        Complete Payment

                    </button>

                </div>

            }

        </div>

    </div>

</div>