@model IEnumerable<Last_Dance_System.Models.LessonPackage>

@{
    Layout = null;
    ViewBag.Title = "Lesson Packages";
}
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #f5f8fc;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       MAIN PAGE
       ========================================================= */

    .package-page {
        min-height: 100vh;
        padding: 50px 20px 70px;
        background: radial-gradient( circle at top right, rgba(37, 99, 235, 0.08), transparent 32% ), radial-gradient( circle at bottom left, rgba(59, 130, 246, 0.05), transparent 30% ), #f5f8fc;
    }

    .package-container {
        max-width: 1150px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .package-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 40px;
    }

    .package-header-content {
        max-width: 700px;
    }

    .header-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: #2563eb;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

        .header-label::before {
            content: "";
            width: 25px;
            height: 2px;
            background: #2563eb;
        }

    .package-header h1 {
        margin: 0 0 12px;
        color: #172033;
        font-size: 38px;
        line-height: 1.15;
        font-weight: 900;
    }

        .package-header h1 span {
            color: #2563eb;
        }

    .package-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    .dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 18px;
        background: #ffffff;
        color: #1e40af;
        border: 1px solid #d7e1ef;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        transition: .2s ease;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

        .dashboard-button:hover {
            background: #eff6ff;
            border-color: #2563eb;
            color: #1d4ed8;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       PACKAGE GRID
       ========================================================= */

    .package-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
        align-items: stretch;
    }


    /* =========================================================
       PACKAGE CARD
       ========================================================= */

    .package-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #dce5f0;
        border-radius: 18px;
        padding: 28px;
        overflow: hidden;
        transition: .25s ease;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
    }

        .package-card:hover {
            transform: translateY(-6px);
            border-color: #93b4ed;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.10), 0 0 0 1px rgba(37, 99, 235, 0.04);
        }

        .package-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #2563eb;
        }


    /* =========================================================
       PACKAGE ICON
       ========================================================= */

    .package-icon-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .package-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 15px;
        color: #2563eb;
        font-size: 24px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
    }

        .package-icon i {
            color: #2563eb;
        }

    .package-number {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
    }

        .package-number i {
            color: #2563eb;
            font-size: 10px;
        }


    /* =========================================================
       PACKAGE NAME
       ========================================================= */

    .package-card h2 {
        margin: 0 0 10px;
        color: #172033;
        font-size: 22px;
        font-weight: 900;
        line-height: 1.3;
    }


    /* =========================================================
       DESCRIPTION
       ========================================================= */

    .package-description {
        min-height: 58px;
        margin-bottom: 22px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.65;
    }


    /* =========================================================
       PRICE
       ========================================================= */

    .package-price {
        display: flex;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .currency {
        margin-top: 5px;
        margin-right: 4px;
        color: #2563eb;
        font-size: 17px;
        font-weight: 800;
    }

    .price {
        color: #172033;
        font-size: 38px;
        font-weight: 900;
        line-height: 1;
    }

    .price-period {
        align-self: flex-end;
        margin-left: 6px;
        margin-bottom: 2px;
        color: #94a3b8;
        font-size: 11px;
    }


    /* =========================================================
       LESSON SUMMARY
       ========================================================= */

    .lesson-summary {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        margin-bottom: 22px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
    }

    .lesson-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        color: #2563eb;
        font-size: 16px;
        flex-shrink: 0;
    }

    .lesson-text {
        line-height: 1.35;
    }

        .lesson-text strong {
            display: block;
            color: #172033;
            font-size: 14px;
        }

        .lesson-text span {
            color: #94a3b8;
            font-size: 10px;
        }


    /* =========================================================
       FEATURES
       ========================================================= */

    .package-features {
        list-style: none;
        padding: 0;
        margin: 0 0 27px;
    }

        .package-features li {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 11px;
            color: #64748b;
            font-size: 12px;
        }

    .check {
        width: 21px;
        height: 21px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        color: #2563eb;
        font-size: 10px;
        font-weight: 900;
        flex-shrink: 0;
    }


    /* =========================================================
       BUTTON AREA
       ========================================================= */

    .package-button-wrapper {
        margin-top: auto;
    }

    .package-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        padding: 14px;
        background: #2563eb;
        color: #ffffff;
        border: 1px solid #2563eb;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: .2s ease;
    }

        .package-button:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.20);
        }

        .package-button i {
            font-size: 12px;
            transition: .2s ease;
        }

        .package-button:hover i {
            transform: translateX(3px);
        }


    /* =========================================================
       PACKAGE FOOTER
       ========================================================= */

    .package-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 13px;
        color: #94a3b8;
        font-size: 10px;
    }

        .package-footer i {
            color: #2563eb;
            font-size: 10px;
        }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty {
        background: #ffffff;
        border: 1px solid #dce5f0;
        border-radius: 16px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 15px;
        color: #2563eb;
        font-size: 26px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
    }

    .empty h3 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 19px;
    }

    .empty p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }


    /* =========================================================
       BOTTOM INFORMATION
       ========================================================= */

    .bottom-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 25px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        background: #ffffff;
        border: 1px solid #dce5f0;
        border-radius: 10px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
        transition: .2s ease;
    }

        .info-item:hover {
            border-color: #bfdbfe;
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
        }

    .info-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        color: #2563eb;
        font-size: 15px;
        flex-shrink: 0;
    }

    .info-text strong {
        display: block;
        color: #172033;
        font-size: 11px;
        margin-bottom: 3px;
    }

    .info-text span {
        color: #94a3b8;
        font-size: 10px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 950px) {

        .package-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .bottom-info {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 700px) {

        .package-page {
            padding: 30px 15px 45px;
        }

        .package-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .package-header h1 {
                font-size: 30px;
            }

        .dashboard-button {
            width: 100%;
        }

        .package-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 450px) {

        .package-header h1 {
            font-size: 27px;
        }

        .package-card {
            padding: 23px;
        }

        .price {
            font-size: 34px;
        }
    }
</style>

<div class="package-page">

    
    <div class="package-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="package-header">

            <div class="package-header-content">

                <div class="header-label">
                    Driving Lessons
                </div>

                <h1>
                    Choose Your
                    <span>Package</span>
                </h1>

                <p>
                    Select the lesson package that fits your driving
                    goals. Your lessons will be added to your account
                    after successful payment.
                </p>

            </div>


            <!-- DASHBOARD -->

            <a href="@Url.Action("Index", "Dashboard")"
               class="dashboard-button">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>


        <!-- =====================================================
             PACKAGES
             ===================================================== -->

        @if (Model != null && Model.Any())
        {
            <div class="package-grid">

                @{
                    int packageNumber = 1;
                }

                @foreach (var package in Model)
                {

                    <div class="package-card">


                        <!-- =================================================
                             PACKAGE ICON
                             ================================================= -->

                        <div class="package-icon-wrapper">

                            <div class="package-icon"
                                 title="Driving Lesson Package">

                                <i class="fa-solid fa-car-side"></i>

                            </div>

                            <div class="package-number">

                                <i class="fa-solid fa-layer-group"></i>

                                PACKAGE
                                @packageNumber.ToString("00")

                            </div>

                        </div>


                        <!-- PACKAGE NAME -->

                        <h2>
                            @package.PackageName
                        </h2>


                        <!-- DESCRIPTION -->

                        <div class="package-description">

                            @package.Description

                        </div>


                        <!-- =================================================
                             PRICE
                             ================================================= -->

                        <div class="package-price">

                            <span class="currency">
                                R
                            </span>

                            <span class="price">
                                @package.Price.ToString("N0")
                            </span>

                            <span class="price-period">
                                package
                            </span>

                        </div>


                        <!-- =================================================
                             LESSON SUMMARY
                             ================================================= -->

                        <div class="lesson-summary">

                            <div class="lesson-icon">

                                <i class="fa-solid fa-road"></i>

                            </div>

                            <div class="lesson-text">

                                <strong>
                                    @package.NumberOfLessons Lessons
                                </strong>

                                <span>
                                    Included in this package
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             FEATURES
                             ================================================= -->

                        <ul class="package-features">

                            <li>

                                <span class="check">
                                    <i class="fa-solid fa-check"></i>
                                </span>

                                Professional driving instructor

                            </li>


                            <li>

                                <span class="check">
                                    <i class="fa-solid fa-calendar-check"></i>
                                </span>

                                Flexible lesson scheduling

                            </li>


                            <li>

                                <span class="check">
                                    <i class="fa-solid fa-book-open"></i>
                                </span>

                                Book lessons through dashboard

                            </li>


                            <li>

                                <span class="check">
                                    <i class="fa-solid fa-chart-simple"></i>
                                </span>

                                Track remaining lesson credits

                            </li>

                        </ul>


                        <!-- =================================================
                             BUTTON
                             ================================================= -->

                        <div class="package-button-wrapper">

                            <a href="@Url.Action(
                            "Details",
                            "Package",
                            new
                            {
                                id = package.LessonPackageId
                            })"
                               class="package-button">

                                <i class="fa-solid fa-eye"></i>

                                View Package

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>


                            <div class="package-footer">

                                <i class="fa-solid fa-shield-halved"></i>

                                Secure package purchase

                            </div>

                        </div>

                    </div>

                    packageNumber++;
                }

            </div>


            <!-- =================================================
                 BOTTOM INFORMATION
                 ================================================= -->

            <div class="bottom-info">


                <!-- PROFESSIONAL INSTRUCTORS -->

                <div class="info-item">

                    <div class="info-icon">

                        <i class="fa-solid fa-user-tie"></i>

                    </div>

                    <div class="info-text">

                        <strong>
                            Professional Instructors
                        </strong>

                        <span>
                            Learn with qualified instructors
                        </span>

                    </div>

                </div>


                <!-- FLEXIBLE SCHEDULING -->

                <div class="info-item">

                    <div class="info-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <div class="info-text">

                        <strong>
                            Flexible Scheduling
                        </strong>

                        <span>
                            Choose lessons that suit you
                        </span>

                    </div>

                </div>


                <!-- PROGRESS -->

                <div class="info-item">

                    <div class="info-icon">

                        <i class="fa-solid fa-chart-line"></i>

                    </div>

                    <div class="info-text">

                        <strong>
                            Track Your Progress
                        </strong>

                        <span>
                            Monitor your lesson credits
                        </span>

                    </div>

                </div>


            </div>

        }
        else
        {

            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <div class="empty">

                <div class="empty-icon">

                    <i class="fa-solid fa-box-open"></i>

                </div>

                <h3>
                    No Packages Available
                </h3>

                <p>
                    There are currently no active lesson packages.
                    Please check again later.
                </p>

            </div>

        }

    </div>
    

</div>
