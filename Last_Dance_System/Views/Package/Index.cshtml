@model IEnumerable<Last_Dance_System.Models.LessonPackage>

@{
    ViewBag.Title = "Lesson Packages";
}

<style>

    /* =========================================
       GLOBAL
       ========================================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #07111f;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* =========================================
       PACKAGE PAGE
       ========================================= */

    .package-page {
        min-height: 90vh;
        padding: 40px 20px;
        background: radial-gradient( circle at top right, rgba(225, 6, 0, .12), transparent 30% ), #07111f;
    }

    .package-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* =========================================
       HEADER
       ========================================= */

    .package-header {
        margin-bottom: 35px;
    }

        .package-header h1 {
            margin: 0 0 8px;
            font-size: 30px;
            font-weight: 800;
        }

            .package-header h1 span {
                color: #e10600;
            }

        .package-header p {
            margin: 0;
            color: #8290a3;
            font-size: 14px;
        }

    /* =========================================
       PACKAGE GRID
       ========================================= */

    .package-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    /* =========================================
       PACKAGE CARD
       ========================================= */

    .package-card {
        position: relative;
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 16px;
        padding: 28px;
        transition: .25s ease;
        overflow: hidden;
    }

        .package-card:hover {
            transform: translateY(-4px);
            border-color: rgba(225, 6, 0, .55);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
        }

        .package-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: #e10600;
        }

    /* =========================================
       PACKAGE ICON
       ========================================= */

    .package-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(225, 6, 0, .10);
        border: 1px solid rgba(225, 6, 0, .25);
        border-radius: 12px;
        color: #e10600;
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 20px;
    }

    /* =========================================
       PACKAGE NAME
       ========================================= */

    .package-card h2 {
        margin: 0 0 10px;
        font-size: 21px;
        font-weight: 800;
    }

    .package-description {
        min-height: 45px;
        margin-bottom: 22px;
        color: #8290a3;
        font-size: 13px;
        line-height: 1.6;
    }

    /* =========================================
       PRICE
       ========================================= */

    .package-price {
        margin-bottom: 20px;
    }

    .currency {
        color: #8290a3;
        font-size: 14px;
        vertical-align: top;
        margin-right: 3px;
    }

    .price {
        color: #ffffff;
        font-size: 32px;
        font-weight: 900;
    }

    /* =========================================
       LESSON COUNT
       ========================================= */

    .lesson-count {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #08111d;
        border: 1px solid #16263a;
        padding: 13px;
        border-radius: 9px;
        margin-bottom: 20px;
        color: #8b98a9;
        font-size: 13px;
    }

    .lesson-count-icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(225, 6, 0, .12);
        color: #e10600;
        border-radius: 7px;
        font-weight: 800;
    }

    .lesson-count strong {
        color: #ffffff;
    }

    /* =========================================
       FEATURES
       ========================================= */

    .package-features {
        list-style: none;
        padding: 0;
        margin: 0 0 25px;
    }

        .package-features li {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 10px;
            color: #8b98a9;
            font-size: 12px;
        }

    .check {
        color: #50e3a4;
        font-weight: bold;
    }

    /* =========================================
       BUTTON
       ========================================= */

    .package-button {
        display: block;
        width: 100%;
        padding: 13px;
        background: #e10600;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        text-align: center;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .2s;
    }

        .package-button:hover {
            background: #ff211a;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================================
       EMPTY STATE
       ========================================= */

    .empty {
        background: #0c1726;
        border: 1px solid #1b2a3d;
        border-radius: 15px;
        padding: 50px;
        text-align: center;
    }

        .empty h3 {
            margin-bottom: 8px;
        }

        .empty p {
            color: #718096;
        }

    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 900px) {

        .package-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {

        .package-page {
            padding: 30px 15px;
        }

        .package-header h1 {
            font-size: 26px;
        }

        .package-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="package-page">

    <div class="package-container">

        <!-- =========================================
             HEADER
        ========================================== -->

        <div class="package-header">

            <h1>
                Lesson <span>Packages</span>
            </h1>

            <p>
                Choose a package that suits your driving needs.
                Purchase once and use your lessons when booking.
            </p>

        </div>


        <!-- =========================================
             PACKAGES
        ========================================== -->

        @if (Model != null && Model.Any())
        {
            <div class="package-grid">

                @foreach (var package in Model)
                {
                    <div class="package-card">

                        <!-- ICON -->

                        <div class="package-icon">
                            🚗
                        </div>


                        <!-- PACKAGE NAME -->

                        <h2>
                            @package.PackageName
                        </h2>


                        <!-- DESCRIPTION -->

                        <div class="package-description">

                            @package.Description

                        </div>


                        <!-- PRICE -->

                        <div class="package-price">

                            <span class="currency">
                                R
                            </span>

                            <span class="price">
                                @package.Price.ToString("N0")
                            </span>

                        </div>


                        <!-- LESSON COUNT -->

                        <div class="lesson-count">

                            <div class="lesson-count-icon">
                                ✓
                            </div>

                            <div>

                                <strong>
                                    @package.NumberOfLessons Lessons
                                </strong>

                                included in this package

                            </div>

                        </div>


                        <!-- FEATURES -->

                        <ul class="package-features">

                            <li>
                                <span class="check">✓</span>
                                Professional driving instructor
                            </li>

                            <li>
                                <span class="check">✓</span>
                                Flexible lesson scheduling
                            </li>

                            <li>
                                <span class="check">✓</span>
                                Lessons booked through dashboard
                            </li>

                        </ul>


                        <!-- BUTTON -->

                        <a href="@Url.Action(
                            "Details",
                            "Package",
                            new { id = package.LessonPackageId })"
                           class="package-button">

                            View Package

                        </a>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty">

                <h3>
                    No Packages Available
                </h3>

                <p>
                    There are currently no active lesson packages.
                    Please check again later.
                </p>

            </div>
        }

    </div>

</div>