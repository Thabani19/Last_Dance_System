<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TK Driving School</title>

    @Styles.Render("~/Content/css")
    <link href="~/Content/instructor-theme.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        bool isInstructorView = currentController == "Instructor" && Request.IsAuthenticated;
    }

    @if (currentController == "Instructor")
    {
        <!-- Instructor Dashboard Navigation Header -->
        <nav class="top-nav-bar">
            <div class="nav-container">
                <a href="@Url.Action("Dashboard", "Instructor")" class="brand-logo">
                    <span class="logo-box">TK</span>
                    <span class="logo-text">Driving School</span>
                </a>

                <div class="nav-actions">
                    <!-- Notifications Bell Direct Link -->
                    <a href="@Url.Action("Index", "Notifications")" class="nav-icon-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                    </a>

                    <!-- Hamburger Navigation Dropdown -->
                    <div class="dropdown">
                        <button class="nav-icon-btn" type="button" id="navMenu" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navMenu">
                            <a class="dropdown-item" href="@Url.Action("Dashboard", "Instructor")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                            <a class="dropdown-item" href="@Url.Action("Schedule", "Instructor")">
                                <i class="bi bi-calendar-event me-2"></i> Schedule &amp; Students
                            </a>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Instructor")">
                                <i class="bi bi-person me-2"></i> Profile
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#generalFeedbackModal" data-bs-toggle="modal" data-bs-target="#generalFeedbackModal">
                                <i class="bi bi-chat-left-text me-2"></i> Give Feedback
                            </a>
                        </div>
                    </div>

                    <!-- Logout Form -->
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-icon-btn" style="background:none; border:none;" title="Log Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    }
                </div>
            </div>
        </nav>
    }
    else
    {
        <!-- Public Header: Shows Brand + Login & Register Only -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container">
                <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")" style="font-weight: 700;">
                    <span style="background: #0284c7; color: white; padding: 4px 8px; border-radius: 6px;">TK</span> Driving School
                </a>
                <div class="ms-auto d-flex gap-2">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-sm">Log In</a>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm" style="background-color: #0284c7; border: none;">Register</a>
                </div>
            </div>
        </nav>
    }

    <div class="nav-actions">
        <!-- Notifications Bell Direct Link -->
        <a href="@Url.Action("Index", "Notifications")" class="nav-icon-btn" title="Notifications">
            <i class="bi bi-bell"></i>
        </a>

        <!-- Navigation Menu Dropdown -->
        <div class="dropdown">
            <button class="nav-icon-btn" type="button" id="navMenu" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navMenu">
                <a class="dropdown-item" href="@Url.Action("Dashboard", "Instructor")">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="dropdown-item" href="@Url.Action("Schedule", "Instructor")">
                    <i class="bi bi-calendar-event me-2"></i> Schedule &amp; Students
                </a>
                <a class="dropdown-item" href="@Url.Action("Profile", "Instructor")">
                    <i class="bi bi-person me-2"></i> Profile
                </a>
                <div class="dropdown-divider"></div>
                <!-- Feedback Trigger -->
                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#generalFeedbackModal" data-bs-toggle="modal" data-bs-target="#generalFeedbackModal">
                    <i class="bi bi-chat-left-text me-2"></i> Give Feedback
                </a>
            </div>
        </div>

        <!-- Logout Icon -->
        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-icon-btn text-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        }
    </div>
    </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <!-- Include jQuery and Bootstrap JS with Popper.js included -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

    <!-- Global Instructor Feedback Modal -->
    <div class="modal fade" id="generalFeedbackModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 12px;">
                @using (Html.BeginForm("SubmitGeneralFeedback", "Instructor", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom: 1px solid #f3f4f6;">
                        <h5 class="modal-title" style="font-weight: 700; color: #1f2937;">Send Feedback</h5>
                        <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="padding: 20px;">
                        <div class="form-group mb-3">
                            <label style="font-weight: 600; color: #374151; margin-bottom: 6px;">Feedback Type</label>
                            <select name="feedbackType" class="form-control" required>
                                <option value="General">General App Feedback</option>
                                <option value="Student Issue">Student / Schedule Issue</option>
                                <option value="Bug Report">System Bug Report</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label style="font-weight: 600; color: #374151; margin-bottom: 6px;">Your Comments / Notes</label>
                            <textarea name="comments" class="form-control" rows="4" placeholder="Type your feedback here..." required style="border-radius: 8px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #f3f4f6;">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" style="background-color: #0284c7; border: none;">Submit Feedback</button>
                    </div>
                }
            </div>
        </div>
    </div>

</body>
</html>