<!DOCTYPE html>
<html lang="en" style="background-color: #0a0e17 !important;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TK Driving School</title>

    @Styles.Render("~/Content/css")
    <link href="~/Content/instructor-theme.css?v=4.0" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    @Scripts.Render("~/bundles/modernizr")
</head>
<body style="background-color: #0a0e17 !important; color: #ffffff !important; margin: 0; padding: 0;">
    <!-- Top Hazard Stripe Bar -->
    <div class="top-stripe-bar"></div>

    @{
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                          && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);

        bool isAppView = !isHomePage && !string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase);
    }

    @if (isAppView)
    {
        <nav class="app-top-nav">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <!-- Red Box TK Logo -->
                <a href="@Url.Action("Dashboard", "Instructor")" class="tk-logo-box text-decoration-none">
                    TK Driving School
                </a>

                <!-- Navigation Icons -->
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <!-- Notifications Icon -->
                    <a href="@Url.Action("Index", "Notifications")" class="nav-icon-link position-relative" title="Notifications">
                        <i class="bi bi-bell"></i>
                    </a>

                    <!-- Hamburger Dropdown Menu -->
                    <div class="dropdown">
                        <button class="nav-icon-link bg-transparent border-0" type="button" id="navMenu" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-list fs-4"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right custom-dark-dropdown shadow-lg">
                            <a class="dropdown-item" href="@Url.Action("Dashboard", "Instructor")">Dashboard</a>
                            <a class="dropdown-item" href="@Url.Action("Schedule", "Instructor")">Schedule &amp; students</a>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Instructor")">Profile</a>
                            <a class="dropdown-item" href="@Url.Action("Feedback", "Instructor")">Feedback</a>
                        </div>
                    </div>

                    <!-- Logout Link -->
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-icon-link bg-transparent border-0 p-0" title="Log Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    }
                </div>
            </div>
        </nav>
    }

    <!-- Container Area -->
    <div class="container body-content mt-4" style="background-color: #0a0e17 !important;">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)


    <!-- Global Instructor Feedback Modal -->
    <div class="modal fade" id="generalFeedbackModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 12px; background-color: #111827; border: 1px solid #1f2937; color: #ffffff;">
                @using (Html.BeginForm("SubmitGeneralFeedback", "Instructor", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom: 1px solid #1f2937;">
                        <h5 class="modal-title" style="font-weight: 700; color: #ffffff;">Send Feedback</h5>
                        <button type="button" class="close btn-close btn-close-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="padding: 20px;">
                        <div class="form-group mb-3">
                            <label style="font-weight: 600; color: #94a3b8; margin-bottom: 6px;">Feedback Type</label>
                            <select name="feedbackType" class="form-control" style="background-color: #0b1120; border-color: #1f2937; color: #ffffff;" required>
                                <option value="General">General App Feedback</option>
                                <option value="Student Issue">Student / Schedule Issue</option>
                                <option value="Bug Report">System Bug Report</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label style="font-weight: 600; color: #94a3b8; margin-bottom: 6px;">Your Comments / Notes</label>
                            <textarea name="comments" class="form-control" rows="4" placeholder="Type your feedback here..." required style="border-radius: 8px; background-color: #0b1120; border-color: #1f2937; color: #ffffff;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #1f2937;">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" style="background-color: #e11d48; border: none;">Submit Feedback</button>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>