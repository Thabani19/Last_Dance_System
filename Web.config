<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Stripe -->
    <add key="Stripe:Simulate" value="true" />
    <add key="Stripe:ApiKey" value="sk_test_YOUR_KEY_HERE" />

    <!-- SMTP (example) -->
    <add key="Smtp:Host" value="smtp.example.com" />
    <add key="Smtp:Port" value="587" />
    <add key="Smtp:User" value="smtp-user" />
    <add key="Smtp:Pass" value="smtp-pass" />
    <add key="Smtp:From" value="no-reply@example.com" />
  </appSettings>

  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=(LocalDb)\MSSQLLocalDB;Database=LastDanceDb;Integrated Security=true;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!-- keep or merge other sections such as system.web, system.net/mailSettings, runtime, etc. -->
</configuration>